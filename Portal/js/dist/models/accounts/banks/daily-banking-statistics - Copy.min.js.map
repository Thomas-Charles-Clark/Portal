const dailyBankingStatisticsViewModel = ({ } = {}) => {
    let self = {};

    //#region Properties

    self.ready = ko.observable(false);

    self.busy = ko.observable(true);

    self.busyMessage = ko.observable('Please Wait');

    self.gridWidget = ko.observable();

    let now = new Date();

    self.date = ko.observable(now);

    self.records = ko.observableArray([]);

    self.columns = ko.observableArray([]);

    //#endregion



    //#region Components

    self.gridDataSourceRead = (options) => {
        var webapi = new kendo.data.transports.webapi({ prefix: "" });

        var mapped = webapi.parameterMap(options.data);

        var additionalParameters = {
            date: self.date().toUTCString()
        };

        var params = new URLSearchParams();

        var data = Object.assign(mapped, additionalParameters);

        for (var propertyName in data) {
            if (Array.isArray(data[propertyName])) {
                data[propertyName].forEach(v => {
                    params.append(propertyName, v);
                });
            } else {
                params.append(propertyName, data[propertyName]);
            }
        }

        console.log('dailyBankingStatistics gridDataSourceRead calling with', data);

        self.busy(true);

        fetch('/api/dailybankingstatisticsapi/BankingStatistics_Select?' + params, {
            method: 'GET',
            headers: window.fetchHeaders,
            cache: 'no-cache',
            credentials: 'same-origin'
        })
            .then(window.handleFetchResponse)
            .then(data => {

                console.log('dailyBankingStatistics gridDataSourceRead returned', data);

                ko.ignoreDependencies(() => {

                    if (Object.hasOwn(data, 'errorMessage')) {

                        document.querySelector('#info-modal').addEventListener('hide.bs.modal', self.refresh);
                        options.success([]);
                        window.showInfo('Sorry', data.errorMessage);

                    } else {
                        document.querySelector('#info-modal')?.removeEventListener('hide.bs.modal', self.refresh);

                        self.records(data.values);

                        self.columns([{
                            field: 'Label',
                            title: ' ',
                            attributes: {
                                class: 'row-label-cell'
                            },
                            width: '200px',
                            editable: () => false,
                            template: (dataItem) => {
                                return dataItem.Label;
                            },
                            locked: true
                        },
                        ...data.columns.map(c => {
                            return {
                                field: c.Label,
                                title: c.Label,
                                attributes: {
                                    'class': ''
                                },
                                width: c.Width ?? 160,
                                editable: () => false,
                                template: (dataItem) => {
                                    return self.records().find(r => {
                                        return (r.RowID == dataItem.RowID &&
                                            r.ColumnID == c.ColumnID);
                                    }).Value;
                                },
                                headerTemplate: (dataItem) => {
                                    return `<span>${c.Label}</span><a class="stretched-link" href="javascript:;" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="${c.ToolTip}"></a>`
                                }
                            }
                        })]);

                        options.success(data.gridData);
                    }

                    if (typeof callback == 'function') {
                        callback();
                    } else {
                        self.busy(false);
                    }
                });

            })
            .catch(err => {
                self.busy(false);
                window.catchFetchError(err);
            })
    }

    self.dateParams = {
        label: "From",
        observable: self.date,
        originalValue: self.date(),
        displayObservable: ko.observable(),
        dateTimePickerOptions: {
            localization: {
                locale: 'en-GB',
                format: 'dddd Do MMMM (dd/MM/yyyy)',
                ordinal: (n) => {
                    const s = ['th', 'st', 'nd', 'rd'];
                    const v = n % 100;
                    return n + (s[(v - 20) % 10] || s[v] || s[0]);
                }
            },
            display: {
                sideBySide: false,
                components: {
                    clock: false,
                    calendar: true,
                    date: true,
                    month: true,
                    year: true,
                    decades: false,
                    clock: false,
                    hours: false,
                    minutes: false,
                    seconds: false
                },
                viewMode: 'calendar',
                cellSize: '3rem'
            },
            restrictions: {
                disabledDates: [],
                //maxDate: new Date(),
            },
            allowInputToggle: true,
            useCurrent: false,
            keepInvalid: true,
            debug: false
        },
        clearable: ko.observable(false),
        revertible: ko.observable(true),
        revertFunction: () => {
            self.dateParams.observable(self.dateParams.originalValue);
        },
        useNativeValidation: false,
        insertValidationMessages: false,
        decorateInputElement: true,
        popupSettings: {
            appendTo: `#daily-statistics-date`
        }
    };

    self.gridDataSource = new kendo.data.DataSource({
        transport: {
            read: self.gridDataSourceRead
        },
        pageSize: 50,
        serverPaging: true,
        serverSorting: true,
        serverFiltering: true,
        autoSync: false,
        schema: $.extend({}, kendo.data.schemas.webapi, {
            data: "Data", 
            total: "Total",
            errors: "Errors",
            aggregates: "Aggregates",
            model: {
                id: 'RowID',
                fields: {
                    RowID: { type: 'number' },
                    Label: { type: 'string' },
                    Tooltip: { type: 'string' },
                    SortOrder: { type: 'number' }
                }
            }
        }),
        requestStart: function (e) {
            console.log('requestStart', e);
        },
        requestEnd: function (e) {
            //if (e.type == "create") {
            //    this.read();
            //}
            self.gridWidget().setOptions({
                autoBind: false,
                columns: self.columns()
            })
        },
    });

    self.gridParams = {
        autoBind: true,
        widget: self.gridWidget,
        columns: self.columns(),
        editable: true,
        batch: true,
        toolbar: ["save", "cancel"],
        // Don't know if we'll ever want to allow addition from here; at present I'm
        // only intent on updating portal.DGPaymentDetails (as opposed to updating MERTEX.BANK directly).
        // I can only imagine the use of this grid is as a data-tidy.
        edit: function (e) {
            if (e.model.isNew()) {
                if (e.sender.options.editable != 'inline') {
                    e.sender.setOptions({ editable: 'inline' });
                    e.sender.one('dataBound', function (x) {
                        window.setTimeout(function () {
                            e.sender.addRow();
                            e.sender.one('dataBound', function (y) {
                                window.setTimeout(function () {
                                    e.sender.setOptions({ editable: 'incell' });
                                }, 0);
                            });
                        }, 0);
                    });
                }
            }
        },
        cancel: function (e) {
            if (e.sender.options.editable == 'inline') {
                e.sender.setOptions({ editable: 'incell' });
            }
        },
        data: self.gridDataSource,
        dataBound: (e) => {
            window.setTimeout(() => {
                const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
            }, 0);
        },
        sortable: true,
        filterable: false,
        reorderable: true,
        pageable: {
            pageSize: 50,
            pageSizes: [10, 20, 50, 100, 200]
        },
        scrollable: true,
        height: 'calc(100vh - 230px)'
    };

    self.errors = new ko.validation.group([

    ]);

    //#endregion



    //#region Computeds



    //#endregion



    //#region Subscriptions



    //#endregion



    //#region Methods

    self.init = () => {

    }

    //#endregion



    //#region Events



    //#endregion


    return self;
};