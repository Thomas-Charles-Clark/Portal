const dailyBankingStatisticsRowViewModel = ({ rec, row } = {
    rec: {},
    column: {}
}) => {
    let self = Object.assign({

    }, rec);

    //#region Properties

    self.ready = ko.observable(false);

    self.busy = ko.observable(true);

    self.busyMessage = ko.observable('Please Wait');

    self.value = ko.observable(self.Value);

    self.originalValue = self.Value;

    switch (column.DataType) {
        case 'money':
            self.value.extend({

                currencyFormatted: {
                    digits: 2,
                    currency: {
                        FormattingCulture: self.FormattingCulture ?? 'en-GB',
                        Code: self.CurrencyCode ?? 'GBP',
                    }
                }

                //numberFormatted: {
                //    digits: 2,
                //    currency: {
                //        FormattingCulture: self.FormattingCulture
                //    }
                //}
            });
            break;
    }

    //#endregion



    //#region Components

    self.valueParams = {
        observable: self.value,
        useNativeValidation: false,
        decorateInputElement: true,
        insertValidationMessages: false,
        showClear: false,
        buttons: false,
        revertible: true,
        clearable: true,
        revertFunction: () => {
            self.value(self.originalValue)
        },
        clearFunction: () => {
            self.value(undefined);
        }
    }

    //#endregion



    //#region Computeds



    //#endregion



    //#region Subscriptions



    //#endregion



    //#region Methods

    self.init = () => {

    }

    self.template = (c) => {
        return self.cells(c.index);
    }

    //#endregion



    //#region Events



    //#endregion


    return self;
};