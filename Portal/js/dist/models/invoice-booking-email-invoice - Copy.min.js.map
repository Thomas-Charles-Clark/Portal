const invoiceBookingEmailInvoiceViewModel = ({
    rec
} = {

    }) => {
    let self = Object.assign(rec, {

    });

    //#region Properties

    self.busy = ko.observable(false);

    self.supplierCode = ko.observable(`${rec.SupplierReference}`);
    self.supplier = ko.observable();

    //#endregion


    //#region Lifted Bits



    //#endregion


    //#region Components

    self.supplierParams = kendoMDCDropDownList({
        autoBind: true,
        label: 'Supplier',
        odata: true,
        endPoint: '/odata/Suppliers',
        textField: 'Name',
        valueField: 'SupplierCode',
        virtual: true,
        pageSize: 40,
        virtualOptions: {
            itemHeight: 34,
            mapValueTo: 'dataItem',
            valueMapper: function (options) {
                if (options.value && options.value != '') {
                    $.ajax({
                        url: `/odata/Suppliers/Default.SupplierValueMapper(supplierCode="${options.value}")`,
                        type: 'GET',
                        success: function (data) {
                            options.success(data.value);
                            if (data.value.length == 1) {
                                self.supplier(data.value[0]);
                            }
                        }
                    });
                } else {
                    options.success();
                }
            }
        },
        idObservable: self.supplierCode,
        objObservable: self.supplier,
        enable: ko.observable(true),
        disable: ko.observable(false),
        clearable: ko.observable(true),
        revertible: ko.observable(false),
        readOnly: false,
        filter: 'contains',
        height: 340,
        parameterMap: (data) => {
            //Generate parameters in odata v4 format
            let d = kendo.data.transports['odata-v4'].parameterMap(data);

            /// thanks, https://stackoverflow.com/questions/28995757/a-binary-operator-with-incompatible-types-was-detected-found-operand-types-edm/48919770
            delete d.$inlinecount; // <-- remove inlinecount
            //delete d.$format; // <-- remove format
            //delete d.$callback; // <-- remove callback

            d.$count = true;

            if (data.filter &&
                data.filter.filters.length &&
                data.filter.filters[0].value != '') {

                let filterValue = data.filter.filters[0].value;

                d.$filter = `StartsWith(ToLower(Name), '${filterValue}') OR StartsWith(ToLower(SupplierCode), '${filterValue}')`;
            }

            return d;
        }
    })

    //#endregion


    //#region Computeds

    self.src = ko.computed(() => {
        return `/incomingemail/attachments/${self.IsInline ? 'inline' : 'regular'}/null/${self.AttachmentID}.${self.FileExtension}`;
    }, self);

    //#endregion


    //#region Subscriptions



    //#endregion


    //#region Methods


    //#endregion


    //#region Events

    self.attributePropertiesResizeStart = (event, ui) => {
        document.querySelector('#attachment-iframe-wrapper').classList.add('blocked');
    }

    self.attributePropertiesResizeStop = (event, ui) => {
        document.querySelector('#attachment-iframe-wrapper').classList.remove('blocked');
    }

    //#endregion

    return self;
}