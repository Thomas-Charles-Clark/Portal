const creditControlDebtBreakdownViewModel = ({
    rec
} = {
    rec: {}
}) => {
    let self = {};

    //#region Properties

    self.ready = ko.observable(false);

    self.busy = ko.observable(false);

    self.heading = ko.observable(rec.Heading.Heading);

    self.pods = ko.observableArray(rec.Pods.map(p => creditControlDebtBreakdownPod({
        rec: p
    })));

    self.records = ko.observableArray(rec.Records.map(p => creditControlDebtBreakdownRecord({
        rec: p
    })));

    //#endregion



    //#region Methods



    //#endregion



    //#region Components

    self.errors = new ko.validation.group([

    ]);

    //#endregion



    //#region Computeds



    //#endregion





    //#region Subscriptions



    //#endregion



    //#region Events



    //#endregion


    return self;
};