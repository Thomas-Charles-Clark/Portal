const creditControlSalesLedgerRecordViewModel = ({
    rec
} = {
        rec: {}
    }) => {
    let self = Object.assign({

    }, rec);

    self.popoverInsertion = async function(event) {
        window.setTimeout(() => {
            document.addEventListener("click", (e) => {
                if (e.target.closest('.info-popover') == null) {
                    document.querySelectorAll('[data-bind*="actualBootstrapPopover"]').forEach(e => {
                        let p = bootstrap.Popover.getInstance(e);
                        if (p) {
                            p.hide();
                        }
                    });
                }
            });
        }, 0);
    }

    self.creditsPopoverInfo = {
        title: "Credits Info",
        html: true,
        sanitize: false,
        busy: ko.observable(false),
        data: ko.observable(),
        element: ko.observable(),
        placement: 'left',
        customClass: 'info-popover credits',
        content: (element) => {
            let e = ko.dataFor(element);
            return `${e.CreditsInfo}`;
        },
        trigger: 'click',
        solo: true,
        show: null,
        shown: (e) => {

        },
        hide: null,
        hidden: null,
        inserted: self.popoverInsertion,
        popperConfig: (defaultPopperConfig) => defaultPopperConfig
    };

    self.depositsPopoverInfo = {
        title: "Deposits Info",
        html: true,
        sanitize: false,
        busy: ko.observable(false),
        data: ko.observable(),
        element: ko.observable(),
        placement: 'left',
        customClass: 'info-popover deposits',
        content: (element) => {
            let e = ko.dataFor(element);
            return `${e.DepositsInfo}`;
        },
        trigger: 'click',
        solo: true,
        show: null,
        shown: (e) => {

        },
        hide: null,
        hidden: null,
        inserted: self.popoverInsertion,
        popperConfig: (defaultPopperConfig) => defaultPopperConfig
    };

    self.overpaymentsPopoverInfo = {
        title: "Overpayments Info",
        html: true,
        sanitize: false,
        busy: ko.observable(false),
        data: ko.observable(),
        element: ko.observable(),
        placement: 'left',
        customClass: 'info-popover overpayments',
        content: (element) => {
            let e = ko.dataFor(element);
            return `${e.OverpaymentsInfo}`;
        },
        trigger: 'click',
        solo: true,
        show: null,
        shown: (e) => {

        },
        hide: null,
        hidden: null,
        inserted: self.popoverInsertion,
        popperConfig: (defaultPopperConfig) => defaultPopperConfig
    };

    self.refundsPopoverInfo = {
        title: "Refunds Info",
        html: true,
        sanitize: false,
        busy: ko.observable(false),
        data: ko.observable(),
        element: ko.observable(),
        placement: 'left',
        customClass: 'info-popover refunds',
        content: (element) => {
            let e = ko.dataFor(element);
            return `${e.RefundsInfo}`;
        },
        trigger: 'click',
        solo: true,
        show: null,
        shown: (e) => {

        },
        hide: null,
        hidden: null,
        inserted: self.popoverInsertion,
        popperConfig: (defaultPopperConfig) => defaultPopperConfig
    };

    self.proformaPaymentsPopoverInfo = {
        title: "Proforma Payments Info",
        html: true,
        sanitize: false,
        busy: ko.observable(false),
        data: ko.observable(),
        element: ko.observable(),
        placement: 'left',
        customClass: 'info-popover proforma',
        content: (element) => {
            let e = ko.dataFor(element);
            return `${e.ProformaPaymentsInfo}`;
        },
        trigger: 'click',
        solo: true,
        show: null,
        shown: (e) => {
           
        },
        hide: null,
        hidden: null,
        inserted: self.popoverInsertion,
        popperConfig: (defaultPopperConfig) => defaultPopperConfig
    };

