      <endpoint address="https://services.postcodeanywhere.co.uk/Capture/Interactive/Retrieve/v1.00/soapnew.ws" binding="basicHttpBinding" bindingConfiguration="PostcodeAnywhere_Soap2" contract="PCARetrieve.PostcodeAnywhere_Soap" name="PostcodeAnywhere_Soap1" />
