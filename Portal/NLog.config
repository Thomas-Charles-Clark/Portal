<?xml version="1.0" encoding="utf-8" ?>
<nlog throwExceptions="true" xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogFile="D:/nlog.txt"
      internalLogToConsole="true"
      internalLogLevel="Info"
      autoReload="true">

  <!-- 
  See http://nlog-project.org/wiki/Configuration_file 
  for information on customizing logging rules and outputs.
   -->
  <targets>
    <target xsi:type="File" name="TraceTarget"
            fileName="${basedir}/Logs/Trace/${date:format=yyyy}/${date:format=MMMM}/Trace_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/Trace_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${logger} ${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="31"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="DebugTarget"
            fileName="${basedir}/Logs/Debug/${date:format=yyyy}/${date:format=MMMM}/Debug_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/Debug_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${logger} ${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="31"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="InfoTarget"
            fileName="${basedir}/Logs/Info/${date:format=yyyy}/${date:format=MMMM}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/Info_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${logger} ${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="31"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="WarnTarget"
            fileName="${basedir}/Logs/Warnings/${date:format=yyyy}/${date:format=MMMM}/Warnings_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/Warnings_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${logger} ${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="31"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="ErrorTarget"
            fileName="${basedir}/Logs/Errors/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/Errors_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${logger} ${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="31"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="FatalTarget"
            fileName="${basedir}/Logs/Fatal/${date:format=yyyy}/${date:format=MMMM}/Fatal_${date:format=dd-MM-yyyy}.log"
            archiveFileName="${basedir}/Logs/Archives/${date:format=yyyy}/${date:format=MM}/Fatal_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${logger} ${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="31"
            archiveAboveSize="1000000"
            createDirs="true"/>
  </targets>

  <rules>
    <logger name="*" level="Trace" writeTo="TraceTarget" />
    <logger name="*" level="Debug" writeTo="DebugTarget" />
    <logger name="*" level="Info" writeTo="InfoTarget" />
    <logger name="*" level="Warn" writeTo="WarnTarget" />
    <logger name="*" level="Error" writeTo="ErrorTarget" />
    <logger name="*" level="Fatal" writeTo="FatalTarget" />
  </rules>
</nlog>