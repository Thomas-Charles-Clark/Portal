:root {
  --vsm-gutter: 0.25rem;
  --sm-gutter: 0.5rem;
  --m-gutter: 0.75rem;
  --l-gutter: 1rem;
  --mxl-gutter: 1.5rem;
  --xl-gutter: 2rem;
  --xxl-gutter: 3rem;
  --disco-color: #e51f7c;
  --letter-spacing-slight: 0.05rem;
  --page-heading-colour: #44546b;
}

.input-group-lg .btn {
  font-size: 1rem;
}

.page-heading-logo {
  width: 44px;
  height: 90px;
}

#invoicing {
  padding: 1rem;
  background-color: #fff;
  border: 1px solid #ced4da;
  border-radius: 0.375rem;
}

.prefilters {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  align-items: center;
}
.prefilters > div:not(#advanced-collapse) {
  flex: 0 1 auto;
  min-width: 260px;
}
.prefilters .k-animation-container li.k-item {
  line-height: 33px;
}
.prefilters > div {
  position: relative;
}
.prefilters + .prefilters {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #dee2e6;
}
.prefilters .k-dropdown-wrap.k-input {
  padding: 9px 0 6px 0;
}

#branches-table {
  margin-top: 1rem;
  margin-bottom: 0;
  font-size: 1rem;
}
#branches-table tr:not(.active) td {
  cursor: pointer;
}
#branches-table tr.table-active td, #branches-table tr.table-active th {
  background-color: #e2eeff;
}
#branches-table tr:focus td,
#branches-table tr:focus-within td {
  border: 1px solid #dee2e6;
}

#sbi-result {
  margin-top: 1rem;
}
#sbi-result .grid {
  gap: 0.5rem;
  grid-template-columns: 0.65fr 0.35fr;
}
#sbi-result .grid > div > .heading {
  background-color: #506e9c;
}

#invoice-document-form {
  margin-top: 14px;
}
#invoice-document-form.offset-top {
  margin-top: 35px;
}
#invoice-document-form .btn-outline-secondary {
  width: 100% !important;
}
#invoice-document-form > div.relative {
  margin-bottom: 1rem;
  padding-bottom: 150%;
}
#invoice-document-form .file-input-wrapper {
  display: none;
}
#invoice-document-form iframe {
  border: 0;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

#invoicing-wrapper {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 36px;
  gap: 1rem;
}
#invoicing-wrapper #invoicing-blurb {
  flex: 1;
  flex-basis: 42%;
}
#invoicing-wrapper #invoicing-values {
  flex: 1;
}
#invoicing-wrapper #invoicing-values > div {
  display: flex;
  justify-content: flex-end;
}
#invoicing-wrapper #invoicing-values > div .field {
  flex-basis: 100%;
}

.heading {
  color: #fff;
  background: #31548B;
  padding: 0.75rem 1rem;
  font-size: 1.25rem;
}
.heading a {
  font-size: 85%;
  color: #fff;
}
.heading.prefilters {
  font-size: 1rem;
}
.heading.prefilters .mdc-select .k-dropdown-wrap {
  border-radius: 0.375rem;
}
.heading.prefilters .mdc-select .k-dropdown-wrap .k-input {
  padding: 9px 0;
}
.heading.prefilters .mdc-select .k-widget {
  background-color: #fff;
}
.heading.prefilters .mdc-select .k-state-hover,
.heading.prefilters .mdc-select .k-state-focused,
.heading.prefilters .mdc-select .k-dropdown-wrap.k-state-focused {
  background-color: #fff;
}

#daily-invoice-details th, #daily-invoice-details td {
  border: 0;
}
#daily-invoice-details th.separator, #daily-invoice-details td.separator {
  padding: 0;
  padding-top: 1rem;
  border: 0;
}

#details-modal .k-grid-content table tbody tr.sale td, #details-modal .k-grid-content table tbody tr.sale th {
  background-color: #d3e8d3;
}
#details-modal .k-grid-content table tbody tr.credit td, #details-modal .k-grid-content table tbody tr.credit th {
  background-color: #e8cccc;
}

#advanced-collapse-btn {
  display: flex;
  align-self: stretch;
  align-items: center;
  padding-top: 2px;
  padding-bottom: 2px;
}
#advanced-collapse-btn i {
  line-height: 0;
}

#advanced-collapse-inner {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  align-items: center;
  width: 132px;
}

.processed-tick {
  position: relative;
  right: 2px;
  text-decoration: none;
  color: #000;
}
.processed-tick:active, .processed-tick:focus {
  border: none;
}
/*# sourceMappingURL=fenwick-invoicing - Copy.css.map */
