:root {
  --vsm-gutter: 0.25rem;
  --sm-gutter: 0.5rem;
  --m-gutter: 0.75rem;
  --l-gutter: 1rem;
  --mxl-gutter: 1.5rem;
  --xl-gutter: 2rem;
  --xxl-gutter: 3rem;
  --disco-color: #e51f7c;
  --letter-spacing-slight: 0.05rem;
  --page-heading-colour: #44546b;
}

.input-group-lg .btn {
  font-size: 1rem;
}

#pre-defined-filters {
  margin-bottom: 1rem;
  position: sticky;
  left: 0;
}
#pre-defined-filters .pre-defined-filter-list .card-title {
  font-size: 1.15rem;
}

.pre-defined-filter-list {
  display: grid;
  gap: 2px;
  width: 100%;
  grid-template-columns: repeat(auto-fill, minmax(136px, 1fr));
}
.pre-defined-filter-list > div:first-of-type {
  border-top-left-radius: 0.375rem;
  border-bottom-left-radius: 0.375rem;
}
.pre-defined-filter-list > div:last-of-type {
  border-top-right-radius: 0.375rem;
  border-bottom-right-radius: 0.375rem;
}
.pre-defined-filter-list .card {
  border-radius: 0;
  margin-bottom: 0;
  cursor: pointer;
  flex: 1;
}
.pre-defined-filter-list .card .card-body {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  justify-content: space-between;
  align-items: center;
  padding: 0;
}
.pre-defined-filter-list .card .card-body .card-title {
  text-align: center;
}
.pre-defined-filter-list .card .card-body label {
  text-align: center;
  margin-bottom: 0;
}
.pre-defined-filter-list .card .card-body p {
  margin-bottom: 0;
  text-align: center;
}
.pre-defined-filter-list .card .card-body p span {
  display: block;
}
.pre-defined-filter-list .card:focus, .pre-defined-filter-list .card:focus-within, .pre-defined-filter-list .card:hover {
  filter: brightness(102%);
}
