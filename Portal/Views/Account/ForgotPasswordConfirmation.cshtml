@{
    ViewBag.Title = "Forgot Password Confirmation - Designers Guild Portal";
}

<div class="row">
    <div class="col-md-push-2 col-xs-push-0 col-md-8 col-xs-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h4 class="panel-title">
                    Reset Link Sent
                </h4>
            </div>
            <div id="loginForm" class="panel-body">
                <p>
                    Please check your inbox for an email from portal.noreply@designersguild.com with the subject line "Reset Password - Designers Guild Portal". Remember to check your spam, clutter and junk folders. Please add portal.noreply@designersguild.com to your address book.
                </p>
            </div>
        </div>
    </div>
</div>