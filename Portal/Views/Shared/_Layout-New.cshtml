    <script id="mdc-address-search-component" type="text/html">
        <div class="mdc-address-searcher">
            <div class="input-group" data-bind="keepElement: pcaLookup.inputGroup">
                <div class="input-group-btn">
                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryDropDownList }, style: { width: countryDropDownList.width }"></div>
                </div>
                <div data-bind="component: { name: 'mdc-text-field-pca-list-component', params: pcaLookup }"></div>
            </div>
            <div class="pca-search-results-list list-group" data-bind="keepElement: pcaLookup.searchResultsList, foreach: pcaLookup.searchResultsList" style="min-height: 41px;">
                <!-- ko if: $index() == 0 -->
                <div class="blocker" data-bind="visible: $parent.pcaLookup.observable.busy()">
                    <div class="loading-spinner"></div>
                </div>
                <!-- /ko -->
                <a class="list-group-item" data-bind="click: $component.pcaLookup.itemSelect, attr: { href: 'javascript:;' }, class: type">
                    <span data-bind="text: label"></span>
                    <!-- ko if: type == 'Mertex' && obj.DeliveryReference != 'C' -->
                    <span class="material-icons" data-bind="click: function (data, event) { event.stopPropagation(); $parent.deleteTradeAccountAddressCleanseRecord(data); }">
                        delete_forever
                    </span>
                    <!-- /ko -->
                </a>
            </div>
            @*<!-- ko if: pcaLookup.searchEndpoint() == mertexEndpoint -->
                <button class="btn btn-default margin-top-15" data-bind="text: 'The address I want is not listed, search global address database', attr: { href: 'javascript:;' }, click: function () { if (!pcaLookup.busy()) { pcaLookup.searchEndpoint(pcaEndpoint); } }, css: { 'not-allowed disabled-anchor': pcaLookup.busy }"></button>
                <!-- /ko -->
                <!-- ko ifnot: isMiscTradeAccount() -->
                <!-- ko if: pcaLookup.searchEndpoint() == pcaEndpoint -->
                <button class="btn btn-default margin-top-15" data-bind="text: 'Return to Mertex address book', attr: { href: 'javascript:;' }, click: function () { if (!pcaLookup.busy()) { pcaLookup.searchEndpoint(mertexEndpoint); } }, css: { 'not-allowed disabled-anchor': pcaLookup.busy }"></button>
                <!-- /ko -->
                <!-- /ko -->*@
            <a class="display-block margin-top-15 text-underline" data-bind="text: 'Enter Address Manually', attr: { href: 'javascript:;' }, click: function () { reset(true); addressObject.manual(true); showEditModal(); }"></a>
        </div>
        <div class="modal address-edit-modal" data-keyboard="false" data-backdrop="static" data-bind="keepElement: editModal">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="blocker" data-bind="visible: busy">
                        <div class="loading-spinner"></div>
                        <h3 data-bind="text: busyMessage"></h3>
                    </div>
                    <div class="modal-header grey-blue">
                        <h4 class="modal-title">
                            <span data-bind="text: title"></span>
                            Address
                            <span class="text-transparent" data-bind="text: 'Delivery Reference: ' + addressObject.deliveryReference()"></span>
                        </h4>
                    </div>
                    <div class="modal-body" data-bind="with: addressObject">
                        @* Contact Details section: removed 02/06/2021 - re-added just for Misc Invoice Addresses 23/06/2021 *@
                        <!-- ko if: $parent.title() == 'Invoice' || $parent.title() == 'Collection' -->
                        <div class="flex-container">
                            <div class="address-edit-modal-main">
                                <h4>
                                    Contact Details
                                </h4>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: email }"></div>
                                <div data-bind="component: { name: 'mdc-phone-field-component', params: phone }"></div>
                            </div>
                            <div>
                                <div class="alert alert-warning margin-bottom-0">
                                    Providing a mobile phone number and / or email address will allow the courier to contact the customer
                                    with important <span data-bind="text: $parent.title().toLowerCase()"></span> information, which in turn will lead to a better <span data-bind="text: $parent.title().toLowerCase()"></span> experience. Please
                                    encourage all customers to provide these details.
                                </div>
                            </div>
                        </div>
                        <hr />
                        <!-- /ko -->
                        <div class="flex-container margin-top-5">
                            <div class="address-edit-modal-main">
                                <h4>
                                    <span data-bind="text: `${$parent.title()} Address`"></span>
                                    <!-- ko if: deliveryReference() && deliveryReference() != 'C'-->
                                    <span data-bind="text: `- ${deliveryReference()}`"></span>
                                    <!-- /ko -->
                                </h4>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: name }"></div>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: companyName }"></div>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: addressLine1 }"></div>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: addressLine2 }"></div>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: town }"></div>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: county }"></div>
                                <div data-bind="component: { name: 'mdc-text-field-component', params: postcode }"></div>
                                <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryDropDownList }"></div>
                            </div>
                            <div data-bind="css: { 'invoice-suggestion': deliveryReference() == 'C' } ">
                                <div class="blocker" data-bind="visible: $parent.cleanseBusy()">
                                    <div class="loading-spinner"></div>
                                </div>
                                <!-- ko if: !$parent.cleanseBusy() -->
                                <!-- ko if: $parent.cleanseResult() -->
                                <div id="cleanse-address-fields">
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: {
                                        label: 'Address Line 1',
                                        observable: ko.observable($parent.cleanseResult().Address1 || ' '),
                                        useNativeValidation: false,
                                        decorateInputElement: false,
                                        insertValidationMessages: false,
                                        showClear: false,
                                        readOnly: true
                                    }}, css: { 'address-cleanse-highlight': $parent.cleanseResult().Address1 != addressLine1.observable() }"></div>
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: {
                                        label: 'Address Line 2',
                                        observable: ko.observable($parent.cleanseResult().Address2 || ' '),
                                        useNativeValidation: false,
                                        decorateInputElement: false,
                                        insertValidationMessages: false,
                                        showClear: false,
                                        readOnly: true
                                    }}, css: { 'address-cleanse-highlight': $parent.cleanseResult().Address2 != addressLine2.observable() }"></div>
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: {
                                        label: 'Town',
                                        observable: ko.observable($parent.cleanseResult().Locality || ' '),
                                        useNativeValidation: false,
                                        decorateInputElement: false,
                                        insertValidationMessages: false,
                                        showClear: false,
                                        readOnly: true
                                    }}, css: { 'address-cleanse-highlight': $parent.cleanseResult().Locality != town.observable() }"></div>
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: {
                                        label: 'County',
                                        observable: ko.observable($parent.cleanseResult().AdministrativeArea || ' '),
                                        useNativeValidation: false,
                                        decorateInputElement: false,
                                        insertValidationMessages: false,
                                        showClear: false,
                                        readOnly: true
                                    }}, css: { 'address-cleanse-highlight': $parent.cleanseResult().AdministrativeArea != county.observable() }"></div>
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: {
                                        label: 'Postcode',
                                        observable: ko.observable($parent.cleanseResult().PostalCode || ' '),
                                        useNativeValidation: false,
                                        decorateInputElement: false,
                                        insertValidationMessages: false,
                                        showClear: false,
                                        readOnly: true
                                    }}, css: { 'address-cleanse-highlight': $parent.cleanseResult().PostalCode != postcode.observable() }"></div>
                                </div>
                                <!-- /ko -->
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="alert-wrapper" data-bind="with: addressObject">
                            <!-- ko if: cleansedAddress() -->
                            <div class="alert alert-success">
                                <p>
                                    This address has been validated by Loqate.
                                </p>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: deliveryReference() ==  'C' -->
                            <div class="alert alert-warning">
                                <p>
                                    This is the read-only invoice address provided by the customer.
                                </p>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: deliveryReference() ==  'C' && !$parent.showManualCleanse() && !isValid() -->
                            <div class="alert alert-danger">
                                <p class="bold">
                                    This invoice address is invalid and must be corrected before it can be used.
                                </p>
                                <p>
                                    Please contact Credit Control immediately and request that they correct the invoice address for
                                    <span data-bind="text: $parentContext.$parent.parent.tradeAccount().Code"></span>.
                                </p>
                                <p>
                                    Once they have corrected the address, please click this button to reload the Address section.
                                </p>
                                <button class="btn btn-default margin-top-15" data-bind="click: $parentContext.$parent.refreshAddresses">
                                    Reload Addresses
                                </button>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: deliveryReference() != 'C' && havePerformedLoqateSearch() && $parent.cleanseResult() == null && cleansedAddress() == false -->
                            <div class="alert alert-danger">
                                <p>
                                    Loqate did not find any matches for this address.
                                    <br />
                                    <br />
                                    If you are sure it is correct you may proceed, alternatively change part of the address and run the Loqate address check again.
                                </p>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: deliveryReference() == 'C' && havePerformedLoqateSearch() && $parent.cleanseResult() == null && cleansedAddress() == false -->
                            <div class="alert alert-danger">
                                <p>
                                    Loqate did not find any matches for this address.
                                    <br />
                                    <br />
                                    Please make absolutely sure that this address is correct by contacting the customer directly.
                                </p>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: $parent.showManualCleanse() -->
                            <div class="alert alert-warning margin-bottom-25">
                                <p>
                                    You have edited this address.
                                    <br />
                                    Would you like Loqate to check it for you?
                                </p>
                            </div>
                            <!-- /ko -->
                        </div>
                        <!-- ko if: cleanseResult() && addressObject.deliveryReference() != 'C' -->
                        <div class="alert alert-warning">
                            <p class="alert-title text-center">
                                Loqate have checked the address you entered and they recommend making the above changes
                            </p>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: cleanseResult() && addressObject.deliveryReference() == 'C' -->
                        <div class="alert alert-warning">
                            <p class="alert-title text-center">
                                Loqate have a suggested correction for this customer's invoice address. Credit Control will be notified.
                            </p>
                        </div>
                        <!-- /ko -->
                        <button class="btn btn-blue pull-left" data-bind="click: closeEditModal">
                            Cancel
                        </button>
                        <!-- ko if: addressObject.deliveryReference() !=  'C' -->
                        <button class="btn btn-flat pull-left" data-bind="enable: !cleanseBusy(), click: validateAddress">
                            <span>
                                Use the above Address
                            </span>
                        </button>
                        <!-- /ko -->
                        <!-- ko if: showManualCleanse() -->
                        <button id="perform-manual-cleanse" class="btn btn-green" data-bind="click: function () { attemptAddressCleanse(true); }">
                            Check Address
                        </button>
                        <!-- /ko -->
                        <!-- ko if: cleanseResult() && !addressObject.cleansedAddress() && addressObject.deliveryReference() != 'C' -->
                        <button id="accept-cleanse-address" class="btn btn-green" data-bind="disable: cleanseResultAccepted, click: function () { loadFromLoqateCleanse(cleanseResult()); validateAddress(); }">
                            Apply Recommended Changes
                        </button>
                        <!-- /ko -->
                        <!-- ko if: addressObject.cleansedAddress() || addressObject.deliveryReference() ==  'C' -->
                        <button class="btn btn-green" data-bind="enable: !cleanseBusy(), click: validateAddress">
                            <span data-bind="text: `${verb()} this Address`"></span>
                        </button>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </script>

