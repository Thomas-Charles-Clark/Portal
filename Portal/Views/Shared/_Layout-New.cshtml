    <script type="text/javascript">
        var sendTARFComponentViewModel = function (params) {
            var self = this;

            self.sendEmailBusy = ko.observable(false);

            self.lastSentTo = ko.observable();
            self.showLastSentTo = ko.observable(false);

            self.validateNow = ko.observable(false);

            self.country = ko.observable(81).extend({
                required: {
                    params: true,
                    onlyIf: function () {
                        return self.validateNow()
                    },
                    message: ' '
                }
            });

            self.language = ko.observable(1).extend({
                required: {
                    params: true,
                    onlyIf: function () {
                        return self.validateNow()
                    },
                    message: ' '
                }
            });

            self.language.subscribe(function (newValue) {
                //console.log('language subscribe hit', newValue);
            });

            self.countryWidget = ko.observable();
            self.languageWidget = ko.observable();

            self.countryDropDownSettings = {
                dataValueField: 'CountryID',
                dataTextField: 'Name',
                widget: self.countryWidget,
                data: new kendo.data.DataSource({
                    serverFiltering: true,
                    serverSorting: true,
                    serverGrouping: true,
                    schema: $.extend({}, kendo.data.schemas.webapi, {
                        data: "Data",
                        total: "Total",
                        filters: "Filters",
                        aggregates: "Aggregates",
                        errors: "Errors",
                        model: {
                            id: 'CountryID',
                            fields: {
                                CountryID: { type: 'number' },
                                Name: { type: 'string' }
                            }
                        }
                    }),
                    transport: {
                        read: function (options) {

                            var webapi = new kendo.data.transports.webapi({ prefix: "" });
                            var mapped = webapi.parameterMap(options.data);

                            var data = {};

                            for (var propertyName in mapped) {
                                data[propertyName] = mapped[propertyName];
                            }

                            $.ajax({
                                url: '/api/ComponentAPI/GetCountries',
                                type: "GET",
                                data: data,
                                success: function (data) {
                                    options.success(data);
                                },
                                error: function (data) {
                                    options.error();
                                }
                            });
                        }
                    }
                }),
                valuePrimitive: true,
                value: self.country,
                //dataItem: self.country,
                autoWidth: false,
                autoBind: false,
                optionLabel: 'Please select',
                filter: 'startswith'
            };

            self.languageDropDownSettings = {
                dataValueField: 'Language.LanguageID',
                dataTextField: 'Language.Name',
                widget: self.languageWidget,
                cascadeFrom: 'tarf-country',// self.countryWidget,
                cascadeFromField: 'Country.ProxyCountryID',
                data: new kendo.data.DataSource({
                    serverFiltering: true,
                    serverSorting: true,
                    serverGrouping: true,
                    schema: $.extend({}, kendo.data.schemas.webapi, {
                        data: "Data",
                        total: "Total",
                        filters: "Filters",
                        aggregates: "Aggregates",
                        errors: "Errors",
                        model: {
                            id: 'LanguageID',
                            fields: {
                                LanguageID: { type: 'number' },
                                Name: { type: 'string' }
                            }
                        },
                    }),
                    transport: {
                        read: function (options) {
                            var webapi = new kendo.data.transports.webapi({ prefix: "" });
                            var mapped = webapi.parameterMap(options.data);

                            var data = {};

                            for (var propertyName in mapped) {
                                data[propertyName] = mapped[propertyName];
                            }

                            $.ajax({
                                url: '/api/ComponentAPI/GetLanguages',
                                type: "GET",
                                data: data,
                                success: function (data) {
                                    //console.log('GetLanguages returned', data);
                                    options.success(data);
                                },
                                error: function (data) {
                                    options.error();
                                }
                            });
                        }
                    }
                }),
                valuePrimitive: true,
                //dataItem: self.language,
                autoWidth: false,
                autoBind: false,
                optionLabel: 'Please select',
                value: self.language,
                dataBound: function (e) {
                    var ds = this.dataSource.data();
                    if (ds.length == 1) {
                        this.select(1);
                    } else {
                        this.select('');
                    }
                    this.trigger('change');
                }
            };

            self.name = ko.observable().extend({
                maxLength: 50,
                charsRemaining: {
                    maxLength: 50,
                    onlyIf: function () {
                        return self.validateNow()
                    },
                    elementId: '.tarf-name'
                },
                required: {
                    params: true,
                    message: 'Please provide a name'
                }
            });

            self.phone = ko.observable().extend({
                maxLength: 20,
                charsRemaining: {
                    maxLength: 20,
                    onlyIf: function () {
                        return self.validateNow()
                    },
                    elementId: '.tarf-phone'
                }
            });

            self.email = ko.observable().extend({
                required: {
                    params: true,
                    onlyIf: function () {
                        return self.validateNow()
                    },
                    message: 'Please provide a valid email address'
                },
                maxLength: 256,
                email: {
                    params: true,
                    onlyIf: function () {
                        return self.validateNow()
                    },
                    message: 'Invalid email format'
                },
                charsRemaining: {
                    maxLength: 256,
                    elementId: '.tarf-email'
                }
            });

            self.immediateOrderRequested = ko.observable(false);

            self.errors = ko.validation.group([
                self.email,
                self.name,
                self.country,
                self.language
            ]);

            self.sendEmail = function () {
                self.validateNow(true);
                if (self.errors().length) {
                    self.errors.showAllMessages(true);
                    return;
                } else {
                    self.sendEmailBusy(true);

                    $.ajax({
                        url: '/component/sendTradeAccountRequestFormEmail',
                        type: 'POST',
                        dataType: 'json',
                        data: {
                            email: self.email(),
                            name: self.name(),
                            phone: self.phone(),
                            immediateOrderRequested: self.immediateOrderRequested(),
                            countryId: self.country(),
                            languageId: self.language()
                        },
                        success: function (data) {
                            self.validateNow(false);
                            window.setTimeout(function () {
                                self.sendEmailBusy(false);
                                self.lastSentTo(self.email());
                                self.email(undefined);
                                self.name(undefined);
                                self.phone(undefined);
                                self.immediateOrderRequested(false);
                                self.showLastSentTo(true);
                                self.countryWidget().value(81);
                                self.languageWidget().value(1);
                                window.setTimeout(function () {
                                    self.errors.showAllMessages(false);
                                }, 0);
                                window.setTimeout(function () {
                                    self.showLastSentTo(false);
                                }, 5000);
                            }, 400);
                            if (typeof viewModel === 'object') {
                                if (viewModel.hasOwnProperty('leadSearch')) {
                                    viewModel.leadSearch.dashboardSelect();
                                    viewModel.leadSearch.resultGridWidget().dataSource.read();
                                }
                            }
                        },
                        error: function (xhr, textStatus, errorThrown) {
                            self.validateNow(false);
                            self.sendEmailBusy(false);
                            $.showError(xhr, textStatus, errorThrown);
                        }
                    });
                }
            }

            self.attachValidation = function () {
                //console.log('tarfComponent: attaching validation...');

                self.countryWidget().value(81);

                self.countryWidget().wrapper.children().first().attr('data-bind', 'validationCore: country');
                self.languageWidget().wrapper.children().first().attr('data-bind', 'validationCore: language');
                // calling cleanNode on this element has the unfortunate side effect of preventing some of kendo's
                // functionality: name .k-state-hover does not get applied to the .k-dropdown-wrap.k-state-default
                // span. Fortunately I don't actually need to call cleanNode on it; it's injected by kendo's library
                // and hasn't yet been tickled by knockout! woop!
                ko.applyBindings(self, self.countryWidget().wrapper.children().first()[0]);
                ko.applyBindings(self, self.languageWidget().wrapper.children().first()[0]);
            }
        };

        function webapiCredViewModel() {
            var self = this;

            self.email = ko.observable().extend({
                maxLength: 256,
                email: {
                    params: true,
                    message: 'Invalid email format'
                }
                //,
                //charsRemaining: {
                //    maxLength: 256,
                //    elementId: '#webapi-email'
                //}
            });

            self.password = ko.observable().extend({
                required: {
                    params: true,
                    message: 'Incorrect email / password combination.'
                }
            });

            self.errorGroup = ko.validation.group([
                self.email,
                self.pass
            ]);

            self.authBusy = ko.observable(false);

            self.performAuth = function () {

                self.authBusy(true);

                if (self.errorGroup.length > 0) {
                    self.errorGroup.showAllMessages(true);
                    return;
                } else {
                    self.errorGroup.showAllMessages(false);

                    $.ajax({
                        url: '/token',
                        type: 'POST',
                        contentType: 'application/x-www-form-urlencoded',
                        data: {
                            grant_type: 'password',
                            username: self.email(),
                            password: self.password()
                        },
                        async: false,
                        success: function (data) {
                            self.authBusy(false);
                            console.log(data);
                            localStorage.BearerToken = data.access_token;
                            console.log('bearer token granted');
                            //if (window.lastAjaxCall) {
                            //    $.ajax(window.lastAjaxCall);
                            //    delete window.lastAjaxCall;
                            //}

                            // 26/10/2018 - abandon repeat ajax calling; just reload the page.
                            //window.slicerCalls.forEach(function (settings) {
                            //    $.ajax(settings);
                            //});
                            //window.slicerCalls = [];
                            window.location.reload(true);
                            $("#credentials-modal").modal('hide');

                        },
                        error: function (xhr, textStatus, errorThrown) {
                            self.authBusy(false);
                            self.password(null);
                            if (xhr.hasOwnProperty('responseJSON')) {
                                window.setTimeout(function () {
                                    self.password.setError(xhr.responseJSON.error_description);
                                });
                            }
                            console.log('bearer token was refused: bad authentication')
                        }
                    });
                }
            }

           @if (!Request.Url.AbsoluteUri.ToLowerInvariant().Contains("/account/login"))
            {
                @:$.get('/api/forceauth/forceAuth');
            }
        }

        // Load exchange rates data via AJAX:
        $.getJSON(
            // 'https://openexchangerates.org/api/latest.json?app_id=3a6d0da0d3d446d3b6e2f73bfc7dfc94',
            // Here's just another example of turning to an absolute insane system in order to retrieve bad data,
            // rather than using sensible data. Hooray, Mertex.
            '/Component/GetExchangeRates',
            function (data) {
                // Mertex is so insane that the codes for SEK, DKK and NOK are SKR, DKR and NKR respectively
                $.extend(data.rates, {
                    SEK: data.rates.SKR,
                    DKK: data.rates.DKR,
                    NOK: data.rates.NKR
                })
                // Check money.js has finished loading:
                if (typeof fx !== "undefined" && fx.rates) {
                    fx.rates = data.rates;
                    fx.base = data.base;
                } else {
                    // If not, apply to fxSetup global:
                    var fxSetup = {
                        rates: data.rates,
                        base: data.base
                    }
                }
            }
        );

        var sterlingConversionViewModel = function (params) {
            var self = this;
            params.widget(self);

            self.currency = params.currency || ko.observable();
            self.gbpCurrency = { Name: 'Sterling', Code: 'GBP', FormattingCulture: 'en-GB' };
            self.controlClass = params.controlClass;
            self.placeholder = ko.observable(params.placeholder);
            self.originalPlaceholder = params.placeholder;
            self.currencies = ko.observableArray([]);

            self.currency.subscribe(function (newValue) {
                if (newValue) {
                    self.placeholder(undefined);
                    setTimeout(function () {
                        $(self.value.DOMElement).focus();
                    }, 0);
                } else {
                    self.placeholder(self.originalPlaceholder);
                }
            });

            if (self.currency()) {
                self.placeholder(undefined);
                setTimeout(function () {
                    $(self.value.DOMElement).focus();
                }, 0);
            }

            $.getJSON('/api/ComponentAPI/GetCurrencies', function (data) {
                self.currencies(data);
            });

            self.value = params.value.extend({
                numberFormatted: {
                    digits: 2,
                    currency: self.gbpCurrency
                }
            });

            self.conversion = ko.pureComputed({
                read: function () {
                    if (ko.unwrap(self.currency)) {
                        if (ko.unwrap(self.currency).Code != 'GBP') {
                            var result = fx.convert(self.value() ? self.value() : 0, { from: ko.unwrap(self.currency).ISO_4217, to: 'GBP' });
                            if (result)
                                return result.toFixed(0);
                            else
                                return null;
                        }
                    }
                    return null;
                }
            }, self).extend({
                currencyFormatted: {
                    digits: 0,
                    currency: self.gbpCurrency
                }
            });
        }

        var basketLockViewModel = function (params) {
            var self = this;

            self.mode = ko.observable('dormant'); // dormant, sendingTakeover, receivingTakeover

            self.busy = ko.observable(true);

            self.message = ko.observable();

            self.secondsRemaining = ko.observable(30);

            self.takeoverSecondsRemaining = ko.observable(30);

            self.busyMessage = ko.pureComputed(function () {
                if (self.takeoverSecondsRemaining() > 0)
                    return 'Please wait ' + self.takeoverSecondsRemaining() + ' seconds';
                else
                    return 'Working...';
            }, self);

            // this is set by the init function
            self.parentBusyMessage = ko.observable();

            self.basket = ko.observable();

            self.notifyUserId = ko.observable();

            self.show = function () {
                $('#basket-lock-modal').modal('show');
                if (self.memberBasketFetcher.hasOwnProperty('busy'))
                    self.memberBasketFetcher.busy(false);
            }

            self.hide = function () {
                $('#basket-lock-modal').modal('hide');
                if (self.memberBasketFetcher.hasOwnProperty('busy'))
                    self.memberBasketFetcher.busy(false);
            }

            self.takingOver = null;

            self.relinquishBasket = function () {
                console.log('basketLockViewModel relinquishBasket calling with', { basketId: self.basket().BasketID, notifyUserId: self.notifyUserId() });
                self.basketLockHub.server.relinquishBasket(self.basket().BasketID, self.notifyUserId()).always(function () {
                    self.reset();
                    self.resetOrderFactory();
                    $('#order-products-modal').modal('hide');
                });
            }

            self.refuseTakeover = function () {
                console.log('basketLockViewModel refuseTakeover hit', { notifyUserId: self.notifyUserId, basketId: self.basket().BasketID });
                self.basketLockHub.server.refuseTakeover(self.notifyUserId(), self.basket().BasketID);
                self.hide();
                self.mode('dormant');
                self.busy(false);
                self.secondsRemaining(30);
                self.message(undefined);
                self.notifyUserId(undefined);

                window.clearInterval(self.responseInterval);
            }

            self.receiveOrderProductsGridViewRefresh = function () {
                console.log('basketLockViewModel receiveOrderProductsGridViewRefresh hit');
                if (self.memberBasketFetcher) {
                    if (self.memberBasketFetcher.resultGridWidget()) {
                        self.memberBasketFetcher.resultGridWidget().dataSource.read();
                    }
                    if (self.memberBasketFetcher.importResultGridWidget()) {
                        self.memberBasketFetcher.importResultGridWidget().dataSource.read();
                    }
                }
            }

            self.receiveRefresh = function () {
                window.location.reload();
            }

            self.sendTakeover = function () {
                self.busy(true);

                self.mode('sendingTakeover');

                console.log('basketLockViewModel sendTakeover hit', self.basket().BasketID);

                // because there's potentially no client to receive the takeover request, we in some cases have to force a quick steal.
                // how can I find out whether or not there was actually a recipient...?
                // that's messy, SignalR demands that we track users ourselves...
                self.basketLockHub.server.sendTakeover(getUserId(), self.basket().BasketID).always(function () {
                    self.takeoverSecondsRemaining(30);

                    window.clearInterval(self.takeoverInterval);

                    self.takeoverInterval = setInterval(function () {
                        self.takeoverSecondsRemaining(self.takeoverSecondsRemaining() - 1);
                    }, 1000);

                    window.clearTimeout(self.takingOver);

                    self.takingOver = window.setTimeout(function () {
                        // fahq...
                        self.unlockBasket(function () {
                            self.busy(false);
                            self.hide();
                            self.showOrderFactory();
                        });
                    }, 30000);
                });
            }

            self.changeDevice = function () {
                self.takeoverSecondsRemaining(-1);
                self.busy(true);

                self.id = new Date().getTime();

                self.basketLockHub.server.sendDeviceChange(getUserId(), self.basket().BasketID, self.id);
            }

            self.receiveDeviceChange = function (params) {
                if (self.hasOwnProperty('id')) {
                    if (self.id == params.id) {
                        //self.busy(false);
                        self.showOrderFactory();
                        return;
                    }
                }

                //self.busy(false);
                self.reset();
                self.resetOrderFactory();
                $('#order-products-modal').modal('hide');
                $('#order-processing-modal').modal('hide');
                $('#allocation-warning-modal').modal('hide');
            }

            // placeholder; will be overridden in init function
            self.memberBasketFetcher = null;

            // placeholder; will be overridden in init function
            self.showNewBasket = function () { }

            // placeholder; will be overridden in init function
            self.showOrderFactory = function () { }

            // placeholder; will be overridden in init function
            self.hideOrderFactory = function () { }

            // placeholder; will be overridden in init function
            self.resetOrderFactory = function () { }

            self.unlockAndRelinquishBasket = function (complete) {
                if (self.basket()) {
                    console.log('basketLockViewModel unlockAndRelinquishBasket calling with', self.basket().BasketID);
                    if (self.basketLockHub.connection.state === 1) {
                        self.basketLockHub.server.unlockAndRelinquishBasket(self.basket().BasketID).done(function () {
                            if (typeof complete === 'function')
                                complete();
                        });
                    } else if (self.basketLockHub.connection.state === 4) {
                        self.basketLockHub.connection.start().done(function () {
                            self.basketLockHub.server.unlockAndRelinquishBasket(self.basket().BasketID).done(function () {
                                if (typeof complete === 'function')
                                    complete();
                            });
                        });
                    } else {
                        $.showError({ responseText: 'Sorry, your basketLockHub is in an unexpected state: ' + self.basketLockHub.connection.state + '. Please report this to <a href="mailto:itsupport@designersguild.com">itsupport@designersguild.com</a>. Refreshing the page should correct this error.' }, 'Error')
                    }
                }
            }

            self.unlockBasket = function (complete) {
                if (self.basket()) {
                    console.log('basketLockViewModel unlockBasket calling with', self.basket().BasketID);
                    if (self.basketLockHub.connection.state === 1) {
                        self.basketLockHub.server.unlockBasket(self.basket().BasketID).done(function () {
                            if (typeof complete === 'function')
                                complete();
                        });
                    } else if (self.basketLockHub.connection.state === 4) {
                        self.basketLockHub.connection.start().done(function () {
                            self.basketLockHub.server.unlockBasket(self.basket().BasketID).done(function () {
                                if (typeof complete === 'function')
                                    complete();
                            });
                        });
                    } else {
                        $.showError({ responseText: 'Sorry, your basketLockHub is in an unexpected state: ' + self.basketLockHub.connection.state + '. Please report this to <a href="mailto:itsupport@designersguild.com">itsupport@designersguild.com</a>. Refreshing the page should correct this error.' }, 'Error')
                    }
                }
            }

            self.receiveTakeoverRequest = function (params) {
                console.log('basketLockViewModel receiveTakeover hit', params)

                self.message(params.message);
                self.notifyUserId(params.fromUserId);
                self.mode('receivingTakeover');

                $("#basket-lock-modal").modal('show');

                self.secondsRemaining(30);
                self.responseInterval = setInterval(function () {
                    if (self.secondsRemaining() > 0) {
                        self.secondsRemaining(self.secondsRemaining() - 1);
                    } else {
                        self.relinquishBasket();
                    }
                }, 1000);
            }

            self.receiveTakeoverSuccess = function (params) {
                console.log('basketLockViewModel receiveTakeoverSuccess hit', params);
                self.showOrderFactory();
                self.reset();
            }

            self.receiveTakeoverRefusal = function (params) {
                console.log('basketLockViewModel receiveTakeoverRefusal hit', params);
                window.clearInterval(self.responseInterval);
                window.clearTimeout(self.takingOver);
                self.message('Your request to take over Basket ' + params.basketId + ' was refused.');
                self.mode('takeoverRefused');
                self.busy(false);
            }

            self.receiveNewParentBusyMessage = function (message) {
                console.log('basketLockViewModel receiveNewParentBusyMessage hit', message);
                if (self.parentBusyMessage() == 'Loading Despatch Options...')
                    self.parentBusyMessage(`${self.parentBusyMessage()}${message}`);
            }

            self.basketLockHub = $.connection.basketLockHub;

            self.basketLockHub.client.receiveTakeoverRequest = self.receiveTakeoverRequest;
            self.basketLockHub.client.receiveTakeoverRefusal = self.receiveTakeoverRefusal;
            self.basketLockHub.client.receiveTakeoverSuccess = self.receiveTakeoverSuccess;
            self.basketLockHub.client.receiveDeviceChange = self.receiveDeviceChange;
            self.basketLockHub.client.receiveNewParentBusyMessage = self.receiveNewParentBusyMessage;
            self.basketLockHub.client.receiveOrderProductsGridViewRefresh = self.receiveOrderProductsGridViewRefresh;

            self.responseInterval = null;
            self.takeoverInterval = null;

            self.basketLockHub.connection.start().done(function () {
                self.busy(false);
            });

            self.reset = function () {
                console.log('basketLockViewModel reset called');
                window.clearInterval(self.responseInterval);
                window.clearInterval(self.takeoverInterval);
                window.clearTimeout(self.takingOver);
                self.busy(false);
                self.mode('dormant');
                self.message(undefined);
                self.basket(undefined);
                self.notifyUserId(undefined);
                self.secondsRemaining(30);
                self.takeoverSecondsRemaining(30);
                if (self.hasOwnProperty('id'))
                    self.id = undefined;
                $("#basket-lock-modal").modal('hide');
            }

            self.init = function () {
                if (window.hasOwnProperty('viewModel')) {
                    if (window.viewModel.hasOwnProperty('orderFactory')) {
                        viewModel.orderFactory.basketLocker = self;
                        self.showNewBasket = viewModel.orderFactory.showNewBasket;
                        self.parentBusyMessage = viewModel.orderFactory.busyMessage;
                        self.showOrderFactory = function () {
                            if (self.showOrderFactoryArguments == null) {
                                self.showOrderFactoryArguments = [self.basket()];
                            } else {
                                self.showOrderFactoryArguments.splice(0, 0, self.basket());
                            }
                            viewModel.orderFactory.show.apply(this, self.showOrderFactoryArguments)
                        };
                        self.resetOrderFactory = viewModel.orderFactory.reset;
                    }
                    if (window.viewModel.hasOwnProperty('memberBasketFetcher'))
                        self.memberBasketFetcher = viewModel.memberBasketFetcher;
                }
            }

            $('#basket-lock-modal').on('hide.bs.modal', function () {
                self.busy(false);
            });
        }

        ko.components.register('send-tarf-component', {
            viewModel: sendTARFComponentViewModel,
            template: { element: $('#send-tarf-template')[0] }
        });

        ko.components.register('webapi-auth-component', {
            viewModel: webapiCredViewModel,
            template: { element: $('#webapi-auth-template')[0] }
        });

        ko.components.register('sterling-conversion-component', {
            viewModel: sterlingConversionViewModel,
            template: { element: $("#sterling-conversion-template")[0] }
        });

