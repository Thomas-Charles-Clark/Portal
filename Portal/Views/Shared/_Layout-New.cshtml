    <script type="text/html" id="send-tarf-template">
        <div id="send-tarf-modal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header grey-blue">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 id="send-tarf-modal-title" class="modal-title">
                            Send Trade Account Request Form
                        </h4>
                    </div>
                    <div id="send-tarf-modal-body">
                        <div class="form-busy" data-bind="fadeVisible: sendEmailBusy()">
                            <div class="busy-bars">
                                <div class="rect1 alert alert-info"></div>
                                <div class="rect2 alert alert-info"></div>
                                <div class="rect3 alert alert-info"></div>
                                <div class="rect4 alert alert-info"></div>
                                <div class="rect5 alert alert-info"></div>
                            </div>
                        </div>
                        <div class="modal-body panel-body">
                            <div class="form-group row">
                                <div class="col-xs-6">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <label class="col-form-label">
                                                Country *
                                            </label>
                                        </div>
                                        <div class="col-xs-12">
                                            <div id="tarf-country" class="form-control" data-bind="kendoDropDownList: countryDropDownSettings"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-6">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <label class="col-form-label">
                                                Language *
                                            </label>
                                        </div>
                                        <div class="col-xs-12">
                                            <div id="tarf-language" class="form-control" data-bind="kendoDropDownList: languageDropDownSettings"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-6">
                                    <div class="form-group row">
                                        <div class="col-xs-12">
                                            <label class="col-form-label">
                                                Name *
                                            </label>
                                        </div>
                                        <div class="col-xs-12">
                                            <input class="form-control tarf-name" data-bind="textInput: name" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-6">
                                    <div class="form-group row">
                                        <div class="col-xs-12">
                                            <label class="col-form-label">
                                                Phone
                                            </label>
                                        </div>
                                        <div class="col-xs-12">
                                            <input class="form-control tarf-phone" data-bind="textInput: phone" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row margin-bottom-0">
                                <div class="col-xs-12">
                                    <label class="col-form-label">
                                        Recipient Email Address *
                                    </label>
                                </div>
                                <div class="col-xs-12">
                                    <div class="input-group" data-bind="validationOptions: { insertMessages: false }">
                                        <input class="form-control tarf-email" data-bind="textInput: email" />
                                        <div class="input-group-btn">
                                            @*<button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border-radius: 0;">
                                                    <span data-bind="text: selectedLanguage().name"></span>
                                                    <span class="caret"></span>
                                                </button>
                                                <ul class="dropdown-menu" data-bind="foreach: availableLanguages">
                                                    <li><a href="javascript:;" data-bind="click: function() { $parent.selectedLanguage($data) }, text: $data.name"></a></li>
                                                </ul>*@
                                            <button class="btn btn-success" data-bind="click: function() { sendEmail(); }">
                                                Send
                                                <span class="glyphicon glyphicon-send"></span>
                                            </button>
                                        </div>
                                    </div>
                                    <span data-bind="validationMessage: email, css: 'validation-message text-danger'"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-12">
                                    <label id="ior-checkbox" class="col-form-label">
                                        <input type="checkbox" data-bind="checked: immediateOrderRequested" /> Immediate Order Requested?
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer panel-footer">
                            <span class="tarf-last-send" style="display: none;" data-bind="fadeVisible: showLastSentTo, fadeSpeed: 'slow', text: 'Sent successfully to: ' + lastSentTo()"></span>
                            <button id="send-tarf-modal-close" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                    <!-- ko if: attachValidation() --><!-- /ko -->
                </div>
            </div>
        </div>
    </script>

    <script type="text/html" id="webapi-auth-template">
        <div id="credentials-modal" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header grey-blue">
                        <h4 id="credentials-modal-title" class="modal-title">Login Expired</h4>
                    </div>
                    <div id="credentials-modal-body">
                        <div class="form-busy" data-bind="fadeVisible: authBusy()">
                            <div class="busy-bars">
                                <div class="rect1 alert alert-info"></div>
                                <div class="rect2 alert alert-info"></div>
                                <div class="rect3 alert alert-info"></div>
                                <div class="rect4 alert alert-info"></div>
                                <div class="rect5 alert alert-info"></div>
                            </div>
                        </div>
                        <div class="modal-body">
                            <p>
                                Please log in again.
                            </p>
                            <div id="credentials-modal-form" class="row">
                                <div class="col-xs-12">
                                    <div class="form-group row">
                                        <div class="col-md-3">
                                            <label class="col-form-label" style="float: none; padding-top: 6px">Email</label>
                                        </div>
                                        <div class="col-md-9">
                                            <input id="webapi-email" name="email" class="form-control" data-bind="textInput: email" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-3">
                                            <label class="col-form-label" style="float: none; padding-top: 6px">Password</label>
                                        </div>
                                        <div class="col-md-9">
                                            <input id="webapi-password" name="password" type="password" class="form-control" data-bind="enterKey: function() { performAuth(); }, textInput: password">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-primary" data-bind="click: function() { performAuth(); }">Login</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </script>

    <script id="basket-lock-template" type="text/html">
        <div id="basket-lock-modal" class="modal fade" data-backdrop="static">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="blocker" data-bind="fadeVisible: busy">
                        <div class="loading-spinner"></div>
                        <h4 data-bind="text: busyMessage"></h4>
                    </div>
                    <div class="modal-header grey-blue">
                        <button type="button" class="close" aria-label="Close" data-dismiss="modal">
                            <span aria-hidden="true">
                                &times;
                            </span>
                        </button>
                        <h4 class="modal-title">
                            Basket Locking
                        </h4>
                    </div>
                    <div class="modal-body">
                        <p data-bind="text: message"></p>
                        <!-- ko if: mode() == 'receivingTakeover' -->
                        <p>
                            If you do nothing, or close this panel, the takeover will be successful in
                            <span data-bind="text: secondsRemaining"></span>
                            seconds.
                        </p>
                        <button class="btn btn-blue" data-bind="click: relinquishBasket">
                            Permit this takeover
                        </button>
                        <button class="btn btn-blue" data-bind="click: refuseTakeover">
                            Refuse this takeover
                        </button>
                        <!-- /ko -->
                        <!-- ko if: mode() == 'sendingTakeover' -->
                        <button class="btn btn-blue" data-bind="click: sendTakeover">
                            Take over this basket
                        </button>
                        <button class="btn btn-blue" data-bind="click: showNewBasket">
                            Start a new basket
                        </button>
                        <!-- /ko -->
                        <!-- ko if: mode() == 'mutiny' -->
                        <button class="btn btn-blue" data-bind="click: changeDevice">
                            Continue on this Screen
                        </button>
                        <button class="btn btn-blue" data-bind="click: showNewBasket">
                            Start a new basket
                        </button>
                        <!-- /ko -->
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-default" data-bind="click: hide">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- ko if: init() --><!-- /ko -->
    </script>

    <script id="sterling-conversion-template" type="text/html">
        <div class="input-group currency-conversion" data-bind="css: controlClass">
            <div class="input-group-btn">
                <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">
                    <span data-bind="with: currency"><span data-bind="text: Code"></span></span> <span class="caret"></span>
                </button>
                <ul class="dropdown-menu">
                    <!-- ko foreach: currencies -->
                    <li><a href="#" data-bind="click: function() { $parent.currency($data) }, text: Code + ' - ' + Name"></a></li>
                    <!-- /ko -->
                </ul>
            </div>
            <input class="form-control" data-bind="numeric, forceNullOnEmpty: value, value: value.formatted, enable: currency, attr: { placeholder: placeholder }, keepElement: value" />
            <!-- ko if: !isNaN(conversion()) && conversion() != null -->
            <span class="input-group-addon input-group-addon-default">
                <span class="gbp-conversion" data-bind="text: conversion.formatted, visible: !isNaN(conversion())"></span>
            </span>
            <!-- /ko -->
        </div>
    </script>

    <script id="mdc-text-field-component" type="text/html">
        <div class="mdc-validating-field" data-bind="visible: $data.hasOwnProperty('visible') ? $data.visible : true">
            <div class="mdc-text-field mdc-text-field--outlined" data-bind="mdcTextFieldComponent: {
                    boundTo: observable,
                    useNativeValidation: useNativeValidation,
                    enable: enable,
                    disable: disable
                 },
                 validationOptions: {
                    insertMessages: typeof insertValidationMessages == 'undefined' ? false : insertValidationMessages,
                    decorateInputElement: typeof decorateInputElement == 'undefined' ? false : decorateInputElement
                 },
                 css: {
                    'busy': busy,
                    'mdc-text-field--disabled': disable() || !enable()
                 }">
                <input type="search" autocomplete="off" class="mdc-text-field__input" data-bind="
                       keepElement: observable,
                       forceNullOnEmpty: observable,
                       textInput: observable,
                       charsRemaining: charsRemainingOptions,
                       enterKey: typeof enterKey === 'undefined' ? null : enterKey,
                       disable: disable() || !enable()
                       hasFocus: (typeof focusObservable === 'undefined' ? ko.observable() : focusObservable),
                       css: {
                            'clearable': clearable,
                            'revertable': revertable
                       },
                       class: typeof cssClasses === 'undefined' ? null : cssClasses" />
                <div class="mdc-notched-outline">
                    <div class="mdc-notched-outline__leading"></div>
                    <div class="mdc-notched-outline__notch">
                        <label for="input" class="mdc-floating-label">
                            <span data-bind="text: label"></span>
                        </label>
                    </div>
                    <div class="mdc-notched-outline__trailing"></div>
                </div>
                <div class="controls">
                    <!-- ko if: revertable -->
                    <div class="close revert" data-bind="click: revertFunction">
                        <i class="material-icons">
                            replay
                        </i>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: clearable -->
                    <div class="close clear" data-bind="click: clearFunction, css: { 'disabled':  typeof disabled == 'undefined' ? false : disabled }">
                        &times;
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </script>

    <script id="mdc-text-field-component-no-outline" type="text/html">
        <div class="mdc-validating-field" data-bind="visible: $data.hasOwnProperty('visible') ? $data.visible : true">
            <div class="mdc-text-field mdc-text-field--outlined" data-bind="
                    mdcTextFieldComponentNoOutline: {
                        boundTo: observable,
                        useNativeValidation: useNativeValidation,
                        enable: enable,
                        disable: disable
                    },
                    validationOptions: {
                        insertMessages: insertValidationMessages,
                        decorateInputElement: decorateInputElement
                    },
                    css: {
                        'busy': busy,
                        'mdc-text-field--disabled': disable() || !enable()
                    }">
                <input type="text" class="mdc-text-field__input" data-bind="
                       keepElement: observable,
                       forceNullOnEmpty: observable,
                       textInput: observable,
                       charsRemaining: charsRemainingOptions,
                       enable: typeof readOnly == 'undefined' ? true : !ko.unwrap(readOnly),
                       hasFocus: (typeof focusObservable === 'undefined' ? ko.observable() : focusObservable),
                       css: {
                            'clearable': clearable,
                            'revertable': revertable
                       }" />
                <!-- ko if: typeof permitRevert != 'undefined' && permitRevert && typeof revertFunction === 'function' && typeof originalValue != 'undefined' -->
                <div class="close revert" data-bind="click: revertFunction">
                    <i class="material-icons">
                        replay
                    </i>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof showClear != 'undefined' && showClear && typeof clearFunction === 'function' -->
                <div class="close pull-right" data-bind="click: clearFunction, css: { 'disabled':  typeof disabled == 'undefined' ? false : disabled }">
                    &times;
                </div>
                <!-- /ko -->
            </div>
        </div>
    </script>

    <script id="mdc-text-field-numeric-component" type="text/html">
        <div class="mdc-validating-field" data-bind="visible: $data.hasOwnProperty('visible') ? $data.visible : true">
            <div class="mdc-numeric-field input-group">
                <button type="button" class="btn btn-secondary" data-bind="click: decrement">
                    <i class="bi bi-dash-lg"></i>
                </button>
                <div class="mdc-text-field mdc-text-field--outlined" data-bind="
                     mdcTextFieldComponent: {
                        boundTo: observable,
                        useNativeValidation: useNativeValidation,
                        enable: enable,
                        disable: disable
                     },
                     validationOptions: {
                        insertMessages: insertValidationMessages,
                        decorateInputElement: decorateInputElement
                     },
                     css: {
                        'busy': busy(),
                        'mdc-text-field--disabled': disable() || !enable()
                     }">
                    <input class="mdc-text-field__input text-right mdc-text-field__numeric" data-bind="
                        numeric: observable,
                        enterKey: typeof enterKey === 'undefined' ? null : enterKey,
                        keepElement: observable,
                        value: observable.formatted,
                        charsRemaining: charsRemainingOptions,
                        enable: typeof readOnly == 'undefined' ? true : !readOnly(),
                        hasFocus: (typeof focusObservable === 'undefined' ? ko.observable() : focusObservable),
                        css: {
                            clearable: clearable,
                            revertable: revertable
                        },
                        class: typeof cssClasses === 'undefined' ? null : cssClasses,
                        attr: {
                           type: inputType,
                           min: minValue,
                           max: maxValue,
                           step: step
                        }
                        " />
                    <div class="mdc-notched-outline">
                        <div class="mdc-notched-outline__leading"></div>
                        <!-- ko if: typeof label !== 'undefined' && label -->
                        <div class="mdc-notched-outline__notch">
                            <label for="input" class="mdc-floating-label">
                                <span data-bind="text: label"></span>
                            </label>
                        </div>
                        <!-- /ko -->
                        <div class="mdc-notched-outline__trailing"></div>
                    </div>
                    <div class="controls">
                        <!-- ko if: revertable -->
                        <div class="close revert" data-bind="click: revertFunction">
                            <i class="material-icons">
                                replay
                            </i>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: clearable -->
                        <div class="close clear" data-bind="click: clearFunction, css: { 'disabled':  typeof disabled == 'undefined' ? false : disabled }">
                            &times;
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <button type="button" class="btn btn-secondary" data-bind="click: increment">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
