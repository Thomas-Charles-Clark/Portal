                </h3>
            </div>
            <h4>
                File Upload
            </h4>
            <form class="file-upload-form" data-bind="keepElement: observable">
                <input type="hidden" name="destination" data-bind="value: destination" />
                <div class="file-wrapper" data-bind="keepElement: fileFullPath">
                    <!-- ko if: fileFullPath() -->
                    <div class="d-flex align-items-center gap-2">
                        <a class="file-placeholder" data-bind="attr: { href: fileFullPath, target: '_blank' },text: fileFullPath" />
                        <button type="button" class="btn-close" aria-label="Close" data-bind="click: clearFile"></button>
                    </div>
                    <!-- /ko -->
                    <!-- ko ifnot: fileFullPath() -->
                    <h5 class="mb-0 py-3">
                        No File
                    </h5>
                    <!-- /ko -->
                </div>
                <label class="form-label" data-bind="attr: { 'for': `${fieldId}-file-upload` }">
                    Select a File
                    <!-- ko if: accept -->
                    (<span data-bind="html: accept"></span>)
                    <!-- /ko -->
                </label>
                <input class="form-control mb-3" name="image" type="file" data-bind="
                    value: fileName,
                    keepElement: fileName,
                    attr: {
                        'id': `${fieldId}-file-upload`,
                        'accept': accept
                    }">
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-primary" data-bind="click: upload">
                        Upload
                    </button>
                </div>
            </form>
        </div>
    </script>

