    <script type="text/javascript">
        $(document).ready(function () {
            $('.modal').on('shown.bs.modal', function () {
                $(document).off('focusin.modal');
            });
        });

        function _spoons() {
            $.get('/account/SpooneriseIt', null, function (data) {
                console.log(data.join('\n'));
            })
        }

        // with thanks: https://stackoverflow.com/questions/32581987/need-click-twice-after-hide-a-shown-bootstrap-popover#answer-34320956
        $('html').on('hidden.bs.popover', function (e) {
            $(e.target).data("bs.popover").inState.click = false;
        });

        // with thanks: https://stackoverflow.com/questions/11703093/how-to-dismiss-a-twitter-bootstrap-popover-by-clicking-outside#answer-15670200
        $('html').on('mouseup', function (e) {
            if (!$(e.target).closest('.popover').length) {
                $('.popover').each(function () {
                    $(this.previousSibling).popover('hide');
                });
            }
        });
    </script>

    <script type="text/javascript">
        function foo() {
            let url = '/api/componentapi/FetchDocument';
            if (window.fetch) {
                fetch(url, {
                    method: 'POST',
                    body: JSON.stringify({
                        documentType: 2,
                        basketId: 134037,
                        transactionId: null,
                        orderHeadId: null,
                        languageId: 1
                    }),
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + localStorage.BearerToken
                    }
                }).then(function (response) {
                    return response.blob();
                }).then(function (blob) {
                    const newWindow = window.open('', '')
                    //newWindow.document.title = 'Document.pdf'
                    newWindow.document.write('<html><head><title>Document.pdf</title><link rel="shortcut icon" type="image/x-icon" href="https://www.designersguild.com/favicon.ico" /></head><body style="margin: 0">')
                    newWindow.document.write(`<iframe src="${window.URL.createObjectURL(blob)}" frameborder="0" style="border:0; top:0px; left:0px; bottom:0px; right:0px; width:100%; height:100%;" allowfullscreen></iframe>`);
                    newWindow.document.write('</body></html');
                }).catch(function (xhr, s, a) {
                    $.showError(xhr, s, a);
                });
            }
        }
    </script>
