    <script type="text/javascript">
        function getUserId() {
            return @(User.Identity.GetUserId<int>());
        }
        function getUserEmail() {
            return '@User.Identity.GetEmail()';
        }

        window.fetchHeaders = {
            'accept': 'application/json',
            'content-type': 'application/json; charset=utf-8',
            'authorization': 'Bearer ' + localStorage.BearerToken
        }

@*@if (!Convert.ToBoolean(System.Web.Configuration.WebConfigurationManager.AppSettings["productionVersion"]))
{
@:window.fetchHeaders.authorization = 'Basic Q0FkbWluOlRhcGVzdHJ5Rmxvd2VyMjI=';
@:window.fetchHeaders.dateOverride = '@($"{d:ddMMyyyy}")';
@:window.fetchHeaders.countryOverride = '@(Request.QueryString["countryOverride"])';
}*@

        window.fetchPostParams = {
            method: 'POST',
            headers: window.fetchHeaders,
            cache: 'no-store',
            credentials: 'same-origin',
        }

        window.handleFetchResponse = async (response, requestData) => {
            if (response.ok) {
                return await response.json();
            } else {
                let resp = {};
                try {
                    resp = await response.json();
                }
                catch (e) {

                }
                throw {
                    message: `${response.status} - ${response.url}`,
                    exception: resp.Message,
                    source: requestData
                }
            }
        }

        window.logClientSideError = (message) => {
            fetch('/api/generalapi/LogClientError', {
            method: 'POST',
                    headers: window.fetchHeaders,
                    cache: 'no-store',
                    credentials: 'same-origin',
                    body: message
                }).catch((e) => {
                console.error(e);
            })
        }

        window.catchFetchError = (error) => {
            console.error(error);
            if (error instanceof TypeError)
                error = { message: error.message };
            window.showError();
            window.logClientSideError(JSON.stringify(error));
        }

        window.onerror = function (message, source, lineno, colno, error) {
            $.ajax({
                url: '/api/error/LogClientError',
                type: 'POST',
                dataType: 'json',
                data: {
                    message: message + '\n' + (error.stack || ''),
                    source: source,
                    lineno: lineno,
                    colno: colno,
                    error: error
                }
            });
        }
    </script>
