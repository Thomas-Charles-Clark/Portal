<script id="retail-till-phase-template" type="text/html">
    <div class="section">
        <h4>
            Retail Parameters
        </h4>
    </div>
    <div class="retail-parameters-header">
        <div class="blocker" data-bind="visible: retailBusy">
            <div class="busy-bars">
                <div class="rect1 alert alert-info"></div>
                <div class="rect2 alert alert-info"></div>
                <div class="rect3 alert alert-info"></div>
                <div class="rect4 alert alert-info"></div>
                <div class="rect5 alert alert-info"></div>
            </div>
        </div>
        <div style="        display: flex;
        padding-left: 0;
">
            <div class="alert alert-info margin-bottom-0" style="flex: 1 1 50%; margin-right: 15px;">
                <strong>
                    Delivery Details
                </strong>
                <div style="margin-bottom: -7px;" data-bind="html: deliveryAddress.displayBlock()"></div>
                <!-- ko if: dispatchFactory.lastChancePhone.observable() -->
                <span class="address-block-span no-comma" data-bind="text: dispatchFactory.lastChancePhone.observable"></span>
                <!-- /ko -->
            </div>
            <div>
                <div>
                    <div class="margin-bottom-15 pull-left" style="width: 35%;" data-bind="component: { name: 'mdc-select-component', params: retailTillNumberParams }"></div>
                    <div class="margin-bottom-15 pull-right" style="width: calc(65% - 15px); margin-left: 15px;" data-bind="component: { name: 'mdc-select-component', params: retailSessionNumberParams }"></div>
                    <div class="clearfix"></div>
                </div>
                <div class="alert alert-warning margin-bottom-15">
                    <p>
                        This collection of Tills and Sessions is fetched live from Mertex. A fresh fetch of Till and Session data is made every time you visit this Retail Till stage.<br/>
                        <strong>
                            Please make sure that all orders are submitted to Mertex before the end of day banking is done.
                        </strong>
                    </p>
                </div>
            </div>
        </div>
        <div data-bind="with: dispatchFactory">
            <h3 class="display: block;">
                Overall Total: <span data-bind="text: formatCurrency(retailTotalPayable(), 2, $parent.currency().FormattingCulture,  $parent.currency().ISO_4217)"></span>
            </h3>
            <h3 class="display: block;">
                Remaining: <span data-bind="text: formatCurrency(retailTotalRemaining(), 2, $parent.currency().FormattingCulture,  $parent.currency().ISO_4217)"></span>
            </h3>
        </div>
    </div>
    <div class="basket-phase" data-bind="with: dispatchFactory">
        <!-- ko template: { name: 'basket-group-template', data: $data } --><!-- /ko -->
    </div>
</script>

