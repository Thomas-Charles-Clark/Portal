@model Portal.ViewModels.ComponentModels.OrderProductsViewModel


<script type="text/javascript">

    if (getUserId() != 8) {
        window.addEventListener('beforeunload', function (event) {
            event.preventDefault();
            event.returnValue = '';
            return true;
        });
    }

    window.addEventListener('unload', function (event) {
        console.log('unloading', viewModel);
        if (viewModel.orderFactory.basketId())
            viewModel.orderFactory.basketLocker.unlockBasket();
    });

    function getCountries() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.VATCountries));
    }

    function getFOCPromotionCodes() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.TradePromotionCodes));
    }

    function getCallTypes() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.CallTypes));
    }

    function getTransactionTypes() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.TransactionTypes));
    }

    function getSaveReasons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.SavedBasketReasons));
    }

    function getSortOptions() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.SortOptions));
    }

    function getDiscountReasons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.DiscountReasons));
    }

    function getTradeAccount() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedTradeAccount));
    }

    function getProductFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.ProductFilterButtons));
    }

    function getCompleteProductFilterButtonSet() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.CompleteProductFilterButtonSet));
    }

    function getBrandFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.BrandFilterButtons));
    }

    function getLaunchFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.LaunchFilterButtons));
    }

    function getPatternFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.PatternFilterButtons));
    }

    function getItemTypeFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.ItemTypeFilterButtons));
    }

    function getStockFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.StockFilterButtons));
    }

    function getMartindaleFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.MartindaleFilterButtons));
    }

    function getSizeFilterButtons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.SizeFilterButtons));
    }

    function getDeliveryFOCReasons() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.DeliveryFOCReasons));
    }

    function getWidthFilterButtons() {
        return [{
            Name: 'Standard',
            WidthID: false
        }, {
            Name: 'Wide',
            WidthID: true
        }]
    }
</script>

<script id="order-phase-btns" type="text/html">
    <div class="btn-group btn-group-justified">
        <!-- ko foreach: $data -->
        <!-- ko if: visible -->
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-default" data-bind="text: name, enable: enabled, click: click, css: { 'btn-battleship-blue': phases.indexOf($parentContext.$parent.phase()) > -1 }"></button>
        </div>
        <!-- /ko -->
        <!-- /ko -->
    </div>
</script>

<script id="search-result-list" type="text/html">
    <div class="search-result-flex-container">
        @*<div class="search-mode-header" data-bind="html: modeHeader"></div>*@
        <!-- ko if: searchResults().length -->
        <!-- ko fastForEach: brandGroupedSearchResults -->
        <div class="search-result-brand-row">
            <img class="brand-logo" data-bind="attr: { src: brand.LogoSrc }" />
        </div>

        <!-- ko fastForEach: productTypes -->
        <!-- ko if: $parent.productTypes.length > 1 -->
        <div class="search-result-product-type">
            <span data-bind="html: productType.ProductType"></span>
        </div>
        <!-- /ko -->
        <!-- ko fastForEach: productPages -->
        <!-- ko if: productPage.Grouped -->
        <div class="search-result-row" data-bind="click: function() { $parentContext.$parentContext.$parent.searchResultDrilldown($data); }">
            <div class="search-column-product">
                <img class="thumb" data-bind="attr: { src: 'https://www.designersguild.com/image/156/' + productPage.ProductPageImageID, title: productPage.ProductPageName }" />
                <a href="javascript:;" data-bind="text: productPage.ProductPageName"></a>
            </div>
        </div>
        <!-- /ko -->
        <!-- ko ifnot: productPage.Grouped -->
        <!-- ko fastForEach: products -->
        <div class="search-result-row" data-bind="with: record">
            <div class="search-column-product" data-bind="css: { 'pattern-book-saturation': $parent.patternBookSaturation }">
                <img class="thumb" data-bind="click: function () { $parent.parent.searchResultDrilldown($parent); }, attr: { src: 'https://www.designersguild.com/image/156/' + ImageID, title: Code }" />
                <div class="product-details">
                    @* Not in the mockup *@
                    @*<div data-bind="with: $parent.patternBookSaturation">
                        <span class="pattern-book-history">
                            <span data-bind="text: Quantity"></span>
                            <i class="material-icons" data-bind="click: function() { $.info($parentContext.$parentContext.$parent.parent.tradeAccount().Code + ' - ' + $parentContext.$parentContext.$parent.parent.tradeAccount().Name + '<br/>Pattern Book History: ' + $parent.Code, $parentContext.$parentContext.$parent.patternBookSaturationDisplay() ); }, attr: { title: 'Pattern Book History' }">
                                history
                            </i>
                        </span>
                    </div>*@
                    <span class="bold product-name">
                        <span data-bind="text: OrderFormName + (Size ? ' - ' + Size : '')"></span>
                        <span class="product-tag-wrapper" data-bind="html: $parent.tagDisplay"></span>
                    </span>
                    <span class="small product-collection" data-bind="text: Collection"></span>
                    <span class="code-price">
                        <span class="product-code" data-bind="text: Code"></span>
                    </span>
                    <!-- ko if: $parent.productFilterOptions().StockMessageOverride -->
                    <span data-bind="text: $parent.stockStatus"></span>
                    <!-- /ko -->
                    <!-- ko ifnot: $parent.productFilterOptions().StockMessageOverride -->
                    <!-- ko ifnot: MadeToOrder -->
                    <div class="search-result-list stock-table-wrapper" data-bind="template: { name: 'stock-table-template', data: $parent.stockData }"></div>
                    <!-- /ko -->
                    <!-- ko if: MadeToOrder -->
                    <label data-bind="text: $parent.stockStatus">
                        @*Made to Order*@
                    </label>
                    <!-- /ko -->
                    <!-- /ko -->
                    @*<a data-bind="html: $parent.stockStatus, attr: { href: 'javascript:;' }, click: function () { $parent.parent.drilldownData($parentContext.$parentContext.$parent); $parent.parent.parent.orderProductsDrilldown.showStockTabHook(); }"></a>*@
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="btn-container">
                <div class="product-price" data-bind="html: $parent.priceDisplay"></div>
                <div class="product-price smaller">
                    Unit Price Ex. VAT
                </div>
                <div class="code-price">
                    <div class="btn-toolbar pull-right">
                        <!-- ko if: $parent.parent.displayOrderFeatures() -->
                        <!-- ko if: $parent.productFilterOptions().AllowQuickAddToBasket -->
                        <div class="btn-group">
                            <div class="quantity-control input-group">
                                <div class="input-group-btn">
                                    <button class="btn btn-default" data-bind="click: function (data) { if ($parent.quantity() > 0) { $parent.quantity(+$parent.quantity() - 1); } }">
                                        &minus;
                                    </button>
                                </div>
                                <input type="number" step="1" min="0" class="form-control" data-bind="keepElement: $parent.quantity, numeric, forceZeroOnEmpty: $parent.quantity, value: $parent.quantity, hasfocus: $parent.quantityHasFocus, attr: { step: $parent.productFilterOptions().QuantityPrecision }" />
                                <span class="input-group-btn">
                                    <button class="btn btn-default" data-bind="click: function(data) { $parent.quantity(+$parent.quantity() + 1); }">
                                        +
                                    </button>
                                </span>
                            </div>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-default quick-add-btn" data-bind="enable: !parent.addingBasketItem(), click: parent.quickAddBasketItem">
                                Quick Add
                            </button>
                        </div>
                        <!-- /ko -->
                        <!-- /ko -->
                        <!-- ko if: BespokeProduct && $parent.parent.displayOrderFeatures() -->
                        <div class="btn-group">
                            <button class="btn btn-default order-btn" data-bind="click: function () { $parent.parent.openBespokeFactoryModal($parent) }">
                                View
                            </button>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: !BespokeProduct -->
                        <div class="btn-group">
                            <button class="btn btn-default order-btn" data-bind="click: function () { $parent.parent.searchResultDrilldown($parent); }">
                                View
                            </button>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="clearfix"></div>
                </div>
                <!-- ko if: $parent.basketQuantity() > 0 -->
                <span class="smaller pull-right" data-bind="text: '(' + $parent.basketQuantity() + ' ' + Units + ' in your basket)'"></span>
                <!-- /ko -->
                <div class="clearfix"></div>

                <div class="smaller">
                    <div class="text-right">
                        <!-- ko if: $parent.price().rrp != null -->
                            RRP: <span data-bind="text: formatCurrency($parent.price().rrp, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
                        <!-- /ko -->
                        <!-- ko if: $parent.price().rrp == null -->
                            RRP: N/A
                        <!-- /ko -->
                        <span class="product-tag-wrapper" data-bind="html: $parent.tagDisplay"></span>
                    </div>
                    <!-- ko if: $parent.record.EAN != null -->
                    <div class="text-right">
                        EAN: <span data-bind="text: $parent.record.EAN"></span>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
        <!-- /ko -->
        <!-- /ko -->
        <!-- /ko -->
        <!-- /ko -->
        <!-- /ko -->
        <!-- /ko -->
    </div>
</script>

<script id="order-tab-list" type="text/html">

    <div class="product-selection-stage search-result-flex-container">

        <div class="search-result-brand-row">
            <img class="brand-logo" style="margin-top: 0;" data-bind="attr: { src: parent.brandLogoSrc($data.record.BrandID) }" />
        </div>

        <!-- ko if: $data.hasOwnProperty('products') -->
        <!-- ko foreach: Enumerable.From(products).GroupBy('$.record.OrderFormGroup', '', 'key, e => { orderFormGroup: e.Key(), products: e.source }').ToArray() -->
        <!-- ko if: orderFormGroup -->
        <div class="search-result-product-type">
            <span data-bind="html: orderFormGroup"></span>
        </div>
        <!-- /ko -->

        <!-- ko fastForEach: products -->
        <div class="search-result-row" data-bind="with: record">
            <div class="search-column-product" data-bind="css: { 'pattern-book-saturation': $parent.patternBookSaturation }">
                <img class="thumb" data-bind="attr: { src: 'https://www.designersguild.com/image/156/' + ImageID, title: Code }" />
                <div class="product-details">
                    @* Not in the mockup *@
                    @*<div data-bind="with: $parent.patternBookSaturation">
                        <span class="pattern-book-history">
                            <span data-bind="text: Quantity"></span>
                            <i class="material-icons" data-bind="click: function() { $.info($parentContext.$parentContext.$parent.parent.tradeAccount().Code + ' - ' + $parentContext.$parentContext.$parent.parent.tradeAccount().Name + '<br/>Pattern Book History: ' + $parent.Code, $parentContext.$parentContext.$parent.patternBookSaturationDisplay() ); }, attr: { title: 'Pattern Book History' }">
                                history
                            </i>
                        </span>
                    </div>*@
                    <span class="bold product-name">
                        <span data-bind="text: OrderFormName + (Size ? ' - ' + Size : '')"></span>
                        @* Not in the mockup *@
                        <span class="product-tag-wrapper" data-bind="html: $parent.tagDisplay"></span>
                    </span>
                    <span class="small product-collection" data-bind="text: Collection"></span>
                    <span class="code-price">
                        <span class="product-code" data-bind="text: Code"></span>
                        <!-- ko if: $parent.record.EAN -->
                        <span class="product-ean smaller">
                            EAN: <span data-bind="text: $parent.record.EAN"></span>
                        </span>
                        <!-- /ko -->
                    </span>
                    <!-- ko if: $parent.productFilterOptions().StockMessageOverride -->
                    <span data-bind="text: $parent.stockStatus"></span>
                    <!-- /ko -->
                    <!-- ko ifnot: $parent.productFilterOptions().StockMessageOverride -->
                    <!-- ko ifnot: MadeToOrder -->
                    <div class="search-result-list stock-table-wrapper" data-bind="template: { name: 'stock-table-template', data: $parent.stockData }"></div>
                    <!-- /ko -->
                    <!-- ko if: MadeToOrder -->
                    <label data-bind="text: $parent.stockStatus">
                        @*Made to Order*@
                    </label>
                    <!-- /ko -->
                    <!-- /ko -->
                </div>
                <div class="clearfix"></div>
            </div>
            <!-- ko if: $parent.parent.displayOrderFeatures() -->
            <div class="fulfilment-container">
                <div class="quantity-control input-group pull-right" style="margin-bottom: 15px;">
                    <div class="input-group-btn">
                        <button class="btn btn-default" data-bind="click: function (data) { if ($parent.quantity() > $parent.productFilterOptions().QuantityMinimum) { $parent.quantity(+$parent.quantity() - $parent.productFilterOptions().QuantityIncrement); } }">
                            &minus;
                        </button>
                    </div>
                    <input type="number" step="1" min="0" class="form-control" data-bind="keepElement: $parent.quantity, numeric, forceZeroOnEmpty: $parent.quantity, value: $parent.quantity, hasfocus: $parent.quantityHasFocus, attr: { min: $parent.productFilterOptions().QuantityMinimum, step: $parent.productFilterOptions().QuantityIncrement }" />
                    <span class="input-group-btn">
                        <button class="btn btn-default" data-bind="click: function(data) { $parent.quantity(+$parent.quantity() + $parent.productFilterOptions().QuantityIncrement); }">
                            +
                        </button>
                    </span>
                </div>
                <!-- ko if: $parent.fetchFulfilmentOptions() --><!-- /ko -->
                <div class="form-group">
                    <select class="form-control fulfilment-option" data-bind="value: $parent.fulfilmentOption, options: $parent.availableFulfilmentOptions, optionsText: 'FulfilmentType'"></select>
                    <span class="smaller" data-bind="with: $parent.fulfilmentOption">
                        From: <span data-bind="text: StockLocation"></span>
                    </span>
                </div>
                <div class="line-reference" data-bind="component: { name: 'mdc-text-field-component', params: $parent.lineReference }"></div>
            </div>
            <div class="btn-container">
                <div class="margin-bottom-10">
                    <div class="product-price" data-bind="html: $parent.priceDisplay"></div>
                    <div class="product-price smaller">
                        Unit Price Ex. VAT
                    </div>
                    <div class="product-price">
                        <!-- ko if: $parent.parent.currency() -->
                        <span data-bind="html: FinalPrice == 0 ? '&nbsp;' : formatCurrency(FinalPrice * $parent.quantity(), 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
                        <!-- /ko -->
                    </div>
                    <div class="product-price smaller">
                        <span data-bind="text: FinalPrice == 0 ? '&nbsp' : 'Subtotal Ex. VAT'"></span>
                    </div>
                </div>
                <div data-bind="with: $parent">
                    <div class="btn-toolbar pull-right">
                        <!-- ko if: productFilterOptions().AllowQuickAddToBasket -->
                        <div class="btn-group">
                            <button class="btn btn-default quick-add-btn" data-bind="enable: !parent.addingBasketItem(), click: parent.quickAddBasketItem">
                                Quick Add
                            </button>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: productFilterOptions().AllowReserveOrders -->
                        <div class="btn-group">
                            <button class="btn btn-default quick-add-btn" data-bind="enable: !parent.addingBasketItem() && forwardOrderDate() == null, click: parent.reserveBasketItem">
                                Reserve
                            </button>
                        </div>
                        <!-- /ko -->
                        <div class="btn-group">
                            <button class="btn btn-default order-btn" data-bind="enable: !parent.addingBasketItem(), click: function (data) { Promise.resolve(parent.addBasketItem(data)); }">
                                Order
                            </button>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <!-- ko if: $parent.basketQuantity() > 0 -->
                <span class="smaller pull-right" data-bind="text: '(' + $parent.basketQuantity() + ' ' + Units + ' in your basket)'"></span>
                <!-- /ko -->
                <div class="clearfix"></div>
            </div>
            <div class="dispatch-container" data-bind="with: $parent">
                <div class="margin-bottom-10">
                    <div class="product-dispatch">
                        <span data-bind="text: timeSensitiveDispatchDate"></span>
                        @*<span data-bind="text: forwardOrderDate() ? moment(forwardOrderDate()).format('DD/MM/YYYY') : moment(estimatedDispatchDate()).format('DD/MM/YYYY')"></span>*@
                    </div>
                    <div class="product-dispatch smaller">
                        Estimated Despatch Date
                    </div>
                    <div class="product-dispatch">
                        <span data-bind="text: estimatedPackageWeight"></span>
                    </div>
                    <div class="product-dispatch smaller">
                        Estimated Weight (ex. packaging)
                    </div>
                </div>
                <div class="date-required" data-bind="component: { name: 'mdc-date-time-picker-component', params: dateRequired }"></div>
                @*<div class='input-group date' data-bind="keepElement: forwardOrderDate, dateTimePicker: forwardOrderDate, dateTimePickerOptions: forwardOrderDateOptions">
                    <input type='text' class="form-control" readonly="readonly" placeholder="Delay Despatch?" data-bind="enable: productFilterOptions().AllowForwardOrders"/>
                    <div class="input-group-btn">
                        <button class="btn btn-default" data-bind="css: { 'disabled': !productFilterOptions().AllowForwardOrders }">
                            <span class="glyphicon glyphicon-calendar"></span>
                        </button>
                    </div>
                </div>*@
            </div>
            <!-- /ko -->
        </div>
        <!-- /ko -->
        <!-- /ko -->
        <!-- /ko -->
    </div>
</script>

<script id="stock-table-template" type="text/html">
    <table class="table table-condensed search-result-stock">
        <colgroup>
            <!-- ko if: StockLocationB.Name == null -->
            <col style="width: 50.0%" />
            <col style="width: 50.0%" />
            <!-- /ko -->
            <!-- ko if: StockLocationB.Name != null -->
            <col style="width: 33.3333%" />
            <col style="width: 33.3333%" />
            <col style="width: 33.3333%" />
            <!-- /ko -->
        </colgroup>
        <tr>
            <td>
                Stock
            </td>
            <td class="text-right">
                <span data-bind="text: StockLocationA.Name"></span>
            </td>
            <!-- ko if: StockLocationB.Name != null -->
            <td class="text-right">
                <span data-bind="text: StockLocationB.Name"></span>
            </td>
            <!-- /ko -->
        </tr>
        <tr>
            <td>
                Available Now
            </td>
            <td class="text-right">
                <span data-bind="text: (StockLocationA.Available).toFixed(StockLocationA.QuantityPrecision) + ' ' + StockLocationA.Units, css: StockLocationA.AvailableClass"></span>
            </td>
            <!-- ko if: StockLocationB.Name != null -->
            <td class="text-right">
                <span data-bind="text: (StockLocationB.Available).toFixed(StockLocationB.QuantityPrecision) + ' ' + StockLocationB.Units, css: StockLocationB.AvailableClass"></span>
            </td>
            <!-- /ko -->
        </tr>
        <tr>
            <td>
                Due In
            </td>
            <td class="text-right">
                <span data-bind="text: (StockLocationA.Incoming).toFixed(StockLocationA.QuantityPrecision) + ' ' + StockLocationA.Units, css: StockLocationA.IncomingClass"></span>
            </td>
            <!-- ko if: StockLocationB.Name != null -->
            <td class="text-right">
                <span data-bind="text: (StockLocationB.Incoming).toFixed(StockLocationB.QuantityPrecision) + ' ' + StockLocationB.Units, css: StockLocationB.IncomingClass"></span>
            </td>
            <!-- /ko -->
        </tr>
    </table>
</script>

<script id="basket-display-template" type="text/html">
    <div class="basket-grouping" data-bind="foreach: orderTypeGroupings">
        <div class="basket-group">
            <div>
                <span data-bind="text: orderType.name"></span>
                <!-- ko if: orderType.orderTypeId == 3 -->
                <div data-bind="component: { name: 'mdc-checkbox-component', params: $parent.reserveBatchCuttingExpressIndicatorParams }"></div>
                <!-- /ko -->
            </div>
            <label>
                Stock Location
            </label>
            <label>
                Fulfilment Option
            </label>
            <label>
                Trade Price
            </label>
            <label>
                Special Price
            </label>
            <label>
                Quantity
                <span data-bind="html: orderType.quantityDisplay"></span>
            </label>
            <!-- ko if: $parent.phase() >= 13 -->
            <label>
                Total
                <span data-bind="html: orderType.totalExVatDisplay"></span>
            </label>
            <label>
                VAT
                <span data-bind="html: orderType.totalVatDisplay"></span>
            </label>
            <label>
                Total
                <span data-bind="html: orderType.totalIncVatDisplay"></span>
            </label>
            <!-- /ko -->
        </div>
        <!-- ko foreach: basketGroupings -->
        <div class="search-result-product-type">
            <span data-bind="html: basketGrouping.basketGroup"></span>
            <!-- ko if: $parentContext.$parent.phase() == ORDERFACTORY_PHASE_REVIEW_HOLD -->
            <!-- ko with: basketGrouping.deliveryGroup -->
            <!-- ko template: { name: 'delivery-group-template' } --><!-- /ko -->
            <!-- /ko -->
            <!-- /ko -->
        </div>
        <div class="basket-group-inner" data-bind="foreach: products">
            <!-- ko template: { name: 'basket-group-inner-product-template' } --><!-- /ko -->
        </div>
        <!-- /ko -->
    </div>
</script>

<script id="basket-group-inner-product-template" type="text/html">
    <div class="basket-group-product-wrapper alert" data-bind="visible: record.BasketVisible, with: record, css: { 'alert-danger': record.basketItemErrors.length != 0, 'margin-left-15': record.ParentRowNumber != null, 'margin-left-30': typeof isGrandChild === 'undefined' ? false : isGrandChild }">
        <div class="products-container">
            <div class="basket-group-product">
                <!-- ko if: ProductImageID -->
                <img class="thumb" data-bind="click: function () { if (AllowEdit) { $parentContext.$parentContext.$parentContext.$parent.loadBasketItemForEdit($data); } }, attr: { src: 'https://www.designersguild.com/image/156/' + ProductImageID, title: ProductCode + ' BasketItemID: ' + BasketItemID }" />
                <!-- /ko -->
                <div class="delivery-product-details">
                    <div class="delivery-product-details-inner">
                        <span class="product-name">
                            <span>
                                <span data-bind="text: ProductBasketName, attr: { title: ProductBasketName }"></span>
                                <span class="product-tag-wrapper" data-bind="html: $parent.tagDisplay"></span>
                            </span>
                        </span>
                        <span class="product-view-details">
                            <span>
                                <span data-bind="text: ProductCode"></span>
                                <i class="material-icons-outlined pointer" style="font-size: 16px;" data-bind="bootstrapPopover: bootstrapPopoverDetails">
                                    info
                                </i>
                            </span>
                        </span>
                        <!-- ko if: $parentContext.$parentContext.$parentContext.$parent.phase() >= 13 && BasketItemTypeID == 6 -->
                        <span class="product-view-details">
                            <span>
                                <a data-bind="attr: { href: 'javascript:;' }, click: function () { $parent.fetchQuote() }">
                                    Get Quotation PDF
                                </a>
                            </span>
                        </span>
                        <!-- /ko -->
                        <!-- ko if: $parentContext.$parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_BASKET -->
                        <span class="product-view-details">
                            <span data-bind="visible: AllowEdit">
                                <a data-bind="attr: { href: 'javascript:;' }, click: function() { $parentContext.$parentContext.$parentContext.$parent.loadBasketItemForEdit($data) }">
                                    Edit
                                </a>
                            </span>
                            <span data-bind="visible: AllowDelete">
                                <a data-bind="attr: { href: 'javascript:;' }, click: function (data) { $parentContext.$parentContext.$parentContext.$parent.removeFromBasket($parent) }">
                                    Delete
                                </a>
                            </span>
                        </span>
                        <!-- /ko -->
                    </div>
                    @*<div class="product-edit-delete">
                        <a data-bind="attr: { href: 'javascript:;' }, bootstrapPopover: bootstrapPopoverDetails">
                            Edit
                        </a>
                        <a data-bind="attr: { href: 'javascript:;' }, click: function (data) { $parentContext.$parent.removeFromBasket(data) }">
                            Delete
                        </a>
                    </div>*@
                </div>
            </div>
        </div>
        <div class="stock-location-container">
            <span data-bind="text: StockLocationCode"></span>
            <span class="smaller" data-bind="text: StockLocationName"></span>
            <a class="smaller basket-allocation-message" data-bind="attr: { href: 'javascript:;' }, text: StockStatusMessage, bootstrapPopover: preAllocationPopoverDetails"></a>
            <!-- ko if: DuplicateLineWarning -->
            <span class="smaller red-text" data-bind="html: DuplicateLineWarning"></span>
            <!-- /ko -->
            <!-- ko foreach: basketItemErrors -->
            <span class="smaller red-text" data-bind="html: ErrorMessage"></span>
            <!-- /ko -->
            <span class="smaller" data-bind="html: BasketMessage"></span>
        </div>
        <div class="fulfilment-option-container">
            <span data-bind="text: FulfilmentTypeName"></span>
        </div>
        <div class="trade-price-container">
            <!-- ko if: IncludeInPriceTotal -->
            <span data-bind="text: formatCurrency(TradePrice, 2,  $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
            <!-- /ko -->
        </div>
        <div class="special-price-container">
            <!-- ko if: IncludeInPriceTotal -->
            <!-- ko ifnot: SpecialPrice == null -->
            <span data-bind="text: formatCurrency(SpecialPrice, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
            <!-- /ko -->
            <!-- ko if: SpecialPrice == null -->
            <span>&nbsp;</span>
            <!-- /ko -->
            <!-- ko if: SpecialPriceExplanation -->
            <span class="smaller" data-bind="text: SpecialPriceExplanation"></span>
            <!-- /ko -->
            <!-- /ko -->
        </div>
        <div class="quantity-container">
            <!-- ko if: $parent.productFilterOptions() -->
            <span data-bind="html: `${+Quantity.toFixed($parent.productFilterOptions().QuantityPrecision)}`"></span>
            <span class='smaller' data-bind="html: `${Units == 'm' ? 'metre(s)' : Units}`"></span>
            <!-- /ko -->
        </div>
        <!-- ko if: $parentContext.$parentContext.$parentContext.$parent.phase() >= 13 -->
        <div class="total-ex-vat-container">
            <!-- ko if: IncludeInPriceTotal -->
            <span data-bind="text: formatCurrency(SubTotal, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
            <!-- /ko -->
        </div>
        <div class="total-vat-container">
            <!-- ko if: IncludeInPriceTotal -->
            <span data-bind="text: formatCurrency(VATSubTotal, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
            <!-- /ko -->
        </div>
        <div class="total-inc-vat-container">
            <!-- ko if: IncludeInPriceTotal -->
            <span data-bind="text: formatCurrency((FinalPrice * Quantity) + VATSubTotal, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217)"></span>
            <!-- /ko -->
        </div>
        <!-- /ko -->
    </div>
    <!-- ko with: record -->
    <!-- ko if: BasketItemLineMemos.length -->
    <!-- ko foreach: Enumerable.From(BasketItemLineMemos).Where('$.LineMemoType.AlertOperator').ToArray() -->
    <div class="memo well" data-bind="html: LineMemo.replace(/\\n/g, '<br>')"></div>
    <!-- /ko -->
    <!-- /ko -->
    <!-- /ko -->
</script>

<script id="delivery-group-template" type="text/html">
    <div class="delivery-group" data-bind="visible: deliveryGroup.visible">
        <!-- ko if: ($parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_DISPATCH) || ($parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_REVIEW_HOLD) -->
        <div class="delivery-group-label" data-bind="with: deliveryGroup, css: { 'alert-danger': !isValid() }">
            <label class="delivery-group-name-label">
                <span data-bind="text: name"></span>
            </label>
            <label>
                Lines
                <span data-bind="text: products().length"></span>
            </label>
            <label>
                Quantity
                <span data-bind="text: quantity"></span>
            </label>
            <label>
                Total
                <!-- ko if: $parents[2].hasOwnProperty('currency') -->
                <span data-bind="html: formatCurrency(totalEx(), 2, $parents[2].currency().FormattingCulture, $parents[2].currency().ISO_4217) +  ' <sub>Ex. VAT</sub>'"></span>
                <!-- /ko -->
            </label>
            <label>
                <!-- ko if: $parentContext.$parentContext.$parentContext.$parent.phase() > ORDERFACTORY_PHASE_DISPATCH -->
                <!-- ko if: $parents[2].hasOwnProperty('currency') -->
                VAT
                <span data-bind="html: formatCurrency(vat(), 2, $parents[2].currency().FormattingCulture, $parents[2].currency().ISO_4217)"></span>
                <!-- /ko -->
                <!-- /ko -->
            </label>
            <label>
                <!-- ko if: $parents[2].hasOwnProperty('currency') -->
                <!-- ko if: $parentContext.$parentContext.$parentContext.$parent.phase() > ORDERFACTORY_PHASE_DISPATCH -->
                Total (excludes delivery)
                <span data-bind="html: formatCurrency(totalWithoutDelivery(), 2, $parents[2].currency().FormattingCulture, $parents[2].currency().ISO_4217) +  ' <sub>Inc. VAT</sub>'"></span>
                <!-- /ko -->
                <!-- /ko -->
            </label>
        </div>
        <!-- /ko -->
        <!-- ko if: $parent.hasOwnProperty('customerRequests') -->
        <!-- ko if: $parent.customerRequests() && customerRequestNotMet() -->
        <div class="delivery-group-request-fail alert alert-warning margin-top-10">
            <h4 class="alert-title bold">
                Warning
            </h4>
            <p class="margin-bottom-15">
                The Delivery Service for this Group does not meet the Customer's request. The Customer requested:
            </p>
            <!-- ko if: $parent.customerRequests().CustomerRequestDeliveryServiceName -->
            <label>
                Delivery Service Name:
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestDeliveryServiceName"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestHaulierCode -->
            <label>
                Haulier Code:
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestHaulierCode"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestServiceCode -->
            <label>
                Carriage Code:
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestServiceCode"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestHaulierAccountNumberForShippingCharge -->
            <label>
                Haulier Account No. (Shipping):
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestHaulierAccountNumberForShippingCharge"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestHaulierAccountNumberForDuty -->
            <label>
                Haulier Account No. (Duty & Taxes):
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestHaulierAccountNumberForDuty"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestDeliveryTerms -->
            <label>
                Delivery Terms:
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestDeliveryTerms"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestDeliveryType -->
            <label>
                Delivery Type:
                <span class="font-normal" data-bind="text: $parent.customerRequests().CustomerRequestDeliveryType"></span>
            </label>
            <!-- /ko -->
            <!-- ko if: $parent.customerRequests().CustomerRequestsFullDespatch -->
            <label>
                Full Despatch
            </label>
            <!-- /ko -->
        </div>
        <!-- /ko -->
        <!-- /ko -->
        <div class="delivery-group-inner">
            <div class="delivery-group-product-wrapper">
                <div class="products-container">
                    <!-- ko if: $parentContext.$parentContext.$parent.hasOwnProperty('phase') ? ($parentContext.$parentContext.$parent.phase() <= ORDERFACTORY_PHASE_REVIEW_HOLD) || ($parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_RETAIL) : true -->
                    <!-- ko foreach: { data: (deliveryGroup.revealAllProducts() ? deliveryGroup.products() : Enumerable.From(deliveryGroup.products()).Take(2).ToArray()) } -->
                    <div class="delivery-group-product" data-bind="with: record">
                        <!-- ko if: ProductImageID -->
                        <img class="thumb" data-bind="attr: { src: 'https://www.designersguild.com/image/156/' + ProductImageID, title: ProductCode + ' BasketItemID: ' + BasketItemID }" />
                        <!-- /ko -->
                        <div class="delivery-product-details">
                            <div class="delivery-product-details-inner">
                                <span class="product-name">
                                    <span>
                                        <span data-bind="text: ProductBasketName, attr: { title: ProductBasketName }"></span>
                                        <span class="product-tag-wrapper" data-bind="html: $parent.tagDisplay"></span>
                                    </span>
                                </span>
                                <span class="product-code" data-bind="text: ProductCode"></span>
                                <span class="product-quantity-details">
                                    <span data-bind="html: Quantity + ' ' + Units"></span>
                                    <i class="material-icons-outlined pointer" style="font-size: 16px;" data-bind="bootstrapPopover: bootstrapPopoverDetails">
                                        info
                                    </i> 
                                </span>
                                <span data-bind="text: formatCurrency(FinalPrice * Quantity, 2, Currency.FormattingCulture, Currency.ISO_4217) + ' Ex. VAT'"></span>
                                <span data-bind="text: AdditionalInformation"></span>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: deliveryGroup.products().length > 2 -->
                    <a class="reveal-products" href="javascript:;" data-bind="click: function () { deliveryGroup.revealAllProducts(!deliveryGroup.revealAllProducts()) }">
                        <span data-bind="text: deliveryGroup.revealAllProducts() ? 'Hide all but 2 lines' : 'Show all ' + deliveryGroup.products().length + ' lines'"></span>
                    </a>
                    <!-- /ko -->
                    <!-- /ko -->
                    <!-- ko if: $parentContext.$parentContext.$parent.hasOwnProperty('phase') ? $parentContext.$parentContext.$parent.phase() > ORDERFACTORY_PHASE_REVIEW_HOLD : true -->
                    <span data-bind="text: deliveryGroup.name"></span>
                    <!-- /ko -->
                </div>
                <div class="delivery-group-dispatch">
                    <!-- ko foreach: { data: (deliveryGroup.revealAllProducts() ? deliveryGroup.products() : Enumerable.From(deliveryGroup.products()).Take(2).ToArray()) } -->
                    <div class="delivery-group-dispatch-inner">
                        <!-- ko if: $index() == 0 -->
                        <label class="dispatch-estimates-title">
                            Despatch Estimates
                        </label>
                        <!-- /ko -->
                        <span data-bind="html: DespatchEstimate"></span>
                    </div>
                    <!-- /ko -->
                </div>
                <!-- ko if: $parentContext.$parentContext.$parent.phase() != ORDERFACTORY_PHASE_RETAIL -->
                <div class="delivery-group-services">
                    <dl class="dl-horizontal services">
                        <dt>
                            Service:
                        </dt>
                        <dd>
                            <span data-bind="text: deliveryService().ServiceName"></span>
                            <!-- ko if: $parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_DISPATCH -->
                            <a href="javascript:;" data-bind="click: $parent.showDeliveryOptions, css: { 'red-text': !isValid() }, attr: { title: `(${services().length})` }">Change</a>
                            <!-- /ko -->
                            <!-- ko if: $parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_DISPATCH -->
                            <a href="javascript:;" data-bind="click: $parent.resetDeliveryOptions">Reset</a>
                            <!-- /ko -->
                        </dd>
                        <dt>
                            From:
                        </dt>
                        <dd>
                            <span data-bind="text: deliveryService().From"></span>
                        </dd>
                        <dt>
                            To:
                        </dt>
                        <dd>
                            <span data-bind="text: deliveryService().To"></span>
                        </dd>
                        <!-- ko if: deliveryService().haulier.transportShipperButtons.visible -->
                        <dt>
                            Transport Billed To:
                        </dt>
                        <dd>
                            <span data-bind="text: `${deliveryService().TransportBilledToName} ${deliveryService().TransportBilledToCode ? '(' + deliveryService().TransportBilledToCode + ')' : ''}`"></span>
                            <!-- ko if: $parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_DISPATCH -->
                            <a href="javascript:;" data-bind="click: $parent.showDeliveryOptions">Change</a>
                            <!-- /ko -->
                        </dd>
                        <!-- /ko -->
                        <!-- ko if: deliveryService().haulier.allowCustomerHaulierAccountForDutyAndTax != false -->
                        <dt>
                            Duty &amp; Tax Billed To:
                        </dt>
                        <dd>
                            <span data-bind="text: `${deliveryService().DutyTaxBilledToName} ${deliveryService().DutyTaxBilledToCode ? '(' + deliveryService().DutyTaxBilledToCode + ')' : ''}`"></span>
                            <!-- ko if: $parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_DISPATCH -->
                            <a href="javascript:;" data-bind="click: $parent.showDeliveryOptions">Change</a>
                            <!-- /ko -->
                        </dd>
                        <!-- /ko -->
                    </dl>
                </div>
                <!-- /ko -->
                <div class="delivery-group-charges">
                    <!-- ko with: deliveryService -->
                    <dl class="dl-horizontal charges">
                        <dt>
                            Charge:
                        </dt>
                        <dd>
                            <span class="display-block" data-bind="html: finalPriceFormattedForDisplay"></span>
                            <!-- ko if: EstimatedParcelCount -->
                            <!-- ko if: EstimatedParcelCount == 1 -->
                            <a class="display-block pointer" data-bind="text: 'Estimated ' + EstimatedParcelCount + ' Parcel', bootstrapPopover: $parent.deliveryGroup.parcelEstimatePopoverDetails"></a>
                            <!-- /ko -->
                            <!-- ko if: EstimatedParcelCount > 1 -->
                            <a class="display-block pointer" data-bind="text: 'Estimated ' + EstimatedParcelCount + ' Parcels', bootstrapPopover: $parent.deliveryGroup.parcelEstimatePopoverDetails"></a>
                            <!-- /ko -->
                            <!-- /ko -->
                            <!-- ko if: ContractChargeEx != null -->
                            <span class="display-block">
                                (Contract Price)
                            </span>
                            <!-- /ko -->
                        </dd>
                        <!-- ko if: $parentContext.$parentContext.$parentContext.$parent.phase() > ORDERFACTORY_PHASE_DISPATCH -->
                        <dt>
                            VAT:
                        </dt>
                        <dd>
                            <span data-bind="text: vatFormatted"></span>
                        </dd>
                        <dt>
                            Total:
                        </dt>
                        <dd>
                            <span data-bind="text: finalTotalFormattedForDisplayIncludingVAT"></span>
                        </dd>
                        <!-- /ko -->
                        <dt>
                            &nbsp;
                        </dt>
                        <dd>
                            <a class="view-order-delivery-details" href="javascript:;" data-bind="click: function () { showServiceDetails($parent); }">
                                View Details
                            </a>
                        </dd>
                    </dl>
                    <!-- ko if: OperatorDiscountPercentage == 100 || discounter.currentDiscountPercentage == 100 -->
                    <div class="alert alert-danger margin-bottom-0">
                        <span>
                            Operator Provided 100% Discount
                        </span>
                        <!-- ko if: discounter.discountReasonText() -->
                        <span data-bind="text: discounter.discountReasonText"></span>
                        <!-- /ko -->
                        <!-- ko if: discounter.customDiscountReason.observable -->
                        <span data-bind="text: discounter.customDiscountReason.observable"></span>
                        <!-- /ko -->
                        <a class="display-block pointer" data-bind="click: function() { removeDiscount($parent); }">
                            Remove
                        </a>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: (OperatorDiscountPercentage != null && OperatorDiscountPercentage < 100) || 
                                (discounter.currentDiscountPercentage != null && discounter.currentDiscountPercentage < 100) -->
                    <div class="alert alert-warning margin-bottom-0">
                        <span>
                            Operator Provided <span style="display: inline" data-bind="text: OperatorDiscountPercentage || discounter.currentDiscountPercentage"></span>% Discount
                        </span>
                        <!-- ko if: discounter.discountReasonText() -->
                        <span data-bind="text: discounter.discountReasonText"></span>
                        <!-- /ko -->
                        <!-- ko if: discounter.customDiscountReason.observable -->
                        <span data-bind="text: discounter.customDiscountReason.observable"></span>
                        <!-- /ko -->
                        <a class="display-block pointer" data-bind="click: function() { removeDiscount($parent); }">
                            Remove
                        </a>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: OperatorEnteredChargeEx == 0 || discounter.currentDiscountMonetary == 0 -->
                    <div class="alert alert-danger margin-bottom-0">
                        <span class="bold display-block">
                            Operator Requested Final Charge of £0.00
                        </span>
                        <!-- ko if: discounter.discountReasonText() -->
                        <span class="display-block" data-bind="text: discounter.discountReasonText"></span>
                        <!-- /ko -->
                        <!-- ko if: discounter.customDiscountReason.observable -->
                        <span class="display-block" data-bind="text: discounter.customDiscountReason.observable"></span>
                        <!-- /ko -->
                        <a class="display-block pointer" data-bind="click: function() { removeDiscount($parent); }">
                            Remove
                        </a>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: (OperatorEnteredChargeEx != null && OperatorEnteredChargeEx > 0) || (discounter.currentDiscountMonetary != null && discounter.currentDiscountMonetary > 0) -->
                    <div class="alert alert-warning margin-bottom-0">
                        <span class="bold display-block">
                            Operator <span style="display: inline" data-bind="text: FinalDeliveryChargeEx == null ? 'Entered Charge' : 'Requested Discount'"></span> <span data-bind="html: finalPriceFormattedForDisplay"></span>
                        </span>
                        <!-- ko if: discounter.discountReasonText() -->
                        <span class="display-block" data-bind="text: discounter.discountReasonText"></span>
                        <!-- /ko -->
                        <!-- ko if: discounter.customDiscountReason.observable -->
                        <span class="display-block" data-bind="text: discounter.customDiscountReason.observable"></span>
                        <!-- /ko -->
                        <a class="display-block pointer" data-bind="click: function() { removeDiscount($parent); }">
                            Remove
                        </a>
                    </div>
                    <!-- /ko -->
                    <!-- /ko -->
                    <!-- ko if: deliveryGroup.products().length > 1 &&  $parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_DISPATCH -->
                    <div data-bind="with: deliveryService">
                        <div data-bind="component: { name: 'mdc-checkbox-component', params: customerRequestsFullDespatchParams }"></div>
                    </div>
                    @*<label class="checkbox-wrapper" data-bind="with: deliveryService">
                        <input type="checkbox" data-bind="checked: customerRequestsFullDespatch" />
                        <span class="font-normal">
                            Despatch order only when all items are in stock?
                        </span>
                    </label>*@
                    <!-- /ko -->
                </div>
                <!-- ko if: $parentContext.$parentContext.$parent.phase() == ORDERFACTORY_PHASE_RETAIL -->
                <div class="delivery-group-retail-payments">
                    <div>
                        <h4 class="total-payable">
                            Total Payable: 
                            <span data-bind="text: formatCurrency(retailTotalPayable(), 2, $parents[2].currency().FormattingCulture, $parents[2].currency().ISO_4217)"></span>
                        </h4>
                    </div>
                    <!-- ko foreach: retailPaymentEntries -->
                    <div class="margin-bottom-15">
                        <div class="payment-wrapper">
                            <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: retailPaymentTypeParams }"></div>
                            <!-- ko if: retailPaymentReferenceRequired -->
                             <div data-bind="component: { name: 'mdc-text-field-component', params: retailPaymentReferenceParams }"></div>
                            <!-- /ko -->
                            <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: retailPaymentAmountParams }"></div>
                        </div>
                        <div>
                            <i class="material-icons pointer" data-bind="click: $parent.removeRetailPaymentEntry">
                                delete_forever
                            </i>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div class="payment-controls">
                        <h4 data-bind="style: { 'color': retailRemainingPayable() >= 0 ? 'inherit' : '#db0028' }">
                            <span data-bind="text: retailRemainingPayable() >= 0 ? 'Remaining:' : 'Overpaid by:'"></span>
                            <span data-bind="text: formatCurrency(retailRemainingPayable(), 2, $parents[2].currency().FormattingCulture, $parents[2].currency().ISO_4217).replace(/-/g, '')"></span>
                        </h4>
                        <!-- ko if: retailRemainingPayable() > 0 -->
                        <button class="btn btn-default" data-bind="click: addRetailPaymentEntry">
                            Add Payment
                        </button>
                        <!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
</script>

<script id="basket-group-template" type="text/html">
    <!-- ko foreach: deliveryGroups -->
    <!-- ko template: { name: 'delivery-group-template' } --><!-- /ko -->
