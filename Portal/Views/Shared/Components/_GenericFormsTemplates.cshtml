<script type="text/html" id="generic-form-template">
    <form class="form-container card" data-bind="class: displayClass, event: { 'onsubmit': (ev) => { ev.preventDefault() } }">
        <!-- ko if: heading -->
        <div class="card-header">
            <h4 data-bind="html: heading"></h4>
            <!-- ko if: subHeading -->
            <h6 class="card-subtitle" data-bind="html: subHeading"></h6>
            <!-- /ko -->
        </div>
        <!-- /ko -->
        <div class="card-body bg-light">
            <!-- ko if: intro -->
            <div class="form-description" data-bind="html: intro"></div>
            <!-- /ko -->
            <div data-bind="
                class: layoutClass,
                template: {
                    foreach: panels,
                    name: 'generic-form-panel-template'
                }"></div>
            <!-- ko if: submittable -->
            <div class="d-flex gap-3 pt-3">
                <button type="button" class="btn btn-success" data-bind="click: submit">
                    Submit
                </button>
                <span class="validation-message" data-bind="visible: isInvalid">
                    Please correct all errors before submitting this form
                </span>
            </div>
            <!-- /ko -->
        </div>
    </form>
</script>

<script type="text/html" id="generic-form-panel-template">
    <fieldset class="form-fieldset card" data-bind="class: layoutClass">
        <!-- ko if: heading -->
        <div class="card-header">
            <h5 class="card-title" data-bind="html: heading"></h5>
            <!-- ko if: subHeading -->
            <h6 class="card-subtitle" data-bind="html: subHeading"></h6>
            <!-- /ko -->
        </div>
        <!-- /ko -->
        <div class="card-body">
            <!-- ko if: intro -->
            <div class="panel-description" data-bind="html: intro"></div>
            <!-- /ko -->
            <div data-bind="
                 class: layoutClass,
                 template: {
                    foreach: visibleFields,
                    name: 'generic-form-field-template'
                 }"></div>
            <!-- ko if: submittable -->
            <div class="d-flex gap-3 pt-3">
                <button type="button" class="btn btn-success" data-bind="click: submit">
                    Submit
                </button>
                <span class="validation-message" data-bind="visible: isInvalid">
                    Please correct all errors before submitting this form
                </span>
            </div>
            <!-- /ko -->
        </div>
    </fieldset>
</script>

<script type="text/html" id="generic-form-field-template">
    <div class="field" data-bind="class: layoutClass">
        <div data-bind="
             attr: {
                'data-bs-toggle': 'tooltip',
                'data-bs-title': tooltip
             },
             component: {
                name: templateName,
                params: params
             }"></div>
        <!-- ko if: note -->
        <div class="field-note" data-bind="html: note"></div>
        <!-- /ko -->
        <!-- ko if: typeof creationModel !== 'undefined' -->
        @*<div class="popper-form card" data-bind="attr: { 'id': `${fieldId}-creation-form` }">
            <h4 class="card-header">
                <span></span>
                <button type="button" class="btn btn-close" data-bind="click: hideCreation"></button>
            </h4>
            <div class="card-body" data-bind="template: { name: 'generic-form-template', data: creationModel }"></div>
        </div>*@
        <div class="popper-form" data-bind="template: { name: 'generic-form-template', data: creationModel }, attr: { 'id': `${fieldId}-creation-form` }"></div>
        <!-- /ko -->
    </div>
</script>

<script type="text/html" id="change-summary-template">
    <table class="table table-striped table-condensed">
        <thead>
            <tr>
                <th>
                    Table
                </th>
                <th>
                    Change
                </th>
                <th class="text-end">
                    Count
                </th>
            </tr>
        </thead>
        <tbody>
            <!-- ko foreach: $data -->
            <tr>
                <td>
                    <span data-bind="text: Table"></span>
                </td>
                <td>
                    <span data-bind="text: Change"></span>
                </td>
                <td class="text-end">
                    <span data-bind="text: Count"></span>
                </td>
            </tr>
            <!-- /ko -->
        </tbody>
    </table>
</script>

<script type="text/html" id="no-data-template">
    <h4 class="text-danger">
        Blah
    </h4>
</script>