<div style="position: relative">
    <div id="price-checker-grid-loading" class="panel-busy-wrapper" style="border-radius: 4px;">
        <div class="form-busy">
            <div class="busy-bars">
                <div class="rect1 alert alert-info"></div>
                <div class="rect2 alert alert-info"></div>
                <div class="rect3 alert alert-info"></div>
                <div class="rect4 alert alert-info"></div>
                <div class="rect5 alert alert-info"></div>
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-xs-12">
            <div id="price-checker-grid" data-bind="kendoGrid: resultGridSettings"></div>
        </div>
    </div>
</div>

<div class="form-group row">
    <div class="col-xs-12 text-center">
        <div style="float: left">
            <!-- ko if: currentQuery() === 'CustomerPrices' -->
            <button role="button" class="btn btn-default btn-sm" href="\#" data-bind="click: function() { resultsToPdf(); }">
                <span class="k-icon k-i-file-pdf"></span>Export to PDF
            </button>
            <!-- /ko -->
            <button role="button" class="btn btn-default btn-sm" href="\#" data-bind="click: function() { resultsToXlsx(); }">
                <span class="k-icon k-i-file-xls"></span>Export to Xlsx
            </button>
        </div>
        <div style="float: right">
            <button class="btn btn-success btn-sm" data-bind="click: function(e) { cacheBuster(true) }">
                Hard Refresh
                <span class="glyphicon glyphicon-refresh"></span>
            </button>
        </div>
        <div>
            <label class="text-muted">
                Key:&nbsp;
            </label>
            <div class="panel panel-warning" style="display: inline-block;">
                <div class="panel-heading" style="padding: 4px 8px; cursor: default;">
                    Clearance
                </div>
            </div>
            <div class="panel panel-danger" style="display: inline-block;">
                <div class="panel-heading" style="padding: 4px 8px; cursor: default;">
                    Gross Margin beneath Target Margin
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</div>

