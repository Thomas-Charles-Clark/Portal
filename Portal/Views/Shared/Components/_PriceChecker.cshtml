@* Templates for Kendo controls *@

<script type="text/kendo-x-tmpl" id="list-item-template">
    <div class="list-group-item">#= Name #</div>
</script>

<script type="text/kendo-x-tmpl" id="currency-list-item-template">
    <div class="list-group-item">#= Currency.Name #</div>
</script>

<script type="x/kendo-template" id="grid-page-template">
    <div class="page-template">
        <div class="header">
            <div style="float: right">Page #: pageNum # of #: totalPages #</div>
            Multi-page grid with automatic page breaking
        </div>
        <div class="watermark">DESIGNERS GUILD</div>
        <div class="footer">
            Page #: pageNum # of #: totalPages #
        </div>
    </div>
</script>

