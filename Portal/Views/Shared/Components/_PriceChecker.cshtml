                            </div>
                            <div class="panel-body no-padding">
                                <div class="slicer-list list-group" data-bind="kendoListView: { dataValueField: 'ProductTypeID', dataTextField: 'Name', widget: productTypeWidget, data: productTypeDataSource, change: function(e) { productTypeChange(e) }, dataBound: function(e) { productTypeDataBound(e); }, template: $('#list-item-template').html(), selectable: 'multiple'}"></div>
