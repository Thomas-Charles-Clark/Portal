                        </div>
                        <div class="slicer panel panel-primary">
                            <div class="panel-heading">
                                Launch
                                <span class="clear-selection glyphicon glyphicon-filter" style="display: none;" data-bind="visible: selectedLaunchIDs().length > 0,click: function() { launchWidget().clearSelection(); }"><span>&times;</span></span>
                            </div>
                            <div class="panel-body no-padding">
                                <div class="slicer-list list-group" data-bind="kendoListView: { dataValueField: 'LaunchID', dataTextField: 'Name', widget: launchWidget, data: launchDataSource, change: function(e) { launchChange(e) }, dataBound: function(e) { launchDataBound(e); }, template: $('#list-item-template').html(), selectable: 'multiple'}"></div>
                            </div>
                            <div class="panel-footer">
                                <a data-bind="attr: { href: launchDataSourceURL(), target: '_blank' }, text: launchDataSourceURL()"></a>
