                        </div>
                        <div class="slicer panel panel-primary">
                            <div class="panel-heading">
                                Item Type
                                <span class="clear-selection glyphicon glyphicon-filter" style="display: none;" data-bind="visible: selectedItemTypeIDs().length > 0, click: function() { itemTypeWidget().clearSelection(); }"><span>&times;</span></span>
                            </div>
                            <div class="panel-body no-padding">
                                <div class="slicer-list list-group" data-bind="kendoListView: { dataValueField: 'ItemTypeID', dataTextField: 'Name', widget: itemTypeWidget, data: itemTypeDataSource, change: function(e) { itemTypeChange(e) }, dataBound: function(e) { itemTypeDataBound(e); }, template: $('#list-item-template').html(), selectable: 'multiple'}"></div>
