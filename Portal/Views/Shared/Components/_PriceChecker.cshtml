@* End of Templates for Kendo controls *@

<div class="form-group row">
    <div class="col-xs-12">
        <div id="query-btns" class="btn-group btn-group-justified">
            <label class="btn" data-bind="css: { 'btn-success active': currentQuery() == 'CustomerPrices', 'btn-default': selectedTradeAccountId() == null, 'btn-primary': selectedTradeAccountId() != null }, click: function() { selectedTradeAccountId() ? currentQuery('CustomerPrices') : $.info('Info', 'You must select a trade account to use this enquiry.') }">
                @*Trade Price Enquiry*@
                Customer Prices
            </label>
            <label class="btn btn-primary" data-bind="css: { 'btn-success active': currentQuery() == 'ListPrices' }, click: function() { currentQuery('ListPrices') }">
                @*Price List Enquiry*@
                List Prices
            </label>
            <label class="btn btn-primary" data-bind="css: { 'btn-success active': currentQuery() == 'ContractPrices' }, click: function() { currentQuery('ContractPrices') }">
                @*Special Price Enquiry*@
                Special Prices
            </label>
            <label class="btn btn-primary" data-bind="css: { 'btn-success active': currentQuery() == 'ProductsNoPrices' }, click: function() { currentQuery('ProductsNoPrices') }">
                @*Products Without Prices*@
                Products without Prices
            </label>
            <label class="btn btn-primary" data-bind="css: { 'btn-success active': currentQuery() == 'LowMargin' }, click: function() { currentQuery('LowMargin') }">
                @*Low Margin*@
                Low Margin
            </label>
            <label class="btn btn-primary" data-bind="css: { 'btn-success active': currentQuery() == 'ContractAgreements' }, click: function() { currentQuery('ContractAgreements') }">
                @*Special Price Agreements*@
                Price Agreements
            </label>
        </div>
    </div>
</div>

@*data-parent="#accordion"*@
<div id="price-search-accordion">
    <div class="panel panel-secondary-blue">
        <div class="panel-heading no-padding non-search">
            <h4 class="panel-title">
                <a href="javascript:;" class="panel-title panel-toggle" data-toggle="collapse" data-parent="price-search-accordion" data-target="#market-collapse">
                    Market Filters
                </a>
            </h4>
        </div>
        <div id="market-collapse" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-4 col-xs-12">
                        <div class="slicer panel panel-primary" style="width: 100%; margin-bottom: 0">
                            <div class="panel-heading">
                                Currency
                                <!-- ko if: permitMarketChange() -->
                                <span class="clear-selection glyphicon glyphicon-filter" style="display: none;" data-bind="visible: (selectedCurrencyId() != null), click: function() { selectedCurrencyId(undefined); }"><span>×</span></span>
                                <!-- /ko -->
                            </div>
                            <div class="panel-body no-padding">
                                <div class="slicer-disabler" data-bind="visible: selectedTradeAccountId() != null"></div>
                                <div class="slicer-list list-group" data-bind="kendoListView: {  dataValueField: 'Value', dataTextField: 'Currency.Name',  data: currencyDataSource, change: function(e) { currencyChange(e); }, dataBound: function(e) { currencyDataBound(e); }, template: $('#currency-list-item-template').html(), selectable: permitMarketChange }"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <div class="slicer panel panel-primary" style="width: 100%; margin-bottom: 0">
                            <div class="panel-heading">
                                Market
                                <!-- ko if: permitMarketChange() -->
                                <span class="clear-selection glyphicon glyphicon-filter" style="display: none;" data-bind="visible: (selectedMarketId() != null), click: function() { selectedMarketId(undefined); }"><span>×</span></span>
                                <!-- /ko -->
                            </div>
                            <div class="panel-body no-padding">
                                <div class="slicer-disabler" data-bind="visible: selectedTradeAccountId() != null"></div>
                                <div class="slicer-list list-group" data-bind="kendoListView: { dataValueField: 'Value', dataTextField: 'Name',  data: marketDataSource, change: function(e) { marketChange(e); }, dataBound: function(e) { marketDataBound(e); }, template: $('#list-item-template').html(), selectable: permitMarketChange }"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 col-xs-12">
                        <div class="slicer panel panel-primary" style="width: 100%; margin-bottom: 0">
                            <div class="panel-heading">
                                Price List
                                <!-- ko if: permitMarketChange() -->
                                <span class="clear-selection glyphicon glyphicon-filter" style="display: none;" data-bind="visible: (selectedTradePriceListId() != null), click: function() { selectedTradePriceListId(undefined); }"><span>×</span></span>
                                <!-- /ko -->
                            </div>
                            <div class="panel-body no-padding">
                                <div class="slicer-disabler" data-bind="visible: selectedTradeAccountId() != null"></div>
                                <div class="slicer-list list-group" data-bind="kendoListView: { widget: tradePriceListWidget(), dataValueField: 'Value', dataTextField: 'Name',  data: tradePriceListDataSource, change: function(e) { tradePriceListChange(e); }, dataBound: function(e) { tradePriceListDataBound(e); }, template: $('#list-item-template').html(), selectable: permitMarketChange, filterable: true}"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="panel panel-secondary-blue">
        <div class="panel-heading no-padding non-search">
            <h4 class="panel-title">
                <a href="javascript:;" class="panel-title panel-toggle" data-toggle="collapse" data-parent="price-search-accordion" data-target="#product-collapse">
                    Product Filters
                </a>
            </h4>
        </div>
        <div id="product-collapse" class="panel-collapse collapse in">
            <div class="panel-body">
                <div class="row">
                    <div class="col-xs-12">
                        <div class="row">
                            <div class="col-sm-12 col-xs-12">
                                <div class="form-group row">
                                    <div class="col-xs-12 price-checker-controls">
                                        <div class="input-group">
                                            <input id="price-checker-search" type="text" class="form-control" data-bind="textInput: searchTerm" placeholder="Search for a Product, Design or Collection" />
                                            <span class="input-group-addon">
                                                <button class="clear-btn btn btn-primary @(Model.Properties?.Application_ButtonClass)" type="button" data-bind="click: function() { clearPriceCheckerSearch() }">×</button>
                                            </span>
                                            <span class="input-group-btn">
                                                <button style="border-top-right-radius: 4px; border-bottom-right-radius: 4px;" class="search-btn btn btn-primary @(Model.Properties?.Application_ButtonClass)" data-bind="click: function() { performPriceCheckerAutocompleteSearch() }"><span class="glyphicon glyphicon-search"></span></button>

                                                <span style="margin-left: 12px;">
                                                    <input id="include-samples" type="checkbox" style="margin-left: 12px;" />
                                                </span>
                                                <span style="margin-left: 12px;">
                                                    <input id="include-clearance" type="checkbox" style="margin-left: 12px;" />
                                                </span>
                                                <button style="border-radius: 4px; margin-left: 12px;" class="btn btn-danger" data-bind="click: function() { reset(); }">
                                                    Reset
                                                </button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="slicer-wrapper" class="row">
                    <div class="col-xs-12">
                        @*<div class="slicer panel panel-primary">
