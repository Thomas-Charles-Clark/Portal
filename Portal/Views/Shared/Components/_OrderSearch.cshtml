@model Portal.ViewModels.ComponentModels.OrderSearchViewModel
<!-- ko with: orderSearch -->
<div class="panel panel-primary">
    <div class="panel-heading no-padding">
        <h4 class="panel-title">
            <a class="panel-title panel-toggle" data-toggle="collapse" data-target="#order-search-collapse">Search for Orders</a>
        </h4>
        <div class="clearfix"></div>
    </div>
    <div id="order-search-collapse" class="panel-collapse collapse in">
        <div class="selector panel-body">
            @*<label class="col-form-label">Search by Order Number, Customer Reference, Postcode, Email, Name or Telephone Number</label>*@

            <div class="input-group">
                <input id="order-search" type="text" class="form-control" maxlength="100" data-bind="value: searchTerm, event: { keyup: onSearchKeyUp }" placeholder="Search by address, contact, product or order" />
                <span class="input-group-addon">
                    <button class="clear-btn btn btn-default @(Model.ButtonCssOverride)" type="button" data-bind="click: function() { clearSearch() }">&times;</button>
                </span>
                <span class="input-group-btn">
                    <button class="search-btn btn btn-default @(Model.ButtonCssOverride)" data-bind="click: function() { performSearch() }"><span class="glyphicon glyphicon-search"></span></button>
                </span>
            </div>

            <div class="row margin-top-15">
                <div class="col-xs-6">
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Product Type</label>
                        </div>
                        <div class="col-xs-12">
                            <select id="product-type" class="form-control" data-bind="value: productType, optionsText: 'Name', optionsValue: 'ProductTypeID', optionsCaption: 'All', options: availableProductTypes"></select>
                        </div>
                    </div>
                </div>
                <div class="col-xs-6">
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Order Status</label>
                        </div>
                        <div class="col-xs-12">
                            <select id="order-status" class="form-control" data-bind="value: orderStatus, optionsText: 'Name', optionsValue: 'Value', options: orderStatusOptions"></select>
                        </div>
                    </div>
                </div>
            </div>


            <div class="row margin-top-15">
                <div class="col-xs-12">
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Period</label>
                        </div>
                        <div class="col-xs-12">
                            <select id="period" class="form-control" data-bind="value: period, options: periodOptions, optionsText: 'Name', optionsValue: 'Value', optionsCaption: 'Please select'"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row margin-top-15" style="display: none;" data-bind="visible: period() == 'custom'">
                <div class="col-xs-6">
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">From:</label>
                        </div>
                        <div class="col-xs-12">
                            <div class='input-group date'>
                                <input type='text' class="date-input form-control" readonly="readonly" data-bind="dateTimePicker: fromDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true }" />
                                <span class="input-group-btn">
                                    <button id="from-calendar-btn" class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </button>
                                </span>
                            </div>
                                                        @*

        <div class='input-group date' data-bind="dateTimePicker: fromDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY LT', ignoreReadonly: true, showClear: true, allowInputToggle: true }">
            <input type='text' class="form-control" readonly="readonly" />
            <span class="input-group-btn">
                <button class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                    <span class="glyphicon glyphicon-calendar"></span>
                </button>
            </span>
        </div>
                                                        *@
                        </div>

                    </div>
                </div>
                <div class="col-xs-6">
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">To:</label>
                        </div>
                        <div class="col-xs-12">
                            <div class='input-group date'>
                                <input type='text' class="date-input form-control" readonly="readonly" data-bind="dateTimePicker: toDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true }" />
                                <span class="input-group-btn">
                                    <button id="to-calendar-btn" class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row margin-top-30" data-bind="visible: (displayFilters() == false && searchBusy() == true)">
    <div class="col-xs-12">
        <div class="loading-busy"></div>
    </div>
</div>

<div class="row margin-top-15 margin-bottom-15">
    <div class="pager-info col-xs-12">
        <label class="search-result-count-label" data-bind="visible: haveSearched, text: searchResultsTotalCount() + ' result' + (searchResultsTotalCount() == 1 ? '' : 's')"></label>
        <label id="order-search-page-count" class="page-count-label" data-bind="visible: pageCount() > 1, text: pageCount() + ' page' + (pageCount() > 1 ? 's' : '')"></label>
    </div>
</div>
<div class="row">
    <div class="col-xs-12">
        <nav aria-label="Search Result Navigation" data-bind="visible: pageCount() > 1">
            <ul class="pagination order-search-pagination pagination-sm"></ul>
            <div class="loading-busy search-results-busy" data-bind="visible: searchBusy()"></div>
        </nav>
    </div>
</div>

<div class="row" style="display: none;" data-bind="visible: true">
    <div class="col-xs-12">
        <div style="position: relative">
            <div id="grid-loading" class="panel-busy-wrapper" style="border-radius: 4px;">
                <div class="form-busy">
                    <div class="busy-bars">
                        <div class="rect1 alert alert-info"></div>
                        <div class="rect2 alert alert-info"></div>
                        <div class="rect3 alert alert-info"></div>
                        <div class="rect4 alert alert-info"></div>
                        <div class="rect5 alert alert-info"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div id="order-search-grid" data-bind="kendoGrid: resultGridSettings"></div>
                </div>
            </div>
        </div>
    </div>

    @*<!-- ko foreach: searchResults -->
    <div class="col-xs-12">
        <div class="order-result card">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 data-bind="html: orderHeading"></h4>
                    <span data-bind="html: orderDate"></span>
                </div>
                <div class="panel-body">
                    <!-- ko if: $data.orderLines -->
                    <!-- ko if: $data.orderLines.length >= 1 -->
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Name</label>
                            <span class="value-display" data-bind="text: $data.orderLines[0].FullName"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Address</label>
                            <a class="break-all value-display" data-bind="text: $data.orderLines[0].Postcode, click: function() { $data.loadAddress($data.orderLines[0]) }, attr: { href: 'javascript:;' }"></a>
                        </div>
                    </div>
                    <!-- ko if: $data.orderLines[0].CustomerOrderReference -->
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Reference</label>
                            <span class="value-display" data-bind="text: $data.orderLines[0].CustomerOrderReference"></span>
                        </div>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: $data.orderLines[0].PhoneNumber -->
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="col-form-label">Telephone</label>
                            <a class="break-all value-display" data-bind="text: $data.orderLines[0].PhoneNumber, attr: { href: 'tel:' + $data.orderLines[0].PhoneNumber }"></a>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div class="row">
                        <div class="col-xs-12">
                            <label class="hidden-xs col-form-label">Email</label>
                            <a class="break-all value-display email" data-bind="text: $data.orderLines[0].Email, attr: { href: 'mailto:' + $data.orderLines[0].Email }"></a>
                        </div>
                    </div>
                    <!-- /ko -->

                    <ul class="list-group list-group-flush">
                        <!-- ko foreach: $data.orderLines -->
                        <li class="list-group-item">
                            <!-- ko if: $data.ImageID -->
                            <img class="thumb" data-bind="click: function() { $parent.loadLargeImage($data) }, attr: { src: 'https://www.designersguild.com/image/32/' + $data.ImageID, title: $data.ProductCode }" />
                            <!-- /ko -->
                            <!-- ko ifnot: $data.ImageID -->
                            <img class="thumb" data-bind="click: function() { $parent.loadLargeImage($data) }, attr: { src: '/Areas/Products/content/images/not-found.png', title: $data.ProductCode }" />
                            <!-- /ko -->
                            <!-- ko if: $data.Description != null -->
                            <span class="desc" data-bind="text: $data.Description"></span>
                            <!-- /ko -->
                            <span class="code" data-bind="html: $parent.quantityDisplay($data)"></span>
                            <span class="clearfix"></span>
                            <!-- ko if: $data.TrackingURL != null -->
                            <a class="break-all tracking-url" data-bind="attr: { href: $data.TrackingURL, target: '_blank' }">Delivery Tracking</a>
                            <!-- /ko -->
                            <!-- ko if: $data.OrderStatus -->
                            <span class="status" data-bind="text: $data.OrderStatus"></span>
                            <!-- /ko -->
                            <span class="clearfix"></span>
                        </li>
                        <!-- /ko -->
                    </ul>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->*@
</div>

<div class="row" data-bind="visible: pageCount() > 1">
    <div class="col-xs-12">
        <nav aria-label="Search Result Navigation">
            <div class="loading-busy search-results-busy" data-bind="visible: searchBusy()"></div>
            <ul class="pagination order-search-pagination pagination-sm"></ul>
        </nav>
    </div>
</div>
<!-- /ko -->

<script type="text/javascript">
    function getTradeAccountGroupId() {
        return @Html.Raw(Json.Encode(Model.TradeAccountGroupID))
    }
    function getTradeAccountId() {
        return @Html.Raw(Json.Encode(Model.TradeAccountID))
    }
    function getProductTypes() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.ProductTypes.OrderBy(p => p.Name)))
    }
    function getOrderStatusOptions() {
        return @Html.Raw(Json.Encode(Model.OrderStatusOptions))
    }
    function getPeriodOptions() {
        return @Html.Raw(Json.Encode(Model.PeriodOptions))
    }
</script>