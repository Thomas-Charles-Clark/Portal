@model Portal.ViewModels.ComponentModels.VisitSearchViewModel

<div class="row margin-top-20 margin-bottom-15" style="display: none" data-bind="visible: tradeAccountSelector().selected">
    <div class="col-xs-12">
        <div class="panel panel-primary">
            <div class="panel-heading no-padding non-search">
                <h4 class="panel-title">
                    <a class="panel-title panel-toggle collapse" data-toggle="collapse" data-target="#visit-search-collapse">
                        Search for Visits
                    </a>
                </h4>
            </div>
            <div id="visit-search-collapse" class="collapse in" data-bind="with: visitSearch">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <label for="product-code" class="col-form-label">Search for Visits</label>
                        </div>
                        <div class="col-xs-12">
                            <div class="selector">
                                <div class="input-group">
                                    <input id="visit-search" type="text" class="form-control" maxlength="100" data-bind="value: searchTerm, event: { keyup: onSearchKeyUp }" />
                                    <span class="input-group-addon">
                                        <button class="clear-btn btn btn-default @(Model.ButtonCssOverride)" type="button" data-bind="click: function() { clearSearch() }">&times;</button>
                                    </span>
                                    <span class="input-group-btn">
                                        <button class="search-btn btn btn-default @(Model.ButtonCssOverride)" data-bind="click: function() { performSearch() }"><span class="glyphicon glyphicon-search"></span></button>
                                    </span>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row margin-top-15">
                        <div class="col-xs-12">
                            <div class="row">
                                <div class="col-xs-12">
                                    <label class="col-form-label">Period</label>
                                </div>
                                <div class="col-xs-12">
                                    <select id="period" class="form-control" data-bind="value: period, options: periodOptions, optionsText: 'Name', optionsValue: 'Value', optionsCaption: 'Please select'"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row margin-top-15" style="display: none;" data-bind="visible: period() == 'custom'">
                        <div class="col-xs-6">
                            <div class="row">
                                <div class="col-xs-12">
                                    <label class="col-form-label">From:</label>
                                </div>
                                <div class="col-xs-12">
                                    <div class='input-group date'>
                                        <input type='text' class="date-input form-control" readonly="readonly" data-bind="dateTimePicker: fromDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true }" />
                                        <span class="input-group-btn">
                                            <button id="from-calendar-btn" class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </button>
                                        </span>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="col-xs-6">
                            <div class="row">
                                <div class="col-xs-12">
                                    <label class="col-form-label">To:</label>
                                </div>
                                <div class="col-xs-12">
                                    <div class='input-group date'>
                                        <input type='text' class="date-input form-control" readonly="readonly" data-bind="dateTimePicker: toDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true }" />
                                        <span class="input-group-btn">
                                            <button id="to-calendar-btn" class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row" data-bind="with: visitSearch">
    <div class="col-xs-12">
        <div style="position: relative">
            <div id="grid-loading" class="panel-busy-wrapper" style="border-radius: 4px;">
                <div class="form-busy">
                    <div class="busy-bars">
                        <div class="rect1 alert alert-info"></div>
                        <div class="rect2 alert alert-info"></div>
                        <div class="rect3 alert alert-info"></div>
                        <div class="rect4 alert alert-info"></div>
                        <div class="rect5 alert alert-info"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div id="visit-search-grid" data-bind="kendoGrid: resultGridSettings"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/kendo-x-tmpl" id="visit-search-result-template">
    <!-- ko with: visitSearch -->
    <!-- ko with: getRow('#= uid #') -->
    <div class="panel panel-default margin-bottom-0">
        <div class="panel-heading grey-blue no-padding">
            <h4 class="panel-title">
                <a class="panel-title panel-edit" href="javascript:;" data-bind="click: function() { $root.visitBooker().loadVisitForEdit($data._raw()); }">
                    <span data-bind="text: renderFullDate($data.VisitDT)"></span>
                </a>
            </h4>
        </div>
        <div class="panel-body">
            <div style="float: right;" class="text-right">
                <button class="btn btn-secondary-blue" data-bind="click: function() { $root.visitBooker().loadVisitForEdit($data._raw()); }">
                    Edit
                </button>
            </div>
            <p data-bind="html: Notes"></p>
            <!-- ko foreach: Attendees -->
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-default @(Model.ButtonCssOverride) dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span data-bind="text: FullName"></span>
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu">
                    <li><a href="javascript:;">Action</a></li>
                    <li><a href="javascript:;">Another action</a></li>
                    <li><a href="javascript:;">Something else here</a></li>
                    <li role="separator" class="divider"></li>
                    <li><a href="javascript:;">Separated link</a></li>
                </ul>
            </div>
            <!-- /ko -->
            <div class="clearfix"></div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->
</script>

<script type="text/javascript">
    function getTradeAccountId() {
        return @Html.Raw(Json.Encode(Model.TradeAccountID))
    }
    function getPeriodOptions() {
        return @Html.Raw(Json.Encode(Model.PeriodOptions))
    }
</script>
