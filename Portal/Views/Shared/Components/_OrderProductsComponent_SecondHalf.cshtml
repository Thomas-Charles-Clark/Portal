@model Portal.ViewModels.ComponentModels.OrderProductsViewModel
<div id="service-details-modal" class="modal fade" data-bind="with: orderFactory.dispatchFactory">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @*<div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Delivery Service Details
                </h4>
            </div>*@
            <div class="blocker" data-bind="visible: busy">
                <div class="loading-spinner"></div>
            </div>
            <div class="modal-body" data-bind="with: selectedService">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="blue-heading text-center">
                    Basket Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Basket Split ID:
                        </label>
                        <label>
                            Parent Basket Split ID:
                        </label>
                        <label>
                            Basket Split Name:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${BasketSplitID}`"></span>
                        <span data-bind="text: `${ParentBasketSplitID}`"></span>
                        <span data-bind="text: `${BasketSplitName}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Trade Account Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Trade Account ID:
                        </label>
                        <label>
                            Trade Account Group ID:
                        </label>
                        <label>
                            Charge Trade Account ID:
                        </label>
                        <label>
                            Charge Trade Account Group ID:
                        </label>
                        <label>
                            Is Furniture Order:
                        </label>
                        <label>
                            Is Treatment Order:
                        </label>
                        <label>
                            Order Context:
                        </label>
                        <label>
                            Order Level:
                        </label>
                        <label>
                            Sales Market ID:
                        </label>
                        <label>
                            Mertex Currency Code:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${TradeAccountID}`"></span>
                        <span data-bind="text: `${TradeAccountGroupID}`"></span>
                        <span data-bind="text: `${ChargeTradeAccountID}`"></span>
                        <span data-bind="text: `${ChargeTradeAccountGroupID}`"></span>
                        <span data-bind="text: `${IsFurnitureOrder}`"></span>
                        <span data-bind="text: `${IsTreatmentOrder}`"></span>
                        <span data-bind="text: `${OrderContext}`"></span>
                        <span data-bind="text: `${OrderLevel}`"></span>
                        <span data-bind="text: `${SalesMarketID}`"></span>
                        <span data-bind="text: `${MertexCurrencyCode}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Service Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Haulier Code Group:
                        </label>
                        <label>
                            Haulier:
                        </label>
                        <label>
                            Service:
                        </label>
                        <label>
                            Delivery Type:
                        </label>
                        <label>
                            Delivery Terms:
                        </label>
                        <label>
                            Transport Billed To:
                        </label>
                        <label>
                            Duty &amp; Tax Billed To:
                        </label>
                        <label>
                            Preference:
                        </label>
                        <label>
                            Haulier Sort Order:
                        </label>
                        <label>
                            Data Origin:
                        </label>
                        <label>
                            Haulier Service Code: 
                        </label>
                        <label>
                            Express Service:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${HaulierCodeGroup}`"></span>
                        <span data-bind="text: `${HaulierName} (${HaulierCode})`"></span>
                        <span data-bind="text: `${ServiceName} (${ServiceCode})`"></span>
                        <span data-bind="text: `${DeliveryType}`"></span>
                        <span data-bind="text: `${DeliveryTerms}`"></span>
                        <span data-bind="text: `${TransportBilledToName} ${TransportBilledToCode ? TransportBilledToCode : ''}`"></span>
                        <span data-bind="text: `${DutyTaxBilledToName} ${DutyTaxBilledToCode ? DutyTaxBilledToCode : ''}`"></span>
                        <span data-bind="text: `${Preference}`"></span>
                        <span data-bind="text: `${HaulierSortOrder}`"></span>
                        <span data-bind="text: `${ServiceDataOrigin} (${ServiceDataOriginID})`"></span>
                        <span data-bind="text: `${HaulierServiceCode}`"></span>
                        <span data-bind="text: `${ExpressService}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Parcel Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Parcel Weight:
                        </label>
                        <label>
                            Parcel Width:
                        </label>
                        <label>
                            Parcel Length:
                        </label>
                        <label>
                            Parcel Height:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${ParcelWeight != null ? ParcelWeight + ' KG' : 'Unknown'}`"></span>
                        <span data-bind="text: `${ParcelWidthCM != null ? ParcelWidthCM + ' CM' : 'Unknown'}`"></span>
                        <span data-bind="text: `${ParcelLengthCM != null ? ParcelLengthCM + ' CM' : 'Unknown'}`"></span>
                        <span data-bind="text: `${ParcelHeightCM != null ? ParcelHeightCM + ' CM' : 'Unknown'}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Charge Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Unit Delivery Charge:
                        </label>
                        <label>
                            Delivery Charging Logic:
                        </label>
                        <label>
                            Unit Delivery Surcharge:
                        </label>
                        <label>
                            Surcharge Delivery Charging Logic:
                        </label>
                        <label>
                            Unit Delivery VAT:
                        </label>
                        <label>
                            Total Delivery Charge:
                        </label>
                        <label>
                            Total Delivery VAT:
                        </label>
                        <label>
                            Final Delivery Charge:
                        </label>
                        <label>
                            Final Delivery VAT:
                        </label>
                        <label>
                            Final Delivery Charging Logic:
                        </label>
                    </div>
                    <div> 
                        <span data-bind="text: `${UnitDeliveryChargeEx != null ? formatCurrency(UnitDeliveryChargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${DeliveryChargingLogicName} (${DeliveryChargingLogicID})`"></span>
                        <span data-bind="text: `${UnitDeliverySurchargeEx != null ? formatCurrency(UnitDeliverySurchargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${SurchargeDeliveryChargingLogicName} (${SurchargeDeliveryChargingLogicID})`"></span>
                        <span data-bind="text: `${UnitDeliveryVAT != null ? formatCurrency(UnitDeliveryVAT, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) : 'Unknown'}`"></span>
                        <span data-bind="text: `${TotalDeliveryChargeEx != null ? formatCurrency(TotalDeliveryChargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${TotalDeliveryVAT != null ? formatCurrency(TotalDeliveryVAT, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) : 'Unknown'}`"></span>
                        <span data-bind="text: `${FinalDeliveryChargeEx != null ? formatCurrency(FinalDeliveryChargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${FinalDeliveryVAT != null ? formatCurrency(FinalDeliveryVAT, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) : 'Unknown'}`"></span>
                        <span data-bind="text: `${FinalDeliveryChargingLogicName} (${FinalDeliveryChargingLogicID})`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Charge Calculation Components
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Pricelist Unit Charge:
                        </label>
                        <label>
                            Pricelist Proportional Charge:
                        </label>
                        <label>
                            Contract Charge:
                        </label>
                        <label>
                            Operator Entered Charge:
                        </label>
                        <label>
                            Operator Entered Charging Logic:
                        </label>
                        <label>
                            Courier Cost:
                        </label>
                        <label>
                            Markup:
                        </label>
                        <label>
                            Delivery Surcharge:
                        </label>
                        @*<label>
                            Delivery Details JSON:
                        </label>*@
                        <label>
                            Source Currency:
                        </label>
                        <label>
                            Target Currency:
                        </label>
                        <label>
                            Quote:
                        </label>
                        <label>
                            Calculate Total Delivery Charge:
                        </label>
                        <label>
                            Payment Terms ID:
                        </label>
                        <label>
                            Threshold:
                        </label>
                        <label>
                            Surcharge Threshold:
                        </label>
                        <label>
                            Estimated Parcel Count:
                        </label>
                        <label>
                            Avg. Parcel Weight KG:
                        </label>
                        <label>
                            Calculated Avg. Parcel Weight KG:
                        </label>
                        <label>
                            Avg. Pallet Weight KG:
                        </label>
                        <label>
                            Estimated Pallet Count:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${PricelistUnitChargeEx != null ? formatCurrency(PricelistUnitChargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${PricelistProportionalCharge != null ? formatCurrency(PricelistProportionalCharge, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${ContractChargeEx != null ? formatCurrency(ContractChargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${OperatorEnteredChargeEx != null ? formatCurrency(OperatorEnteredChargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${OperatorEnteredChargingLogicID}`"></span>
                        <span data-bind="text: `${CourierCostEx != null ? formatCurrency(CourierCostEx, 2, 'en-GB', 'GBP') + ' Ex. VAT (includes fuel but excludes surcharges)' : 'Unknown (includes fuel but excludes surcharges)'}`"></span>
                        <span data-bind="text: `${CourierMarkupPercentage != null ? CourierMarkupPercentage + '%' : 'Unknown'}`"></span>
                        <span data-bind="text: `${CourierSurchargeEx != null ? formatCurrency(CourierSurchargeEx, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) : 'Unknown'}`"></span>
                        @*<span data-bind="html: '<pre><code>' + JSON.stringify(DeliveryDetailsJSON, null, ' ') + '</pre></code>'"></span>*@
                        <span data-bind="text: `CurrencyID: ${SourceCurrencyID} (${SourceCurrencyCode}) (GBP to ${SourceCurrencyCode} FX:${GBPtoSourceCurrencyFX.toFixed(4)})`"></span>
                        <span data-bind="text: `CurrencyID: ${TargetCurrencyID} (${TargetCurrencyCode}) (GBP to ${TargetCurrencyCode} FX:${GBPtoTargetCurrencyFX.toFixed(4)})`"></span>
                        <span data-bind="text: `${Quote ? 'Yes' : 'No'}`"></span>
                        <span data-bind="text: `${CalculateTotalDeliveryCharge ? 'Yes' : 'No'}`"></span>
                        <span data-bind="text: `${PaymentTermsID}`"></span>
                        <span data-bind="text: `${Threshold}`"></span>
                        <span data-bind="text: `${SurchargeThreshold}`"></span>
                        <span data-bind="text: `${EstimatedParcelCount}`"></span>
                        <span data-bind="text: `${AvgParcelWeightKG} KG`"></span>
                        <span data-bind="text: `${CalculatedAvgParcelWeightKG} KG`"></span>
                        <span data-bind="text: `${AvgPalletWeightKG} KG`"></span>
                        <span data-bind="text: `${EstimatedPalletCount}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Order Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Order Data Origin:
                        </label>
                        <label>
                            Order Total:
                        </label>
                        <label>
                            Order Weight:
                        </label>
                        <label>
                            Order Quantity:
                        </label>
                        <label>
                            Order Discount Percentage:
                        </label>
                        <label>
                            Delivery Group:
                        </label>
                        <label>
                            Fulfilment Type ID:
                        </label>
                        <label>
                            Item Count
                        </label>
                        <label>
                            Seat Count
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${OrderDataOrigin})`"></span>
                        <span data-bind="text: `${OrderTotal != null ? formatCurrency(OrderTotal, 2, $parent.parent.currency().FormattingCulture, $parent.parent.currency().ISO_4217) + ' Ex. VAT' : 'Unknown'}`"></span>
                        <span data-bind="text: `${OrderWeight != null ? OrderWeight + ' KG' : 'Unknown'}`"></span>
                        <span data-bind="text: `${OrderQuantity}`"></span>
                        <span data-bind="text: `${OrderDiscountPercentage != null ? OrderDiscountPercentage + '%' : 'Unknown'}`"></span>
                        <span data-bind="text: `${DeliveryGroupName} (${DeliveryGroupID})`"></span>
                        <span data-bind="text: `${FulfilmentTypeID}`"></span>
                        <span data-bind="text: `${ItemCount}`"></span>
                        <span data-bind="text: `${SeatCount}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Discount Details
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Operator Discount Percentage:
                        </label>
                        <label>
                            Discount Reason:
                        </label>
                        <label>
                            Trade Promotion Code ID:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${OperatorDiscountPercentage != null ? OperatorDiscountPercentage + '%' : 'Unknown'}`"></span>
                        <span data-bind="text: DiscountReasonID ? `${DiscountReasonComment} (${DiscountReasonID})` : 'No Discount'"></span>
                        <span data-bind="text: `${TradePromotionCodeID}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Estimates
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Delivery Estimate Min:
                        </label>
                        <label>
                            Delivery Estimate Max:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${DeliveryEstimateMin ? moment.utc(DeliveryEstimateMin).format('dddd Do MMM YY') : 'Unknown'}`"></span>
                        <span data-bind="text: `${DeliveryEstimateMax ? moment.utc(DeliveryEstimateMax).format('dddd Do MMM YY') : 'Unknown'}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Controls
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Allow Customer Haulier Account for Transport:
                        </label>
                        <label>
                            Allow Customer Haulier Account for Duty &amp; Tax:
                        </label>
                        <label>
                            Offer Consolidated Shipment:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${AllowCustomerHaulierAccountForTransportCharges}`"></span>
                        <span data-bind="text: `${AllowCustomerHaulierAccountForDutyAndTax}`"></span>
                        <span data-bind="text: `${OfferConsolidatedShipment}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    VAT Parameters
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            Origin Country:
                        </label>
                        <label>
                            Destination Country:
                        </label>
                        <label>
                            Destination in EU:
                        </label>
                        <label>
                            EU Exit Code:
                        </label>
                        <label>
                            VAT Number:
                        </label>
                        <label>
                            VAT Code:
                        </label>
                        <label>
                            VAT Rate:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${OriginCountryName} (${OriginCountryID})`"></span>
                        <span data-bind="text: `${DestinationCountryName} (${DestinationCountryID})`"></span>
                        <span data-bind="text: `${DestinationInEU}`"></span>
                        <span data-bind="text: `${EUExitCode}`"></span>
                        <span data-bind="text: `${VATNumber}`"></span>
                        <span data-bind="text: `${VATCode}`"></span>
                        <span data-bind="text: `${VATRate}`"></span>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Location Details: Origin
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            From:
                        </label>
                        <label>
                            Origin Stock Location ID:
                        </label>
                        <label>
                            Origin Stock Location Site ID:
                        </label>
                        @*<label>
                            Supplier Address Details:
                        </label>*@
                    </div>
                    <div>
                        <span data-bind="text: `${From}`"></span>
                        <span data-bind="text: `${OriginStockLocationID}`"></span>
                        <span data-bind="text: `${OriginStockLocationSiteID}`"></span>
                        @*<!-- ko if: SupplierCompanyName -->
                        <div>
                            <span class="address-block-span" data-bind="text: `${SupplierCompanyName}`"></span>
                            <span class="address-block-span" data-bind="text: `${SupplierAddressLine1}`"></span>
                            <span class="address-block-span" data-bind="text: `${SupplierAddressLine2}`"></span>
                            <span class="address-block-span" data-bind="text: `${SupplierTown}`"></span>
                            <span class="address-block-span" data-bind="text: `${SupplierCounty}`"></span>
                            <span class="address-block-span" data-bind="text: `${SupplierPostcode}`"></span>
                            <span class="address-block-span" data-bind="text: `${SupplierCountryCode} (CountryID: ${SupplierCountryID})`"></span>
                        </div>
                        <!-- /ko -->
                        <!-- ko ifnot: SupplierCompanyName -->
                        <span data-bind="text: `Unknown`"></span>
                        <!-- /ko -->*@
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Location Details: Destination
                </h4>
                <hr/>
                <div class="flex-container">
                    <div>
                        <label>
                            To:
                        </label>
                        <label>
                            Destination Stock Location ID:
                        </label>
                        <label>
                            Destination Stock Location Site ID:
                        </label>
                        <label>
                            Delivery Address Details:
                        </label>
                    </div>
                    <div>
                        <span data-bind="text: `${From}`"></span>
                        <span data-bind="text: `${DestinationStockLocationID}`"></span>
                        <span data-bind="text: `${DestinationStockLocationSiteID}`"></span>
                        <div class="address-block">
                            <span class="address-block-span" data-bind="text: `${DeliveryName}`"></span>
                            <span class="address-block-span" data-bind="text: `${DeliveryCompanyName}`"></span>
                            <span class="address-block-span" data-bind="text: `${DeliveryAddressLine1}`"></span>
                            <!-- ko if: DeliveryAddressLine2 -->
                            <span class="address-block-span" data-bind="text: `${DeliveryAddressLine2}`"></span>
                            <!-- /ko -->
                            <!-- ko if: DeliveryTown -->
                            <span class="address-block-span" data-bind="text: `${DeliveryTown}`"></span>
                            <!-- /ko -->
                            <!-- ko if: DeliveryCounty -->
                            <span class="address-block-span" data-bind="text: `${DeliveryCounty}`"></span>
                            <!-- /ko -->
                            <span class="address-block-span" data-bind="text: `${DeliveryPostcode}`"></span>
                            <span class="address-block-span" data-bind="text: `${DeliveryCountryCode} (CountryID: ${DeliveryCountryID})`"></span>
                            <!-- ko if: DeliveryPhoneNumber -->
                            <span class="address-block-span" data-bind="text: `${DeliveryPhoneNumber}`"></span>
                            <!-- /ko -->
                            <span class="address-block-span" data-bind="text: `${DeliveryZoneName} (DeliveryZoneID: ${DeliveryZoneID})`"></span>
                        </div>
                    </div>
                </div>
                <h4 class="blue-heading text-center">
                    Customer's Saved Haulier Account Details
                </h4>
                <hr/>
                <div class="flex-container flex-container-column">
                    <div>
                        <h5 class="blue-heading bold">
                            Haulier
                        </h5>
                        <div data-bind="foreach: $parent.customerAccountNumbers.sort(function (a, b) { return a.HaulierCode === b.HaulierCode ? 0 : a.HaulierCode < b.HaulierCode ? -1 : 1 })">
                            <span data-bind="text: HaulierCode"></span>
                        </div>
                    </div>
                    <div>
                        <h5 class="blue-heading bold">
                            Transport
                        </h5>
                        <div data-bind="foreach: $parent.customerAccountNumbers.sort(function (a, b) { return a.HaulierCode === b.HaulierCode ? 0 : a.HaulierCode < b.HaulierCode ? -1 : 1 })">
                            <span data-bind="text: HaulierTransportAccountCode"></span>
                        </div>
                    </div>
                    <div>
                        <h5 class="blue-heading bold">
                            Taxes &amp; Duty
                        </h5>
                        <div data-bind="foreach: $parent.customerAccountNumbers.sort(function (a, b) { return a.HaulierCode === b.HaulierCode ? 0 : a.HaulierCode < b.HaulierCode ? -1 : 1 })">
                            <span data-bind="text: HaulierDutyTaxAccountCode"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="order-products-drilldown-modal" class="modal fade" data-bind="with: orderFactory">
    <div class="modal-dialog modal-lg modal-xl modal-full" data-bind="with: drilldownData">
        <div class="modal-content">
            <div class="blocker" data-bind="visible: $parent.parent.orderProductsDrilldown.busy">
                <div class="loading-spinner"></div>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-dismiss="modal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <!-- ko if: $data.hasOwnProperty('productPage') -->
                <h4 class="modal-title" data-bind="text: productPage.ProductPageName"></h4>
                <!-- /ko -->
                <!-- ko ifnot: $data.hasOwnProperty('productPage') -->
                <h4 class="modal-title" data-bind="text: record.OrderFormName"></h4>
                <!-- /ko -->
            </div>
            <div class="modal-body">
                <div id="order-products-drilldown-leading">
                    @*<div class="blocker" data-bind="visible: $parent.parent.orderProductsDrilldown.carouselBusy">
                            <div class="loading-spinner"></div>
                        </div>*@
                    <div class="owl-carousel owl-theme" data-bind="keepElement: $parent.parent.orderProductsDrilldown.productPageImages">
                        <div class="order-products-carousel" data-bind="foreach: $parent.parent.orderProductsDrilldown.productPageImages">
                            <img class="pointer" data-bind="click: function (data) { $parentContext.$parent.parent.orderProductsDrilldown.loadLargeImage($data, $parentContext.$parent.preferredEmail); }, attr: { src: 'https://www.designersguild.com/image/428/' + $data.ImageID, title: $data.TitleText, alt: $data.AltText }" />
                        </div>
                    </div>
                </div>
                <!-- ko if: productPage.ProductPageDescription-->
                <p id="order-products-drilldown-description">
                    <span data-bind="html: productPage.ProductPageDescription"></span>
                </p>
                <!-- /ko -->
                <div id="order-products-drilldown">
