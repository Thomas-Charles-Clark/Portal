<div id="saved-basket-reason-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div id="saved-basket-reason-modal-inner" class="modal-dialog">
        <div class="modal-content">
            <div class="blocker" data-bind="fadeVisible: busy">
                <div class="loading-spinner"></div>
                <h3 data-bind="text: busyMessage"></h3>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-dismiss="modal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    What would you like to do with your basket?
                </h4>
            </div>
            <div class="modal-body">
                <h4>
                    Save for later
                </h4>
                <p class="margin-bottom-30">
                    Save this order to your "My Saved Orders" list. You will be able to return to this basket and finish processing it later. Please give a reason for
                    saving the basket, this will help you find it again later.
                </p>
                <div data-bind="component: { name: 'mdc-select-component', params: savedBasketReasons }"></div>
                <button class="btn btn-default margin-top-15" data-bind="click: function () { saveAndCloseBasket() }">
                    Save Basket
                </button>
                <!-- ko with: basketServerObject -->
                <!-- ko if: Imported -->
                <h4 class="margin-top-45">
                    Relinquish Basket
                </h4>
                <p>
                    Relinquishing the basket will return it to the "Web Orders to Release" list, available for you or someone else to process it later.
                </p>
                <button class="btn btn-default" data-bind="click: function () { $parent.saveAndRelinquishBasket() }">
                    Relinquish Basket
                </button>
                <!-- /ko -->
                <!-- /ko -->
                <h4 class="margin-top-45">
                    Delete Basket
                </h4>
                <p class="alert alert-danger">
                    <span class="bold">WARNING!</span> This will <span class="bold">permanently delete</span> the basket, all its contents
                    and release all associated stock allocations. Once a basket is deleted it will <span class="bold">not be available</span> for you 
                    or anyone else to process later.
                </p>
                <button class="btn btn-default" data-bind="click: function() { saveAndCloseFunction = function () {
                            parent.tradeAccountSelector.clearSearch();
                            hideSavedBasketReasonModal();
                            parent.memberBasketFetcher.resultGridWidget().dataSource.read();
                            busy(false);
                            busyMessage(undefined);
                            $('#order-products-modal').modal('hide');
                        }; deleteBasket(basketId(), true, saveAndCloseFunction); }">
                    Delete Basket
                </button>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-dismiss="modal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<div id="quantity-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div id="quantity-modal-inner" class="modal-dialog modal-sm">
        <div class="modal-content" data-bind="with: searchResultRequestingQuantity">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    How many are required?
                </h4>
            </div>
            <div class="modal-body">
                <div class="quantity-control input-group pull-right" style="margin-bottom: 0; margin-left: 15px;">
                    <div class="input-group-btn">
                        <button class="btn btn-default" data-bind="click: function (data) { if (quantity() > productFilterOptions().QuantityMinimum) { quantity(+quantity() - productFilterOptions().QuantityIncrement); } }">
                            &minus;
                        </button>
                    </div>
                    <input type="number" step="1" min="0" class="form-control" data-bind="keepElement: quantity, numeric, forceZeroOnEmpty: quantity, value: quantity, hasfocus: quantityHasFocus, attr: { min: productFilterOptions().QuantityMinimum, step: productFilterOptions().QuantityIncrement }" />
                    <span class="input-group-btn">
                        <button class="btn btn-default" data-bind="click: function(data) { quantity(+quantity() + productFilterOptions().QuantityIncrement); }">
                            +
                        </button>
                    </span>
                </div>
                <p style="line-height: 34px; margin-bottom: 0; text-align: right;">
                    Quantity:
                </p>
                <div class="clearfix"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: function() { closeRequestingQuantity() }">
                    Cancel
                </button>
                <button class="btn btn-green" data-bind="click: function () { progressFromRequestingQuantity() }">
                    Order
                </button>
            </div>
        </div>
    </div>
</div>

<div id="purchase-order-line-number-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
