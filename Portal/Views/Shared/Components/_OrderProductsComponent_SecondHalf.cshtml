<div id="add-all-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div id="add-all-modal-inner" class="modal-dialog">
        <div class="modal-content" data-bind="with: addAll">
            <div class="modal-header grey-blue">
                <div class="blocker" data-bind="fadeVisible: busy">
                </div>
                <button type="button" class="close" aria-label="Close" data-bind="click: hide">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Add All
                    <span data-bind="text: searchResultCount"></span>
                    Search Results to Basket
                </h4>
            </div>
            <div class="modal-body" data-bind="with: searchResult">
                <div class="blocker" data-bind="fadeVisible: $parent.busy">
                </div>
                <div class="fulfilment-container add-all-phase" data-bind="fadeBetweenMany: { observable: $parent.displayPercentage, visibleWhen: false, swapWith: '.add-all-phase' }">
                    <div>
                        <div>
                            <span>
                                Quantity of Each
                            </span>
                            <div class="quantity-control input-group" style="margin-bottom: 15px;">
                                <div class="input-group-btn">
                                    <button class="btn btn-default" data-bind="click: function (data) { if (quantity() > 0) { quantity(+quantity() - 1); } }">
                                        &minus;
                                    </button>
                                </div>
                                <input type="number" step="1" min="0" class="form-control" data-bind="keepElement: quantity, numeric, forceZeroOnEmpty: quantity, value: quantity, hasfocus: quantityHasFocus, attr: { step: productFilterOptions().QuantityPrecision }" />
                                <span class="input-group-btn">
                                    <button class="btn btn-default" data-bind="click: function(data) { quantity(+quantity() + 1); }">
                                        +
                                    </button>
                                </span>
                            </div>
                        </div>
                        <!-- ko if: fetchFulfilmentOptions() --><!-- /ko -->
                        <div class="form-group">
                            <select class="form-control fulfilment-option" data-bind="value: fulfilmentOption, options: availableFulfilmentOptions, optionsText: 'FulfilmentType'"></select>
                            <span class="smaller" data-bind="with: fulfilmentOption">
                                From: <span data-bind="text: StockLocation"></span>
                            </span>
                        </div>
                    </div>
                    <div>
                        <div class="line-reference" data-bind="component: { name: 'mdc-text-field-component', params: lineReference }"></div>
                        <div class="date-required" data-bind="component: { name: 'mdc-date-time-picker-component', params: dateRequired }"></div>
                    </div>
                    <div class="margin-top-30">
                        <div class="discounter-vertical" data-bind="component: { name: 'mdc-discounter-component', params: $parent.discounter }"></div>
                    </div>
                </div>
                <div class="add-all-phase" data-bind="fadeBetweenMany: { observable: $parent.displayPercentage, visibleWhen: true, swapWith: '.add-all-phase' }">
                    <div class="add-all-progress">
                        <div data-bind="kendoProgressBar: $parent.progressBarParams"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="blocker" data-bind="fadeVisible: busy">
                    <div class="loading-spinner"></div>
                </div>
                <!-- ko if: !displayPercentage() -->
                <button class="btn btn-default pull-left" data-bind="click: hide">
                    Cancel
                </button>
                <button class="btn btn-green pull-right" data-bind="click: addAll">
                    Add to Basket
                </button>
                <!-- /ko -->
                <!-- ko if: displayPercentage() -->
                <button class="btn btn-blue pull-right" data-bind="click: hide">
                    Finished
                </button>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>

