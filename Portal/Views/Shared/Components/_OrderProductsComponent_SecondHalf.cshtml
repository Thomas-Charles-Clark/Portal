<script id="processing-progression" type="text/html">
    <div data-bind="with: stageInformation">
        <div class="product-progression-wrapper" style="margin-bottom: 5px;">
            <!-- ko foreach: stages -->
            <div class="pointer" data-bind="css: { 'blue': $parent.currentStage().StepID == $data.StepID, 'light-blue': $parent.currentStage().StepID < $data.StepID, 'complete': $parent.currentStage().StepID > $data.StepID }">
                <span data-bind="text: Name"></span>
                <div class="arrow-r"></div>
            </div>
            <!-- /ko -->
        </div>
    </div>
    <div class="progression-controls-wrapper" data-bind="with: addingProductToBasket">
        <div class="form-group" data-bind="with: record">
            <img class="thumb" data-bind="attr: { src: 'https://www.designersguild.com/image/156/' + ImageID, title: Code }" />
            <div class="product-details">
                <span class="bold product-name">
                    <span data-bind="text: OrderFormName + (Size ? ' - ' + Size : '')"></span>
                </span>
                <span class="code-price">
                    <span class="product-code" data-bind="text: Code"></span>
                </span>
                <span class="code-price">
                    Quantity:
                    <span class="product-code" data-bind="text: $parent.quantity()"></span>
                    <span data-bind="text: Units"></span>
                    <!-- ko if: $parent.orderTypeId == 3 -->
                    <span class="margin-left-15">
                        Reserve
                    </span>
                    <!-- ko if: $parent.parent.parent.orderProductsDrilldown.reserveBatchCuttingIndicator() -->
                    <span>
                        with batch cutting
                    </span>
                    <!-- /ko -->
                    <!-- ko ifnot: $parent.parent.parent.orderProductsDrilldown.reserveBatchCuttingIndicator() -->
                    <span>
                        without batch cutting
                    </span>
                    <!-- /ko -->
                    <!-- /ko -->
                </span>
            </div>
        </div>
        <div class="product-progression-nav-btns">
            <div class="btn-group-justified">
                <!-- ko if: typeof $parent.alt === 'undefined' -->
                <div class="btn-group">
                    <button class="btn btn-default" data-bind="click: $parent.cancelAddingProductToBasket, enable: !$parent.areAnyAllocationsBusy()">
                        Delete
                    </button>
                </div>
                <!-- /ko -->
                <!-- ko with: $parent -->
                <!-- ko if: minStageId() != currentStageId() -->
                <div class="btn-group">
                    <button class="btn btn-default" data-bind="click: function () { previousStage(true); }, enable: !areAnyAllocationsBusy() && !processingBusy()">
                        Back
                    </button>
                </div>
                <!-- /ko -->
                <!-- ko ifnot: maxStageId() == currentStageId() -->
                <div class="btn-group">
                    <button class="btn btn-default" data-bind="click: function () { nextStage(); }, enable: !areAnyAllocationsBusy() && !processingBusy()">
                        Next
                    </button>
                </div>
                <!-- /ko -->
                <!-- ko if: maxStageId() == currentStageId() -->
                <div class="btn-group">
                    <button class="btn btn-default" data-bind="click: closeProcessingModal, enable: !areAnyAllocationsBusy() && !processingBusy()">
                        Finished
                    </button>
                </div>
                <!-- /ko -->
                <!-- /ko -->
            </div>
        </div>
    </div>
</script>

