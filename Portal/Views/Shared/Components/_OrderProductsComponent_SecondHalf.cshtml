<div id="end-customer-or-parent-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Distributor Account Detected
                </h4>
            </div>
            <div class="modal-body" data-bind="with: tradeAccount">
                <p>
                    Trade Account <span data-bind="text: Label"></span> is a Distributor.
                </p>
                <p>
                    Would you like to deliver directly to <span data-bind="text: Name"></span>, or to one of their end customers?
                </p>
                <div class="flex-container" style="justify-content: space-between">
                    <button class="btn btn-default" data-bind="click: $parent.deliveryAddressFactory.deliveryToParent">
                        Deliver to <span data-bind="text: Name"></span>
                    </button>
                    <button class="btn btn-default" data-bind="click: $parent.deliveryAddressFactory.deliveryToEndCustomer">
                        Deliver to End Customer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="delivery-group-bulk-discounter-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div id="delivery-group-bulk-discounter-modal-inner" class="modal-dialog" data-bind="with: bulkDiscounter">
        <div class="modal-content">
            <div class="blocker" data-bind="fadeVisible: busy">
                <div class="loading-spinner"></div>
            </div>
            <div class="modal-header grey-blue">
                <div class="blocker" data-bind="fadeVisible: busy"></div>
                <button type="button" class="close" aria-label="Close" data-bind="click: hide">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Apply Bulk Discount to <span data-bind="text: bulkDiscountGroupName"></span>
                </h4>
            </div>
            <div class="modal-body">
                <!-- ko if: finished() -->
                    <div class="alert alert-success margin-bottom-0">
                        <h4 class="alert-title margin-bottom-0">
                            Done!
                        </h4>
                    </div>
                <!-- /ko -->
                <!-- ko ifnot: finished() -->
                    <!-- ko if: deniedBasketItems().length -->
                    <div class="alert alert-warning">
                        <!-- ko if: permittedBasketItems().length > 0 -->
                        <h4 class="alert-title">
                            Warning
                        </h4>
                        <p>
                            The following <span data-bind="text: deniedBasketItems().length == 1 ? 'product is' : 'products are'"></span>
                            not going to have this discount applied. Please check the reasons for each.
                        </p>
                        <!-- /ko -->
                        <!-- ko if: permittedBasketItems().length == 0 -->
                        <h4 class="alert-title">
                            Sorry
                        </h4>
                        <p>
                            None of the products in the group you selected are eligible for bulk discounting. Please check the reasons for each product beneath.
                        </p>
                        <!-- /ko -->
                        <ul class="margin-top-15">
                            <!-- ko foreach: deniedBasketItems -->
                            <li>
                                <label>
                                    <span data-bind="text: ProductName"></span>
                                    &times;
                                    <span data-bind="text: Quantity"></span>
                                </label>
                                <span class="margin-left-15" data-bind="text: '- ' + BulkDiscountDeniedReason"></span>
                            </li>
                            <!-- /ko -->
                        </ul>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: permittedBasketItems().length > 0 -->
                    <div class="discounter-vertical" data-bind="component: { name: 'mdc-discounter-component', params: discounter }"></div>
                    <!-- /ko -->
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <!-- ko ifnot: finished() -->
                <button class="btn btn-default pull-left" data-bind="click: hide">
                    Cancel
                </button>
                <!-- /ko -->
                <!-- ko if: permittedBasketItems().length > 0 -->
                <button class="btn btn-green pull-right" data-bind="click: apply">
                    Appy Discount to <span data-bind="text: permittedBasketItems().length"></span> product<span data-bind="text: permittedBasketItems().length == 1 ? '' : 's'"></span>
                </button>
                <!-- /ko -->
                <!-- ko if: finished() -->
                <button class="btn btn-blue pull-right" data-bind="click: hideRefresh">
                    Finished
                </button>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>