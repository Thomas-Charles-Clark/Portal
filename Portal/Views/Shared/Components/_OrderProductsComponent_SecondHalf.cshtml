                <button class="btn btn-green" data-bind="click: function () { progressFromRequestingPOLineNumber() }">
                    Order
                </button>
            </div>
        </div>
    </div>
</div>

<div id="supplier-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div id="supplier-modal-inner" class="modal-dialog">
        <div class="modal-content" data-bind="with: searchResultRequestingSupplier">
            <div class="blocker" data-bind="fadeVisible: supplierBusy">
                <div class="loading-spinner"></div>
                <h3>
                    Working...
