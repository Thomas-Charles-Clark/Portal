<div id="back-order-modal" class="modal fade" data-bind="with: currentlyActiveDrilldown">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="blocker" data-bind="visible: processingBusy">
                <div class="loading-spinner"></div>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-dismiss="modal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Back Order
                </h4>
            </div>
            <div class="modal-body">
                <!-- ko if: addingProductToBasket() -->
                <!-- ko if: ['C'].indexOf(addingProductToBasket().record.Status) > -1 -->
                <p>
                    Are you sure you want to Back Order this line?
                </p>
                <p class="note">
                    Back Ordering this line is telling the system that we do not have any suitable
                    stock to satisfy this demand and to wait until suitable stock arrives in the warehouse.
                </p>
                <p class="note">
                    This line will link to the next purchase order with sufficient stock to satisfy the demand. See purchase order breakdown below.
                </p>
                <button class="btn btn-green" data-bind="click: function() { skipAllocationAndBackOrder(false); }">
                    Continue and Back Order this line. This will delete any existing allocations.
                </button>
                <button class="btn btn-blue" data-dismiss="modal">
                    Return to the allocation screen and select appropriate stock.
                </button>
                <!-- ko if: name == 'main' -->
                <button class="btn btn-red" data-bind="click: cancelAddingProductToBasket">
                    Delete this order line.
                </button>
                <!-- /ko-->
                <!-- /ko-->

                <!-- ko if: ['L', 'Y'].indexOf(addingProductToBasket().record.Status) > -1 -->
                <p>
                    This is a Limited product.
                </p>
                <!-- ko if: Enumerable.From(addingProductAllocationStockData()).Where(function (x) { return x.stockLocation.stockLocationId == allocationStockLocation.observable() }).Select('+$.stockLocation.totalIncludingDue()').Sum() >= +addingProductToBasket().quantity() -->
                <p>
                    There appears to be sufficient stock to satisfy your customer's demand. A replenishment task will be raised if you back order this line. This 
                    will instruct the warehouse to move stock to a pickable location to satisfy your order.
                </p>
                <button class="btn btn-green" data-bind="click: function() { skipAllocationAndBackOrder(false); }">
                    Continue and Back Order this line. This will delete any existing allocations.
                </button>
                <button class="btn btn-blue" data-dismiss="modal">
                    Return to the allocation screen and select more appropriate stock.
                </button>
                <button class="btn btn-red" data-bind="click: cancelAddingProductToBasket">
                    Delete this order line.
                </button>
                <!-- /ko -->
                <!-- ko ifnot: Enumerable.From(addingProductAllocationStockData()).Where(function (x) { return x.stockLocation.stockLocationId == allocationStockLocation.observable() }).Select('+$.stockLocation.totalIncludingDue()').Sum() >= +addingProductToBasket().quantity() -->
                <p>
                    There is insufficient stock to satisfy your customer's demand, and no further purchase orders may be placed for this product.
                </p>
                <button class="btn btn-blue" data-dismiss="modal">
                    Return to the allocation screen and select appropriate stock.
                </button>
                <button class="btn btn-red" data-bind="click: cancelAddingProductToBasket">
                    Delete this order line.
                </button>
                <!-- /ko -->
                <!-- /ko -->

                <!-- ko if: ['C', 'Y', 'L'].indexOf(addingProductToBasket().record.Status) == -1 -->
                <p>
                    This is a discontinued / clearance product and cannot be back ordered.
                </p>
                <button class="btn btn-blue" data-dismiss="modal">
                    Return to the allocation screen and select appropriate stock.
                </button>
                <button class="btn btn-red" data-bind="click: cancelAddingProductToBasket">
                    Delete this order line.
                </button>
                <!-- /ko-->
                <!-- /ko-->
            </div>
        </div>
    </div>
</div>

