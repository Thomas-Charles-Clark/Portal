@model Portal.ViewModels.ComponentModels.TaskSearchViewModel
<!-- ko with: taskSearch -->
    <div class="panel panel-default">
        <div class="panel-heading no-padding">
            <h4 class="panel-title">
                <a class="panel-title panel-toggle" data-toggle="collapse" data-target="#task-search-collapse">Search for Tasks</a>
            </h4>
            <div class="clearfix"></div>
        </div>
        <div id="task-search-collapse" class="panel-collapse collapse in">
            <div class="selector panel-body">
                <div class="row">
                    <div class="col-xs-12">
                        <div class="selector">
                            <div class="input-group">
                                <input id="task-search" type="text" class="form-control" maxlength="100" data-bind="value: searchTerm, event: { keyup: onSearchKeyUp }" />
                                <span class="input-group-addon">
                                    <button class="clear-btn btn btn-default @(Model.ButtonCssOverride)" type="button" data-bind="click: function() { clearSearch() }">&times;</button>
                                </span>
                                <span class="input-group-btn">
                                    <button class="search-btn btn btn-default @(Model.ButtonCssOverride)" data-bind="click: function() { performSearch() }"><span class="glyphicon glyphicon-search"></span></button>
                                </span>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>

                <div class="row margin-top-30" data-bind="visible: (displayFilters() == false && searchBusy() == true)">
                    <div class="col-xs-12">
                        <div class="loading-busy"></div>
                    </div>
                </div>

                <div class="row margin-top-15">
                    <div class="col-xs-6">
                        <div class="row">
                            <div class="col-xs-12">
                                <label class="col-form-label">Task Status</label>
                            </div>
                            <div class="col-xs-12">
                                <select id="order-status" class="form-control" data-bind="value: taskSearchStatus, optionsText: 'Name', optionsValue: 'Value', options: taskSearchStatusOptions"></select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="row">
                            <div class="col-xs-12">
                                <label class="col-form-label">Period</label>
                            </div>
                            <div class="col-xs-12">
                                <select id="period" class="form-control" data-bind="value: period, options: periodOptions, optionsText: 'Name', optionsValue: 'Value', optionsCaption: 'Please select'"></select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row margin-top-15" style="display: none;" data-bind="visible: period() == 'custom'">
                    <div class="col-xs-6">
                        <div class="row">
                            <div class="col-xs-12">
                                <label class="col-form-label">From:</label>
                            </div>
                            <div class="col-xs-12">
                                <div class='input-group date'>
                                    <input type='text' class="date-input form-control" readonly="readonly" data-bind="dateTimePicker: fromDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true }" />
                                    <span class="input-group-btn">
                                        <button id="from-calendar-btn" class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </button>
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="row">
                            <div class="col-xs-12">
                                <label class="col-form-label">To:</label>
                            </div>
                            <div class="col-xs-12">
                                <div class='input-group date'>
                                    <input type='text' class="date-input form-control" readonly="readonly" data-bind="dateTimePicker: toDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true }" />
                                    <span class="input-group-btn">
                                        <button id="to-calendar-btn" class="calendar-btn btn btn-default @(Model.ButtonCssOverride)">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row margin-top-30" data-bind="visible: (displayFilters() == false && searchBusy() == true)">
        <div class="col-xs-12">
            <div class="loading-busy"></div>
        </div>
    </div>

    <div class="row margin-top-15 margin-bottom-15">
        <div class="pager-info col-xs-12">
            <label class="search-result-count-label" data-bind="visible: haveSearched, text: searchResultsTotalCount() + ' result' + (searchResultsTotalCount() == 1 ? '' : 's')"></label>
            <label id="task-search-page-count" class="page-count-label" data-bind="visible: pageCount() > 1, text: pageCount() + ' page' + (pageCount() > 1 ? 's' : '')"></label>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <nav aria-label="Search Result Navigation" data-bind="visible: pageCount() > 1">
                <ul class="pagination task-search-pagination pagination-sm"></ul>
                <div class="loading-busy search-results-busy" data-bind="visible: searchBusy()"></div>
            </nav>
        </div>
    </div>

    <div class="row" style="display: none;" data-bind="visible: true">
        <!-- ko foreach: searchResults -->
        <div class="col-xs-12">
            <div class="order-result card">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 data-bind="">Task</h4>
                        <span data-bind="">Some Date</span>
                    </div>
                    <div class="panel-body">
                        <p>
                            Do something!
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <div class="row" data-bind="visible: pageCount() > 1">
        <div class="col-xs-12">
            <nav aria-label="Search Result Navigation">
                <div class="loading-busy search-results-busy" data-bind="visible: searchBusy()"></div>
                <ul class="pagination task-search-pagination pagination-sm"></ul>
            </nav>
        </div>
    </div>
<!-- /ko -->

<script type="text/javascript">
    function getTradeAccountGroupId() {
        return @Html.Raw(Json.Encode(Model.TradeAccountGroupID))
    }
    function getTradeAccountId() {
        return @Html.Raw(Json.Encode(Model.TradeAccountID))
    }
    function getPeriodOptions() {
        return @Html.Raw(Json.Encode(Model.PeriodOptions))
    }
    function getTaskSearchStatusOptions() {
        return @Html.Raw(Json.Encode(Model.TaskStatusOptions))
    }
</script>