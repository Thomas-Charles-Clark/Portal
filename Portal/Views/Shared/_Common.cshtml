<script type="text/html" id="stock-info-template">
	<div class="stock-info">
		<div>
			<table class="drilldown-stock-table">
				<colgroup>
					<!-- ko if: typeof showThumb == 'undefined' || showThumb == true -->
					<col style="width: 300px" />
					<!-- /ko -->
					<col />
				</colgroup>
				<tbody>
					<tr>
						<!-- ko if: typeof showThumb == 'undefined' || showThumb == true -->
						<td>
							<div id="product-name">
								<!-- ko if: record.ImageID != null -->
								<!-- ko if: $root.hasOwnProperty('orderProductsDrilldown') -->
								<img class="thumb" data-bind="click: function(data) { $root.orderProductsDrilldown.loadLargeImage(record, $parentContext.$parent.preferredEmail); }, attr: { src: 'https://www.designersguild.com/image/156/' + record.ImageID, title: record.Code }" />
								<!-- /ko -->
								<!-- /ko -->
								<div class="product-details">
									<span>
										<span data-bind="text: record.OrderFormName + (record.Size ? ' - ' + record.Size : '')"></span>
										<span data-bind="text: record.Code"></span>
									</span>
									<span data-bind="html: '(Unit of Stock: ' + record.Units + ')'"></span>
								</div>
								<div class="clearfix"></div>
							</div>
						</td>
						<!-- /ko -->
						<td>
							<!-- ko if: record.WideWidthFabricDefaultPoleWidth != null -->
							<div class="alert alert-warning">
								<span>
									This is a wide width fabric,
									<!-- ko if: record.WideWidthFabricDefaultPoleWidth == 'W' -->
									stocked on a wide width pole.
									<!-- /ko -->
									<!-- ko if: record.WideWidthFabricDefaultPoleWidth == 'S' -->
									stocked on a standard width pole.
									<!-- /ko -->
								</span>
							</div>
							<!-- /ko -->
							<!-- ko if: typeof supplierAvailabilityMessage != 'undefined' && supplierAvailabilityMessage() -->
							<div class="alert alert-warning">
								<div data-bind="html: supplierAvailabilityMessage"></div>
							</div>
							<!-- /ko -->
							<!-- ko if: typeof showStockCheckRequester != 'undefined' && showStockCheckRequester() -->
							<!-- ko with: $root.orderProductsDrilldown.stockCheckRequester -->
							<div class="alert" data-bind="class: cssClass">
								<div data-bind="html: message"></div>
								<button class="btn btn-blue request-stock-check-btn" data-bind="enable: allowStockCheckRequest, click: parent.beginStockCheckRequest">
									Request Stock Check
								</button>
							</div>
							<!-- /ko -->
							<!-- /ko -->
							<!-- ko if: typeof stockInfo != 'undefined' && stockInfo() -->
							<table class="stock-allocation-table allocation-table table table-condensed" data-bind="with: stockInfo">
								<colgroup>
									<col style="width: 25%" />
									<col style="width: 105px" />
									<col style="width: 75px" />
									<col style="width: 75px" />
									<col style="width: 75px" />
									<col style="width: 75px" />
									<col style="width: 90px" />
									<col style="width: auto" />
								</colgroup>
								<thead>
									<tr>
										<th>
											Batch
										</th>
										<th>
											<sup class="font-normal">1</sup> Available Now
										</th>
										<th>
											Bulk Stock
										</th>
										<th>
											<sup class="font-normal">2</sup> Just Arrived
										</th>
										<th>
											<sup class="font-normal">3</sup> Ring Fenced
										</th>
										<th>
											On Reserve
										</th>
										<th>
											Total
										</th>
										<th>
											Due In
										</th>
									</tr>
									<tr>
										<th>
											Total all Locations
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('$.stockLocation.availableNowTotal').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('$.stockLocation.bulkTotal').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('$.stockLocation.waitingTotal').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('$.stockLocation.ringFencedTotal').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('$.stockLocation.onReserveTotal').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('+$.stockLocation.totalQuantity()').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: Enumerable.From($data).Select('$.stockLocation.dueInTotal').Sum().toFixed($parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td colspan="8">
											&nbsp;
										</td>
									</tr>
									<!-- ko foreach: $data -->
									<!-- ko if: stockLocation.totalIncludingDue() == 0 -->
									<tr class="stock-location">
										<th>
											<span data-bind="text: `${stockLocation.stockLocationCode} - ${stockLocation.stockLocationName}`"></span>
										</th>
										<th colspan="7">
											<span class="font-normal text-italic">
												No stock available in this location
											</span>
										</th>
									</tr>
									<!-- /ko -->
									<!-- ko if: stockLocation.totalIncludingDue() > 0 -->
									<tr class="stock-location">
										<th>
											<span data-bind="text: `${stockLocation.stockLocationCode} - ${stockLocation.stockLocationName}`"></span>
										</th>
										<th>
											<span data-bind="text: stockLocation.availableNowTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: stockLocation.bulkTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: stockLocation.waitingTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: stockLocation.ringFencedTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: stockLocation.onReserveTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: (+stockLocation.totalQuantity()).toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
										<th>
											<span data-bind="text: stockLocation.dueInTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
										</th>
									</tr>
									<!-- ko foreach: batches -->
									<tr data-bind="css: { 'location-end': $index() == ($parent.batches.length - 1) }">
										<td>
											<span data-bind="text: batch.batchNo"></span>
										</td>
										<td colspan="7" class="no-padding">
											<table class="piece-table table table-condensed">
												<colgroup>
													<col style="width: 105px;" />
													<col style="width: 75px;" />
													<col style="width: 75px;" />
													<col style="width: 75px;" />
													<col style="width: 75px;" />
													<col style="width: 90px;" />
													<col style="width: auto" />
												</colgroup>
												<tbody>
													<!-- ko foreach: pieces -->
													<tr>
														<td>
															<span data-bind="text: AvailableNowDisplay"></span>
														</td>
														<td>
															<span data-bind="text: BulkDisplay"></span>
														</td>
														<td>
															<span data-bind="text: WaitingDisplay"></span>
														</td>
														<td>
															<span data-bind="text: RingFencedDisplay"></span>
														</td>
														<td>
															<span data-bind="text: OnReserveDisplay"></span>
														</td>
														<td>
															<span data-bind="text: TotalDisplay"></span>
														</td>
														<td>
															<span data-bind="text: DueInDisplay"></span>
															<!-- ko if: POOnCallOff -->
															<span>(call off)</span>
															<!-- /ko -->
															<!-- ko ifnot: POOnCallOff -->
															<!-- ko if: POConfirmed != null -->
															<span data-bind="text: POConfirmed ? '(confirmed)' : '(unconfirmed)'"></span>
															<!-- /ko -->
															<!-- /ko -->
														</td>
													</tr>
													<!-- /ko -->
												</tbody>
											</table>
										</td>
									</tr>
									<!-- /ko -->
									<!-- /ko -->
									<!-- ko if: $index() != ($parent.length - 1) -->
									<tr>
										<td colspan="6">
											&nbsp;
										</td>
									</tr>
									<!-- /ko -->
									<!-- /ko -->
								</tbody>
							</table>
							<p>
								<sup class="font-normal">1</sup> "Available Now" = Free Stock + Stock Ring Fenced for this Customer
							</p>
							<p>
								<sup class="font-normal">2</sup> "Just Arrived" = Stock waiting to be put away
							</p>
							<p>
								<sup class="font-normal">3</sup> "Ring Fenced" = Stock Ring Fenced for other Customers
							</p>
							<!-- /ko -->
							<!-- ko if: typeof stockInfo != 'undefined' && (stockInfo() ? stockInfo().length == 0 : true) -->
							<label data-bind="text: stockStatus"></label>
							<!-- /ko -->
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</script>

<script id="filter-pills-template" type="text/html">
	<ul class="filter-pills list-group list-group-horizontal-sm">
		<!-- ko foreach: getSelectedFilters -->
		<li class="filter-pill relative" data-bs-toggle="tooltip" data-bind="attr: { 'data-bs-title': bsTooltipTitle }">
			<span>
				<!-- ko if: Object.hasOwn($data, 'dropDownListSettings') -->
				<!-- ko if: ko.unwrap(dropDownListSettings.dataItem) -->
				<!-- ko if: Object.hasOwn(ko.unwrap(dropDownListSettings.dataItem), $data.complexObjectName) -->
				<span data-bind="html: `${ko.unwrap(dropDownListSettings.dataItem)[complexObjectName][complexObjectTextField]}`"></span>
				<!-- /ko -->
				<!-- ko ifnot: complexObjectName -->
				<span data-bind="html: `${ko.unwrap(dropDownListSettings.dataItem)[dropDownListSettings.dataTextField]}`"></span>
				<!-- /ko -->
				<!-- /ko -->
				<!-- /ko -->
			</span>
			<!-- ko if: typeof(clearFunction) != 'undefined' -->
			<a class="stretched-link" href="javascript:;" data-bind="click: clearFunction">
				<button type="button" class="btn-close"></button>
			</a>
			<!-- /ko -->
		</li>
		<!-- /ko -->
		<!-- ko if: typeof($parent.selectedPod) != 'undefined' && $parent.selectedPod() -->
		<li class="filter-pill relative">
			<span data-bind="with: $parent.selectedPod">
				@*<span data-bind="text: `Dashboard Selection = ${Heading}`"></span>*@
				<span data-bind="text: Heading"></span>
			</span>
			<!-- ko if: typeof($parent.clearSelectedPod) != 'undefined' -->
			<a class="stretched-link" href="javascript:;" data-bind="click: clearSelectedPod">
				<button type="button" class="btn-close"></button>
			</a>
			<!-- /ko -->
		</li>
		<!-- /ko -->
		<li>
			<button class="btn btn-secondary" href="javascript:;" data-bind="click: reset">
				<span>
					Reset Filters
				</span>
				<i class="bi bi-arrow-counterclockwise"></i>
			</button>
		</li>
	</ul>
</script>

<script type="text/html" id="credit-control-quantity-value-dropdown-container">
	<ul class="dropdown-menu display-mode-list">
		<li class="dropdown-menu-controls d-flex gap-2" data-bind="click: () => { }, clickBubble: false">
			<button class="btn btn-secondary btn-sm" data-bind="click: () => { displayModes([DISPLAY_MODE_QUANTITY, DISPLAY_MODE_VALUE]) }, clickBubble: false">
				Select All
			</button>
			<button class="btn btn-secondary btn-sm" data-bind="click: () => { displayModes([]); }, clickBubble: false">
				Deselect All
			</button>
			<button class="btn btn-secondary btn-sm ms-auto" data-bind="click: (data, event) => { bootstrap.Dropdown.getOrCreateInstance(event.currentTarget.closest('.dropdown').querySelector('.dropdown-toggle')).hide(); }, clickBubble: false">
				Close
			</button>
		</li>
		<li style="padding-left: 2rem;">
			<label class="form-check" data-bind="attr: { 'for': `display-mode-value` }, click: function() { return true }, clickBubble: false">
				<input class="form-check-input" type="checkbox" data-bind="checked: displayModes,
                checkedValue: DISPLAY_MODE_VALUE,
                attr: {
                    id: `display-mode-value`,
                    disabled: false
                }" />
				<span data-bind="text: 'Value'"></span>
			</label>
		</li>
		<li style="padding-left: 2rem;">
			<label class="form-check" data-bind="attr: { 'for': `display-mode-quantity` }, click: function() { return true }, clickBubble: false">
				<input class="form-check-input" type="checkbox" data-bind="checked: displayModes,
                checkedValue: DISPLAY_MODE_QUANTITY,
                attr: {
                    id: `display-mode-quantity`,
                    disabled: false
                }" />
				<span data-bind="text: 'Quantity'"></span>
			</label>
		</li>
	</ul>
</script>

<script type="text/html" id="held-orders-template">
	<div class="blocker" data-bind="flexFadeVisible: heldOrdersGridBusy">
		<div class="loading-spinner"></div>
		<h4 class="" data-bind="html: busyMessage"></h4>
	</div>
	<div class="prefilters" style="display: none" data-bind="visible: true">
		<div id="held-orders-market-filter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: heldOrdersMarketParams }"></div>
		<div id="held-orders-hold-reason-filter" class="prefilter" data-bind="component: { name: 'mdc-kendo-multiselect-component', params: heldOrdersHoldReasonsParams }"></div>
		<div id="held-orders-search-term-filter" class="prefilter" data-bind="component: { name: 'mdc-text-field-component', params: heldOrdersSearchTermParams }"></div>
		<button id="held-orders-filter-search-btn" class="btn btn-flat btn-secondary" type="button" data-bind="click: heldOrdersSearchTermParams.enterKey">
			<span>
				Search
			</span>
			<span class="bi bi-search"></span>
		</button>
		<button id="held-orders-filter-clear-btn" class="btn btn-flat btn-secondary" type="button" data-bind="click: clearHeldOrdersGridFilters">
			<span>
				Clear Filters
			</span>
			<span class="bi bi-x"></span>
		</button>
	</div>
	<!-- ko if: holdReasonSummaryPods().length -->
	<div class="hold-reason-summary-pods" style="display: none" data-bind="visible: true">
		<div class="pods-wrapper">
			<!-- ko foreach: holdReasonSummaryPods -->
			<div class="card hold-reason-summary-pod" data-bind="click: apply, css: { 'active': active, 'priority': Priority }, attr: { 'data-hold-reason-summary-pod-id': HoldReasonSummaryPodID }">
				<div class="title-wrapper">
					<h4 class="title" data-bind="html: HoldReasonGroupName"></h4>
					<h5 class="subtitle" data-bind="html: RoleName"></h5>
				</div>
				<div class="detail">
					<span data-bind="text: Count"></span>
				</div>
			</div>
			<!-- /ko -->
		</div>
	</div>
	<!-- /ko -->
	<div id="held-orders-grid" data-bind="kendoGrid: heldOrdersResultGridSettings"></div>
<pre id="json-viewer" class="prettyprint lang-js mb-0" style="display: none;" data-bind="visible: jsonViewer() != null, html: jsonViewer"></pre>
</script>



<script id="held-order-row-template" type="text/html">
	<tr>
		<td style="white-space: normal">
			<span data-bind="html: Reference"></span>
		</td>
		<td>
			<span data-bind="text: moment(HeldSince).format('DD/MM/YYYY HH:mm')"></span>
		</td>
		<td>
			<span class="display-block" data-bind="text: CustomerCode"></span>
			<span class="display-block" data-bind="text: CustomerName"></span>
		</td>
		<td>
			<span data-bind="text: CustomerReference"></span>
		</td>
		<td class="text-right">
			<span data-bind="html: Value"></span>
		</td>
		<td class="text-center">
			<!-- ko if: HasAllocations -->
			<span class="material-icons" title="Has Allocations">
				done
			</span>
			<!-- /ko -->
			<!-- ko ifnot: HasAllocations -->
			<span class="material-icons" title="Does not have Allocations">
				close
			</span>
			<!-- /ko -->
		</td>
		<td style="white-space: normal">
			<div data-bind="foreach: Enumerable.From(JSON.parse(HeldReasons)).Select('$.HeldReason').ToArray()">
				<div class="hold-reason" data-bind="html: $data"></div>
			</div>
		</td>
		<td class="held-order-controls-column">
			<!-- ko if: AllowBasketView -->
			<button class="btn btn-flat" data-bind="click: $parent.fetchBasketView">
				View Details
			</button>
			<!-- /ko -->
			<!-- ko if: AllowBasketEdit -->
			<button class="btn btn-flat" data-bind="click: $parent.editBasket">
				Edit Basket
			</button>
			<!-- /ko -->
			<!-- ko if: AllowBasketRelease -->
			<button class="btn btn-green" data-bind="click: $parent.releaseBasket">
				Release Basket
			</button>
			<!-- /ko -->
			<!-- ko if: AllowBasketDelete -->
			<button class="btn btn-red" data-bind="click: function () { $parentContext.$parent.orderFactory.deleteBasket(BasketID, true, () => { $parentContext.$parent.memberBasketFetcher.heldOrdersGridWidget().dataSource.read() }); }">
				Delete Basket
			</button>
			<!-- /ko -->
			<!-- ko if: AllowTransactionView -->
			<button class="btn btn-flat" data-bind="click: $parent.fetchTransactionView">
				View Details
			</button>
			<!-- /ko -->
			<!-- ko if: AllowTransactionEdit -->
			<button class="btn btn-battleship-blue" data-bind="click: $parent.editTransaction">
				Edit / Delete
			</button>
			<!-- /ko -->
			<!-- ko if: AllowRetailPaymentDetails -->
			<button class="btn btn-blue" data-bind="click: $parent.provideRetailPaymentDetails">
				Provide Retail Payment Details
			</button>
			<!-- /ko -->
			<!-- ko if: AllowTransactionRelease -->
			<button class="btn btn-green" data-bind="click: $parent.releaseTransaction">
				Release Transaction
			</button>
			<!-- /ko -->
			<!-- ko if: AllowTransactionDelete -->
			<button class="btn btn-red" data-bind="click: $parent.deleteTransaction">
				Delete Transaction
			</button>
			<!-- /ko -->
			<!-- ko foreach: documents -->
			<button class="btn btn-flat" data-bind="click: function () { $parentContext.$parent.fetchDocument($data, $parent); }">
				<span data-bind="text: label"></span>
			</button>
			<!-- /ko -->
		</td>
		<td>
			<div class="mb-0" data-bind="html: DocumentSendHistory"></div>
		</td>
		<td>
			<div data-bind="html: PaidOnline"></div>
		</td>
	</tr>
</script>

<script id="transaction-row-template" type="text/html">
	<tr class="pointer">
		<td>
			<span data-bind="text: BasketID"></span>
		</td>
		<td>
			<!-- ko foreach: orderDetails -->
			<a class="display-block" data-bind="bootstrapPopover: bootstrapPopoverDetails, text: label"></a>
			<!-- /ko -->
		</td>
		<td>
			<span class="display-block" data-bind="text: TradeAccountCode"></span>
			<span class="display-block" data-bind="text: TradeAccountName"></span>
		</td>
		<td>
			<span data-bind="text: OrderReference"></span>
		</td>
		<td>
			<span class="display-block" data-bind="text: MemberName"></span>
			<span class="display-block" data-bind="text: MemberEmail"></span>
		</td>
		<td>
			<span data-bind="text: moment(CreatedDT).format('dddd Do MMM YY')"></span>
		</td>
	</tr>
</script>

<script id="order-line-row-template" type="text/html">
	<tr>
		<td>
			<span data-bind="text: code"></span>
		</td>
		<td>
			<span data-bind="text: quantity"></span>
		</td>
		<td>
			<span data-bind="text: formatCurrency(priceEx, 2,  formattingCulture, currencyCode)"></span>
		</td>
		<td>
			<span data-bind="text: formatCurrency(priceInc, 2,  formattingCulture, currencyCode)"></span>
		</td>
		<td>
			<span data-bind="text: status"></span>
		</td>
	</tr>
</script>

<script id="order-enquiry-order-line-row-template" type="text/html">
	<tr>
		<td>
			<span data-bind="text: LineNumber"></span>
		</td>
		<td>
			<img width="128" height="128" class="thumb" data-bind="attr: { src: 'https://www.designersguild.com/image/156/' + ImageID }" />
		</td>
		<td>
			<span class="d-block" data-bind="text: ProductCode"></span>
			<span class="d-block" data-bind="text: ProductDescription"></span>
		</td>
		<td>
			<span data-bind="text: QuantityOrdered"></span>
		</td>
		<td>
			<!-- ko if: FormattingCulture -->
			<span data-bind="text: formatCurrency(LineValueCurrency, 2,  FormattingCulture, CurrencyCode)"></span>
			<!-- /ko -->
			<!-- ko ifnot: FormattingCulture -->
			<span data-bind="text: LineValueCurrency"></span>
			<!-- /ko -->
		</td>
		<td>
			<!-- ko if: FormattingCulture -->
			<span data-bind="text: formatCurrency(LineDiscountValueCurrency, 2,  FormattingCulture, CurrencyCode)"></span>
			<!-- /ko -->
			<!-- ko ifnot: FormattingCulture -->
			<span data-bind="text: LineDiscountValueCurrency"></span>
			<!-- /ko -->
		</td>
		<td>
			<span data-bind="text: LineStatus"></span>
		</td>
	</tr>
</script>