                                </label>
                            </div>
                            <div class="col-xs-12">
                                <div class='input-group date' data-bind="keepElement: visitDate, dateTimePicker: visitDate, dateTimePickerOptions: { locale: 'en-gb', format: 'DD/MM/YYYY', ignoreReadonly: true, showClear: true, allowInputToggle: true, sideBySide: true, useCurrent: true, minDate: 'now', showClose: true, keepInvalid: true }">
