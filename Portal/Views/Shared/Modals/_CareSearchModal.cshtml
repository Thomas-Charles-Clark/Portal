<div id="care-search-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 id="care-search-title" class="modal-title">Care Records</h4>
                <span id="care-search-sub-title"></span>
            </div>
            <div class="modal-body">
                <div id="order-enquiry-container">
                    @Html.Action("CareSearch", "Component", new
                    {
                        Area = ""
                    })
                </div>
            </div>
            <div class="modal-footer" data-bind="with: careSearch">
                <button type="button" class="btn btn-default modal-search-toggle" data-bind="click: function() { toggleFilters() }"><span class="glyphicon glyphicon-search"></span> Search</button>
                <button id="care-search-close" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>