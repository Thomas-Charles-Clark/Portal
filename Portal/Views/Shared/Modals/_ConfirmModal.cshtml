<div id="confirm-modal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <h4 id="confirm-modal-heading">Are you sure?</h4>
                <p id="confirm-modal-message"></p>
            </div>
            <div class="modal-footer">
                <button id="confirm-modal-yes" type="button" class="btn btn-primary" data-dismiss="modal">Yes</button>
                <a id="confirm-modal-no" class="btn btn-default" data-dismiss="modal">No</a>
            </div>
        </div>
    </div>
</div>

<div id="red-confirm-modal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body alert alert-danger">
                <h4 id="red-confirm-modal-heading">Are you sure?</h4>
                <p id="red-confirm-modal-message"></p>
            </div>
            <div class="modal-footer">
                <button id="red-confirm-modal-yes" type="button" class="btn btn-primary" data-dismiss="modal">Yes</button>
                <a id="red-confirm-modal-no" class="btn btn-default" data-dismiss="modal">No</a>
            </div>
        </div>
    </div>
</div>