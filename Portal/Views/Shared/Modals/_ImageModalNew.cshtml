            </div>
            <!-- ko if: typeof emailerInstance !== "undefined" -->
            <div class="modal-footer">
                <div data-bind="component: { name: 'emailer-component', params: emailer }"></div>
            </div>
            <!-- /ko -->
        </div>
    </div>
</div>