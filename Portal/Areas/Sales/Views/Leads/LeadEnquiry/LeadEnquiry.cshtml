@model Portal.Areas.Sales.ViewModels.LeadEnquiryViewModel
@{
    ViewBag.Title = "Leads";
    var userId = User.Identity.GetUserId<int>();
}
@section styles {
    @Styles.Render("~/bundles/css/lead-enquiry")
    @Styles.Render("~/bundles/css/kendo-custom")
}
@section scripts {
    @Scripts.Render("~/bundles/js/intl-tel")
    @Scripts.Render("~/bundles/js/translations")
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/lead-enquiry")

    <script type="text/javascript">

        var lockedToRep = true;

        @if (!Model.LockedToRep)
        {
            <text>
        lockedToRep = false;
        </text>
        }

        function getRetailAppointmentTypes() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.RetailAppointmentTypes))
        }

        function formatGBP(val) {
            return formatCurrency(val, 0, 'en-GB', 'GBP')
        }

        function formatGBPDec(val) {
            return formatCurrency(val, 2, 'en-GB', 'GBP')
        }

        function formatSelectedCurrency(val) {
            // we don't have a selected currency.
            //var curr = viewModel.slicerGroup.selectedCurrency();
            //if (curr) {
            //    if (curr.hasOwnProperty('FormattingCulture')) {
            //        return formatCurrency(val, 0, curr.FormattingCulture, curr.CurrencyCode);
            //    }
            //}
            return formatNumber(val, 0, 'en-GB');
        }

        function getPreselectedLaunchId() {
            return @Html.Raw(Model.PreselectedLaunchID);
        }

        function getPreselectedSalesRep() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedSalesRep));
        }

        // Initialise Bootstrap popovers...
        $(function () {
            $('[data-toggle="popover"]').popover()
        })

        var viewModel = new leadEnquiryViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        var cv = null;

        $(document).ready(function () {
            ko.applyBindings(viewModel, document.body);

            if (getPreselectedLead()) {
                viewModel.leadEdit.loadLeadForEdit(getPreselectedLead(), 'summary');
            }

            cv = viewModel.customerView;
            //$('#order-products-modal').modal('show');
        });
    </script>

    <script id="misc-row-template" type="text/x-kendo-template">
        <tr>
            <td>
                <span data-bind="text: Code"></span>
            </td>
            <td>
                <span data-bind="text: Name"></span>
            </td>
            <td>
                <span>
                    <span class="misc-address" data-bind="html: HTMLDisplay"></span>
                    <a class="map-button" data-bind="attr: { href: 'javascript:;' }, click: function() { $parent.viewMap($parent); }">[map]</a>
                </span>
            </td>
            <td>
                <span data-bind="text: formatNumber(SalesLast12Months, 0, 'en-GB')"></span>
            </td>
            <td>
                <span data-bind="text: formatNumber(OrderCountLast12Months, 0, 'en-GB')"></span>
            </td>
            <td>
                <span data-bind="text: formatNumber(SalesLast48Months, 0, 'en-GB')"></span>
            </td>
            <td>
                <span data-bind="text: formatNumber(OrderCountLast48Months, 0, 'en-GB')"></span>
            </td>
        </tr>
    </script>

    <script id="customer-row-template" type="text/x-kendo-template">
        <tr data-uid="#= uid #" data-bind="attr: { 'data-trade-account-code': Code }">
            <td class="check-column">
                <label>
                    <input class="row-checkbox" type="checkbox" />
                </label>
            </td>
            <td>
                <span style="display: none" data-bind="text: LeadID"></span>
                <span data-bind="text: Code"></span>
            </td>
            <td>
                <span data-bind="text: Name"></span>
            </td>
            <td>
                <span data-bind="text: Contact"></span>
            </td>
            <td>
                <a data-bind="attr: { href: 'tel:' + Phone }, text: Phone"></a>
            </td>
            <td>
                <a data-bind="attr: { href: 'mailto:' + Email }, text: Email"></a>
            </td>
            <td>
                <span data-bind="with: InvoiceAddress">
                    <span class="misc-address" data-bind="html: HTMLDisplay"></span>
                    <a class="map-button" data-bind="attr: { href: 'javascript:;' }, click: function() { $parentContext.$parent.viewMap($parent); }">[map]</a>
                </span>
            </td>
            <td>
                <span data-bind="with: VisitAddress">
                    <span class="misc-address" data-bind="html: HTMLDisplay"></span>
                    <a class="map-button" data-bind="attr: { href: 'javascript:;' }, click: function() { $parentContext.$parent.viewMap($parent); }">[map]</a>
                </span>
            </td>
            <td>
                <a data-bind="attr: { href: 'https://' + ((Website || '').replace('https://', '').replace('http://', '')), target: '_blank' }, text: Website"></a>
            </td>
            <td>
                <span data-bind="text: Market"></span>
            </td>
            <td>
                <span data-bind="text: Area"></span>
            </td>
            <td>
                <span data-bind="text: Rep"></span>
            </td>
            <td>
                <span data-bind="text: Agent"></span>
            </td>
            <td>
                <span data-bind="text: Type"></span>
            </td>
            <td>
                <span data-bind="text: PriceList"></span>
            </td>
            <td>
                <span data-bind="text: CreditTerms"></span>
            </td>
        </tr>
    </script>

    <script id="visit-row-template" type="text/x-kendo-template">
        <tr>
            <td style="display: none;">
                <span data-bind="text: TradeAccountVisitID"></span>
            </td>
            <td>
                <span data-bind="text: moment(VisitDT).format('DD/MM/YYYY hh:mm a')"></span>
            </td>
            <td>
                <span data-bind="text: Notes"></span>
            </td>
            <td>
                <!-- ko foreach: Attendees -->
                <span data-bind="with: TradeAccountContact">
                    <span class="attendee" data-bind="css: { 'btn-red': Deleted == true }">
                        <span data-bind="with: Title">
                            <span data-bind="text: Title"></span>
                        </span>
                        <span data-bind="text: FullName"></span>
                    </span>
                </span>
                <!-- /ko -->
            </td>
        </tr>
    </script>

    <script id="care-row-template" type="text/x-kendo-template">
        <tr>
            <td>
                <div class="care-heading-wrapper">
                    <span class="care-heading">
                        Invoice No.
                        <span data-bind="text: invoiceNumber"></span>
                        CCR No.
                        <span data-bind="text: careHeadId"></span>
                        Order No.
                        <span data-bind="text: orderHeadId"></span>
                        Created Date
                        <span data-bind="text: createdDtText"></span>
                    </span>
                </div>
                <div class="care-heading-wrapper">
                    <span class="care-heading" data-bind="with: creditNumber">
                        Credit No.
                        <span data-bind="text: $data"></span>
                    </span>
                    <span class="care-heading" data-bind="with: creditDate">
                        Credit Date
                        <span data-bind="text: renderDate($data)"></span>
                    </span>
                    <span class="care-heading" data-bind="with: creditValue">
                        Credit Value
                        <span data-bind="text: formatCurrency($data, 2, 'en-GB', 'GBP')"></span>
                    </span>
                </div>
                <!-- ko foreach: careLines -->
                <div class="care-line">
                    <!-- ko if: imageId -->
                    <img class="thumb" data-bind="click: function() { $parent.loadLargeImage($data) }, attr: { src: 'https://www.designersguild.com/image/156/' + $data.imageId }" />
                    <!-- /ko -->
                    <p>
                        <span data-bind="text: productName"></span>
                        <span data-bind="text: productCode"></span>
                        <span data-bind="text: 'Quantity: ' + claimQuantityDisplay()"></span>
                        <span data-bind="text: 'Credit Reason: ' + notes"></span>
                    </p>
                </div>
                <!-- /ko -->
            </td>
        </tr>
    </script>

    <script id="slicer-group-template" type="text/html">
        <div class="grid-container">
            <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: marketParams }"></div>
            <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: areaParams }"></div>
            <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: accountTypeParams }"></div>
            <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: accountGroupParams }"></div>
            <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: repParams }"></div>
            <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: repOrAgentParams }"></div>
            <div class="search" data-bind="component: { name: 'mdc-text-field-component', params: searchParams }"></div>
            <div class="tagging" data-bind="component: { name: 'mdc-kendo-multiselect-component', params: tagParams }"></div>
        </div>
    </script>
}
