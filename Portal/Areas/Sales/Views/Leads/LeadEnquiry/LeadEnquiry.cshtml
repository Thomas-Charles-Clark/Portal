@section postscripts {
    <script>
        var mapLibsReady = 0;

        function mapLibReadyHandler() {
            if (++mapLibsReady < 2) return;
            initMiscMap();
            window.canLoadOMS = true;
        }
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?callback=mapLibReadyHandler&key=AIzaSyA_d3HoXoCV7M85_xduYJUze1GOscDnjUw" async defer></script>
    <script src="/Scripts/oms.min.js?spiderfier_callback=mapLibReadyHandler" async defer></script>
    <script type="text/javascript">
        var _googleMap;

        var infoWindow;

        function iwClose() {
            console.log('iwClose done');
            infoWindow.close();
        }

        function initGoogleMap() {
            console.log('init google map');

            window.blueIcon = {
                url: '/content/images/icons/panel-pin-blue-wide.png',
                plus: 'blueIconPlus',
                labelClass: 'text-center'
            };

            window.blueIconPlus = {
                url: '/content/images/icons/panel-pin-blue-wide-plus.png',
                regular: 'blueIcon',
                labelClass: 'text-center no-display'
            }

            window.greenIcon = {
                url: '/content/images/icons/panel-pin-green-wide.png',
                plus: 'greenIconPlus',
                labelClass: 'text-center'
            };

            window.greenIconPlus = {
                url: '/content/images/icons/panel-pin-green-wide-plus.png',
                regular: 'greenIcon',
                labelClass: 'text-center no-display'
            }

            window.yellowIcon = {
                url: '/content/images/icons/panel-pin-yellow-wide.png',
                plus: 'yellowIconPlus',
                labelClass: 'text-center'
            }

            window.yellowIconPlus = {
                url: '/content/images/icons/panel-pin-yellow-wide-plus.png',
                regular: 'yellowIcon',
                labelClass: 'text-center no-display'
            }

            _googleMap = new google.maps.Map(document.getElementById('proximity-map'), {
                center: { lat: 51.518225, lng: -0.223972 },
                zoom: 10,
                maxZoom: 18
            });

            infoWindow = new google.maps.InfoWindow({
                maxWidth: 240
            });

            google.maps.event.addListener(_googleMap, 'click', iwClose);

            if (window.canLoadOMS) {
                window.oms = new OverlappingMarkerSpiderfier(_googleMap, {
                    markersWontMove: true,
                    markersWontHide: false,
                    keepSpiderfied: true,
                    nearbyDistance: 24
                });

                window.oms.addListener('format', function (marker, status) {
                    if (marker.icon) {
                        switch (status) {
                            case OverlappingMarkerSpiderfier.markerStatus.SPIDERFIABLE:
                                marker.setIcon(window[marker.iconType + 'plus']);
                                break;
                            case OverlappingMarkerSpiderfier.markerStatus.SPIDERFIED:
                            case OverlappingMarkerSpiderfier.markerStatus.UNSPIDERFIABLE:
                                marker.setIcon(window[marker.iconType]);
                                break;
                        }
                    }
                });

                window.oms.addListener('spider_format', function (marker, status) {
                    console.log('spider_format hit');
                });
            }
        }
    </script>
}

