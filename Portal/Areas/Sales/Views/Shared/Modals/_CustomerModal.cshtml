<div id="customer-modal" class="modal fade" tabindex="-1" role="dialog" data-bind="with: customerView" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-lg modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header grey-blue bg-info">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 id="customer-title" class="modal-title" data-bind="with: tradeAccount">
                    <!-- ko if: TradeAccountID -->
                    <span data-bind="text: Code"></span>
                    -
                    <span data-bind="with: Name">
                        <span data-bind="text: $data, attr: { title: $parent.TradeAccountID }"></span>
                    </span>
                    <!-- /ko -->
                </h4>
            </div>
            <div class="modal-body">
                <div id="customer-modal-loading" class="panel-busy-wrapper" data-bind="visible: busy()">
                    <div class="form-busy">
                        <div class="busy-bars">
                            <div class="rect1 alert alert-info"></div>
                            <div class="rect2 alert alert-info"></div>
                            <div class="rect3 alert alert-info"></div>
                            <div class="rect4 alert alert-info"></div>
                            <div class="rect5 alert alert-info"></div>
                        </div>
                    </div>
                </div>
                <div class="panel-body" style="padding: 0; min-height: 264px;">
                    <ul class="nav nav-pills">
                        <li class="active">
                            <a href="#customer-summary" data-toggle="tab">
                                Customer Information
                            </a>
                        </li>
                        <li>
                            <a href="#customer-visit" data-toggle="tab">
                                Visits
                            </a>
                        </li>
                        <li>
                            <a href="#customer-notes" data-toggle="tab">
                                Notes
                            </a>
                        </li>
                        @if ((User.Identity.GetUserId<int>() == 8 || User.Identity.GetUserId<int>() == 2 || User.Identity.GetUserId<int>() == 18))
                        {
                            <li>
                                <a href="#customer-orders" data-toggle="tab">
                                    Outstanding Orders
                                </a>
                            </li>
                            <li>
                                <a href="#customer-care" data-toggle="tab">
                                    Care Records
                                </a>
                            </li>
                            <li>
                                <a href="#customer-sales" data-toggle="tab">
                                    Sales Figures
                                </a>
                            </li>
                            <li>
                                <a href="#customer-agreements" data-toggle="tab">
                                    Pricing Agreements
                                </a>
                            </li>
                            <li>
                                <a href="#customer-pattern-books" data-toggle="tab">
                                    Pattern Book Library
                                </a>
                            </li>
                            <li>
                                <a href="#customer-folder-updates" data-toggle="tab">
                                    Folder Updates
                                </a>
                            </li>
                            <li>
                                <a href="#customer-account-balance" data-toggle="tab">
                                    Account Balance
                                </a>
                            </li>
                            <li>
                                <a href="#customer-invoices" data-toggle="tab">
                                    Invoices
                                </a>
                            </li>
                            <li>
                                <a href="#customer-payments" data-toggle="tab">
                                    Recent Payments
                                </a>
                            </li>
                            @*<li>
                                <a href="#order-products-modal" data-toggle="modal">
                                    Place Order
                                </a>
                            </li>*@
                        }
                    </ul>
                    <div class="tab-content">
                        <div id="customer-summary" class="tab-pane active">
                            <ul class="nav nav-pills group">
                                <li class="active">
                                    <a href="#summary-info" data-toggle="tab" class="btn btn-secondary-blue">
                                        Customer Information
                                    </a>
                                </li>
                                <li>
                                    <a href="#summary-sales" data-toggle="tab" class="btn btn-secondary-blue">
                                        Sales Groupings
                                    </a>
                                </li>
                                <li>
                                    <a href="#summary-addresses" data-toggle="tab" class="btn btn-secondary-blue">
                                        Addresses
                                    </a>
                                </li>
                                <li>
                                    <a href="#summary-contacts" data-toggle="tab" class="btn btn-secondary-blue">
                                        Contacts
                                    </a>
                                </li>
                            @if ((User.Identity.GetUserId<int>() == 8 || User.Identity.GetUserId<int>() == 2 || User.Identity.GetUserId<int>() == 18))
                            {
                                <li>
                                    <a href="#summary-credit-control" data-toggle="tab" class="btn btn-secondary-blue">
                                        Credit Control
                                    </a>
                                </li>
                                <li>
                                    <a href="#summary-shipping" data-toggle="tab" class="btn btn-secondary-blue">
                                        Shipping
                                    </a>
                                </li>
                                <li>
                                    <a href="#summary-system-fields" data-toggle="tab" class="btn btn-secondary-blue">
                                        System Fields
                                    </a>
                                </li>
                            }
                            </ul>
                            <div class="tab-content">
                                <div id="summary-info" class="tab-pane active" data-bind="with: summary">
                                    <dl class="dl-horizontal" data-bind="with: CustomerInfo">
                                        <dt>
                                            Name
                                        </dt>
                                        <dd>
                                            <span data-bind="text: Name"></span>
                                        </dd>
                                        <dt>
                                            Code
                                        </dt>
                                        <dd>
                                            <span data-bind="text: Code"></span>
                                        </dd>
                                        <!-- ko if: OpenedDate -->
                                        <dt>
                                            Date Opened
                                        </dt>
                                        <dd>
                                            <span data-bind="text: moment(OpenedDate).format('DD/MM/YYYY')"></span>
                                        </dd>
                                        <!-- /ko -->
                                        <dt>
                                            Status
                                        </dt>
                                        <dd>
                                            <span data-bind="text: Status"></span>
                                        </dd>
                                        <dt>
                                            Price List
                                        </dt>
                                        <dd>
                                            <span data-bind="text: PriceListCode"></span>
                                            <span data-bind="text: PriceListName"></span>
                                        </dd>
                                        <dt>
                                            Currency
                                        </dt>
                                        <dd>
                                            <span data-bind="text: Currency"></span>
                                        </dd>
                                        <!-- ko if: Website -->
                                        <dt>
                                            Website
                                        </dt>
                                        <dd>
                                            <a data-bind="attr: { href: Website, target: '_blank' }, text: Website"></a>
                                        </dd>
                                        <!-- /ko -->
                                        <!-- ko if: PhoneNumber -->
                                        <dt>
                                            Phone Number
                                        </dt>
                                        <dd>
                                            <a data-bind="attr: { href: 'tel:' + PhoneNumber, target: '_blank' }, text: PhoneNumber"></a>
                                        </dd>
                                        <!-- /ko -->
                                        <!-- ko if: PrimaryEmail -->
                                        <dt>
                                            Primary Email
                                        </dt>
                                        <dd>
                                            <a data-bind="attr: { href: 'mailto:' + PrimaryEmail,  }, text: PrimaryEmail"></a>
                                        </dd>
                                        <!-- /ko -->
                                        <!-- ko if: MarketingEmail -->
                                        <dt>
                                            Marketing Email
                                        </dt>
                                        <dd>
                                            <a data-bind="attr: { href: 'mailto:' + MarketingEmail,  }, text: MarketingEmail"></a>
                                        </dd>
                                        <!-- /ko -->
                                        <dt>
                                            Invoice Address
                                        </dt>
                                        <dd>
                                            <div data-bind="html: $parent.CustomerAddresses[0].model.displayBlock()"></div>
                                            <div data-bind="html: $parent.CustomerAddresses[0].model.displayTags()"></div>
                                        </dd>
                                        <dt>
                                            Delivery Address
                                        </dt>
                                        <dd>
                                            <div data-bind="html: $parent.CustomerAddresses[1].model.displayBlock()"></div>
                                            <div data-bind="html: $parent.CustomerAddresses[1].model.displayTags()"></div>
                                        </dd>
                                        <dt>
                                            Visit Address
                                        </dt>
                                        <dd>
                                            <div data-bind="html: $parent.CustomerAddresses[2].model.displayBlock()"></div>
                                            <div data-bind="html: $parent.CustomerAddresses[2].model.displayTags()"></div>
                                        </dd>
                                    </dl>
                                </div>
                                <div id="summary-sales" class="tab-pane">

                                </div>
                                <div id="summary-addresses" class="tab-pane" data-bind="with: summary">
                                    <div class="form-group row">
                                        <div class="col-xs-12">
                                            <button class="btn btn-blue pull-right" data-target="#address-edit-modal" data-toggle="modal">
                                                Add Address
                                            </button>
                                        </div>
                                    </div>
                                    <div id="summary-addresses-inner" class="form-group">
                                        <div class="trade-account-addresses">
                                            <!-- ko foreach: CustomerAddresses -->
                                            <!-- ko if: $index() < 3 -->
                                            <div class="trade-account-address">
                                                <div class="trade-account-address-inner">
                                                    <label data-bind="text: Label"></label>
                                                    <div class="customer-address-actions">
                                                    </div>
                                                    <div data-bind="html: model.displayBlock()"></div>
                                                    <div data-bind="html: model.displayTags()"></div>
                                                    <!-- ko if: $index() == 0-->
                                                    <a data-bind="click: $parentContext.$parent.setDefaultDeliveryAddress">
                                                        Make Default Delivery Address
                                                    </a>
                                                    <a data-bind="click: $parentContext.$parent.setDefaultVisitAddress">
                                                        Make Default Visit Address
                                                    </a>
                                                    <!-- /ko -->
                                                    <!-- ko if: $index() == 1 -->
                                                    <a data-bind="click: $parentContext.$parent.setDefaultVisitAddress">
                                                        Make Default Visit Address
                                                    </a>
                                                    <!-- /ko -->
                                                    <!-- ko if: $index() == 2 -->
                                                    <a data-bind="click: $parentContext.$parent.setDefaultDeliveryAddress">
                                                        Make Default Delivery Address
                                                    </a>
                                                    <!-- /ko -->
                                                    <!-- ko if: Editable -->
                                                    <a class="edit pointer" data-bind="click: function (data) { $parentContext.$parent.editCustomAddress(data, false); }, attr: { href: 'javascript:;' }">
                                                        edit
                                                    </a>
                                                    <div class="clearfix"></div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- /ko -->
                                        </div>
                                        <hr/>
                                        <div class="trade-account-addresses custom-addresses">
                                            <!-- ko foreach: CustomerAddresses -->
                                            <!-- ko if: $index() > 2 -->
                                            <div class="trade-account-address">
                                                <div class="trade-account-address-inner">
                                                    <label data-bind="text: Label"></label>
                                                    <div data-bind="html: model.displayBlock()"></div>
                                                    <div data-bind="html: model.displayTags()"></div>
                                                    <a data-bind="click: $parentContext.$parent.setDefaultDeliveryAddress">
                                                        Make Default Delivery Address
                                                    </a>
                                                    <a data-bind="click: $parentContext.$parent.setDefaultVisitAddress">
                                                        Make Default Visit Address
                                                    </a>
                                                    <!-- ko if: Editable -->
                                                    <a class="edit pointer" data-bind="click: function (data) { $parentContext.$parent.editCustomAddress(data, true); }, attr: { href: 'javascript:;' }">
                                                        edit
                                                    </a>
                                                    <div class="clearfix"></div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <button class="btn btn-blue pull-right" data-target="#address-edit-modal" data-toggle="modal">
                                                Add Address
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div id="summary-contacts" class="tab-pane">
                                    @Html.Action("TradeAccountContactsTablePartial", "TradeAccountContacts", new { Area = "trade-accounts" })
                                    @*<iframe id="contacts-iframe" data-bind="attr: { src: contactsiFrameSrc }"></iframe>*@
                                    <!--<div class="form-group row">
                                        <div class="col-xs-12">
                                            <button class="btn btn-blue pull-right" data-bind="click: addNewContact">
                                                Add Contact
                                            </button>
                                        </div>
                                    </div>
                                    <div class="form-group contacts-wrapper">
                                        <label class="contacts-group-header">
                                            Receive Order Confirmations
                                        </label>
                                        <label class="contacts-group-header">
                                            Receive Marketing Communications
                                        </label>
                                        <label class="contacts-group-header">
                                            Receive Invoices, Statements &amp; Credit Notes
                                        </label>
                                        <label class="contacts-group-header">
                                            Receive Pricelists
                                        </label>
                                        <label class="contacts-group-header">
                                            Other
                                        </label>
                                        <div class="contacts-group">-->
                                            <!-- ko foreach: tradeAccountContactsOrderConfirmations -->
                                            <!--<div class="trade-account-contact" data-bind="template: { name: 'trade-account-contact-template', data: $data }"></div>-->
                                            <!-- /ko -->
                                        <!--</div>
                                        <div class="contacts-group">-->
                                            <!-- ko foreach: tradeAccountContactsMarketing -->
                                            <!--<div class="trade-account-contact" data-bind="template: { name: 'trade-account-contact-template', data: $data }"></div>-->
                                            <!-- /ko -->
                                        <!--</div>
                                        <div class="contacts-group">-->
                                            <!-- ko foreach: tradeAccountContactsFinancial -->
                                            <!--<div class="trade-account-contact" data-bind="template: { name: 'trade-account-contact-template', data: $data }"></div>-->
                                            <!-- /ko -->
                                        <!--</div>
                                        <div class="contacts-group">-->
                                            <!-- ko foreach: tradeAccountContactsPricelists -->
                                            <!--<div class="trade-account-contact" data-bind="template: { name: 'trade-account-contact-template', data: $data }"></div>-->
                                            <!-- /ko -->
                                        <!--</div>
                                        <div class="contacts-group">-->
                                            <!-- ko foreach: tradeAccountContactsOther -->
                                            <!--<div class="trade-account-contact" data-bind="template: { name: 'trade-account-contact-template', data: $data }"></div>-->
                                            <!-- /ko -->
                                        <!--</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <button class="btn btn-blue pull-right" data-bind="click: addNewContact">
                                                Add Contact
                                            </button>
                                        </div>
                                    </div>-->
                                </div>
                                <div id="summary-credit-control" class="tab-pane">

                                </div>
                                <div id="summary-shipping" class="tab-pane">

                                </div>
                                <div id="summary-system-fields" class="tab-pane">

                                </div>
                            </div>
                        </div>
                        <div id="customer-visit" class="tab-pane">
                            <button class="btn btn-primary" data-bind="click: showBooker">
                                Book Visit
                            </button>
                            <div id="customer-visit-grid" data-bind="kendoGrid: visitGridSettings"></div>
                        </div>
                        <div id="customer-notes" class="tab-pane">
                            <div class="form-group row">
                                <div class="col-xs-12">
                                    <label class="col-form-label note-label">
                                        New Note
                                    </label>
                                </div>
                                <div class="col-xs-12">
                                    <textarea id="new-note" rows="4" class="task-comment form-control" data-bind="textInput: newNote" maxlength="2000"></textarea>
                                </div>
                                <div class="col-xs-12">
                                    <!-- ko if: notes().length > 0 -->
                                    <button class="btn btn-default pull-left pointer no-select" data-bind="click: function () { allNotesExpanded(!allNotesExpanded()); }">
                                        <span data-bind="text: allNotesExpanded() ? 'Collapse All' : 'Expand All'"></span>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-success pull-right" data-bind="click: saveNote">
                                        Save
                                    </button>
                                </div>
                            </div>
                            <div class="form-group row" data-bind="visible: notes().length > 3">
                                <div class="col-xs-12">
                                </div>
                            </div>
                            <div class="notes-container">
                                <!-- ko foreach: Enumerable.From(notes()).Where('$.Deleted == false').OrderByDescending('$.CreatedDT').ToArray() -->
                                <div class="note">
                                    <a class="col-form-label note-label" data-bind="with: Author, attr: { 'href': '#comment-' + $index() }" data-toggle="collapse">
                                        <span data-bind="text: moment($parent.CreatedDT).format('ddd Do MMM YY h:mma')"></span>
                                        <span data-bind="text: FullName"></span>
                                        <span data-bind="text: 'Show / Hide'"></span>
                                    </a>
                                    <div class="comment-display collapse in" data-bind="attr: { id: 'comment-' + $index() }">
                                        <p data-bind="html: Note.replace(/(\n)+/g, '<br />'), css: { 'in': $index() == 0 }"></p>
                                    </div>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                        <div id="customer-orders" class="tab-pane">
                            <div class="form-group row">
                                <div class="col-xs-12">
                                    <div class="group">
                                        <!-- ko foreach: orderLineStatusGroups -->
                                        <a class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': $parent.currentOrderLineStatusGroup() == OrderLineStatusGroupID }, attr: { href: 'javascript:;' }, text: Name + ' (' + Count + ')', click: $parent.statusGroupButtonClick"></a>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-12">
                                    <div id="outstanding-orders-grid" data-bind="kendoGrid: outstandingOrderGridSettings"></div>
                                </div>
                            </div>
                        </div>
                        <div id="customer-care" class="tab-pane">
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="group form-group">
                                        <a class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': currentCareStatusGroup() == 1 }, click: function() { currentCareStatusGroup(1); }">
                                            Waiting for Goods to be Returned
                                        </a>
                                        <a class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': currentCareStatusGroup() == 2 }, click: function() { currentCareStatusGroup(2); }">
                                            Credit Pending
                                        </a>
                                        <a class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': currentCareStatusGroup() == 3 }, click: function() { currentCareStatusGroup(3); }">
                                            Completed
                                        </a>
                                        <div id="care-search">
                                            <div class="input-group">
                                                <input class="form-control" data-bind="value: careGridSearchTerm, attr: { placeholder: 'Search by Product Code, Order, CCR or Document No.' }" />
                                                <span class="input-group-addon">
                                                    <button class="clear-btn btn btn-default" type="button" data-bind="click: function() { careGridSearchTerm(undefined); }">
                                                        ×
                                                    </button>
                                                </span>
                                                <span class="input-group-btn">
                                                    <button class="search-btn btn btn-default" data-bind="click: function() { careGridSearchTerm.valueHasMutated(); }">
                                                        <span class="glyphicon glyphicon-search"></span>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- ko if: careRecords().length == 0 -->
                            <div class="form-group row">
                                <div class="col-xs-12">
                                    <p class="alert alert-info margin-bottom-0">
                                        No Care Records Found
                                    </p>
                                </div>
                            </div>
                            <!-- /ko -->
                            <div class="row">
                                <div class="col-xs-12">
                                    <div id="care-grid" data-bind="kendoGrid: careGridSettings"></div>
                                </div>
                            </div>
                        </div>
                        <div id="customer-sales" class="tab-pane">
                            @* Include a chart! *@
                            <ul class="nav nav-pills group">
                                <li class="active">
                                    <a href="#financial-sales" data-toggle="tab" class="btn btn-secondary-blue">
                                        Financial Year
                                    </a>
                                </li>
                                <li>
                                    <a href="#calendar-sales" data-toggle="tab" class="btn btn-secondary-blue">
                                        Calendar Year
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div id="financial-sales" class="tab-pane active">
                                    <div class="form-group row">
                                        <div class="col-xs-12">
                                            <div data-bind="kendoGrid: summaryGridSettings"></div>
                                        </div>
                                    </div>
                                </div>
                                <div id="calendar-sales" class="tab-pane">
                                    <div class="form-group row">
                                        <div class="col-xs-12">
                                            <div data-bind="kendoGrid: quarterFinancialGridSettings"></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div data-bind="kendoGrid: quarterCalendarGridSettings"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="customer-agreements" class="tab-pane" data-bind="with: priceChecker">
                            @*@Html.Partial("Components/_PriceChecker")*@

                            <ul class="nav nav-pills group">
                                <li class="active">
                                    <a href="#special-discounts" data-toggle="tab" class="btn btn-secondary-blue">
                                        Special Discount
                                    </a>
                                </li>
                                <li>
                                    <a href="#price-list" data-toggle="tab" class="btn btn-secondary-blue">
                                        Price List
                                    </a>
                                </li>
                                <li>
                                    <a href="#special-prices" data-toggle="tab" class="btn btn-secondary-blue">
                                        Special Prices
                                    </a>
                                </li>
                                <li>
                                    <a href="#price-notes" data-toggle="tab" class="btn btn-secondary-blue">
                                        Special Pricing Requests
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div id="special-discounts" class="tab-pane active">

                                </div>
                                <div id="special-prices" class="tab-pane">

                                </div>
                                <div id="price-list" class="tab-pane">

                                </div>
                                <div id="price-notes" class="tab-pane">
                                    <p>
                                        This becomes functionality to request special pricing from Customer Services. This takes the form of special types of notes.
                                    </p>
                                    <p>
                                        Add NoteTypeID to TradeAccount Notes, default to "General".
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div id="customer-pattern-books" class="tab-pane">
                            <ul class="nav nav-pills group">
                                <li class="active">
                                    <a href="#pattern-books-tab" data-toggle="tab" class="btn btn-secondary-blue" data-bind="click: function () { resetPatternBookToggles(0); }">
                                        Sales Opportunities
                                    </a>
                                </li>
                                <li>
                                    <a href="#pattern-books-tab" data-toggle="tab" class="btn btn-secondary-blue" data-bind="click: function () { resetPatternBookToggles(1); }">
                                        Pattern Books Held
                                    </a>
                                </li>
                                <li>
                                    <a href="#pattern-book-schemes" data-toggle="tab" class="btn btn-secondary-blue">
                                        Pattern Book Schemes
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div id="pattern-books-tab" class="tab-pane active">
                                    <div class="row">
                                        <div class="col-xs-8">
                                            <div class="group">
                                                <div class="btn-toolbar">
                                                    <div class="btn-group">
                                                        <button class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': patternBookHeldState() == null }, click: function () { patternBookHeldState(null) }">
                                                            All
                                                        </button>
                                                        <button class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': patternBookHeldState() == false }, click: function () { patternBookHeldState(false) }">
                                                            Not Held
                                                        </button>
                                                        <button class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': patternBookHeldState() == true }, click: function () { patternBookHeldState(true) }">
                                                            Held
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="btn-toolbar">
                                                    <div class="btn-group">
                                                        <button class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': patternBookProductFilter() == 13 }, click: function () { if (patternBookProductFilter() == 13) { patternBookProductFilter(null); } else { patternBookProductFilter(13) } }">
                                                            Fabric
                                                        </button>
                                                        <button class="btn btn-secondary-blue" data-bind="css: { 'btn-primary': patternBookProductFilter() == 62 }, click: function () { if (patternBookProductFilter() == 62) { patternBookProductFilter(null); } else { patternBookProductFilter(62) } }">
                                                            Wallpaper
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="btn-toolbar">
