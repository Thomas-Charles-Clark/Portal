<div id="address-edit-modal" class="modal fade" data-bind="with: customerView">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: customAddress">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-bind="click: function () { $parent.customAddress.reset(); $('#address-edit-modal').modal('hide'); }">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Address
                </h4>
            </div>
            <div class="modal-body">
                <div id="add-customer-address">
                    <div data-bind="template: { name: 'mdc-address-template', data: $data }"></div>
                </div>
                <hr />
                <div id="address-tagging">
                    <div data-bind="component: { name: 'tagging-component', params: taggingParams }"></div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- ko if: tradeAccountAddressId() == null -->
                <button class="btn btn-blue pull-right" data-bind="click: $parent.addCustomAddress">
                    Add Address
                </button>
                <!-- /ko -->
                <!-- ko ifnot: tradeAccountAddressId() == null -->
                <button class="btn btn-red pull-left" data-bind="click: $parent.deleteCustomAddress">
                    Delete
                </button>
                <button class="btn pull-right margin-left-15" data-bind="click: function () { $parent.customAddress.reset(); $('#address-edit-modal').modal('hide'); }">
                    Cancel
                </button>
                <button class="btn btn-blue pull-right" data-bind="click: $parent.saveCustomAddress">
                    Save Address
                </button>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>

<div id="trade-account-contact-modal" class="modal fade" data-bind="with: customerView">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" data-bind="with: tradeAccount">
                    Trade Account Contact
                    <span class="subtitle">
                        <span data-bind="text: Code + ' - ' + Name"></span>
                    </span>
                </h4>
            </div>
            <div class="modal-body" data-bind="with: contactFactory">
                <div class="blocker" data-bind="visible: busy()">
                    <div class="loading-spinner"></div>
                </div>
                <div id="trade-account-contact-fields-wrapper">
                    <div class="input-group">
                        <div class="input-group-btn">
                            <div data-bind="component: { name: 'mdc-select-component', params: title }"></div>
                        </div>
                        <div data-bind="component: { name: 'mdc-text-field-component', params: name }"></div>
                    </div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: role }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: mobile }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: work }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: email }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: skype }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: whatsApp }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: website }"></div>
                    <dl class="dl-horizontal">
                        <dt>
                            Receive
                        </dt>
                        <dd>
                            <label class="checkbox-label">
                                <input type="checkbox" class="checkbox-inline" data-bind="checked: receiveOrderConfirmations"/>
                                Order Confirmations
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" class="checkbox-inline" data-bind="checked: receiveMarketing"/>
                                Marketing Material
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" class="checkbox-inline" data-bind="checked: receiveFinancial"/>
                                Invoices, Statements &amp; Credit Notes
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" class="checkbox-inline" data-bind="checked: receivePricelists"/>
                                Pricelists
                            </label>
                        </dd>
                    </dl>
                </div>
            </div>
            <div class="modal-footer" data-bind="with: contactFactory">
                <!-- ko if: tradeAccountContactId() != null -->
                <button class="btn btn-red pull-left" data-bind="click: deleteContact">
                    Delete
                </button>
                <!-- /ko -->
                <button class="btn btn-blue pull-right" data-bind="click: save">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<script id="trade-account-contact-template" type="text/html">
    <div class="card">
        <label>
            <!-- ko if: Title -->
            <span data-bind="text: Title"></span>
            <!-- /ko -->
            <span data-bind="text: FullName"></span>
        </label>
        <span data-bind="text: Role"></span>
        <span data-bind="text: MobilePhone"></span>
        <span data-bind="text: WorkPhone"></span>
        <a data-bind="attr: { href: 'mailto:' + Email }, text: Email"></a>
        <div class="contact-buttons">
            <!-- ko if: SkypeID -->
            <a class="pull-left" data-bind="attr: { href: 'skype:' + SkypeID + '?call' }">
                <img class="contact-thumb" src="/Content/images/icons/skype.png" style="width: 24px; height: 24px;" />
            </a>
            <!-- /ko -->
            @*<!-- ko if: WhatsApp -->
            <a class="pull-left" data-bind="attr: { href: 'https://wa.me/' + WhatsApp, target: '_blank' }">
                <img class="contact-thumb" src="/Content/images/icons/whatsapp.png" />
            </a>
            <!-- /ko -->*@
            <a class="pull-right" data-bind="click: $parentContext.$parent.loadContactForEdit, attr: { href: 'javascript:;' }">
                edit
            </a>
            <div class="clearfix"></div>
        </div>
    </div>
</script>