                                    <button class="btn" style="width: 140px;" data-bind="css: { 'btn-success': (selectedLeadStatus() ? selectedLeadStatus().LeadStatusID == 9 : false), 'btn-danger': (selectedLeadStatus() ? selectedLeadStatus().LeadStatusID != 9 : true) }, click: function () { selectedLeadStatus({ LeadStatusID: 9, Name: 'Account Declined' }); $('#decline-reason').show(); }">
                                        Declined Account
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="decline-reason" class="col-xs-9">
                            <label class="col-form-label" style="width: 10%; float: right;"></label>
                            <textarea type="text" rows="6" style="width: 90%;" class="lead-status-reason form-control" data-bind="highlightNullField: leadStatusReason, textInput: leadStatusReason"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default pull-left @(Model.Properties?.Application_ButtonClass)" data-bind="click: function() { cancelDecline(); }">
                        Cancel
                    </button>
                    <div class="text-right">
                        <button class="btn btn-success @(Model.Properties?.Application_ButtonClass)" data-bind="click: function() { declineAndSubmit(); }">
                            Save
                        </button>
