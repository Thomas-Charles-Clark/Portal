            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Potential
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <select class="form-control" data-bind="highlightNullField: editingPotential, value: editingPotential, options: [{ 'text': 'Yes', 'value': true }, { 'text': 'No', value: false }], optionsText: 'text', optionsValue: 'value'"></select>
                    </div>
                </div>
                <div data-bind="visible: editingPotential">
                    <div class="form-group row">
                        <div class="col-xs-12">
                            <label class="col-form-label">
                                Value
                            </label>
                        </div>
                        <div class="col-xs-12">
                            <div class="input-group">
                                <span class="input-group-addon input-group-addon-default" data-bind="with: parent.companyCurrency"><span data-bind="text: Symbol"></span></span>
                                <input class="form-control" data-bind="highlightNullField: editingValue, numeric, forceNullOnEmpty: editingValue, textInput: editingValue.formatted" />
                                <!-- ko if: editingValueGBP -->
                                <span class="input-group-addon"></span>
                                <span class="gbp-conversion form-control form-group-span" data-bind="text: editingValueGBP.formatted"></span>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-xs-12">
                            <label for="custom-country" class="col-form-label">Financial Year</label>
                        </div>
                        <div class="col-xs-12">
                            <select class="form-control" data-bind="highlightNullField: editingFinancialYear, options: getAvailableFinancialYears(), value: editingFinancialYear, optionsText: 'Name', optionsValue: 'Value', optionsCaption: 'Please Select...'"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">Comment</label>
                    </div>
                    <div class="col-xs-12">
                        <div class="form-group row">
                            <div class="col-xs-12">
                                <textarea class="form-control" placeholder="Comment..." rows="3" data-bind="highlightNullField: editingNote, textInput: editingNote"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="text-right">
                    <button class="btn btn-success @(Model.Properties?.Application_ButtonClass)" aria-label="Close" data-bind="click: function() { saveLeadPotential(); }">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('#lead-accordion > .panel > .panel-collapse').collapse({
        parent: '#lead-accordion',
        toggle: false
    })

    $('#lead-form > .panel > .panel-collapse').collapse({
        parent: '#lead-form',
        toggle: false
    })

    $('#prepare-lead .panel > .panel-collapse').collapse({
        parent: '#prepare-lead',
        toggle: false
    })

    $('#complete-application .panel > .panel-collapse').collapse({
        parent: '#complete-application',
        toggle: false
    })

    $('#specify-payment-terms .panel > .panel-collapse').collapse({
        parent: '#specify-payment-terms',
        toggle: false
    })

    $(document).ready(function () {
        $(".star").hover(function () {
            $(this).prevAll().toggleClass('star-rated');
            $(this).toggleClass('star-rated');
        });

        $(".star").click(function () {

            $(this).prevAll().addClass('star-rated-saved');

            if ($.grep($(this).nextAll(), function (i) { return $(i).hasClass('star-rated-saved'); }).length > 0) {

            } else {
                $(this).toggleClass('star-rated-saved');
            }

            $(this).nextAll().each(function () {
                if ($(this).hasClass('star-rated-saved'))
                    $(this).removeClass('star-rated-saved');
            });

        });
    });

    $('[href="#tab-five"]').on('shown.bs.tab', function () {
        console.log('tab five was shown')
        //console.log('map shown');

        if ($('.bootstrap-switch-id-my-accounts-only').length > 0) {
            console.log('destroying bootstrap-switch on #my-accounts-only');
            $('#my-accounts-only').bootstrapSwitch('destroy');
        }

        $('#my-accounts-only').bootstrapSwitch({
            animate: false,
            labelText: 'My Accounts',
            onText: 'My Accounts',
            offText: 'All Accounts',
            state: false,
            offColor: 'primary',
            onSwitchChange: function (event, state) {
                switch (state) {
                    case true:
                        $('#my-accounts-only').bootstrapSwitch('labelText', 'All Accounts');
                        break;
                    case false:
                        $('#my-accounts-only').bootstrapSwitch('labelText', 'My Accounts');
                        break;
                }
                console.log('my accounts switch changed', state);
                viewModel.leadEdit.justMyAccounts(state);
                viewModel.leadEdit.loadTradeAccountsWithinProximity();
            }
        });

        if (_googleMap == null)
            initGoogleMap();

        viewModel.leadEdit.loadTradeAccountsWithinProximity();
    });
</script>

