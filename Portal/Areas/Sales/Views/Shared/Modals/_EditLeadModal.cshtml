@{
    bool creditControlOverride = false;

    @* Frida Skoglund, Paul Fearn, Super Admins, *@
    if (new int[] { 1299294, 1395367 }.Contains(User.Identity.GetUserId<int>()) || User.IsInRole("Super Admin"))
    {
        creditControlOverride = true;
    }
}
<script type="text/html" id="retail-appointment-template">
    <div class="form-group row">
        <div class="col-xs-12">
            <label>
                Requested Retail Appointment
            </label>
        </div>
        <!-- ko if: retailAppointmentType() -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentType().Name"></span>
            </span>
        </div>
        <!-- /ko -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentShop"></span>
            </span>
        </div>
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: moment(retailAppointmentDate()).format('dddd Do MMMM YYYY')"></span>
            </span>
        </div>
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentTime"></span>
            </span>
        </div>
    </div>
</script>
<script type="text/html" id="retail-appointment-template-actual-display">
    <!-- ko if: displayRetailAppointmentActuals() -->
    <div class="form-group row">
        <div class="col-xs-12">
            <label>
                Confirmed Appointment Details
            </label>
        </div>
        <!-- ko if: retailAppointmentActualType() -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentActualType().Name"></span>
            </span>
        </div>
        <!-- /ko -->
        <!-- ko if: retailAppointmentActualShop() -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentActualShop"></span>
            </span>
        </div>
        <!-- /ko -->
        <!-- ko if: retailAppointmentActualDate() -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: moment(retailAppointmentActualDate()).format('dddd Do MMMM YYYY')"></span>
            </span>
        </div>
        <!-- /ko -->
        <!-- ko if: retailAppointmentActualTime() -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentActualTime"></span>
            </span>
        </div>
        <!-- /ko -->
        <!-- ko if: retailAppointmentActualAssistant() -->
        <div class="col-xs-12">
            <span class="form-group span">
                <span data-bind="text: retailAppointmentActualAssistant"></span>
            </span>
        </div>
        <!-- /ko -->
    </div>
    <!-- /ko -->
    <!-- ko ifnot: displayRetailAppointmentActuals -->
    <div class="row">
        <div class="col-xs-12">
            <span class="text-danger">
                Unconfirmed Appointment
            </span>
        </div>
    </div>
    <!-- /ko -->
</script>
<script type="text/html" id="retail-appointment-template-actual-edit">
    <div class="form-group row">
        <div class="col-xs-12">
            <label>
                Confirmed Appointment Details
            </label>
        </div>
        <div class="col-xs-12 margin-bottom-10">
            <label class="col-form-label">
                Type
            </label>
            <select id="actual-retail-appointment-type" class="form-control" data-bind="value: retailAppointmentActualTypeId, options: availableRetailAppointmentTypes, optionsText: 'Name', optionsValue: 'RetailAppointmentTypeID', optionsCaption: 'Please Select'"></select>
        </div>
        <div class="col-xs-12 margin-bottom-10">
            <label class="col-form-label">
                Shop
            </label>
            <select id="actual-retail-appointment-shop" class="form-control" data-bind="value: retailAppointmentActualShop">
                <option value="">
                    Please Select
                </option>
                <option value="King's Road">
                    King's Road
                </option>
                <option value="Marylebone High Street">
                    Marylebone High Street
                </option>
            </select>
        </div>
        <div class="col-xs-12 margin-bottom-10">
            <label class="col-form-label">
                Date
            </label>
            <div data-bind="component: { name: 'mdc-date-time-picker-component', params: retailAppointmentActualDatePicker }"></div>
        </div>
        <div class="col-xs-12">
            <label class="col-form-label">
                Time
            </label>
            <select id="actual-retail-appointment-time" class="form-control" data-bind="value: retailAppointmentActualTime">
                <option value="">
                    Please Select
                </option>
                <option value="10:00">10:00</option>
                <option value="10:30">10:30</option>
                <option value="11:00">11:00</option>
                <option value="11:30">11:30</option>
                <option value="12:00">12:00</option>
                <option value="12:30">12:30</option>
                <option value="13:00">13:00</option>
                <option value="13:30">13:30</option>
                <option value="14:00">14:00</option>
                <option value="14:30">14:30</option>
                <option value="15:00">15:00</option>
                <option value="15:30">15:30</option>
                <option value="16:00">16:00</option>
                <option value="16:30">16:30</option>
            </select>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-xs-12">
            <label class="col-form-label">
                Store Consultant
            </label>
            <input type="text" class="form-control" data-bind="textInput: retailAppointmentActualAssistant" />
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <button class="btn btn-success pull-right" data-bind="click: saveActualRetailAppointmentDetails">
                Save
            </button>
            <span id="actual-appointment-save" style="display: none; line-height: 23px;" class="col-form-span alert alert-success pull-right margin-right-15">
                Saved
            </span>
        </div>
    </div>
</script>

