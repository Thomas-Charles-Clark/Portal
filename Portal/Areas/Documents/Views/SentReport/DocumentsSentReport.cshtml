@model Portal.Areas.Documents.ViewModels.DocumentsSentReportViewModel
@{
    ViewBag.Title = "Documents Sent Report";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/generic-forms")
    @Styles.Render("~/bundles/css/documents-sent-report")
    @Styles.Render("~/bundles/css/tempus-dominus")
    @Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/documents-sent-report")
    @Scripts.Render("~/bundles/js/tempus-dominus")

<script type="text/javascript">

        window.getDto = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Dto));
        }

        window.getDashboardPods = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.SentReport.DashboardPods))
        }

        window.getDashboardNotices = () => {
            return [];
        }
</script>

    <script type="text/javascript">

        var viewModel = documentsSentReportViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

    </script>
}
@section modals {

}

<script type="text/html" id="document-sent-row-template">
    <tr class="document-sent-row" data-bs-toggle="popover">
        <td data-bind="html: TradeAccount"></td>
        <td class="wrapping" data-bind="html: SentRegarding"></td>
        <td>
            <a href="javascript:;" data-bind="click: $parent.selectRow, text: Document, clickBubble: true"></a>
        </td>
        <td>
            <span data-bind="text: moment(SentDT).format('DD/MM/YYYY HH:mm')"></span>
        </td>
        <td data-bind="html: SentTo"></td>
        <td data-bind="html: SentBy"></td>
        <td data-bind="html: ReplyTo"></td>
    </tr>
</script>

<div class="blocker" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="page-heading-wrapper">
    <div class="page-heading-logo">
        <div></div>
    </div>
    <div class="page-heading text-right">
        @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
        {
            <h1 class="main-heading mb-3">
                @(Model.ApplicationHeading)
            </h1>
        }
        @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
        {
            <h4 class="sub-heading">
                <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
            </h4>
        }
    </div>
</div>

<div id="document-history-wrapper">
    <div class="tab-content" id="documents-sent-tabs-content">
        <div class="tab-pane active" id="browse-tab" role="tabpanel" aria-labelledby="browse-tab-btn">
            <div id="dashboard" style="display: none;" data-bind="visible: true">
                <div id="dashboard-pods" data-bind="with: dashboard">
                    <!-- ko foreach: sortedPods -->
                    <div class="dashboard-pod" data-bind="click: $parent.select, css: { 'active': $parent.selectedPod() == $data }">
                        <div data-bind="class: CSSClasses, html: HTMLContents"></div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
            <div id="prefilters" data-bind="with: filters">
                <div class="document-prefilter prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: documentParams }"></div>
                <div class="trade-account-prefilter prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
                <div class="document-date-range-prefilter date-prefilter prefilter">
                    <div class="date-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: documentDateRangeParams }"></div>
                </div>
                <div class="prefilter" style="display: none" data-bind="visible: documentDateRangeId() == -1">
                    <div class="from-date date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: documentFromDateParams }"></div>
                </div>
                <div class="prefilter" style="display: none" data-bind="visible: documentDateRangeId() == -1">
                    <div class="to-date date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: documentToDateParams }"></div>
                    <span class="validation-message text-danger" data-bind="validationMessage: documentFromDate"></span>
                    <span class="validation-message text-danger" data-bind="validationMessage: documentToDate"></span>
                    <span class="validation-message text-danger" data-bind="validationMessage: fromPreceedsTo"></span>
                </div>
                <div class="free-text-prefiler prefilter" data-bind="component: { name: 'mdc-text-field-component', params: freeTextSearchParams }"></div>
            </div>
            <div id="grid-wrapper">
                <div data-bind="kendoGrid: gridParams"></div>
            </div>
        </div>
    </div>
    <!-- ko if: viewingDocument -->
    <div id="viewing-document-wrapper" class="ratio" data-bind="css: { 'd-block': viewingDocumentLoaded }, with: viewingDocument">
        
    </div>
    <!-- /ko -->
</div>

<div id="generic-modal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Modal
                </h4>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="bold">
                    Important Notes
                </p>
                <p class="mb-0">
                    This is a modal window.
                </p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-bs-dismiss="modal">
                    Ok
                </button>
            </div>
        </div>
    </div>
</div>