@model Tasks.ViewModels.TasksViewModel
@{
    ViewBag.Title = "Tasks Dashboard - Designers Guild";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}

@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/product-maintenance")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/product-maintenance")

    <script type="text/javascript">

        window.getFormDefinitions = () => {
            return @Html.Raw(Model.FormJSON);
        }

        window.getFormData = () => {
            return @Html.Raw(Model.DataJSON);
        }

        let viewModel = productMaintenanceBaseViewModel(getFormDefinitions(), getFormData());

        let ftf = viewModel.fabricTreatmentFactory;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        $(document).ready(function () {
            ko.applyBindings(viewModel, document.body);
            window.setTimeout(() => {
                viewModel.ready();
            }, 0);
        });

        function getInitialWidget() {
            return '@Model.StartingWidget';
        }

        function getUserId() {
            return @Html.Raw(User.Identity.GetUserId<int>());
        }

        function getUserName() {
            return '@Html.Raw(Model.UserName)';
        }

        function getAvailableExternalCompanies() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ExternalCompanies));
        }

        function getAvailableProjects() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Projects));
        }

        function getAvailableTaskTypes() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.TaskTypes));
        }

        function getPreloaded() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Preloaded));
        }

        function getEmployeeHierarchyData() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.EmployeeHierarchyData));
        }

        $(document).ready(function () {

            viewModel = new tasksDashboardViewModel();

            ko.validation.init({
                decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
            });

            ko.options.deferUpdates = true;
            ko.applyBindings(viewModel, document.body);

            //$("#new-task-modal").modal('show');

            $("#new-task-due-date").attr('readonly', true);
            $("#new-task-due-date").click(function () {
                $("#new-task-due-date").data("kendoDatePicker").open();
            });

            $("#new-task-from-date").attr('readonly', true);
            $("#new-task-from-date").click(function () {
                $("#new-task-from-date").data("kendoDatePicker").open();
            });

            $("#new-task-until-date").attr('readonly', true);
            $("#new-task-until-date").click(function () {
                $("#new-task-until-date").data("kendoDatePicker").open();
            });

            $(".edit-task-delivery-date").attr('readonly', true);
            $(".edit-task-delivery-date").click(function () {
                $("input.edit-task-delivery-date").data("kendoDatePicker").open();
            });
            $("#g-recaptcha-tip").hide()
            //viewModel.preFilters.assignedToSlicer()._selectItemByText('Tom');
        });

        //$("#edit-task-tabs a").click

        //$('#new-task-modal').on('shown.bs.modal', function () {
        //    $(document).off('focusin.modal');
        //});
        //$('#edit-task-modal').on('shown.bs.modal', function () {
        //    $(document).off('focusin.modal');
        //});
</script>
}
