                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>*@
                    </div>
                    <div id="new-task-attachments" class="tab-pane">
                        <div class="row">
                            <div class="col-xs-12">
                                <form method="post" data-bind="kendoUpload: uploadSettings">
                                    <input name="files" type="file" multiple="multiple" />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: function() { closeModal(); }">
                    Cancel
                </button>
                <button class="btn btn-success pull-right" data-bind="click: function() { save(); }">
                    Save
                </button>
                <span class="col-form-span text-danger pull-right" data-bind="visible: errors.isAnyMessageShown()">
                    Please correct all errors
                </span>
                <span id="latest-task-id" class="col-form-span pull-right" style="margin-right: 25px;">
                </span>
            </div>
        </div>
        @*<div data-bind="visible: attachValidation()"></div>*@
    </div>
</div>