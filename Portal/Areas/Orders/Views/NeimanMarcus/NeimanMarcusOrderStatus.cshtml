<div id="summary-pods" style="display: none" data-bind="visible: true, foreach: summaryPods">
    <div class="summary-pod card" data-bind="css: { 'active': active }, click: $parent.summaryPodClick" tabindex="0">
        <div class="card-body">
            <h5 class="card-title" data-bind="text: Label"></h5>
            <div>
                <p data-bind="text: orderCountDisplay"></p>
                <p data-bind="text: salesTotalDisplay"></p>
            </div>
        </div>
    </div>
</div>

<div id="prefilters" style="display: none;" data-bind="visible: true">
    <div id="order-status-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: statusParams }"></div>
    <div id="order-date-prefilter">
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: dateRangeParams }"></div>
        <div class="custom-date-wrapper" style="display: none" data-bind="visible: dateRangeId() == -1">
            <div id="from-date" class="date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: fromDateParams }"></div>
        </div>
        <div class="custom-date-wrapper" style="display: none" data-bind="visible: dateRangeId() == -1">
            <div id="to-date" class="date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: toDateParams }"></div>
            <span class="validation-message text-danger" data-bind="validationMessage: fromDate"></span>
            <span class="validation-message text-danger" data-bind="validationMessage: toDate"></span>
            <span class="validation-message text-danger" data-bind="validationMessage: fromPreceedsTo"></span>
        </div>
    </div>
    <div id="search-term-prefilter" data-bind="component: { name: 'mdc-text-field-component', params: searchTermParams }"></div>
    <button id="search-btn" class="btn btn-dark" data-bind="click: performSearch">
        Search
        <i class="ms-3 bi bi-search"></i>
    </button>
</div>

<div id="order-status-grid" data-bind="kendoGrid: orderStatusGridSettings"></div>

<div id="grid-key" class="card">
    <div class="card-body">
        <div id="key-display">
            <div class="key-item">
                <div class="colour-box success"></div>
                <label>
                    Success / Complete
                </label>
            </div>
            <div class="key-item">
                <div class="colour-box in-progress"></div>
                <label>
                    In Progress
                </label>
            </div>
            <div class="key-item">
                <div class="colour-box delayed"></div>
                <label>
                    Overdue / Delayed
                </label>
            </div>
            <div class="key-item">
                <div class="colour-box errored"></div>
                <label>
                    Errored
                </label>
            </div>
            @*<div class="key-item">
                <div class="colour-box cancelled"></div>
                <label>
                    Cancelled
                </label>
            </div>*@
        </div>
    </div>
</div>