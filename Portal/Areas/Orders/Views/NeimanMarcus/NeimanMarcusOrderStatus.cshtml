@model Portal.Areas.Orders.ViewModels.NeimanMarcusOrderStatusViewModel
@{
    Layout = "~/Views/Shared/_Layout-New.cshtml";
    ViewBag.Title = "Neiman Marcus Order Status";
}
@section styles {
    @Styles.Render("~/bundles/css/neiman-marcus-order-status")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/neiman-marcus-order-status")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">

        let viewModel = neimanMarcusOrderStatusViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

        viewModel.ready();
    </script>
}
@section beforeContainer {
    <div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
        <div class="loading-spinner"></div>
        <h3 class="mt-3">
            Please Wait...
        </h3>
    </div>
}

<script type="text/html" id="row-template">
    <tr class="order-row">
        <td class="k-group-cell"></td>
        <td>
            <span data-bind="text: DG_OrderID"></span>
        </td>
        <td>
            <span data-bind="text: ProductCode"></span>
        </td>
        <td>
            <span data-bind="text: Quantity"></span>
        </td>
        <td>
            <div data-bind="html: SummaryStatus"></div>
        </td>
        <td class="slanted-column received">
            <div class="cell received" data-bind="class: ReceivedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column exploded">
            <div class="cell exploded" data-bind="class: ExplodedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column imported">
            <div class="cell imported" data-bind="class: ImportedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column verified">
            <div class="cell verified" data-bind="class: VerifiedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column acknowledged">
            <div class="cell acknowledged" data-bind="class: AcknowledgedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column packed">
            <div class="cell packed" data-bind="class: PackedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column drop-shipped">
            <div class="cell drop-shipped" data-bind="class: DropShipCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column shipped">
            <div class="cell shipped" data-bind="class: ShippedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column invoiced">
            <div class="cell invoiced" data-bind="class: InvoicedCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
        <td class="slanted-column cancelled">
            <div class="cell cancelled" data-bind="class: CancelledCell, actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>
        </td>
    </tr>
</script>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

