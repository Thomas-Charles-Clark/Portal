<script id="search-controls-template" type="text/html">
    <div>
        <div class="select-group">
            <!-- ko if: showSampleControl -->
            <select class="form-control" data-bind="value: sampleOrders, options: [{ name: 'Product Orders', value: false }, { name: 'Sample Orders', value: true }], optionsText: 'name', optionsValue: 'value'"></select>
            <!-- /ko -->
            <select class="form-control" data-bind="value: dateRangeType, options: availableDateRangeTypes, optionsValue: 'dateRangeTypeId', optionsText: 'name'"></select>
            <select class="form-control" data-bind="value: dateRange, options: dateRanges, optionsValue: 'dateRangeId', optionsText: 'name'"></select>
        </div>
        <!-- ko if: dateRange() == -1 -->
        <div class="custom-date-wrapper">
            <label>
                From
            </label>
            <input id="custom-from-date" class="date-picker" data-bind="kendoDatePicker: customFromDatePicker" />
            <label class="date-clear" data-bind="click: function () { customFromDatePicker.clear(); }">
                &times;
            </label>
        </div>
        <div class="custom-date-wrapper">
            <label>
                To
            </label>
            <input id="custom-to-date" class="date-picker" data-bind="kendoDatePicker: customToDatePicker" />
            <label class="date-clear" data-bind="click: function () { customToDatePicker.clear(); }">
                &times;
            </label>
            <span class="validation-message text-danger" data-bind="validationMessage: customFromDate"></span>
            <span class="validation-message text-danger" data-bind="validationMessage: customToDate"></span>
            <span class="validation-message text-danger" data-bind="validationMessage: fromPreceedsTo"></span>
        </div>
        <!-- /ko -->
    </div>
    <div>
        <div class="input-group">
            <input type="text" class="form-control" data-bind="enterKey: search, textInput: searchTerm, attr: { placeholder: 'Search by order number, product, or customer\'s reference' }" />
            <span class="input-group-btn">
                <button class="btn btn-flat" data-bind="click: search">
                    Search
                </button>
            </span>
        </div>
    </div>
</script>

