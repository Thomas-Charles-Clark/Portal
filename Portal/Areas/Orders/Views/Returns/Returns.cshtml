                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: function() { cancelCCRSelection(); }">
                    Cancel
                </button>
                <button class="btn btn-battleship-blue" data-bind="click: function () { arrangeReturnRegardlessOfExtant(); }">
                    Create a New Return Anyway
                </button>
            </div>
        </div>
    </div>
</div>

<div id="quantity-modal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    Quantity
                </h4>
            </div>
            <div class="modal-body" data-bind="with: returnLineConsideringQuantity">
                <span class="margin-right-15">
                    How many are going in this parcel?
                </span>
                <div class="btn-group">
                    <div class="quantity-control input-group">
                        <div class="input-group-btn">
                            <button class="btn btn-default" data-bind="click: function (data) { if (quantityParcelled() > 1) { quantityParcelled(+quantityParcelled() - 1); } }">
                                &minus;
                            </button>
                        </div>
                        <input type="number" step="1" min="0" class="form-control" data-bind="keepElement: quantityParcelled, numeric, value: quantityParcelled, attr: { step: 1, max: quantity, min: 0 }" />
                        <span class="input-group-btn">
                            <button class="btn btn-default" data-bind="click: function(data) { if (quantityParcelled() < quantity()) { quantityParcelled(+quantityParcelled() + 1); } }">
                                +
                            </button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: function() { cancelParcellingLine(); }">
                    Cancel
                </button>
                <button class="btn btn-battleship-blue" data-bind="click: function () { confirmParcellingLine(); }">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<div id="tracking-modal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" aria-label="Close" data-bind="click: hideTrackingModal">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">
                    Order:
                    <span data-bind="text: trackingOrderNumber"></span>
                    -
                    Tracking Information
                </h4>
            </div>
            <div class="modal-body">
                <ul>
                    <!-- ko foreach: trackingResults -->
                    <li>
                        <label data-bind="text: Parcel"></label>
                        <span class="display-block" data-bind="text: ProductCodes"></span>
                        <span class="display-block" data-bind="text: Descriptions"></span>
                        <a class="display-block" data-bind="attr: { href: TrackingURL }, text: TrackingURL"></a>
                    </li>
                    <!-- /ko -->
                </ul>
            </div>
        </div>
    </div>
</div>

<div id="order-detail-modal" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" aria-label="Close" data-bind="click: hideOrderDetailModal">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">
                    Order Details:
                    <span data-bind="text: orderDetailsOrderNumber"></span>
                </h4>
            </div>
            <div class="modal-body">
                <dl class="dl-horizontal">
                    <dt>
                        Order Date
                    </dt>
                    <dd data-bind="text: moment(orderDetailsOrderDate()).format('dddd Do MMMM YYYY')"></dd>
                    </dl>
                <dl class="dl-horizontal" data-bind="with: orderDetailsDeliveryInfo">
                    <dt>
                        Delivery Name
                    </dt>
                    <dd data-bind="text: DeliveryName"></dd>
                    <dt>
                        Address Line 1
                    </dt>
                    <dd data-bind="text: AddressLine1"></dd>
                    <dt>
                        Address Line 2
                    </dt>
                    <dd data-bind="text: AddressLine2"></dd>
                    <dt>
                        Address Line 3
                    </dt>
                    <dd data-bind="text: AddressLine3"></dd>
                    <dt>
                        Address Line 4
                    </dt>
                    <dd data-bind="text: AddressLine4"></dd>
                    <dt>
                        Postal Code / Zip
                    </dt>
                    <dd data-bind="text: PostalCode"></dd>
                    <dt>
                        Phone Number
                    </dt>
                    <dd data-bind="text: PhoneNumber"></dd>
                    <dt>
                        Haulier Description
                    </dt>
                    <dd data-bind="text: HaulierDescription"></dd>
                </dl>
                <div data-bind="with: orderDetailsDeliveryInfo">

                </div>
                <div data-bind="kendoGrid: ordersDetailsGrid"></div>
            </div>
        </div>
    </div>
</div>