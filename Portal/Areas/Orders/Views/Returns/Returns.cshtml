@model Portal.Areas.Orders.ViewModels.TradeOrdersReturnsViewModel
@{
    ViewBag.Title = "Returns";
    
    var firstTab = 3;
    var firstStatus = "despatchedOrders";

    if (Request.QueryString.AllKeys.Contains("tab"))
    {
        switch (Request.QueryString["tab"])
        {
            case "backOrders":
                firstTab = 1;
                firstStatus = Request.QueryString["tab"];
                break;
            case "reserveOrders":
                firstTab = 2;
                firstStatus = Request.QueryString["tab"];
                break;
            case "dispatched":
            case "despatched":
            case "dispatchedOrders":
            case "despatchedOrders":
                firstTab = 3;
                firstStatus = "despatchedOrders";
                break;
            case "ordersInProgress":
                firstTab = 4;
                firstStatus = Request.QueryString["tab"];
                break;
            case "held":
                firstTab = 5;
                firstStatus = Request.QueryString["tab"];
                break;
            default:
                break;
        }
    }
}
@section styles {
    @Styles.Render("~/bundles/css/order-returns")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/order-returns")

    <script type="text/javascript">
        function getUPSAccounts() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.UPSAccounts))
        }
        function getUserName() {
            return '@(User.Identity.GetFullName())';
        }
    </script>

    <script id="return-line-template" type="text/html">
        <div class="return-line">
            <label class="display-block">
                Product Code: <span class="font-normal" data-bind="text: ProductCode"></span>
            </label>
            <label class="display-block">
                Description: <span class="font-normal" data-bind="text: Product?.Name"></span>
            </label>
            <label class="display-block">
                Quantity: <span class="font-normal" data-bind="text: quantity"></span>
            </label>
            <label class="display-block">
                Unit: <span class="font-normal" data-bind="text: Product?.StockUnit?.Units"></span>
            </label>
        </div>
    </script>
    
    <script id="returning-line-template" type="text/html">
        <div class="return-line returning-line">
            <button class="close pull-right" data-bind="click: function(data, event) { $parent.removeLine(data); }">
                &times;
            </button>
            <label class="display-block">
                Product Code: <span class="font-normal" data-bind="text: ProductCode"></span>
            </label>
            <label class="display-block">
                Description: <span class="font-normal" data-bind="text: Product?.Name"></span>
            </label>
            <label class="display-block">
                Quantity: <span class="font-normal" data-bind="text: quantityParcelled"></span>
            </label>
            <label class="display-block">
                Unit: <span class="font-normal" data-bind="text: Product?.StockUnit?.Units"></span>
            </label>
        </div>
    </script>

    <script type="text/javascript">
        ko.bindingHandlers.kendoSortable.options = {
            connectWith: ".return-line",
            placeholder: function(element) {
                return element.clone().css({
                    "opacity": 0.3,
                    "border": "1px dashed #000000"
                }).addClass('placeholder');
            }
        };

        function getAvailableTags() {
            return [];
        }

        function getPreselectedTradeAccount() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedTradeAccount))
        }
        
        $(document).ready(function () {
            $('#accounts-menu a[data-toggle="tab]').on('show.bs.tab', function (e) {
                let orderStatus = e.target.data('refresh');
                viewModel.searchTerm(undefined);
                viewModel.viewingStatus(orderStatus)
                viewModel.refresh(orderStatus, false);
            });
            viewModel.busy(false);
            viewModel.ready(true);
            //viewModel.refresh('@(firstStatus)');
        });

        var viewModel = new tradeOrderReturnsViewModel();

        $(document).ready(function () {
            ko.applyBindings(viewModel, document.body);

            //viewModel.customerCareRecord('222234');
            //viewModel.claimRecordAutocomplete.observable(viewModel.customerCareRecord());
            //viewModel.fetchCCRDetails(function () {
            //    window.setTimeout(function () {
            //        viewModel.collectionAddress.phone.observable('07400123456');
            //        window.setTimeout(function () {
            //            viewModel.confirmCollectionAddress(function () {

            //            });
            //        }, 500);
            //    }, 300);
            //});
        });
    </script>
}
@section modals {
    @Html.Partial("Modals/_ImageModal")
