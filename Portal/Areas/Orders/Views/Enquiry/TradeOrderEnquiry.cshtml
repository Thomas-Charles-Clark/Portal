@model Portal.Areas.Orders.ViewModels.TradeOrdersEnquiryViewModel
@{
    ViewBag.Title = "Trade Order Enquiry";
}
@section styles {
    @Styles.Render("~/bundles/css/order-search")
    @Styles.Render("~/Areas/Orders/Content/trade-order-enquiry.css")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/order-search")
    @Scripts.Render("~/bundles/js/trade-order-enquiry")

    <script type="text/javascript">
        $(function () {

            $('#from-calendar-btn').click(
                function () {
                    $(this).closest('.date').find(".date-input").data("DateTimePicker").toggle();
                }
            );

            $('#to-calendar-btn').click(
                function () {
                    $(this).closest('.date').find(".date-input").data("DateTimePicker").toggle();
                }
            );
        });

        var viewModel = new tradeOrderEnquiryViewModel();


        $(document).ready(function () {
            ko.applyBindings(viewModel, document.body);
            $("#order-search").focus();
        });
    </script>
}
@section modals {
    @Html.Partial("Modals/_ImageModal")
    @Html.Partial("Modals/_AddressModal")
}

<div class="row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

@Html.Action("TradeAccountSelector", "Component", new { Area = "", canSearch = Model.CanSearch })

<div class="row margin-top-15" style="display: none;" data-bind="visible: tradeAccountSelector().selected">
    <div class="col-xs-12">
        @Html.Action("OrderSearch", "Component", new { Area = "" })
    </div>
</div>