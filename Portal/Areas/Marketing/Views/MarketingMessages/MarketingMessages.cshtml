@model Portal.Areas.Marketing.ViewModels.MarketingMessagesViewModel
@{
    ViewBag.Title = "MarketingMessages";
}
@section styles {
    @Styles.Render("~/bundles/css/marketing-messages")
}
@section scripts {
    @Scripts.Render("~/bundles/js/marketing-messages")
    @Scripts.Render("~/bundles/js/jqueryui")

    <script type="text/javascript">
        var viewModel = new marketingMessagesViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

    </script>
}
@section modals {
    @Html.Partial("Modals/_MarketingMessageModal")
}
@section beforeContainer {
    <div class="page-busy-wrapper" style="display: none;" data-bind="fadeVisible: busy">
        <div class="form-busy">
            <div class="busy-bars">
                <div class="rect1 alert alert-info"></div>
                <div class="rect2 alert alert-info"></div>
                <div class="rect3 alert alert-info"></div>
                <div class="rect4 alert alert-info"></div>
                <div class="rect5 alert alert-info"></div>
            </div>
        </div>
    </div>
}

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
                <button style="float: right;" class="btn btn-success" data-bind="click: function() { startNewMessage() }">
                    Create Marketing Message
                    <span class="material-icons create-message">&#xE150;</span>
                </button>
            }
        </div>
    </div>
</div>

<div class="row" style="display: none;" data-bind="visible: true">
    <div class="col-xs-12">
        <div style="position: relative">
            <div id="grid-loading" class="panel-busy-wrapper" style="border-radius: 4px;">
                <div class="form-busy">
                    <div class="busy-bars">
                        <div class="rect1 alert alert-info"></div>
                        <div class="rect2 alert alert-info"></div>
                        <div class="rect3 alert alert-info"></div>
                        <div class="rect4 alert alert-info"></div>
                        <div class="rect5 alert alert-info"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div id="result-grid" data-bind="kendoGrid: resultGridSettings"></div>
                </div>
            </div>
        </div>
    </div>
</div>