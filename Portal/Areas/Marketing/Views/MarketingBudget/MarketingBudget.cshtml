@model Portal.Areas.Marketing.ViewModels.MarketingBudgetViewModel
@{
    ViewBag.Title = "Marketing Budget";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/marketing-budget")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/marketing-budget")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">
        let viewModel = marketingBudgetViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

    </script>
}
@section modals {

}
@section beforeContainer {
    <div class="blocker" style="display: flex;" data-bind="flexVisible: busy, toggleOpacity: busy">
        <div class="loading-spinner"></div>
        <h3 class="my-3">
            Please Wait
        </h3>
    </div>
}

<script id="marketing-budget-row-template" type="text/html">
    <tr>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
    </tr>
</script>

<div class="grid mb-3">
    <div class="g-col-12 relative">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="grid" style="display: none;" data-bind="visible: true">
            <div class="g-col-3">
                <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: priceListParams }"></div>
            </div>
            <div class="g-col-3">
                <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: marketingChannelParams }"></div>
            </div>
            <div class="g-col-2">
                <div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: periodParams }"></div>
            </div>
        </div>
    </div>
</div>
<div data-bind="kendoGrid: gridSettings"></div>