@model BankAccountsViewModel
@{
	ViewBag.Title = "Bank Accounts";
}
@section styles {
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/bank-accounts")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/full-width-app")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/accounts/bank-accounts")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	<script type="text/javascript">
		window.isCreditControlApp = () => "C";

		@if (User.Identity.GetUserId<int>() == 8)
		{
			<text>
			window.getPredefinedFilterParams = () =>
			{
				return {
					//tradeAccountCode: 'K0098'
				}
			}
			</text>
		}
		else
		{
			<text>
			window.getPredefinedFilterParams = () =>
			{
				return {}
			}
			</text>
		}

	</script>

	<script type="text/javascript">

		var viewModel = bankAccountsViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		viewModel.init();

		window.self = viewModel;

	</script>
}
@section modals {

}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div id="bank-accounts-container" class="d-flex align-items-start w-100" data-bind="flexFadeVisible: true">
	<main id="bank-accounts-main">
		<ul class="nav nav-tabs" id="bank-account-tabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link fs-5 active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-tab-pane" type="button" role="tab" aria-controls="dashboard-tab-pane" aria-selected="true">
					Maintain Banking Information
				</button>
			</li>
		</ul>
		<div class="tab-content" id="overview-tab-content">
			<div class="tab-pane fade show active" id="overview-tab-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
				<div id="bank-account-grid-container" data-bind="kendoGrid: gridParams"></div>
			</div>
		</div>
	</main>
</div>