<div id="main-credit-control-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: filters.togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: filters.countDisplay"></label>
			</div>
			<div id="sidebar-collapse" class="sidebar-body">
				<form id="credit-control-prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Customers
						</h5>
						<div id="credit-control-sales-markets-prefilter" class="prefilter" data-bind="component: { name: 'mdc-bootstrap-multiselect-component', params: salesMarketsParams }"></div>
						<div id="credit-control-sales-representative-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesRepresentativeParams }"></div>
						<div id="credit-control-sales-agent-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesAgentParams }"></div>
						<div id="credit-control-sales-area-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesAreaParams }"></div>
						<div id="credit-control-country-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryParams }"></div>
						<div id="credit-control-credit-controller-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: creditControllerParams }"></div>
						<div id="credit-control-trade-account-type-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeParams }"></div>
						<div id="credit-control-trade-account-type-group-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeGroupParams }"></div>
						<div id="credit-control-trade-account-group-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountGroupParams }"></div>
						<div id="credit-control-trade-account-company" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountCompanyParams }"></div>
						<div id="credit-control-payment-terms-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsParams }"></div>
						<div id="credit-control-payment-terms-type-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsTypeParams }"></div>
						<div id="credit-control-credit-stopped-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: creditStoppedParams }"></div>
						<div id="credit-control-trade-account-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
						<div id="credit-control-debt-funder-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: debtFunderParams }"></div>
						<div id="credit-control-currency-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: currencyParams }"></div>
						<div id="credit-control-trade-account-status-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountStatusParams }"></div>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Invoice
						</h5>
						<div id="invoice-company-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: invoiceCompanyParams }"></div>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Sales Analysis
						</h5>
						<div id="sales-history-analysis-period-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesHistoryAnalysisPeriodsParams }"></div>
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: filters.reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
	<main id="credit-control-main">
		<ul class="nav nav-tabs" id="credit-control-tabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-tab-pane" type="button" role="tab" aria-controls="dashboard-tab-pane" aria-selected="true">
					Dashboard
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="order-release-tab" data-bs-toggle="tab" data-bs-target="#order-release-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">
					Portal Order Release <span data-bind="with: selectedTradeAccount">
						<span data-bind="text: `: ${TradeAccountCode} - ${TradeAccountName}`"></span>
					</span>
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="statements-tab" data-bs-toggle="tab" data-bs-target="#statements-tab-pane" type="button" role="tab" aria-controls="statements-tab-pane" aria-selected="false">
					Statements
				</button>
			</li>
		</ul>
		<div class="tab-content" id="credit-control-tab-content">
			<div class="tab-pane fade show active" id="dashboard-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
				<div id="performance-container">
					<div class="accordion" id="performance-accordion">
						<div class="accordion-item relative" data-bind="with: performance">
							<h2 class="accordion-header">
								<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#performance-collapse" aria-expanded="false" aria-controls="performance-collapse">
									<span>
										Performance
									</span>
								</button>
							</h2>
							<div id="performance-collapse" class="accordion-collapse collapse" data-bs-parent="#performance-accordion">
								<div class="blocker" data-bind="flexFadeVisible: busy">
									<h4 class="loading-title" data-bind="text: busyMessage"></h4>
									<div class="loading-spinner"></div>
								</div>
								<div class="accordion-body">
									<table class="performance-table table table-bordered" style="display: none" , data-bind="visible: periods().length">
										<colgroup>
											<col />
											<!-- ko foreach: periods -->
											<col />
											<!-- /ko -->
										</colgroup>
										<thead>
											<tr>
												<th>
													<div class="prefilters">
														<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: reportingGroupParams }"></div>
														<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: currencyOrSterlingParams }"></div>
													</div>
												</th>
												<th>
													Trade Account Count
												</th>
												<th>
													Credit Stopped Count
												</th>
												<th>
													Twelve Month Order Count
												</th>
												<th>
													Twelve Month Order Value
												</th>
												<!-- ko foreach: periods -->
												<th>
													<span data-bind="text: $data"></span>
												</th>
												<!-- /ko -->
											</tr>
										</thead>
										<tbody data-bind="foreach: records">
											<tr class="totals-row">
												<th>
													<span data-bind="text: currencyCode"></span>
												</th>
												<th>
													<span data-bind="text: formatNumber(tradeAccountCount, 0, formattingCulture)"></span>
												</th>
												<th>
													<span data-bind="text: formatNumber(creditStoppedCount, 0, formattingCulture)"></span>
												</th>
												<th>
													<span data-bind="text: formatNumber(twelveMonthOrderCount, 0, formattingCulture)"></span>
												</th>
												<th>
													<span data-bind="text: formatCurrency(twelveMonthOrderValue, 0, formattingCulture, currencyCode)"></span>
												</th>
