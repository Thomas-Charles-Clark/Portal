<div id="main-credit-control-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<main id="credit-control-main">
		<ul class="nav nav-tabs" id="credit-control-tabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-tab-pane" type="button" role="tab" aria-controls="dashboard-tab-pane" aria-selected="true">
					Dashboard
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="manage-ledger-tab" data-bs-toggle="tab" data-bs-target="#manage-ledger-tab-pane" type="button" role="tab" aria-controls="mange-ledger-tab-pane" aria-selected="false">
					Manage Ledger
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="order-release-tab" data-bs-toggle="tab" data-bs-target="#order-release-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">
					Portal Order Release <span data-bind="with: selectedTradeAccount">
						<span data-bind="text: `: ${TradeAccountCode} - ${TradeAccountName}`"></span>
					</span>
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="statements-tab" data-bs-toggle="tab" data-bs-target="#statements-tab-pane" type="button" role="tab" aria-controls="statements-tab-pane" aria-selected="false">
					Statements
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="paying-off-with-proforma-tab" data-bs-toggle="tab" data-bs-target="#paying-off-with-proforma-tab-pane" type="button" role="tab" aria-controls="paying-off-with-proforma-tab-pane" aria-selected="false">
					Pay off Invoices with Proforma Deposits
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="online-payment-history-tab" data-bs-toggle="tab" data-bs-target="#online-payment-history-pane" type="button" role="tab" aria-controls="online-payment-history-pane" aria-selected="false">
					Online Payment History
				</button>
			</li>
		</ul>
		<div class="tab-content" id="credit-control-tab-content">
			<div class="tab-pane fade show active" id="dashboard-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
				<div id="dashboard-tab-flex-container" style="display: none" data-bind="flexFadeVisible: true">
					<!-- ko template: { name: 'sidebar-template', data: filters } --><!-- /ko -->
					<div id="dashboard-main">
						<div id="performance-container">
							<div class="accordion" id="performance-accordion">
								<div class="accordion-item relative" data-bind="with: performance">
									<h2 class="accordion-header">
										<button id="performance-collapse-btn" class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#performance-collapse" aria-expanded="false" aria-controls="performance-collapse">
											<span>
												Performance
											</span>
										</button>
									</h2>
									<div id="performance-collapse" class="accordion-collapse collapse" data-bs-parent="#performance-accordion">
										<div class="blocker" data-bind="flexFadeVisible: busy">
											<h4 class="loading-title" data-bind="text: busyMessage"></h4>
											<div class="loading-spinner"></div>
										</div>
										<div class="accordion-body">
											<table class="performance-table table table-bordered" style="display: none" , data-bind="visible: periods().length">
												<colgroup>
													<col width="240" />
													<!-- ko foreach: periods -->
													<col />
													<!-- /ko -->
												</colgroup>
												<thead>
													<tr>
														<th>
															<div class="prefilters">
																<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: reportingGroupParams }"></div>
																<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: currencyOrSterlingParams }"></div>
															</div>
														</th>
														<!-- ko foreach: periods -->
														<th>
															<span data-bind="text: columnLabel"></span>
														</th>
														<!-- /ko -->
													</tr>
												</thead>
												<tbody data-bind="foreach: rowGrouping">
													<tr data-bind="css: { 'totals-row': isTotalRow }">
														<!-- ko if: isTotalRow -->
														<th>
															<span data-bind="text: rowLabel"></span>
														</th>
														<!-- ko foreach: $parent.periods() -->
														<th>
															<span data-bind="text: $parentContext.$parent.performanceCellLookup($parent.rowIndex, columnIndex)?.Value ?? ''"></span>
														</th>
														<!-- /ko -->
														<!-- /ko -->
														<!-- ko ifnot: isTotalRow -->
														<td>
															<span data-bind="text: rowLabel"></span>
														</td>
														<!-- ko foreach: $parent.periods() -->
														<td>
															<span data-bind="text: $parentContext.$parent.performanceCellLookup($parent.rowIndex, columnIndex)?.Value ?? ''"></span>
														</td>
														<!-- /ko -->
														<!-- /ko -->
													</tr>
												</tbody>
											</table>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="grouped-pods-container accordion" data-bind="foreach: groupedPods">
							<div class="pod-group accordion-item">
								<h4 class="pod-group-title accordion-header">
									<button type="button" class="accordion-button" data-bs-toggle="collapse" data-bind="html: groupName, attr: { 'data-bs-target': `#sales-ledger-pod-group-${$index()}` }"></button>
								</h4>
								<div class="accordion-collapse collapse show" data-bind="attr: { id: `sales-ledger-pod-group-${$index()}` }">
									<div class="pods">
										<!-- ko foreach: pods -->
										<div class="pod" data-bind="css: { 'selected-pod': $parentContext.$parent.selectedPod()?.PodHandle == PodHandle }">
											<div data-bind="class: Classes">
												<h4 data-bind="html: Heading"></h4>
												<div data-bind="html: Stats"></div>
												<a href="#" class="stretched-link" data-bind="click: $parentContext.$parent.podClick"></a>
											</div>
										</div>
										<!-- /ko -->
									</div>
								</div>
							</div>
						</div>
						@*<div class="dashboard" style="display: none" data-bind="visible: dashboardPods().length, foreach: dashboardPods">
							<div class="dashboard-pod card" data-bind="css: { 'selected-pod': $parent.selectedPod() == $data }">
								<div class="card-body" data-bind="class: Classes">
									<h4 data-bind="html: Heading"></h4>
									<div data-bind="html: Stats"></div>
									<a href="#" class="stretched-link" data-bind="click: $parent.dashboardClick"></a>
								</div>
							</div>
						</div>*@
						<div class="selected-filter-pills">
							<!-- ko template: { name: 'filter-pills-template', data: filters } --><!-- /ko -->
							<div class="dropdown ms-3" style="display: none" data-bind="visible: true">
								<a class="btn btn-secondary dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
									<i class="bi bi-list-check"></i>
								</a>
								<!-- ko template: { name: 'credit-control-quantity-value-dropdown-container', data: filters } --><!-- /ko -->
							</div>
							<button class="btn btn-dark btn-export ms-auto" data-bind="click: exportToExcel">
								Export to Excel
								<i class="bi bi-download"></i>
								<i class="bi bi-filetype-xlsx"></i>
							</button>
							<!-- ko if: filters.initTooltips() --><!-- /ko -->
						</div>
						<div id="credit-control-grid-container" data-bind="kendoGrid: gridParams"></div>
						@*<div id="credit-control-scroller-container" class="virtual-scoller-container" data-bind="with: virtualScoller">
			<table id="credit-control-main-table" class="table  virtual-scrolling-table table-condensed table-striped table-hover">
				<colgroup data-bind="foreach: $parent.gridColumns">
					<col data-bind="style: { width: `${$data.width}px` }">
				</colgroup>
				<thead>
					<tr>
						<!-- ko foreach: $parent.gridColumns -->
						<!-- ko if: typeof columns == 'undefined' -->
						<th data-bind="style: { '--left-offset': `${$parentContext.$parent.gridColumns.reduce((a, c, i) => a += i < $index() ? c.width : 0, 0)}px` }" style="--left-offset: 0px;"></th>
						<!-- /ko -->
						<!-- ko if: typeof columns != 'undefined' -->
						<!-- ko foreach: columns -->
						<th data-bind="attr: { colspan: $parent.columns.length }, style: { '--left-offset': `${$parentContext.$parentContext.$parent.gridColumns.reduce((a, c, i) => a += i < $index() ? c.width : 0, 0)}px` }" style="--left-offset: 0px;">
							<span data-bind="text: columnNameDisplay"></span>
						</th>
						<!-- /ko -->
						<!-- /ko -->
						<!-- /ko -->
					</tr>
					<tr>
						<!-- ko foreach: $parent.gridColumns -->
						<th class="sortable-column" data-bind="click: $root.sortByColumn, style: { '--left-offset': `${$parentContext.$parent.gridColumns.reduce((a, c, i) => a += i < $index() ? c.width : 0, 0)}px` }" style="--left-offset: 0px;">
							<span data-bind="text: columnNameDisplay"></span>
							<!-- ko if: (Object.hasOwn($data, 'direction') && $data.direction()) -->
							<i class="bi bi-caret-down" data-bind="css: { 'bi-caret-up': direction() == 'asc', 'bi-caret-down': direction() == 'desc' }"></i>
							<!-- /ko -->
						</th>
						<!-- /ko -->
					</tr>
				</thead>
				<tbody class="virtual-spacing">
					<tr>
						<td colspan="500" style="height: 0" data-bind="style: { height: `${gridScrollTopPadding()}px` }"></td>
					</tr>
				</tbody>
				<tbody data-bind="foreach: { data: visibleItems, as: 'record' }">
					<tr class="visible-item">
						<!-- ko foreach: $parentContext.$parent.gridColumns -->
						<!-- ko template: { name: 'main-grid-row-template', data: { column: $data, record: record } } --><!-- /ko -->
						<!-- /ko -->
					</tr>
				</tbody>
				<tbody class="virtual-spacing">
					<tr class="final-row">
						<td colspan="500" style="height: 0" data-bind="style: { height: `${gridScrollBottomPadding()}px` }"></td>
					</tr>
				</tbody>
			</table>
		</div>*@
					</div>
				</div>
			</div>
			<div class="tab-pane fade" id="manage-ledger-tab-pane" role="tabpanel" aria-labelledby="manage-ledger-tab" tabindex="0">
				<div id="manage-ledger-tab-flex-container" data-bind="with: manageLedger">
					<div class="blocker" data-bind="flexFadeVisible: busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: busyMessage"></h4>
					</div>
					<!-- ko template: { name: 'sidebar-template', data: filters } --><!-- /ko -->
					<div id="manage-ledger-main">
						<div id="manage-ledger-grid-container">
							<!-- ko template: { name: 'sales-ledger-template' } --><!-- /ko -->
						</div>
					</div>
				</div>
			</div>
			<div class="tab-pane fade" id="order-release-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
				<div id="order-release-container" data-bind="with: memberBasketFetcher">
					<!-- ko template: { name: 'held-orders-template' } --><!-- /ko -->
				</div>
			</div>
			<div class="tab-pane fade" id="statements-tab-pane" role="tabpanel" aria-labelledby="statements-tab" tabindex="0">
				<div id="statements-tab-flex-container" data-bind="with: statements">
					<div class="blocker" data-bind="flexFadeVisible: busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: busyMessage"></h4>
					</div>
					<!-- ko template: { name: 'sidebar-template', data: filters } --><!-- /ko -->
					<div id="statements-main">
						<div id="statements-grid-container">
							<!-- ko template: { name: 'sales-ledger-template' } --><!-- /ko -->
						</div>
					</div>
				</div>
				@*<form id="send-statements-controls" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
						<div class="trade-account-prefilter prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: statementsTradeAccountParams }"></div>
						<div class="prefilter">
							<div class="date-prefilter" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: dateParams }"></div>
							<span class="validation-message" data-bind="validationMessage: date"></span>
						</div>
					</form>
					<div id="controls-wrapper">
						<button class="btn btn-dark" data-bind="click: sendStatements">
							Send Statements
						</button>
					</div>
					<div id="response-container" data-bind="html: sendResponse"></div>*@
			</div>
			<div id="paying-off-with-proforma-tab-pane" class="tab-pane fade">
				<div class="prefilters mb-3" data-bind="with: filters">
					<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: outstandingInvoicesTradeAccountParams }"></div>
					<div id="outstanding-invoices-date-prefilter-container" class="prefilter">
						<div class="date-prefilters">
							<div id="outstanding-invoices-date-type-prefilter" class="date-prefilter prefilter relative">
								<div class="date-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: outstandingInvoicesDateRangeParams }"></div>
							</div>
							<div id="outstanding-invoices-from-date" class="prefilter" style="display: none" data-bind="visible: outstandingInvoicesDateRangeId() == -1">
								<div class="from-date date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: outstandingInvoicesFromDateParams }"></div>
							</div>
							<div id="outstanding-invoices-to-date" class="prefilter" style="display: none" data-bind="visible: outstandingInvoicesDateRangeId() == -1">
								<div class="to-date date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: outstandingInvoicesToDateParams }"></div>
							</div>
						</div>
						<span class="validation-message text-danger" data-bind="validationMessage: outstandingInvoicesFromDate"></span>
						<span class="validation-message text-danger" data-bind="validationMessage: outstandingInvoicesToDate"></span>
						<span class="validation-message text-danger" data-bind="validationMessage: outstandingInvoicesFromPrecedesTo"></span>
					</div>
					<div id="outstanding-invoices-banking-currency-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: outstandingInvoicesCurrencyParams }"></div>
					<div class="prefilter" data-bind="component: { name: 'mdc-text-field-component', params: outstandingInvoicesSearchTermParams }"></div>
				</div>
				<div data-bind="kendoGrid: outstandingInvoices.gridParams"></div>
			</div>
			<div id="online-payment-history-pane" class="tab-pane fade">
				<div class="prefilters mb-3" data-bind="with: filters">
					<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentHistoryTradeAccountParams }"></div>
					<div id="payment-history-credit-controller-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentHistoryCreditControllerParams }"></div>
					<div id="payment-history-payment-status-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentHistoryPaymentStatusParams }"></div>
					<div id="payment-history-date-prefilter-container" class="prefilter">
						<div class="date-prefilters">
							<div id="payment-history-date-type-prefilter" class="date-prefilter prefilter relative">
								<div class="date-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentHistoryDateRangeParams }"></div>
							</div>
							<div id="payment-history-from-date" class="prefilter" style="display: none" data-bind="visible: paymentHistoryDateRangeId() == -1">
								<div class="from-date date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: paymentHistoryFromDateParams }"></div>
							</div>
							<div id="payment-history-to-date" class="prefilter" style="display: none" data-bind="visible: paymentHistoryDateRangeId() == -1">
								<div class="to-date date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: paymentHistoryToDateParams }"></div>
							</div>
						</div>
						<span class="validation-message text-danger" data-bind="validationMessage: paymentHistoryFromDate"></span>
						<span class="validation-message text-danger" data-bind="validationMessage: paymentHistoryToDate"></span>
						<span class="validation-message text-danger" data-bind="validationMessage: paymentHistoryFromPrecedesTo"></span>
					</div>
					<div id="payment-history-banking-account-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentHistoryBankAccountParams }"></div>
					<div id="payment-history-banking-currency-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentHistoryCurrencyParams }"></div>
					<div class="prefilter" data-bind="component: { name: 'mdc-text-field-component', params: paymentHistorySearchTermParams }"></div>
				</div>
				<div data-bind="kendoGrid: paymentHistory.gridParams"></div>
			</div>
		</div>
	</main>
</div>