<div class="modal fade" id="statement-send-modal" tabindex="-1">
	<div class="modal-dialog" id="statement-send-modal-dialog">
		<div class="modal-content" data-bind="with: statements">
			<div class="blocker" data-bind="flexFadeVisible: busy">
				<div class="loading-spinner"></div>
				<h4>
					Please Wait...
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<h4 class="modal-title">
					Send Statement(s)
				</h4>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p class="fs-5">
					<span data-bind="text: modalMessage"></span>
				</p>
				<div class="d-flex justify-content-between align-items-center">
					<div class="d-inline-flex gap-3 align-items-center">
						<label>
							Statement Date
						</label>
						<div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: statementDateParams }"></div>
					</div>
					<a class="btn btn-dark statement-btn" href="javascript:;" data-bind="click: sendStatements" target="_blank">
						Send
						<i class="bi bi-receipt-cutoff ms-2"></i>
					</a>
				</div>
			</div>
		</div>
	</div>
</div>

