<div id="credit-control-content" class="card">
	<div class="card-body">
		<form id="credit-control-prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
			<div id="credit-control-sales-markets-prefilter" class="prefilter" data-bind="component: { name: 'mdc-bootstrap-multiselect-component', params: salesMarketsParams }"></div>
			<div id="credit-control-sales-representative-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesRepresentativeParams }"></div>
			<div id="credit-control-sales-agent-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesAgentParams }"></div>
			<div id="credit-control-sales-area-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesAreaParams }"></div>
			<div id="credit-control-country-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryParams }"></div>
			<div id="credit-control-credit-controller-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: creditControllerParams }"></div>
			<div id="credit-control-trade-account-type-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeParams }"></div>
			<div id="credit-control-trade-account-type-group-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeGroupParams }"></div>
			<div id="credit-control-trade-account-group-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountGroupParams }"></div>
			<div id="credit-control-payment-terms-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsParams }"></div>
			<div id="credit-control-payment-terms-type-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsTypeParams }"></div>
			<div id="credit-control-credit-stopped-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: creditStoppedParams }"></div>
			<div id="credit-control-trade-account-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
			<div id="credit-control-date-prefilter" class="prefilter">
				<div class="date-prefilter" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: dateParams }"></div>
				<span class="validation-message" data-bind="validationMessage: date"></span>
			</div>
		</form>
		<div class="dashboard mt-3" style="display: none" data-bind="visible: dashboardPods().length, foreach: dashboardPods">
			<div class="dashboard-pod card">
				<div class="card-body" data-bind="class: Classes">
					<h4 data-bind="html: Heading"></h4>
					<div data-bind="html: Stats"></div>
				</div>
			</div>
		</div>
		<div id="credit-control-grid-container" class="mt-3" data-bind="kendoGrid: gridParams"></div>
	</div>
</div>