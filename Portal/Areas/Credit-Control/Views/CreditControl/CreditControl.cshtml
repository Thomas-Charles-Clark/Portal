@model CreditControlViewModel
@{
	ViewBag.Title = "Credit Control";
}
@section styles {
	@Styles.Render("~/bundles/css/kendo-custom")
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/credit-control")
	@Styles.Render("~/bundles/css/trade-account-contacts")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/mdc-custom")
	@Styles.Render("~/bundles/css/full-width-app")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/credit-control")
	@Scripts.Render("~/bundles/js/trade-account-contacts")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	<script type="text/javascript">
		window.getCreditControllerCode = () => {
			return '@(Model.CreditControllerCode)'
		}
		window.lockCreditController = () => false;

		window.getMarketToLoad = () => '';

		window.getHeldOrderReasonPodIdToLoad = () => undefined;

		window.getMyHeldOrderImportStatuses = () => [{
			Status: 'Active',
			Name: 'Active Baskets'
		}, {
			Status: 'Held',
			Name: 'Held Baskets'
		}, {
			Status: 'Parked',
			Name: 'Parked Baskets'
			}];

		window.getHeldOrderReasonGroupIdToLoad = () => undefined;

		window.getOrderImportStatuses = () => [{
			Status: 'Sample',
			Name: 'Sample Orders'
		}, {
			Status: 'Mixed',
			Name: 'Mixed Orders'
		}];

		window.getOrderImportSources = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.OrderImportSources));
		}

		window.getTradeMarkets = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.TradeMarkets));
		}

		window.getCanSearchTradeAccounts = () => true;

		window.getSelectedTradeAccount = () => null;

		window.getBasketIdToLoad = () => null;

		window.getTransactionIdToLoad = () => null;

		window.getOrderHeadIdToLoad = () => null;

		window.getHeldOrderReasonIdToLoad = () => null;

		window.getTabToLoad = () => "ordersToApprove";

		window.getCreditControlRoleIds = () => [13, 17]

	</script>

	<script type="text/javascript">

		var viewModel = creditControlViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		window.self = viewModel;

	</script>
}
@section modals {

}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div class="modal fade breakdown-modal" id="debt-breakdown-modal" tabindex="-1">
	<div class="modal-dialog modal-lg modal-xl" id="debt-breakdown-modal-dialog">
		<div class="modal-content">
			<div class="blocker" data-bind="flexFadeVisible: busy">
				<div class="loading-spinner"></div>
				<h4>
					Please Wait...
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<h4 class="modal-title">
					Debt Breakdown
				</h4>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" data-bind="with: debtBreakdown">
				<h4 class="breakdown-modal-heading" data-bind="with: heading">
					<span data-bind="text: Heading"></span>
					<a class="btn btn-dark statement-btn" href="javascript:;" data-bind="attr: { 'href': @(SharedEFClasses.Utilities.PortalFramework.IsDebug() ? "StatementURI.replace('portal.designersguild.com', 'localhost:44335')" : "StatementURI") }" target="_blank">
						View Statement
						<i class="bi bi-receipt-cutoff"></i>
					</a>
				</h4>
				<div class="breakdown-pods" data-bind="foreach: pods">
					<div class="breakdown-pod card" data-bind="css: { 'selected-pod': $parent.selectedPod() == PodHandle }">
						<div class="card-body" data-bind="class: Classes">
							<h4 data-bind="html: Heading"></h4>
							<div data-bind="html: Stats"></div>
							<a href="#" class="stretched-link" data-bind="click: $parent.podClick"></a>
						</div>
					</div>
				</div>
				<div data-bind="kendoGrid: gridParams"></div>
			</div>
		</div>
	</div>
</div>

