@model CreditControlViewModel
@{
	ViewBag.Title = "Credit Control";
}
@section styles {
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/credit-control")
	@Styles.Render("~/bundles/css/trade-account-contacts")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/full-width-app")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/credit-control")
	@Scripts.Render("~/bundles/js/trade-account-contacts")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	<script type="text/javascript">
		window.getCreditControllerCode = () => {
			return '@(Model.CreditControllerCode)'
		}
		window.lockCreditController = () => false;

		window.getMarketToLoad = () => '';

		window.getHeldOrderReasonPodIdToLoad = () => undefined;

		window.getMyHeldOrderImportStatuses = () => [{
			Status: 'Active',
			Name: 'Active Baskets'
		}, {
			Status: 'Held',
			Name: 'Held Baskets'
		}, {
			Status: 'Parked',
			Name: 'Parked Baskets'
			}];

		window.getHeldOrderReasonGroupIdToLoad = () => undefined;

		window.getOrderImportStatuses = () => [{
			Status: 'Sample',
			Name: 'Sample Orders'
		}, {
			Status: 'Mixed',
			Name: 'Mixed Orders'
		}];

		window.getOrderImportSources = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.OrderImportSources));
		}

		window.getTradeMarkets = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.TradeMarkets));
		}

		window.getCanSearchTradeAccounts = () => true;

		window.getSelectedTradeAccount = () => null;

		window.getBasketIdToLoad = () => null;

		window.getTransactionIdToLoad = () => null;

		window.getOrderHeadIdToLoad = () => null;

		window.getHeldOrderReasonIdToLoad = () => null;

		window.getTabToLoad = () => "ordersToApprove";

		window.isCreditControlApp = () => "C";

		@if (User.Identity.GetUserId<int>() == 8)
		{
			<text>
			window.getPredefinedFilterParams = () =>
			{
				return {
					//tradeAccountCode: 'K0098'
				}
			}
			</text>
		}
		else
		{
			<text>
			window.getPredefinedFilterParams = () =>
			{
				return {}
			}
			</text>
		}

	</script>

	<script type="text/javascript">

		var viewModel = creditControlViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		viewModel.init();

		window.self = viewModel;

	</script>
}
@section modals {

}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<script type="text/html" id="sidebar-template">
	<sidebar class="sidebar sticky-top" data-bind="attr: { id: `${prefix}sidebar` }">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: countDisplay"></label>
			</div>
			<div class="sidebar-body" data-bind="attr: { id: `${prefix}sidebar-collapse` }">
				<form data-bind="attr: { id: `${prefix}-prefilters` }" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Customers
						</h5>
						<div class="prefilter" data-bind="attr: { id: `${prefix}sales-markets-prefilter` }, component: { name: 'mdc-bootstrap-multiselect-component', params: salesMarketsParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}sales-representative-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: salesRepresentativeParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}sales-agent-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: salesAgentParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}sales-area-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: salesAreaParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}country-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: countryParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}credit-controller-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: creditControllerParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}trade-account-type-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}trade-account-type-group-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeGroupParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}trade-account-group-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountGroupParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}trade-account-company-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountCompanyParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}payment-terms-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}payment-terms-type-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsTypeParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}credit-stopped-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: creditStoppedParams }"></div>
						<div class="prefilter trade-account-prefilter" data-bind="attr: { id: `${prefix}trade-account-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}debt-funder-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: debtFunderParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}currency-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: currencyParams }"></div>
						<div class="prefilter" data-bind="attr: { id: `${prefix}trade-account-status-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountStatusParams }"></div>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Invoice
						</h5>
						<div class="prefilter" data-bind="attr: { id: `${prefix}invoice-company-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: invoiceCompanyParams }"></div>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Sales Analysis
						</h5>
						<div class="prefilter" data-bind="attr: { id: `${prefix}sales-history-analysis-period-prefilter` }, component: { name: 'mdc-kendo-dropdown-component', params: salesHistoryAnalysisPeriodsParams }"></div>
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
</script>

<script type="text/html" id="sales-ledger-template">
	<h4 class="breakdown-modal-heading" data-bind="with: heading">
		<span data-bind="text: Heading"></span>
		<div class="sales-ledger-heading-btn-container">
			<span>
				Contacts
			</span>
			<a href="#" class="grid-btn contacts-btn" data-bind="click: $parent.callee.openContactsModal">
				<i class="bi bi-people-fill"></i>
				<span class="badge rounded-pill text-bg-primary" data-bind="text: $parent.callee.MemberCount"></span>
			</a>
		</div>
		<div class="sales-ledger-heading-btn-container">
			<span>
				Stop Status
			</span>
			<a href="javascript:;" class="grid-btn stop-btn" data-bind="actualBootstrapPopover: { details: $parent.callee.popoverDetails }, click: () => { return true; }, clickBubble: false">
				<i class="bi bi-octagon" data-bind="css: { 'bi-octagon': $parent.callee.onStop() == false, 'bi-sign-stop-fill text-red-500': $parent.callee.onStop() == true }"></i>
				<i class="bi bi-octagon bi-octagon-red d-none" data-bind="flexFadeVisible: $parent.callee.onStop() == true"></i>
			</a>
		</div>
		<div class="sales-ledger-heading-btn-container">
			<a class="btn btn-dark statement-btn" href="javascript:;" data-bind="attr: { 'href': @(SharedEFClasses.Utilities.PortalFramework.IsDebug() ? "StatementURI.replace('portal.designersguild.com', 'localhost:44335')" : "StatementURI") }" target="_blank">
				View Statement
				<i class="bi bi-receipt-cutoff"></i>
			</a>
		</div>
	</h4>
	<!-- ko if: heading()?.OverviewMessage -->
	<div data-bind="html: heading().OverviewMessage"></div>
	<!-- /ko -->
	<div class="grouped-pods-container accordion" data-bind="foreach: groupedPods">
		<div class="pod-group accordion-item">
			<h4 class="pod-group-title accordion-header">
				<button type="button" class="accordion-button" data-bs-toggle="collapse" data-bind="html: groupName, attr: { 'data-bs-target': `#sales-ledger-pod-group-${$index()}` }"></button>
			</h4>
			<div class="accordion-collapse collapse show" data-bind="attr: { id: `sales-ledger-pod-group-${$index()}` }">
				<div class="pods">
					<!-- ko foreach: pods -->
					<div class="pod" data-bind="css: { 'selected-pod': $parentContext.$parent.selectedPod()?.PodHandle == PodHandle }">
						<div data-bind="class: Classes">
							<h4 data-bind="html: Heading"></h4>
							<div data-bind="html: Stats"></div>
							<a href="#" class="stretched-link" data-bind="click: $parentContext.$parent.podClick"></a>
						</div>
					</div>
					<!-- /ko -->
				</div>
			</div>
		</div>
	</div>
	<div class="selected-filter-pills" style="display: none;" data-bind="visible: true, with: filters">
		<!-- ko template: { name: 'filter-pills-template' } --><!-- /ko -->
		<div class="dropdown ms-3" style="display: none" data-bind="visible: true">
			<a class="btn btn-secondary dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
				<i class="bi bi-list-check"></i>
			</a>
			<!-- ko template: { name: 'credit-control-quantity-value-dropdown-container' } --><!-- /ko -->
		</div>
		<!-- ko if: typeof $parent.statementSendModal != 'undefined' -->
		<button class="btn btn-dark ms-auto me-3" data-bind="click: $parent.showSendStatementsModal">
			<span>
				Send Statements
			</span>
			<i class="bi bi-envelope-at ms-2"></i>
		</button>
		<!-- /ko -->
		<button class="btn btn-dark btn-export" data-bind="click: $parent.exportToExcel, css: { 'ms-auto': typeof $parent.statementSendModal == 'undefined' }">
			Export to Excel
			<i class="bi bi-download"></i>
			<i class="bi bi-filetype-xlsx"></i>
		</button>
		<!-- ko if: initTooltips() --><!-- /ko -->
	</div>
	<div data-bind="kendoGrid: gridParams"></div>
</script>

<div class="modal fade breakdown-modal" id="sales-ledger-modal" tabindex="-1">
	<div class="modal-dialog modal-fullscreen" id="sales-ledger-modal-dialog">
		<div class="modal-content" data-bind="with: salesLedger">
			<div class="blocker" data-bind="flexFadeVisible: busy">
