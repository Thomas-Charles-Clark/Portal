@model Portal.Areas.Translations.ViewModels.TranslateResourcesViewModel
@{
	ViewBag.Title = "Translation Maintenance";
	Layout = "~/Views/Shared/_Layout-New-2026.cshtml";
}
@section styles {
	@Styles.Render("~/bundles/css/components")
	@Styles.Render("~/bundles/css/kendo-custom")
	@Styles.Render("~/bundles/css/translations")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/translations")

	<script type="text/javascript">
    @if (User.IsInRole("Super Admin"))
    {
        <text>
        window.getToolbarOptions = () => {
			return ["save", "cancel"] // "create",
        }
        </text>
    }
    else
    {
        <text>
        window.getToolbarOptions = () => {
			return ["save", "cancel"]
        }
        </text>
    }
		window.getLanguageId = () => {
			return @(Model.LanguageID);
		}
		window.getApproval = () => {
			return @(Model.Approval.HasValue ? $"{Model.Approval.Value.ToString().ToLower()}" : "");
		}
		window.getDashboardPods = () => {
			return @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DashboardPods));
		}
	</script>

	<script type="text/javascript">

		var viewModel = translationsViewModel({});

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		window.addEventListener('load', function () {
			ko.applyBindings(viewModel, document.body);
			window.setTimeout(() => {
				if (window.getLanguageId()) {
					viewModel.resourceGridSettings.widget().dataSource.page(1);
				}
				viewModel.ready(true);
			}, 0);
		});

		window.onBeforeUnloadPreventDefault = (e) => {
			e.preventDefault();
		}

	</script>
}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div class="dashboard" style="display: none" data-bind="visible: dashboardPods().length, foreach: dashboardPods">
	<div class="dashboard-pod card pointer" data-bind="css: { 'selected-pod': $parent.selectedPod() == $data }, click: $parent.dashboardClick">
		<div class="card-body" data-bind="class: Classes">
			<h4 data-bind="html: Heading"></h4>
			<div data-bind="html: Stats"></div>
		</div>
	</div>
</div>

<script id="translation-row-template" type="text/html">
	<tr data-bind="keepElement: element, css: { 'dirty': dirty }, click: (data, event) => { event.stopPropagation(); return true; }, clickBubble: false">
		<td class="id-column">
			<span data-bind="text: ResourceID, attr: { title: Resource.Name }"></span>
		</td>
		<td>
			<div data-bind="html: Resource.Value"></div>
		</td>
		<td class="translator-cell" data-bind="click: translatorCellClick">
			@*<div class="grow-wrap" data-bind="attr: { 'data-replicated-value': translation }">
					<textarea data-bind="value: translation"></textarea>
				</div>*@
			<div data-bind="component: { name: 'mdc-kendo-html-editor-component-inline-no-outline', params: translationParams }"></div>
		</td>
		<td class="approval-cell relative" data-bind="attr: { title: approvalTitle }">
			<div data-bind="component: { name: 'mdc-checkbox-component', params: approvalParams }, attr: { title: approvalTitle }"></div>
		</td>
	</tr>
</script>

<div class="blocker" style="display: none" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div id="translate-resources-container" class="card">
	<div class="card-body">
		<div class="prefilters">
			<div class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: languageDropDownList }"></div>
		</div>
		<div class="grid-wrapper">
			<div data-bind="kendoGrid: resourceGridSettings"></div>
		</div>
	</div>
</div>