@model SharedEFClasses.Models.PaintTransferSaveResponse
@{
    Layout = null;
}
<!DOCTYPE HTML>
<html>
    <head>
        <link rel="stylesheet" href="@Url.Content("~/css/dist/lib/bootstrap-3.3.7/bootstrap-3.3.7.css", toAbsolute: true)" />
    </head>
    <body style="text-align: center;">
        <div class="container">
            <div class="row">
                <div class="col-xs-12 text-right">
                    <label>
                        @Html.Raw(DateTime.Now.ToString("dd/MM/yyyy<br/>HH:mm"))
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 text-center">
                    <h1>
                        Paint Transfer Manifest
                    </h1>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12" style="padding-top: @($"{(20 - Model.TransferOrders.Count())}em")">
                    <table class="table">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    Order ID
                                </th>
                                <th class="text-center">
                                    Box Count
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                           @foreach (var order in Model.TransferOrders.GroupBy(o => o.OrderID).OrderBy(g => g.Select(ord => ord.BoxCount).Sum()))
                            {
                                <tr>
                                    <td>
                                        @(order.Key)
                                    </td>
                                    <td>
                                        @(order.Select(ord => ord.BoxCount).Sum())
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </body>
</html>