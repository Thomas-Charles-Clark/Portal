@model SharedEFClasses.Models.PaintTransferSaveResponse
@{
    Layout = null;
}
<!DOCTYPE HTML>
<html>
<head>
    <link rel="stylesheet" href="@Url.Content("~/css/dist/lib/bootstrap-3.3.7/bootstrap-3.3.7.css", toAbsolute: true)" />
    <style type="text/css">
        .mb-1 {
            margin-bottom: 5px;
        }

        .mb-2 {
            margin-bottom: 10px;
        }

        .mb-3 {
            margin-bottom: 15px;
        }

        .mb-4 {
            margin-bottom: 30px;
        }

        .mb-5 {
            margin-bottom: 45px;
        }
    </style>
</head>
    <body style="text-align: center;">
        <h1 class="mb-3">
            Paint Transfer Manifest
        </h1>
        <h3 class="mb-5">
            @Html.Raw(Model.TransferDescription)
        </h3>
        <table class="table">
            <thead>
                <tr>
                    <th class="text-center">
                        Order ID
                    </th>
                    <th class="text-center">
                        Box Count
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.TransferOrders.GroupBy(o => o.OrderID).OrderBy(g => g.Select(ord => ord.BoxCount).Sum()))
                {
                    <tr>
                        <td>
                            @(order.Key)
                        </td>
                        <td>
                            @(order.Select(ord => ord.BoxCount).Sum())
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </body>
</html>