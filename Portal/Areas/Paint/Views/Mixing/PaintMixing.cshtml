@model Portal.Areas.Products.ViewModels.PaintMixingViewModel
@{
    ViewBag.Title = Model.ApplicationHeading;

    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/paint-mixing")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/paint-mixing")

    <script type="text/javascript">
        window.getMixingLocationId = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.MixingLocationID))
        }

        let viewModel = paintMixingViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });
        6
        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;
    </script>
}
@section beforeContainer {
    <div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
        <div class="loading-spinner"></div>
        <h3 class="mt-3">
            Please Wait...
        </h3>
    </div>
}
<script id="outstanding-orders-row-template" type="text/html">
    <tr data-bind="css: { 'locked': Locked }, attr: { 'data-order-id': OrderID }">
        <td class="text-center">
            <span data-bind="text: Priority"></span>
        </td>
        <td>
            <span data-bind="text: OrderID"></span>
        </td>
        <td>
            <span data-bind="html: moment(OrderDT).format('ddd DD/MM/YYYY<br/>HH:mm')"></span>
        </td>
        <td>
            <span class="d-block" data-bind="text: TradeAccountCode"></span>
            <span class="d-block" data-bind="text: TradeAccountName"></span>
        </td>
        <td>
            <span data-bind="text: CustomerOrderReference"></span>
        </td>
        <td>
            <span data-bind="html: Status"></span>
        </td>
    </tr>
</script>

<script id="completed-orders-row-template" type="text/html">
    <tr data-bind="css: { 'locked': Locked }, attr: { 'data-order-id': OrderID }">
        <td>
            <span data-bind="text: OrderID"></span>
        </td>
        <td>
            <span data-bind="html: moment(OrderDT).format('ddd DD/MM/YYYY HH:mm')"></span>
        </td>
        <td>
            <span class="d-block" data-bind="text: TradeAccountCode"></span>
            <span class="d-block" data-bind="text: TradeAccountName"></span>
        </td>
        <td>
            <span data-bind="text: CustomerOrderReference"></span>
        </td>
        <td>
            <span data-bind="html: Status"></span>
        </td>
    </tr>
</script>

<script id="orders-to-invoice-row-template" type="text/html">
    <tr data-bind="css: { 'barber-busy': busy, 'locked': !RequiresInvoicing }">
        <td>
            <span data-bind="text: BasePaintOrderID"></span>
        </td>
        <td>
            <span data-bind="html: BasePaintOrderStatus"></span>
        </td>
        <td>
            <span data-bind="html: moment(OrderDT).format('ddd DD/MM/YYYY HH:mm')"></span>
        </td>
        <td>
            <!-- ko if: RequiresInvoicing -->
            <button class="btn btn-primary btn-sm d-block w-100 border-box" data-bind="click: $parent.stockOrderUpdateStatus, css: { 'disable': busy }, attr: { 'disabled': busy }">
                Update
            </button>
            <!-- /ko -->
        </td>
    </tr>
</script>

<script id="order-lines-row-template" type="text/html">
    <tr data-bind="keepElement: elementHolder, css: { 'locked': Locked }, attr: { 'data-order-line-id': OrderLineID, 'data-uid': $data.uid }">
        <td class="k-group-cell"></td>
        <td class="text-end" data-bind="click: () => { if (!Locked) checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: LineNumber"></span>
        </td>
        <td data-bind="click: () => { if (!Locked) checkboxParams.observable(!checkboxParams.observable()) }">
            <!-- ko if: ImageID -->
            <img class="thumb" width="64" height="64" data-bind="attr: { src: `https://www.designersguild.com/image/156/${ImageID}` }"/>
            <!-- /ko -->
        </td>
        <td class="text-end" data-bind="click: () => { if (!Locked) checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: QuantityOrdered"></span>
        </td>
        <td data-bind="click: () => { if (!Locked) checkboxParams.observable(!checkboxParams.observable()) }">
            <span class="d-block" data-bind="text: ProductCode"></span>
            <span class="d-block" data-bind="text: ProductName"></span>
        </td>
        <td data-bind="click: () => { if (!Locked) checkboxParams.observable(!checkboxParams.observable()) }">
            <span class="d-block" data-bind="text: BaseProductCode"></span>
            <span class="d-block" data-bind="text: BaseProductName"></span>
        </td>
        <td data-bind="click: () => { if (!Locked) checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="html: Status"></span>
        </td>
        <td>
            <!-- ko if: !Locked -->
            <div data-bind="component: { name: 'mdc-checkbox-component', params: checkboxParams }"></div>
            <!-- /ko -->
        </td>
    </tr>
</script>

<script id="transfer-row-template" type="text/html">
    <tr data-bind="keepElement: elementHolder, attr: { 'data-order-id': OrderID, 'data-date': Date }">
        <td class="k-group-cell"></td>
        <td data-bind="click: () => { checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: DespatchGroup"></span>
        </td>
        <td data-bind="click: () => { checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: Time"></span>
        </td>
        <td class="text-center" data-bind="click: () => { checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: BoxCount"></span>
        </td>
        <td>
            <div data-bind="component: { name: 'mdc-checkbox-component', params: checkboxParams }"></div>
        </td>
    </tr>
</script>

<script id="transfer-history-row-template" type="text/html">
    <tr data-bind="keepElement: elementHolder, attr: { 'data-order-id': OrderID, 'data-date': Date }">
        <td class="k-group-cell"></td>
        <td data-bind="click: () => { checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: DespatchGroup"></span>
        </td>
        <td data-bind="click: () => { checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: Time"></span>
        </td>
        <td class="text-center" data-bind="click: () => { checkboxParams.observable(!checkboxParams.observable()) }">
            <span data-bind="text: BoxCount"></span>
        </td>
        <td>
            <div data-bind="component: { name: 'mdc-checkbox-component', params: checkboxParams }"></div>
        </td>
    </tr>
</script>

<div class="form-group row mb-5">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<div id="order-tabs-wrapper" class="d-flex justify-content-between">
    <ul class="nav nav-pills order-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="outstanding-orders-tab-btn" data-bs-toggle="tab" data-bs-target="#outstanding-orders-tab" type="button" role="tab" aria-controls="home" aria-selected="true">
                Orders to Mix
                <!-- ko if: outstandingOrderCount -->
                <sup class="badge rounded-pill text-bg-primary" style="display: none;" data-bind="visible: outstandingOrderCount, text: outstandingOrderCount"></sup>
                <!-- /ko -->
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="stock-orders-tab-btn" data-bs-toggle="tab" data-bs-target="#stock-orders-tab" type="button" role="tab" aria-controls="contact" aria-selected="false">
                Base Paint Orders to Despatch
                <!-- ko if: ordersToInvoiceCount -->
                <sup class="badge rounded-pill text-bg-primary" style="display: none;" data-bind="visible: ordersToInvoiceCount, text: ordersToInvoiceCount"></sup>
                <!-- /ko -->
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="transfers-tab-btn" data-bs-toggle="tab" data-bs-target="#transfers-tab" type="button" role="tab" aria-controls="contact" aria-selected="false">
                Generate Collection Paperwork
                <!-- ko if: transfersCount -->
                <sup class="badge rounded-pill text-bg-primary" style="display: none;" data-bind="visible: transfersCount, text: transfersCount"></sup>
                <!-- /ko -->
            </button>
        </li>
        <li class="nav-item" role="presentation" style="display: none" data-bind="visible: ordersToInvoiceExceptionCount">
            <button class="nav-link bg-danger border-danger" id="stock-orders-exception-tab-btn" data-bs-toggle="tab" data-bs-target="#stock-orders-exception-tab" type="button" role="tab" aria-controls="contact" aria-selected="false">
                Base Paint Orders Exceptions
                <sup class="badge badge-danger border-danger rounded-pill text-bg-danger" style="display: none;" data-bind="visible: ordersToInvoiceExceptionCount, text: ordersToInvoiceExceptionCount"></sup>
            </button>
        </li>
        <li>
            <div class="hstack gap-1">
                <button class="nav-link bg-default" id="completed-orders-tab-btn" data-bs-toggle="tab" data-bs-target="#completed-orders-tab" type="button" role="tab" aria-controls="profile" aria-selected="false">
                    Order History
                </button>
                <button class="nav-link bg-default" id="transfers-history-tab-btn" data-bs-toggle="tab" data-bs-target="#transfers-history-tab" type="button" role="tab" aria-controls="contact" aria-selected="false">
                    Reprint Collection Paperwork
                </button>
            </div>
        </li>
    </ul>
</div>

<div id="paint-mixing-wrapper" class="card">
    <div class="tab-content card-body p-3">
        <div class="tab-pane fade show active" id="outstanding-orders-tab" role="tabpanel" aria-labelledby="outstanding-orders-tab-btn">
            <div data-bind="kendoGrid: outstandingOrdersGrid"></div>
        </div>
        <div class="tab-pane fade" id="completed-orders-tab" role="tabpanel" aria-labelledby="completed-orders-tab-btn">
            <div class="hstack gap-3 mb-3">
                <div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: orderHistoryFromParams }"></div>
                <div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: orderHistoryToParams }"></div>
            </div>
            <div data-bind="kendoGrid: orderHistoryGrid"></div>
        </div>
        <div class="tab-pane fade" id="stock-orders-tab" role="tabpanel" aria-labelledby="stock-orders-tab-btn">
            <!-- ko if: ordersToInvoiceNotice -->
            <div data-bind="html: ordersToInvoiceNotice"></div>
            <!-- /ko -->
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary" data-bind="click: stockOrderUpdateAll">
                    Refresh All
                </button>
            </div>
            <div data-bind="kendoGrid: ordersToInvoiceGrid"></div>
        </div>
        <div class="tab-pane fade" id="stock-orders-exception-tab" role="tabpanel" aria-labelledby="stock-orders-exception-tab-btn">
            <!-- ko if: ordersToInvoiceExceptionNotice -->
            <div data-bind="html: ordersToInvoiceExceptionNotice"></div>
            <!-- /ko -->
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary" data-bind="click: stockOrderUpdateAll">
                    Refresh All
                </button>
            </div>
            <div data-bind="kendoGrid: ordersToInvoiceExceptionsGrid"></div>
        </div>
        <div class="tab-pane fade transfers-tab" id="transfers-tab" role="tabpanel" aria-labelledby="transfers-tab-btn">
            <!-- ko if: transferNotice -->
            <div data-bind="html: transferNotice"></div>
            <!-- /ko -->
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary" data-bind="click: () => { produceTransferManifest('current') }">
                    Produce Collection Paperwork
                </button>
            </div>
            <div data-bind="kendoGrid: transfersGrid"></div>
        </div>
        <div class="tab-pane fade transfers-tab" id="transfers-history-tab" role="tabpanel" aria-labelledby="transfers-tab-btn">
            <!-- ko if: transferNotice -->
            <div data-bind="html: transferNotice"></div>
            <!-- /ko -->
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary" data-bind="click: produceTransferManifest">
                    Produce Collection Paperwork
                </button>
            </div>
            <div data-bind="kendoGrid: transfersHistoryGrid"></div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" id="paint-order-lines-modal">
    <div class="modal-dialog modal-lg modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="with: orderLinesResponse">
                    <span data-bind="text: OrderID"></span>
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bind="click: closeOrderLinesModal"></button>
            </div>
            <div class="modal-body">
                <div data-bind="with: orderLinesResponse">
                    <div class="sql-notice" data-bind="html: Notices.Notification"></div>
                    <div class="accordion mb-3" id="order-details-accordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="order-details-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#order-details-collapse" aria-expanded="true" aria-controls="order-details-collapse">
                                    <span data-bind="text: `Order Details: ${OrderID}`"></span>
                                </button>
                            </h2>
                            <div id="order-details-collapse" class="accordion-collapse collapse" aria-labelledby="order-details-header" data-bs-parent="#order-details-accordion">
                                <div class="accordion-body">
                                    <div id="order-summary">
                                        <label>
                                            Trade Account
                                        </label>
                                        <span>
                                            <span data-bind="text: TradeAccountCode"></span>
                                            -
                                            <span data-bind="text: TradeAccountName"></span>
                                        </span>
                                        <label>
                                            Order Number
                                        </label>
                                        <span data-bind="text: OrderID"></span>
                                        <label>
                                            Order Date
                                        </label>
                                        <span data-bind="text: moment(OrderDT).format('ddd DD/MM/YYYY HH:mm')"></span>
                                        <label>
                                            Customer Order Reference
                                        </label>
                                        <span data-bind="text: CustomerOrderReference"></span>
                                        <label>
                                            Delivery Description
                                        </label>
                                        <span data-bind="text: DeliveryDescription"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-bind="kendoGrid: orderLinesGrid"></div>
            </div>
        </div>
    </div>
    <div id="session-notification-wrapper">
        <div id="session-notification">
            <!-- ko ifnot: checkedOrdersCountDisplay -->
            <h5 class="text-center mb-0">
                Closing...
            </h5>
            <!-- /ko -->
            <!-- ko if: checkedOrdersCountDisplay -->
            <h5 class="text-center mb-0">
                <span class="d-block mb-2" data-bind="text: checkedOrdersCountDisplay"></span>
                <span class="d-block">
                    How many boxes have you used?
                </span>
            </h5>
            <div id="box-count-wrapper" class="mb-0" data-bind="component: { name: 'mdc-text-field-numeric-unformatted-component', params: boxCountParams }"></div>
            <button class="btn btn-success" data-bind="click: saveMixedLines">
                Done
            </button>
            <!-- /ko -->
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" id="paint-box-count-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideBoxCountModal"></button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" id="paint-labels-modal">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Labels
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="label-notices" data-bind="html: labelNotice"></div>
                <iframe id="label-iframe" name="labeliFrame" data-bind="attr: { src: labelSource }"></iframe>
            </div>
        </div>
    </div>
</div>