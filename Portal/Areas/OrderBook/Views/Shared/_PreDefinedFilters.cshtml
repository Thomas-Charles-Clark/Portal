@model Portal.Areas.Orders.ViewModels.OrderBookSummaryViewModel
<script type="text/javascript">
    window.getPreDefinedSummaries = () => {
        return @Html.Raw(JsonConvert.SerializeObject(Model.PreDefinedFilters))
    }
</script>
<div id="pre-defined-filters" data-bind="with: preDefinedFilters">
    <div class="pre-defined-filter-list" data-bind="foreach: summaries">
        <div class="card filter-card alert" data-bind="css: AlertClass">
            <div class="card-body">
                <h5 class="card-title" data-bind="html: Label"></h5>
                <p class="card-text" data-bind="html: display"></p>
            </div>
        </div>
    </div>
</div>