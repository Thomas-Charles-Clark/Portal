                                            <col />
                                            <col />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>
                                                    Data Source
                                                </th>
                                                <th>
                                                    Order Line
                                                </th>
                                                <th>
                                                    Order Line Status
                                                </th>
                                                <th>
                                                    Quantity Ordered
                                                </th>
                                                <th>
                                                    Trade Account
                                                </th>
                                                <th>
                                                    Trade Account Status
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
