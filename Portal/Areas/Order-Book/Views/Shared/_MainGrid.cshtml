@model SharedEFClasses.BaseViewModel
<div id="main-grid-container-wrapper">
    <div id="main-grid-container"
         style="display: none"
         class="main-grid"
         data-bind="fadeVisible: true">
        <div class="main-grid column-headings"
             data-bind="style: { '--grid-column-count': visibleOrderStatuses().length + 2 }">
            <div class="th first-column"></div>
            <div class="th grand-total-column column-controls">
                <div class="mdc-bootstrap-multiselect">
                    <div class="dropdown" data-bind="with: displayColumnHeadingsParams">
                        <button class="btn display-control-btn dropdown-toggle no-ripple"
                                type="button"
                                data-bind="keepElement: observableArray,
                                class: displayClass,
                                attr: {
                                id: elementId
                                },
                                html: btnMarkup,
                                event: {
                                'hide.bs.dropdown' : ()=>
                            { controls.applySelection(false); return true; }
                            }"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            data-bs-display="static"
                            aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu" data-bind="attr: { 'aria-labelledby': elementId }">
                            <!-- ko if: controls != "undefined" -->
                            <li class="dropdown-menu-controls d-flex gap-2">
                                <!-- ko if: controls.selectAll -->
                                <button class="btn btn-secondary btn-sm" data-bind="click: controls.selectAll">
                                    Select All
                                </button>
                                <!-- /ko -->
                                <!-- ko if: controls.deselectAll -->
                                <button class="btn btn-secondary btn-sm" data-bind="click: controls.deselectAll">
                                    Deselect All
                                </button>
                                <!-- /ko -->
                                <!-- ko if: controls.applySelection -->
                                <button class="btn btn-secondary btn-sm ms-auto" data-bind="click: () => { controls.applySelection(true); }">
                                    Apply
                                </button>
                                <!-- /ko -->
                            </li>
                            <!-- /ko -->
                            <!-- ko foreach: options -->
                            <li data-bind="css: { 'disabled': disabled }">
                                <label class="dropdown-item pointer form-check-label">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: $parent.observableArray,
                                checkedValue: $data.orderStatusGroupSortOrder,
                                attr: {
                                    disabled: disabled
                                }">
                                    <span data-bind="text: orderStatusGroupName"></span>
                                </label>
                            </li>
                            <!-- /ko -->
                        </ul>
                    </div>
                </div>
            </div>
            <!-- ko foreach: visibleColumns -->
            <div class="th intersectable span-x order-status-group-heading" data-bind="css: { 'border-left-0': $index() == 0 }, style: { '--colspan': orderStatuses.length }, click: () => { $root.showDetail($data) }">
                <span data-bind="text: orderStatusGroupName"></span>
            </div>
            <!-- /ko -->
            <div class="th order-status first-column"></div>
            <div class="th intersectable order-status-group-heading grand-total-column" data-bind="click: () => { $root.showDetail({}) }">
                Grand Total
            </div>
            <!-- ko foreach: visibleColumns -->
            <!-- ko foreach: orderStatuses -->
            <div class="th intersectable order-status" data-bind="css: { 'order-status-group-start': $parentContext.$index() > 0 && $index() == 0 }, click: () => { $root.showDetail(Object.assign($data, $parentContext.$data)) }">
                <span data-bind="text: orderStatusName"></span>
            </div>
            <!-- /ko -->
            <!-- /ko -->

            <div class="th order-status-total align-items-center justify-content-between first-column grand-total-row pointer gap-2" data-bind="click: toggleAllOrderGroups">
                <span>
                    Total
                </span>
                <div class="dropdown ms-auto">
                    <button class="btn display-control-btn btn-sm dropdown-toggle no-ripple" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                        <i class="bi bi-list-check"></i>
                    </button>
                    <!-- ko template: { name: 'values-dropdown-container' } --><!-- /ko -->
                </div>
            </div>
            <div class="main-cell order-status-total grand-total-column grand-total-row" data-bind="css: { 'intersectable': $root.getCell($data, {}) }, with: $root.getCell($data, null), click: () => { if ($root.getCell($data, null)) { $root.showDetail({}); } }">
                <p class="values-display" data-bind="html: display"></p>
            </div>
            <!-- ko foreach: visibleColumns -->
            <!-- ko foreach: orderStatuses -->
            <div class="main-cell order-status-total grand-total-row" data-bind="css: { 'order-status-group-start': $parentContext.$index() > 0 && $index() == 0, 'intersectable': $root.getCell($data, {}) }, with: $root.getCell($data, {}), click: () => { if ($root.getCell($data, {})) { $root.showDetail($data); } }">
                <p class="values-display" data-bind="html: display"></p>
            </div>
            <!-- /ko -->
            <!-- /ko -->

        </div>
        <!-- ko foreach: rowHeadings -->
        <div class="main-grid"
             data-bind="style: { 'z-index': $parent.rowHeadings().length - $index(), '--grid-column-count': $parent.visibleOrderStatuses().length + 2 }">
            <div class="order-group-heading order-group-row first-column gap-2" data-bind="click: $parent.toggleOrderGroupCollapse, css: { 'collapsed': collapsed }">
                <span data-bind="text: orderGroupName"></span>
                <div class="dropdown ms-auto">
                    <button class="btn display-control-btn btn-sm dropdown-toggle no-ripple" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                        <i class="bi bi-list-check"></i>
                    </button>
                    <!-- ko template: { name: 'values-dropdown-container' } --><!-- /ko -->
                </div>
            </div>
            <div class="main-cell order-group-row order-group-total-row grand-total-column intersectable" data-bind="with: $root.getCell({}, { orderGroupId: $data.orderGroupId }),
                    click: (data)=>
                { $root.showDetail({ orderGroupId: $data.orderGroupId }) }">
                <p class="values-display" data-bind="html: display"></p>
            </div>
            <!-- ko foreach: $parent.visibleColumns -->
            <!-- ko foreach: orderStatuses -->
            <div class="main-cell subtotal-cell order-group-row order-group-total-row" data-bind="css: {
                 'order-status-group-start' : $parentContext.$index()>
                0 && $index() == 0,
                'intersectable': $root.getCell($data, { orderGroupId: $parentContext.$parent.orderGroupId })
                },
                with: $root.getCell($data, { orderGroupId: $parentContext.$parent.orderGroupId }),
                click: () => { if ($root.getCell($data, { orderGroupId: $parentContext.$parent.orderGroupId })) { $root.showDetail(Object.assign($data, { orderGroupId: $parentContext.$parent.orderGroupId })) } }">
                <p class="values-display" data-bind="html: display"></p>
            </div>
            <!-- /ko -->
            <!-- /ko -->

            <div class="main-grid span-n order-group-collapsible collapse" data-bind="class: `order-group-${orderGroupId}`, css: { 'show': !collapsed() }">
                <!-- ko foreach: stockLocationGroups -->
                <div class="th main-cell first-column intersectable" data-bind="css: { 'border-bottom-0': $index() == $parent.stockLocationGroups.length - 1, 'alternate-row': ($index() + 1) % 2 == 0 },
                     click: (data)=>
                    { showDetail({ stockLocationGroupId: data.stockLocationGroupId }); }">
                    <span data-bind="text: stockLocationGroupName"></span>
                </div>
                <div class="main-cell grand-total-column intersectable" data-bind="css: { 'border-bottom-0': $index() == $parent.stockLocationGroups.length - 1, 'alternate-row': ($index() + 1) % 2 == 0 }, with: $root.getCell({ }, { orderGroupId: $data.orderGroupId, stockLocationGroupId: $data.stockLocationGroupId }), click: (data) => { $root.showDetail(data) }">
                    <p class="values-display" data-bind="html: display"></p>
                </div>
                <!-- ko foreach: $parentContext.$parent.visibleColumns -->
                <!-- ko foreach: orderStatuses -->
                <div class="main-cell"
                     data-bind="css: {
                     'order-status-group-start' : $parentContext.$index()>
                    0 && $index() == 0,
                    'intersectable':  $root.getCell($data, $parentContext.$parent),
                    'border-bottom-0': $parentContext.$parentContext.$index() == $parentContext.$parentContext.$parent.stockLocationGroups.length - 1,
                    'alternate-row': ($parentContext.$parentContext.$index() + 1) % 2 == 0
                    },
                    with: $root.getCell($data, $parentContext.$parent),
                    click: () => {
                    if ($root.getCell($data, $parentContext.$parent)) {
                    $root.showDetail(Object.assign($data, $parentContext.$parent, { orderStatusGroupName: $parentContext.$data.orderStatusGroupName, orderGroupName: $parentContext.$parentContext.$parentContext.$data.orderGroupName, }))
                    }
                    }">
                    <p class="values-display" data-bind="html: display">
                    </p>
                </div>
                <!-- /ko -->
                <!-- /ko -->
                <!-- /ko -->
            </div>
        </div>
        <!-- /ko -->
    </div>
</div>