<div id="pre-defined-filters-tab-container" data-bind="with: preDefinedFilters">
    <ul class="nav nav-tabs">
        <!-- ko foreach: visibleManagementPromptTabs -->
        <li class="nav-item">
            <button class="nav-link" type="button" data-bind="click: (data, event) => { $root.podTabIndex($index()); }, attr: { 'data-bs-target': `#pre-defined-tab-${$index()}` }, css: { 'active': $index() == $root.podTabIndex() }">
                <span data-bind="text: name"></span>
            </button>
        </li>
        <!-- /ko -->
    </ul>
    <div class="tab-content">
        <!-- ko foreach: visibleManagementPromptTabs -->
        <div class="tab-pane fade" data-bind="attr: { id: `pre-defined-tab-${$index()}` }, css: { 'show active': $index() == $root.podTabIndex() }">
            <div class="pre-defined-filter-summaries" data-bind="foreach: summaries, style: {  '--grid-column-count': summaries().length }">
                <div class="card filter-card alert" data-bind="css: AlertClass, click: $parentContext.$parent.showDetail">
                    <div class="card-body">
                        <h5 class="card-title" data-bind="html: Label"></h5>
                        <p class="card-text" data-bind="html: display"></p>
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
    </div>
</div>

