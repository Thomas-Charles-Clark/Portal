@model Portal.Areas.Orders.ViewModels.OrderBookSummaryViewModel
<script type="text/javascript">
    window.getPreDefinedSummaries = () => {
        return @Html.Raw(JsonConvert.SerializeObject(Model.PreDefinedFilters))
    }
</script>

<div id="pre-defined-filters-tab-container" data-bind="with: preDefinedFilters">
    <ul class="nav nav-tabs">
        <!-- ko foreach: visibleManagementPromptTabs -->
        <li class="nav-item">
            <button class="nav-link" type="button" data-bind="
                    click: (data, event) => { $root.predefinedFiltersTabsSelectedGroupId($data.groupId); },
                    attr: { 'data-bs-target': `#pre-defined-tab-${$data.groupId}`, 'data-group-id': $data.groupId  },
                    css: { 'active': $data.groupId == $root.predefinedFiltersTabsSelectedGroupId() }">
                <span data-bind="text: name"></span>
            </button>
        </li>
        <!-- /ko -->
    </ul>
    <div class="tab-content">
        <!-- ko foreach: visibleManagementPromptTabs -->
        <div class="tab-pane fade" data-bind="attr: { id: `pre-defined-tab-${$data.groupId}` }, css: { 'show active': $data.groupId == $root.predefinedFiltersTabsSelectedGroupId() }">
            <!-- ko if: summaries().length == 0 -->
            <div class="pre-defined-filter-summaries">
                <div id="nothing-to-display-card" class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-0">
                            Nothing to Display
                        </h5>
                    </div>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko if: summaries().length > 0 -->
            <div class="pre-defined-filter-summaries" data-bind="foreach: summaries, style: {  '--grid-column-count': summaries().length }">
                <div class="card filter-card alert" data-bind="css: AlertClass, click: (data, event) => { $parentContext.$parent.showDetail(data, data.parent.displayModes) }">
                    <div class="card-body">
                        <h5 class="card-title" data-bind="html: Label"></h5>
                        <p class="card-text" data-bind="html: display"></p>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>
        <!-- /ko -->
    </div>
</div>