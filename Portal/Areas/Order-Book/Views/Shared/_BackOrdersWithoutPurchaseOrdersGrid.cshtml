@model SharedEFClasses.BaseViewModel
<!-- ko if: noResults -->
<div id="no-results">
    <div class="alert alert-secondary text-center alert-lg px-4 py-3">
        <h4 class="alert-title mb-3">
            Sorry
        </h4>
        <p>
            No Results Found
        </p>
    </div>
</div>
<!-- /ko -->
<!-- ko ifnot: noResults -->
<div id="order-book-detail-scroller-container" class="virtual-scroller-container" data-bind="with: virtualScroller">
    <table id="order-book-detail-table" class="table table-condensed table-striped table-hover order-book-detail-table" data-bind="style: { '--default-column-width': `${$parent.defaultColumnWidth()}px` }">
        <colgroup>
            <!-- ko foreach: $parent.columns -->
            <col data-bind="style: { width: `${$data.width}px` }" />
            <!-- /ko -->
            <col />
        </colgroup>
        <thead>
            <tr>
                <!-- ko foreach: $parent.columns -->
                <th class="sortable-column" data-bind="style: { '--prev-col-widths': `${$data.accumulatedColumnWidths}px` }">
                    <span data-bind="text: columnNameDisplay"></span>
                </th>
                <!-- /ko -->
                <th colspan="500"></th>
            </tr>
            <tr class="subtotal-row">
                <!-- ko foreach: $parent.columns -->
                <th data-bind="style: { '--prev-col-widths': `${$data.accumulatedColumnWidths}px` }">
                    <!-- ko if: $index() == 1 -->
                    <span class="d-block">
                        Totals
                    </span>
                    <!-- /ko -->
                    <!-- ko if: displayModes.indexOf(DISPLAY_MODE_VALUE_SUM) > -1 -->
                    <span data-bind="with: detailColumns().find(dc => dc.columnName == `${$data.columnName}OrderValue`)">
                        <span class="sortable-column d-block" data-bind="click: $root.sortByColumn">
                            <span data-bind="text: formatCurrency(total, 0, 'en-GB', 'GBP'), attr: { title: `Order Value: ${formatCurrency(total, 0, 'en-GB', 'GBP')} (Click to Sort)` }"></span>
                            <!-- ko if: direction -->
                            <i class="bi" data-bind="css: { 'bi-caret-up': direction() == 'asc', 'bi-caret-down': direction() == 'desc' }"></i>
                            <!-- /ko -->
                        </span>
                    </span>
                    <!-- /ko -->
                    <!-- ko if: displayModes.indexOf(DISPLAY_MODE_QUANTITY_SUM) > -1 -->
                    <span data-bind="with: detailColumns().find(dc => dc.columnName == `${$data.columnName}OrderQuantity`)">
                        <span class="sortable-column d-block" data-bind="click: $root.sortByColumn">
                            <span data-bind="text: formatNumber(total, 2), attr: { title: `Order Quantity: ${formatNumber(total, 2)} (Click to Sort)` }"></span>
                            <!-- ko if: direction -->
                            <i class="bi" data-bind="css: { 'bi-caret-up': direction() == 'asc', 'bi-caret-down': direction() == 'desc' }"></i>
                            <!-- /ko -->
                        </span>
                    </span>
                    <!-- /ko -->
                    <!-- ko if: displayModes.indexOf(DISPLAY_MODE_LINE_COUNT) > -1 -->
                    <span data-bind="with: detailColumns().find(dc => dc.columnName == `${$data.columnName}LineCount`)">
                        <span class="sortable-column d-block" data-bind="click: $root.sortByColumn">
                            <span data-bind="text: formatNumber(total, 0), attr: { title: `Line Count: ${formatNumber(total, 2)} (Click to Sort)` }"></span>
                            <!-- ko if: direction -->
                            <i class="bi" data-bind="css: { 'bi-caret-up': direction() == 'asc', 'bi-caret-down': direction() == 'desc' }"></i>
                            <!-- /ko -->
                        </span>
                    </span>
                    <!-- /ko -->
                    <!-- ko if: displayModes.indexOf(DISPLAY_MODE_ORDER_COUNT) > -1 -->
                    <span data-bind="with: detailColumns().find(dc => dc.columnName == `${$data.columnName}OrderCount`)">
                        <span class="sortable-column d-block" data-bind="click: $root.sortByColumn">
                            <span data-bind="text: formatNumber(total, 0), attr: { title: `Order Count: ${formatNumber(total, 2)} (Click to Sort)` }"></span>
                            <!-- ko if: direction -->
                            <i class="bi" data-bind="css: { 'bi-caret-up': direction() == 'asc', 'bi-caret-down': direction() == 'desc' }"></i>
                            <!-- /ko -->
                        </span>
                    </span>
                    <!-- /ko -->
                </th>
                <!-- /ko -->
                <th colspan="500" data-bind="style: { '--prev-col-widths': `${$data.accumulatedColumnWidths}px` }"></th>
            </tr>
        </thead>
        <tbody class="virtual-spacing">
            <tr style="height: 0px;" data-bind="style: { height: `${gridScrollTopPadding()}px` }">
                <td colspan="500"></td>
            </tr>
        </tbody>
        <tbody data-bind="foreach: visibleItems">
            <tr>
                <!-- ko foreach: $parentContext.$parent.columns -->
                <!-- ko ifnot: grouped -->
                <td data-bind="style: { '--prev-col-widths': `${$data.accumulatedColumnWidths}px` }">
                    <span data-bind="html: $parent[`${columnName}_Display`]"></span>
                </td>
                <!-- /ko -->
                <!-- ko if: grouped -->
                <td class="popover-cell" data-bind="style: { '--prev-col-widths': `${$data.accumulatedColumnWidths}px` }">
                    <div class="relative">
                        <a href="javascript:;" data-bind="html: $parent[`${columnName}_Display`], actualBootstrapPopover: { context: $parent, details: $parent[`${columnName}_PopoverDetails`] }"></a>
                    </div>
                </td>
                <!-- /ko -->
                <!-- /ko -->
                <td colspan="500" data-bind="style: { '--prev-col-widths': `${$data.accumulatedColumnWidths}px` }"></td>
            </tr>
        </tbody>
        <tbody class="virtual-spacing">
            <tr class="final-row" style="height: 0px;" data-bind="style: { height: `${gridScrollBottomPadding()}px` }">
                <td colspan="500"></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- /ko -->