@model SharedEFClasses.BaseViewModel

<div id="user-defined-filters" data-bind="css: 'd-flex', with: userDefinedFilters">
    <div>
        <h5 class="sidebar-heading">
            Customers
        </h5>
        @*<div id="sales-market-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesMarketParams }"></div>*@
        <div id="sales-markets-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-multiselect-component', params: salesMarketsParams }"></div>
        <div id="sales-representative-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesRepresentativeParams }"></div>
        <div id="sales-agent-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesAgentParams }"></div>
        <div id="sales-area-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesAreaParams }"></div>
        <div id="country-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: countryParams }"></div>
        <div id="trade-account-type-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountTypeParams }"></div>
        <div id="trade-account-group-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountGroupParams }"></div>
        <div id="payment-terms-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsParams }"></div>
        <div id="payment-terms-type-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsTypeParams }"></div>
        <div id="trade-account-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
    </div>
    <div>
        <h5 class="sidebar-heading">
            Orders
        </h5>
        <div id="order-search-term-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: orderParams }"></div>
        <div id="order-taker-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: orderTakerParams }"></div>
        <div id="from-date-prefilter" class="user-defined-filter" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: fromDateParams }"></div>
        <div id="to-date-prefilter" class="user-defined-filter" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: toDateParams }"></div>
        <div id="haulier-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: haulierParams }"></div>
        <div id="allocated-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: allocatedParams }"></div>
        <div id="transaction-type-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: transactionTypeParams }"></div>
        <div id="delivery-type-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: deliveryTypeParams }"></div>
    </div>
    <div>
        <h5 class="sidebar-heading">
            Products
        </h5>
        <div id="product-group-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productGroupParams }"></div>
        <div id="item-type-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: itemTypeParams }"></div>
        <div id="brand-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
        <div id="collection-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
        <div id="launch-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
        <div id="quality-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: qualityParams }"></div>
        <div id="design-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: designParams }"></div>
        <div id="supplier-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
        <div id="product-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productParams }"></div>
    </div>
    <div>
        <a class="btn btn-secondary btn-refresh" data-bind="click: parent.refresh">
            Refresh
        </a>
    </div>
    <div>
        <a class="btn btn-secondary btn-reset" data-bind="click: parent.reset">
            Reset
        </a>
    </div>
    <div>
        <h5 class="sidebar-heading">
            Values
        </h5>
        <ul id="display-mode-list" class="list-group">
            <li class="list-group-item" data-bind="css: { 'disabled': parent.displayModes().length == 1 && parent.displayModes()[0] == 1 }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="display-mode-value" data-bind="checked: parent.displayModes,
                        checkedValue: 1,
                        attr: {
                            disabled: parent.displayModes().length == 1 && parent.displayModes()[0] == 1
                        }">
                    <span>
                        Order Value £
                    </span>
                </label>
            </li>
            <li class="list-group-item" data-bind="css: { 'disabled': parent.displayModes().length == 1 && parent.displayModes()[0] == 2 }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="display-mode-quantity" data-bind="checked: parent.displayModes,
                        checkedValue: 2,
                        attr: {
                            disabled: parent.displayModes().length == 1 && parent.displayModes()[0] == 2
                        }">
                    <span>
                        Order Quantity
                    </span>
                </label>
            </li>
            <li class="list-group-item" data-bind="css: { 'disabled': parent.displayModes().length == 1 && parent.displayModes()[0] == 3 }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="display-mode-line-count" data-bind="checked: parent.displayModes,
                        checkedValue: 3,
                        attr: {
                            disabled: parent.displayModes().length == 1 && parent.displayModes()[0] == 3
                        }">
                    <span>
                        No. of Lines
                    </span>
                </label>
            </li>
            <li class="list-group-item" data-bind="css: { 'disabled': parent.displayModes().length == 1 && parent.displayModes()[0] == 4 }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="display-mode-order-count" data-bind="checked: parent.displayModes,
                        checkedValue: 4,
                        attr: {
                            disabled: parent.displayModes().length == 1 && parent.displayModes()[0] == 4
                        }">
                    <span>
                        No. of Orders
                    </span>
                </label>
            </li>
            <li class="list-group-item" data-bind="css: { 'disabled': parent.displayModes().length == 1 && parent.displayModes()[0] == 5 }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="display-mode-percentage-full" data-bind="checked: parent.displayModes,
                        checkedValue: 5,
                        attr: {
                            disabled: parent.displayModes().length == 1 && parent.displayModes()[0] == 5
                        }">
                    <span>
                        % of Full Order Book
                    </span>
                </label>
            </li>
            <li class="list-group-item" data-bind="css: { 'disabled': parent.displayModes().length == 1 && parent.displayModes()[0] == 6 }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="display-mode-percentage-filter" data-bind="checked: parent.displayModes,
                        checkedValue: 6,
                        attr: {
                            disabled: parent.displayModes().length == 1 && parent.displayModes()[0] == 6
                        }">
                    <span>
                        % of Filtered Order Book
                    </span>
                </label>
            </li>
        </ul>
        <h5 class="sidebar-heading">
            Groups
        </h5>
        <ul id="column-display-list" class="list-group">
            <!-- ko foreach: $parent.columnHeadings -->
            <li class="list-group-item" data-bind="css: { 'disabled': $parentContext.$parent.displayColumnHeadings().length == 1 && $parentContext.$parent.displayColumnHeadings()[0] === $data.orderStatusGroupSortOrder }">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" id="column-heading-mode-value" data-bind="checked: $parentContext.$parent.displayColumnHeadings,
                        checkedValue: $data.orderStatusGroupSortOrder,
                        attr: {
                            disabled: $parentContext.$parent.displayColumnHeadings().length == 1 && $parentContext.$parent.displayColumnHeadings()[0] === $data.orderStatusGroupSortOrder
                        }">
                    <span data-bind="text: orderStatusGroupName"></span>
                </label>
            </li>
            <!-- /ko -->
        </ul>
        <div id="data-source-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: dataSourceParams }"></div>
    </div>
    @if (ViewBag.Partial == null)
    {
        <div id="accurate-as-of" class="gap-0">
            <span class="courier-new d-block">
                Accurate as of
            </span>
            <!-- ko if: parent.accurateAsOfDateTime() -->
            <span class="courier-new" data-bind="html: moment(parent.accurateAsOfDateTime()).format('dddd Do MMMM YYYY<br/>DD/MM/YYYY HH:mm')"></span>
            <!-- /ko -->
        </div>
    }
</div>