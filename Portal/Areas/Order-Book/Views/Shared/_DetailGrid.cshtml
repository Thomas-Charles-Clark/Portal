@model SharedEFClasses.BaseViewModel
<!-- ko if: noResults -->
<div id="no-results">
    <div class="alert alert-secondary text-center alert-lg px-4 py-3">
        <h4 class="alert-title mb-3">
            Sorry
        </h4>
        <p>
            No Results Found
        </p>
    </div>
</div>
<!-- /ko -->
<!-- ko ifnot: noResults -->
<div id="order-book-detail-scroller-container" class="virtual-scroller-container" data-bind="with: virtualScroller">
    <table id="order-book-detail-table" class="table table-condensed table-striped table-hover order-book-detail-table">
        <colgroup>
            <!-- ko foreach: $parent.columns -->
            <col data-bind="style: { width: `${$data.width}px` }" />
            <!-- /ko -->
        </colgroup>
        <thead>
            <tr>
                <!-- ko foreach: $parent.columns -->
                <th class="sortable-column" data-bind="click: (data, event) => { $root.sortByColumn(data.detailColumns()[0]) }, style: { '--left-offset': `${$parentContext.$parent.columns().reduce((a, c, i) => a += i < $index() ? c.width : 0, 0)}px` }">
                    <span data-bind="text: columnNameDisplay"></span>
                    <!-- ko if: (Object.hasOwn($data, 'direction') && $data.direction()) -->
                    <i class="bi" data-bind="css: { 'bi-caret-up': direction() == 'asc', 'bi-caret-down': direction() == 'desc' }"></i>
                    <!-- /ko -->
                </th>
                <!-- /ko -->
            </tr>
            <tr class="subtotal-row">
                <!-- ko foreach: $parent.columns -->
                <th data-bind="text: total, style: { '--left-offset': `${$parentContext.$parent.columns().reduce((a, c, i) => a += i < $index() ? c.width : 0, 0)}px` }"></th>
                <!-- /ko -->
            </tr>
        </thead>
        <tbody class="virtual-spacing">
            <tr>
                <td colspan="500" style="height: 0px;" data-bind="style: { height: `${gridScrollTopPadding()}px` }"></td>
            </tr>
        </tbody>
        <tbody data-bind="foreach: visibleItems">
            <tr class="visible-item" data-bind="keepElement">
                <!-- ko foreach: $parentContext.$parent.columns -->
                <td data-bind="style: { '--left-offset': `${$parentContext.$parentContext.$parent.columns().reduce((a, c, i) => a += i < $index() ? c.width : 0, 0)}px` }">
                    <span data-bind="text: $parent[columnName]"></span>
                </td>
                <!-- /ko -->
            </tr>
        </tbody>
        <tbody class="virtual-spacing">
            <tr class="final-row">
                <td colspan="500" style="height: 0px;" data-bind="style: { height: `${gridScrollBottomPadding()}px` }"></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- /ko -->