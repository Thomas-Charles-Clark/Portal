@model SharedEFClasses.BaseViewModel
<div id="sales-filters-tab-container" data-bind="style: { '--first-column-count': salesFilters.groups().slice(1).findIndex(g => g.Label == ''), '--second-column-count': salesFilters.groups().length - salesFilters.groups().slice(1).findIndex(g => g.Label == '') - 2 }">
    <div class="blocker-wrapper" style="display: flex; opacity: 1" data-bind="flexFadeVisible: salesFilters.busy">
        <div class="blocker-message-wrapper loading-wrapper">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div class="blocker-wrapper" data-bind="gridFadeVisible: !salesFilters.busy() && salesFilters.displayBlocker()">
        <div class="blocker-message-wrapper">
            <h4 data-bind="html: salesFilters.blockerMessage"></h4>
        </div>
    </div>
    <div data-bind="with: salesFilters">
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_BUDGET) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Sales vs Budget
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: Budget_Row1, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: Budget_Row2, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: Budget_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && Budget_Row3?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: Budget_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && Budget_Row4?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
        </div>
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_COMBINED) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Net Sales (Sales - Credits)
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CombinedTotal_Row1, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CombinedTotal_Row2, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CombinedTotal_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && CombinedTotal_Row3?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CombinedTotal_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && CombinedTotal_Row4?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
        </div>
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_VALUE_SUM) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Sales before Credits
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: SalesTotal_Row1, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: SalesTotal_Row2, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: SalesTotal_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && SalesTotal_Row3?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: SalesTotal_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && SalesTotal_Row4?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
        </div>
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_CREDIT_SUM) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Credits Issued
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CreditTotal_Row1, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CreditTotal_Row2, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CreditTotal_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && CreditTotal_Row3?.indexOf('-') == -1 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: CreditTotal_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && CreditTotal_Row4?.indexOf('-') == -1 }"></span>
                <!-- /ko -->
            </div>
        </div>
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_QUANTITY_SUM) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Number of Orders
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: OrderCount_Row1, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: OrderCount_Row2, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: OrderCount_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && OrderCount_Row3?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: OrderCount_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && OrderCount_Row4?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
        </div>
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_LINE_COUNT) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Number of Lines
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: LineCount_Row1, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: LineCount_Row2, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: LineCount_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && LineCount_Row3?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: LineCount_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && LineCount_Row4?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>