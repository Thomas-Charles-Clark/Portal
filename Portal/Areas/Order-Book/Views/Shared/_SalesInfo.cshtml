@model SharedEFClasses.BaseViewModel
<div id="sales-filters-tab-container" data-bind="style: { '--first-column-count': salesFilters.groups().slice(1).findIndex(g => g.Label == ''), '--second-column-count': salesFilters.groups().length - salesFilters.groups().slice(1).findIndex(g => g.Label == '') - 2 }">
    <div class="blocker-wrapper" style="display: flex; opacity: 1" data-bind="flexFadeVisible: salesFilters.busy">
        <div class="blocker-message-wrapper loading-wrapper">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div data-bind="with: salesFilters">
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_BUDGET) > -1">
            <div id="budget-blocker" class="blocker-wrapper" data-bind="gridFadeVisible: !busy() && displayBlocker()">
                <div class="blocker-message-wrapper">
                    <h4 data-bind="html: blockerMessage"></h4>
                </div>
            </div>
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Sales vs Budget
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span class="downloadable" data-bind="text: Budget_Row1, class: `sales-cell-${CellType.toLowerCase()}`, click: (data) => { $parent.exportSales({ label: `Budget_${$parent.fetchLabel($index(), 'Budget_Row1')}_${Label}`, startDt: data.Budget_Row1_StartDT, endDt: data.Budget_Row1_EndDT }) }, clickBubble: false"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span class="downloadable" data-bind="text: Budget_Row2, class: `sales-cell-${CellType.toLowerCase()}`, click: (data) => { $parent.showSummaryModal({ startDt: data.Budget_Row2_StartDT, endDt: data.Budget_Row2_EndDT }) }, clickBubble: false"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: Budget_Row3, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && Budget_Row3?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span data-bind="text: Budget_Row4, class: `sales-cell-${CellType.toLowerCase()}`, css: { 'red': CellType != 'L' && Budget_Row4?.indexOf('-') == 0 }"></span>
                <!-- /ko -->
            </div>
        </div>
        <div class="sales-section" data-bind="visible: displayModes().indexOf(DISPLAY_MODE_COMBINED) > -1">
            <div class="sales-header">
                <h5 class="sales-group-title">
                    Net Sales (Sales - Credits)
                </h5>
                <!-- ko foreach: groups -->
                <!-- ko if: $index() > 0 -->
                <span data-bind="text: Label, class: `sales-cell-${CellType.toLowerCase()}`"></span>
                <!-- /ko -->
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span class="downloadable" data-bind="text: CombinedTotal_Row1, class: `sales-cell-${CellType.toLowerCase()}`, click: (data) => { $parent.exportSales({ label: `Net_Sales_${$parent.fetchLabel($index(), 'CombinedTotal_Row1')}_${Label}`, startDt: data.CombinedTotal_Row1_StartDT, endDt: data.CombinedTotal_Row1_EndDT }) }, clickBubble: false"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
                <span class="downloadable" data-bind="text: CombinedTotal_Row2, class: `sales-cell-${CellType.toLowerCase()}`, click: (data) => { $parent.exportSales({ label: `Net_Sales_${$parent.fetchLabel($index(), 'CombinedTotal_Row2')}_${Label}`, startDt: data.CombinedTotal_Row2_StartDT, endDt: data.CombinedTotal_Row2_EndDT }) }, clickBubble: false"></span>
                <!-- /ko -->
            </div>
            <div>
                <!-- ko foreach: groups -->
