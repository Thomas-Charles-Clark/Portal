@model SharedEFClasses.BaseViewModel

<div id="advanced-filters" data-bind="css: 'd-flex', with: advancedFilters">
    <div>
        <h5 class="sidebar-heading">
            Advanced
        </h5>
        <div id="product-status-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productStatusParams }"></div>
        <div id="order-group-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: orderGroupParams }"></div>
        <div id="stock-location-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: stockLocationGroupParams }"></div>
        <div id="order-status-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: orderStatusParams }"></div>
        <div id="order-status-group-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: orderStatusGroupParams }"></div>
        <div id="has-linked-po-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: hasLinkedPOParams }"></div>
        <div id="linked-po-delayed-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: linkedPODelayedParams }"></div>

        <div id="fulfilled-from-free-stock-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: couldBeFulfilledFromFreeStockParams }"></div>
        <div id="line-status-greater-than-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: lineStatusIdGreaterThanParams }"></div>
        <div id="line-status-less-than-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: lineStatusIdLessThanParams }"></div>
        <div id="line-status-changed-today-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: lineStatusChangedTodayParams }"></div>
        <div id="detailed-line-status-is-null-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: detailedLineStatusIsNullParams }"></div>
        <div id="express-delivery-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: expressDeliveryParams }"></div>
        <div id="free-delivery-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: freeDeliveryParams }"></div>
        <div id="reserved-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: reservedParams }"></div>
        <div id="customer-held-for-full-despatch-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: customerHeldForFullDespatchParams }"></div>
        <div id="unpaid-proforma-prefilter" class="user-defined-filter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: unpaidProformaParams }"></div>

    </div>
    <div>
        <div id="accurate-as-of" class="gap-0">
            <span class="courier-new d-block">
                Accurate as of
            </span>
            <!-- ko if: parent.accurateAsOfDateTime() -->
            <span class="courier-new" data-bind="html: moment(parent.accurateAsOfDateTime()).format('dddd Do MMMM YYYY<br/>DD/MM/YYYY HH:mm')"></span>
            <!-- /ko -->
        </div>
    </div>
   @if (SharedEFClasses.Utilities.Framework.DebugMode)
    {
        <div>
            <h5 class="sidebar-heading">
                Debug
            </h5>
            <div class="user-filter">
                <label>
                    Base Bound:
                    <span data-bind="text: allBound"></span>
                </label>
            </div>
            <div class="user-filter">
                <label>
                    Advanced Bound:
                    <span data-bind="text: allBound"></span>
                </label>
            </div>
        </div>
    }
</div>