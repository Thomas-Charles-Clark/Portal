@model SharedEFClasses.BaseViewModel
<!-- ko if: noResults -->
<div id="no-results">
    <div class="alert alert-secondary text-center alert-lg px-4 py-3">
        <h4 class="alert-title mb-3">
            Sorry
        </h4>
        <p>
            No Results Found
        </p>
    </div>
</div>
<!-- /ko -->
<!-- ko ifnot: noResults -->
<div id="order-book-detail-scroller-container" class="virtual-scroller-container" data-bind="with: virtualScroller">
    <table id="order-book-detail-table" class="table table-condensed table-striped table-hover order-book-detail-table">
        <colgroup>
            <!-- ko foreach: $parent.columns -->
            <col style="width: 240px;" />
            <!-- /ko -->
        </colgroup>
        <thead>
            <tr>
                <!-- ko foreach: $parent.columns -->
                <th class="sortable-column" data-bind="click: $root.sortByColumn">
                    <span data-bind="text: columnNameDisplay"></span>
                </th>
                <!-- /ko -->
            </tr>
            <tr class="subtotal-row">
                <!-- ko foreach: $parent.columns -->
                <th data-bind="html: displayTotal"></th>
                <!-- /ko -->
            </tr>
        </thead>
        <tbody class="virtual-spacing">
            <tr>
                <td colspan="500" style="height: 0px;" data-bind="style: { height: `${gridScrollTopPadding()}px` }"></td>
            </tr>
        </tbody>
        <tbody data-bind="foreach: visibleItems">
            <tr>
                <!-- ko foreach: $parentContext.$parent.columns -->
                <!-- ko if: $index() < 5 -->
                <td>
                    <sapn data-bind="html: $parent[`${columnName}_Display`]"></sapn>
                </td>
                <!-- /ko -->
                <!-- ko ifnot: $index() < 5 -->
                <td class="popover-cell">
                    <a class="btn btn-link" data-bind="html: $parent[`${columnName}_Display`], actualBootstrapPopover: $parent.popoverDetails"></a>
                </td>
                <!-- /ko -->
                <!-- /ko -->
            </tr>
        </tbody>
        <tbody class="virtual-spacing">
            <tr class="final-row">
                <td colspan="500" style="height: 0px;" data-bind="style: { height: `${gridScrollBottomPadding()}px` }"></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- /ko -->