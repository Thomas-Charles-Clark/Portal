<script type="text/html" id="management-prompt-tabs-values-dropdown-container">
    <ul class="dropdown-menu display-mode-list">
        <li class="dropdown-menu-controls d-flex gap-2" data-bind="click: () => { }, clickBubble: false">
            <button class="btn btn-secondary btn-sm" data-bind="click: () => { displayTabs($root.preDefinedFilters.availableManagementPromptTabs().map(adm => adm.groupId)); }, clickBubble: false">
                Select All
            </button>
            <button class="btn btn-secondary btn-sm" data-bind="click: () => { displayTabs([]); }, clickBubble: false">
                Deselect All
            </button>
            <button class="btn btn-secondary btn-sm ms-auto" data-bind="click:  (data, event) => { bootstrap.Dropdown.getOrCreateInstance(event.currentTarget.closest('.dropdown').querySelector('.dropdown-toggle')).hide(); }, clickBubble: false">
                Close
            </button>
        </li>
        <!-- ko foreach: $root.preDefinedFilters.availableManagementPromptTabs -->
        <li>
            <label class="form-check" data-bind="attr: { 'for': `management-prompt-${groupId}-display-tab-${groupId}` }, click: function() { return true }, clickBubble: false">
                <input class="form-check-input" type="checkbox" data-bind="checked: $parent.displayTabs,
                        checkedValue: groupId,
                        attr: {
                            id: `management-prompt-${groupId}-display-tab-${groupId}`
                        }" />
                <span data-bind="text: label"></span>
            </label>
        </li>
        <!-- /ko -->
    </ul>
</script>

<div id="main-summary-container" class="d-flex align-items-start w-100" style="opacity: 0" data-bind="flexFadeVisible: true">
    <sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top">
        @* show pinned *@
        <div class="sidebar-inner">
            <div class="sidebar-header" data-bind="click: userDefinedFilters.togglePinning">
                <button type="button"
                        class="btn btn-light"
                        title="Toggle Pinning">
                    <i class="bi bi-pin-angle-fill fs-5"></i>
                </button>
                <label class="filters-count" data-bind="html: userDefinedFilters.countDisplay"></label>
            </div>
            <div id="sidebar-collapse" class="sidebar-body">
                @Html.Partial("_UserDefinedFilters")
            </div>
        </div>
    </sidebar>
    <main id="order-book-main">
        <div class="accordion" id="header-accordion">
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-three-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-three" data-bind="with: salesFilters, click: toggleSales, css: { collapsed: salesCollapse }">
                        <span>
                            Sales
                        </span>
                        @*<a class="btn display-control-btn btn-sm btn-export no-ripple" href="#" data-bind="click: (data, event) => { exportSales(data, JSON.parse(parent.userDefinedFilters.json())) }, clickBubble: false">
                                <i class="bi bi-filetype-xlsx"></i>
                            </a>*@
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-list-check"></i>
                            </a>
                            <!-- ko template: { name: 'sales-values-dropdown-container' } --><!-- /ko -->
                        </div>
                    </button>
                </h5>
                <div id="header-accordion-three" class="accordion-collapse collapse" aria-labelledby="header-accordion-three" data-bind="css: { show: !salesCollapse() }">
                    <div class="accordion-body">
                        @Html.Partial("_SalesInfo")
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-two-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-two" data-bind="with: preDefinedFilters, click: togglePrompts, css: { collapsed: podsCollapse }">
                        <span>
                            Management Prompts
                        </span>
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-collection"></i>
                            </a>
                            <!-- ko template: { name: 'management-prompt-tabs-values-dropdown-container' } --><!-- /ko -->
                        </div>
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-list-check"></i>
                            </a>
                            <!-- ko template: { name: 'values-dropdown-container' } --><!-- /ko -->
                        </div>
                    </button>
                </h5>
                <div id="header-accordion-two" class="accordion-collapse collapse show" aria-labelledby="header-accordion-two" data-bind="css: { show: !podsCollapse() }">
                    <div class="accordion-body">
                        @Html.Partial("_PreDefinedFilters")
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-four-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-four" data-bind="click: toggleGrid, css: { collapsed: gridCollapse }">
                        <span>
                            Order Book
                        </span>
                        <div class="mdc-bootstrap-multiselect">
                            <div class="dropdown" data-bind="with: displayColumnHeadingsParams">
                                <a href="#" class="btn display-control-btn dropdown-toggle no-ripple" type="button"
                                   data-bind="keepElement: observableArray,
                                   class: displayClass,
                                   attr: {
                                   id: elementId
                                   },
                                   html: btnMarkup,
                                   event: {
                                   'hide.bs.dropdown' : ()=>
                                    { controls.applySelection(false); return true; }
                                    },
                                    click: () => { return true },
                                    clickBubble: false"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false">
                                </a>
                                <ul class="dropdown-menu" data-bind="attr: { 'aria-labelledby': elementId }">
                                    <!-- ko if: controls != "undefined" -->
                                    <li class="dropdown-menu-controls d-flex gap-2" data-bind="click: () => { }, clickBubble: false">
                                        <!-- ko if: controls.selectAll -->
                                        <a href="#" class="btn btn-secondary btn-sm" data-bind="click: controls.selectAll, clickBubble: false">
                                            Select All
                                        </a>
                                        <!-- /ko -->
                                        <!-- ko if: controls.deselectAll -->
                                        <a href="#" class="btn btn-secondary btn-sm" data-bind="click: controls.deselectAll, clickBubble: false">
                                            Deselect All
                                        </a>
                                        <!-- /ko -->
                                        <!-- ko if: controls.applySelection -->
                                        <a href="#" class="btn btn-secondary btn-sm ms-auto" data-bind="click: () => { controls.applySelection(true); }, clickBubble: false">
                                            Apply
                                        </a>
                                        <!-- /ko -->
                                    </li>
                                    <!-- /ko -->
                                    <!-- ko foreach: options -->
                                    <li data-bind="css: { 'disabled': disabled }">
                                        <label class="dropdown-item pointer form-check-label" data-bind="click: () => { return true; }, clickBubble: false">
                                            <input class="form-check-input" type="checkbox" data-bind="checked: $parent.observableArray,
                                checkedValue: $data.orderStatusGroupId,
                                attr: {
                                    disabled: disabled
                                }">
                                            <span data-bind="text: orderStatusGroupName"></span>
                                        </label>
                                    </li>
                                    <!-- /ko -->
                                </ul>
                            </div>
                        </div>
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-list-check"></i>
                            </a>
                            <!-- ko template: { name: 'values-dropdown-container', data: $data.dateFilters } --><!-- /ko -->
                        </div>
                        <a class="btn no-ripple" style="text-decoration: underline" href="#" type="button" data-bind="click: $root.showSummaryModal, clickBubble: false">
                            Summary
                        </a>
                    </button>
                </h5>
            </div>
        </div>
        @Html.Partial("_DateFilters")
        @Html.Partial("_MainGrid")
    </main>
</div>

<div id="order-book-summary-modal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" style="display: flex; opacity: 1" data-bind="flexFadeVisible: orderBookSummaryBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title">
                    Order Book Summary
                </h5>
                <button class="btn btn-sm btn-primary no-ripple" type="button" data-bind="click: () => { fetchOrderBookSummary(userDefinedFilters.json()) }">
                    Refresh
                    <i class="material-icons">
                        refresh
                    </i>
                </button>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- ko if: orderBookSummaryResults().length -->
                <table id="order-book-summary-table" class="table table-collapsed">
                    <colgroup>
                        <col />
                        <col />
                        <col />
                        <col />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>

                            </th>
                            <th>
                                Order Value £
                            </th>
                            <th>
                                No. Orders
                            </th>
                            <th>
                                No. Lines
                            </th>
                        </tr>
                    </thead>
                    <!-- ko foreach: orderBookSummaryResults -->
                    <tbody>
                        <!-- ko foreach: rows -->
                        <tr data-bind="css: { 'summary-total-row'  : $index() == 0 }">
                            <td>
                                <span data-bind="text: $index() == 0 ? GroupName ?? 'Total' : RowName"></span>
                            </td>
                            <td>
                                <span data-bind="text: OrderValue"></span>
                            </td>
                            <td>
                                <span data-bind="text: OrderCount"></span>
                            </td>
                            <td>
                                <span data-bind="text: LineCount"></span>
                            </td>
                        </tr>
                        <!-- /ko -->
                    </tbody>
                    <!-- /ko -->
                </table>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>

<div id="order-book-detail-modal" class="modal fade">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span id="order-book-detail-modal-title" class="order-book-detail-modal-title">
                        Order Book Detail
                    </span>
                </h5>
                <div class="d-flex gap-5">
                    <button id="filter-top-btn" class="btn btn-light btn-export" data-bind="click: toggleFilters">
                        <span id="filter-top-btn-display">
                            Filters
                        </span>
                        <i class="bi bi-filter"></i>
                    </button>
                    <button id="copy-to-clipboard-btn" class="btn btn-light btn-export" data-bind="click: copyLink" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Copied to Clipboard" data-bs-trigger="manual">
                        Copy Link to Clipboard
                        <i class="bi bi-copy"></i>
                    </button>
                    <button class="btn btn-light btn-export" data-bind="click: exportDetail">
                        Export to Excel
                        <i class="bi bi-download"></i>
                        <i class="bi bi-filetype-xlsx"></i>
                    </button>
                    <button class="btn btn-secondary d-flex gap-2 align-items-center" data-bs-dismiss="modal" aria-label="Close">
                        Close and return to Order Book Summary
                        <span class="btn-close btn-close-white">
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <div class="blocker" style="display: flex; opacity: 1" data-bind="flexFadeVisible: detailModalBusy">
                    <div class="loading-spinner"></div>
                    <h4 class="mt-3">
                        Please wait...
                    </h4>
                </div>
                <div id="order-book-detail-iframe-target">

                </div>
            </div>
        </div>
    </div>
</div>

<div id="order-book-sales-summary-modal" class="modal fade" tabindex="-1" data-bind="with: salesFilters">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" style="display: flex; opacity: 1" data-bind="flexFadeVisible: summaryBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title">
                    Sales Summary
                </h5>
                <button class="btn btn-sm btn-primary no-ripple" type="button" data-bind="click: fetchSummary">
                    Refresh
                    <i class="material-icons">
                        refresh
                    </i>
                </button>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- ko if: summary().length -->
                <table id="order-book-sales-summary-table" class="table table-collapsed">
                    <colgroup>
                        <col />
                        <col />
                        <col />
                        <col />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>
                                Market
                            </th>
                            <th>
                                Financial Year
                            </th>
                            <th>
                                Financial Period
                            </th>
                            <th>
                                Budget
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ko foreach: summary -->
                        <tr>
                            <td>
                                <span data-bind="text: Label"></span>
                            </td>
                            <td>
                                <span data-bind="text: FinancialYear"></span>
                            </td>
                            <td>
                                <span data-bind="text: FinancialPeriod"></span>
                            </td>
                            <td>
                                <span data-bind="text: formatCurrency(Budget, 0, 'en-GB', 'GBP')"></span>
                            </td>
                        </tr>
                        <!-- /ko -->
                    </tbody>
                </table>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>
