@model Portal.Areas.Orders.ViewModels.OrderBookSummaryViewModel
@{
    ViewBag.Title = "Order Book";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/order-book")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/order-book")

    <script type="text/javascript">

        window.getMainResult = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.MainResult));
        }

        var viewModel = orderBookViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        viewModel.busy(false);

        window.self = viewModel;

    </script>
}
@section modals {
    @Html.Partial("Modals/_ImageModalNew")
}
@section navbarTitle {
    <div>
        <h2 class="d-flex gap-3 align-items-center">
            Order Book Summary
        </h2>
    </div>
}
@section beforeContainer {
    <div id="accuracy-collapse" class="collapse" data-bs-toggle="false">
        <div class="card">
            <div class="card-body">
                <div class="d-flex gap-5 justify-content-center align-items-center">
                    <div data-bind="html: accuracyMessage"></div>
                    <div class="d-flex gap-3">
                        <button class="btn btn-light" data-bind="click: accuracyRefresh">
                            Refresh
                            <i class="material-icons">
                                refresh
                            </i>
                        </button>
                        <button class="btn btn-secondary" data-bind="click: accuracyPleaseStopRemindingMe">
                            Don't prompt me again for 24 hours
                            <i class="material-icons">
                                block
                            </i>
                        </button>
                        <button class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#accuracy-collapse">
                            Not Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="accuracy-error-collapse" class="collapse" data-bs-toggle="false">
        <div class="card">
            <div class="card-body">
                <p class="mb-0">
                    More recent data should be available by now but doesn't appear to be. Please contact <a href='mailto:itsupport@designersguild.com'>itsupport@designersguild.com</a>.
                </p>
            </div>
        </div>
    </div>
}
<div class="blocker" style="display: flex; opacity: 1" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<script type="text/html" id="values-dropdown-container">
    <ul class="dropdown-menu display-mode-list">
        <!-- ko foreach: $root.availableDisplayModes -->
        <li data-bind="css: { 'disabled': $parent.displayModes().length == 1 && $parent.displayModes()[0] == value }">
            <label class="form-check" data-bind="attr: { 'for': `order-group-${$parent.orderGroupId}-display-mode-${value}` }, click: function() { return true }, clickBubble: false">
                <input class="form-check-input" type="checkbox" data-bind="checked: $parent.displayModes,
                        checkedValue: value,
                        attr: {
                            id: `order-group-${$parent.orderGroupId}-display-mode-${value}`,
                            disabled: $parent.displayModes().length == 1 && $parent.displayModes()[0] == value
                        }" />
                <span data-bind="text: label"></span>
            </label>
        </li>
        <!-- ko foreach: children -->
        <li data-bind="visible: $parentContext.$parent.displayModes().indexOf($parent.value) > -1" style="padding-left: 2rem;">
            <label class="form-check" data-bind="attr: { 'for': `order-group-${$parentContext.$parent.orderGroupId}-display-mode-${value}` }, click: function() { return true }, clickBubble: false">
                <input class="form-check-input" type="checkbox" data-bind="checked: $parentContext.$parent.displayModes,
                checkedValue: value,
                attr: {
                    id: `order-group-${$parentContext.$parent.orderGroupId}-display-mode-${value}`,
                    disabled: $parentContext.$parent.displayModes().length == 1 && $parentContext.$parent.displayModes()[0] == value
                }" />
                <span data-bind="text: label"></span>
            </label>
        </li>
        <!-- /ko -->
        <!-- /ko -->
    </ul>
</script>

<div id="main-summary-container" class="d-flex align-items-start w-100" style="opacity: 0" data-bind="flexFadeVisible: true">
    <sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top"> @* show pinned *@
        <div class="sidebar-inner">
            <div class="sidebar-header" data-bind="click: userDefinedFilters.togglePinning">
                <button type="button"
                        class="btn btn-light"
                        title="Toggle Pinning">
                    <i class="bi bi-pin-angle-fill fs-5"></i>
                </button>
                <label class="filters-count" data-bind="html: userDefinedFilters.countDisplay"></label>
            </div>
            <div id="sidebar-collapse" class="sidebar-body">
                @Html.Partial("_UserDefinedFilters")
            </div>
        </div>
    </sidebar>
    <main id="order-book-main">
        <div class="accordion" id="header-accordion">
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-one-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-one" data-bind="with: dateFilters, click: toggleDates, css: { collapsed: datesCollapse }">
                        <span>
                            Order Book Aged by Order Date
                        </span>
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-list-check"></i>
                            </a>
                            <!-- ko template: { name: 'values-dropdown-container' } --><!-- /ko -->
                        </div>
                    </button>
                </h5>
                <div id="header-accordion-one" class="accordion-collapse collapse show" aria-labelledby="header-accordion-header" data-bind="css: { show: !datesCollapse() }">
                    <div class="accordion-body">
                        @Html.Partial("_DateFilters")
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-two-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-two" data-bind="with: preDefinedFilters, click: togglePrompts, css: { collapsed: podsCollapse }">
                        <span>
                            Management Prompts
                        </span>
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-list-check"></i>
                            </a>
                            <!-- ko template: { name: 'values-dropdown-container' } --><!-- /ko -->
                        </div>
                    </button>
                </h5>
                <div id="header-accordion-two" class="accordion-collapse collapse show" aria-labelledby="header-accordion-two" data-bind="css: { show: !podsCollapse() }">
                    <div class="accordion-body">
                        @Html.Partial("_PreDefinedFilters")
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-three-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-three" data-bind="with: salesFilters, click: toggleSales, css: { collapsed: salesCollapse }">
                        <span>
                            Sales
                        </span>
                        <div class="dropdown">
                            <a class="btn display-control-btn btn-sm dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
                                <i class="bi bi-list-check"></i>
                            </a>
                            <!-- ko template: { name: 'values-dropdown-container' } --><!-- /ko -->
                        </div>
                    </button>
                </h5>
                <div id="header-accordion-three" class="accordion-collapse collapse" aria-labelledby="header-accordion-three" data-bind="css: { show: !salesCollapse() }">
                    <div class="accordion-body">
                        <div class="card mb-2">
                            <div class="card-body">
                                <h5 class="mb-0">
                                    TBC
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h5 class="accordion-header" id="header-accordion-four-header">
                    <button class="accordion-button" type="button" aria-expanded="true" aria-controls="header-accordion-four" data-bind="click: toggleGrid, css: { collapsed: gridCollapse }">
                        Order Book
                    </button>
                </h5>
            </div>
        </div>
        @Html.Partial("_MainGrid")
    </main>
</div>

<div class="modal fade" tabindex="-1" id="data-accuracy-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Data Accuracy
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" data-bind="html: accuracyMessage">
            </div>
            <div class="modal-footer justify-content-between">
                <button class="btn btn-secondary" data-bind="click: accuracyRefresh">
                    Refresh
                    <i class="material-icons">
                        refresh
                    </i>
                </button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Not Now
                </button>
                <button class="btn btn-warning" data-bind="click: accuracyPleaseStopRemindingMe">
                    No, Please Stop Reminding Me
                    <i class="material-icons">
                        block
                    </i>
                </button>
            </div>
        </div>
    </div>
</div>

<div id="order-book-detail-modal" class="modal fade">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span id="order-book-detail-modal-title" class="order-book-detail-modal-title">
                        Order Book Detail
                    </span>
                </h5>
                <div class="d-flex gap-5">
                    <button id="filter-top-btn" class="btn btn-light btn-export" data-bind="click: toggleFilters">
                        Filters
                        <i class="bi bi-filter"></i>
                    </button>
                    <button id="copy-to-clipboard-btn" class="btn btn-light btn-export" data-bind="click: copyLink" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Copied to Clipboard" data-bs-trigger="manual">
                        Copy Link to Clipboard
                        <i class="bi bi-copy"></i>
                    </button>
                    <button class="btn btn-light btn-export" data-bind="click: exportDetail">
                        Export to Excel
                        <i class="bi bi-download"></i>
                        <i class="bi bi-filetype-xlsx"></i>
                    </button>
                    <button class="btn btn-secondary d-flex gap-2 align-items-center" data-bs-dismiss="modal" aria-label="Close">
                        Close and return to Order Book Summary
                        <span class="btn-close btn-close-white">
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <div class="blocker" style="display: flex; opacity: 1" data-bind="flexFadeVisible: detailModalBusy">
                    <div class="loading-spinner"></div>
                    <h4 class="mt-3">
                        Please wait...
                    </h4>
                </div>
                <div id="order-book-detail-iframe-target">

                </div>
            </div>
        </div>
    </div>
</div>