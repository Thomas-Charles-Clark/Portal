@model Portal.Areas.Orders.ViewModels.OrderBookSummaryViewModel
@{
    ViewBag.Title = "Order Book";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/order-book")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/order-book")

<script type="text/javascript">

        window.getMainResult = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.MainResult));
        }

        window.getOrderLineDetailedStatusGroups = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.OrderLineDetailedStatusGroups));
        }

        window.getPreDefinedFilterGroups = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreDefinedFilterGroups));
        }


        var viewModel = orderBookViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

</script>
}
@section modals {
    @Html.Partial("Modals/_ImageModalNew")
}
@section navbarTitle {
    <div>
        <h2 class="d-flex gap-3 align-items-center">
            Order Book Summary
        </h2>
    </div>
}
@section beforeContainer {
    <div id="accuracy-collapse" class="collapse" data-bs-toggle="false">
        <div class="card">
            <div class="card-body">
                <div class="d-flex gap-5 justify-content-center align-items-center">
                    <div data-bind="html: accuracyMessage"></div>
                    <div class="d-flex gap-3">
                        <button class="btn btn-light" data-bind="click: accuracyRefresh">
                            Refresh
                            <i class="material-icons">
                                refresh
                            </i>
                        </button>
                        <button class="btn btn-secondary" data-bind="click: accuracyPleaseStopRemindingMe">
                            Don't prompt me again for 24 hours
                            <i class="material-icons">
                                block
                            </i>
                        </button>
                        <button class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#accuracy-collapse">
                            Not Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="accuracy-error-collapse" class="collapse" data-bs-toggle="false">
        <div class="card">
            <div class="card-body">
                <p class="mb-0">
                    More recent data should be available by now but doesn't appear to be. Please contact <a href='mailto:itsupport@designersguild.com'>itsupport@designersguild.com</a>.
                </p>
            </div>
        </div>
    </div>
}
<div class="blocker" style="display: flex; opacity: 1" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<script type="text/html" id="values-dropdown-container">
    <ul class="dropdown-menu display-mode-list">
        <li class="dropdown-menu-controls d-flex gap-2" data-bind="click: () => { }, clickBubble: false">
            <button class="btn btn-secondary btn-sm" data-bind="click: () => { displayModes([...$root.availableDisplayModes().flatMap(adm => [...adm.children.map(c => c.value)].concat([adm.value]))]); }, clickBubble: false">
                Select All
            </button>
            <button class="btn btn-secondary btn-sm" data-bind="click: () => { displayModes([]); }, clickBubble: false">
                Deselect All
            </button>
            <button class="btn btn-secondary btn-sm ms-auto" data-bind="click: (data, event) => { bootstrap.Dropdown.getOrCreateInstance(event.currentTarget.closest('.dropdown').querySelector('.dropdown-toggle')).hide(); }, clickBubble: false">
                Close
            </button>
        </li>
        <!-- ko foreach: $root.availableDisplayModes -->
        <li data-bind="css: { 'disabled': $parent.displayModes().length == 1 && $parent.displayModes()[0] == value }">
            <label class="form-check" data-bind="attr: { 'for': `order-group-${$parent.orderGroupId}-display-mode-${value}` }, click: function() { return true }, clickBubble: false">
                <input class="form-check-input" type="checkbox" data-bind="checked: $parent.displayModes,
                        checkedValue: value,
                        attr: {
                            id: `order-group-${$parent.orderGroupId}-display-mode-${value}`,
                            disabled: $parent.displayModes().length == 1 && $parent.displayModes()[0] == value
                        }" />
                <span data-bind="text: label"></span>
            </label>
        </li>
        <!-- ko foreach: children -->
        <li data-bind="visible: $parentContext.$parent.displayModes().indexOf($parent.value) > -1" style="padding-left: 2rem;">
            <label class="form-check" data-bind="attr: { 'for': `order-group-${$parentContext.$parent.orderGroupId}-display-mode-${value}` }, click: function() { return true }, clickBubble: false">
                <input class="form-check-input" type="checkbox" data-bind="checked: $parentContext.$parent.displayModes,
                checkedValue: value,
                attr: {
                    id: `order-group-${$parentContext.$parent.orderGroupId}-display-mode-${value}`,
                    disabled: $parentContext.$parent.displayModes().length == 1 && $parentContext.$parent.displayModes()[0] == value
                }" />
                <span data-bind="text: label"></span>
            </label>
        </li>
        <!-- /ko -->
        <!-- /ko -->
    </ul>
</script>

