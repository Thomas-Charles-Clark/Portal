@model Portal.Areas.Fenwick.ViewModels.FenwickInvoicingViewModel
@{
    ViewBag.Title = Model.ApplicationHeading;

    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/fenwick-invoicing")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/fenwick-invoicing")
    @Scripts.Render("~/bundles/js/datetime-picker")

    <script type="text/javascript">

        let viewModel = fenwickInvoicingViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });
        6
        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;
    </script>
}
@section beforeContainer {
    <div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
        <div class="loading-spinner"></div>
        <h3 class="mt-3">
            Please Wait...
        </h3>
    </div>
}
<script id="row-template" type="text/html">

</script>

<div class="form-group row mb-3">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<div id="invoicing" aria-labelledby="invoicing-tab-btn" style="display: none" data-bind="visible: true">
    <div class="heading prefilters">
        <span>
            Invoice Date:
        </span>
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component-no-outline', params: billingPeriodParams }"></div>
    </div>
    <!-- ko if: billingPeriod -->
    <div class="branches">
        <table id="branches-table" class="table table-condensed table-bordered table-hover">
            <colgroup>
                <col />
                <col style="width: 160px" />
                <col style="width: 160px" />
                <col style="width: 160px" />
                <col style="width: 160px" />
                <col />
            </colgroup>
            <thead>
                <tr>
                    <th>
                        Branch
                    </th>
                    <th class="text-end">
                        Total Gross Sales
                    </th>
                    <th class="text-end">
                        VAT
                    </th>
                    <th class="text-end">
                        Total Commission
                    </th>
                    <th class="text-end">
                        Variance
                    </th>
                    <th>
                        Status
                    </th>
                </tr>
            </thead>
            <tbody>
                <!-- ko foreach: billingPeriod().Branches -->
                <tr data-bind="css: { 'table-active': $parent.selectedBranchId() === $data.BranchID }, click: $parent.selectBranch">
                    <td>
                        <span data-bind="text: Branch.Name "></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(TotalGrossSales, 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(TotalVAT, 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(TotalCommission, 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(FenwicksVariance, 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td>
                        <span data-bind="html: (SignedOffByMember ? `Signed off by ${SignedOffByMember.FullName} on ${renderDate(SignedOffDT)}` : null)"></span>
                    </td>
                </tr>
                <!-- /ko -->
                <tr>
                    <th>
                        Total
                    </th>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(billingPeriod().Branches.reduce((a, i) => { return a + i.TotalGrossSales }, 0), 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(billingPeriod().Branches.reduce((a, i) => { return a + i.TotalVAT }, 0), 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(billingPeriod().Branches.reduce((a, i) => { return a + i.TotalCommission }, 0), 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td class="text-end">
                        <span data-bind="text: formatCurrency(billingPeriod().Branches.reduce((a, i) => { return a + i.FenwicksVariance }, 0), 2, 'en-GB', 'GBP')"></span>
                    </td>
                    <td>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- ko if: selectedSelfBillInvoice() -->
    <div id="sbi-result">
        <h4 class="heading mt-3 mb-2">
            <span>
                <span data-bind="text: selectedSelfBillInvoice()?.Branch.Name"></span>
            </span>
        </h4>
        <div class="grid gap-2">
            <div>
                <h3 class="heading mb-0">
                    Self Bill Invoice
                </h3>
                <!-- ko if: invoiceDocumentBase64() -->
                <div id="invoicing-wrapper">
                    <div id="invoicing-blurb">
                        <p>
                            Extract 3 values: Total Gross Sales, VAT, and Total Commission from the Self-Bill Invoice
                            below so they can be compared to the Till transaction values on the right.
                            Once you are happy that there is no (or an acceptably low) variance you can sign off
                            this billing period, making any notes that you feel will assist when revisiting the
                            invoicing at a later date. Signing off submits the transaction lines to Mertex so that
                            the stock is downdated and payments can be assigned to the account. It is important
                            that sign off is completed as soon after the invoice date as possible.
                        </p>
                    </div>
                    <div id="invoicing-values">
                        <div data-bind="template: { name: 'generic-form-field-template', data: invoiceTotalGrossSales }"></div>
                        <div data-bind="template: { name: 'generic-form-field-template', data: invoiceTotalVAT }"></div>
                        <div data-bind="template: { name: 'generic-form-field-template', data: invoiceTotalCommission }"></div>
                    </div>
                </div>
                <!-- /ko -->
                <form id="invoice-document-form" onsubmit="return false;" data-bind="css: { 'offset-top': invoiceDocumentBase64() == null }">
                    <!-- ko if: invoiceDocumentBase64()?.indexOf('application/pdf') > -1 || invoiceDocumentBase64()?.indexOf('image/') > -1 -->
                    <div class="relative">
                        <iframe data-bind="attr: { src: invoiceDocumentBase64 }"></iframe>
                    </div>
                    <!-- /ko -->
                    <!-- ko ifnot: signedOff -->
                    <div class="mb-3" data-bind="component: { name: 'mdc-file-field-component', params: invoiceDocumentPdfParams }"></div>
                    <!-- /ko -->
                    <!-- ko if: invoiceDocumentBase64() -->
                    <button type="button" class="btn btn-secondary" data-bind="click: openInvoiceDocument">
                        Open PDF in New Tab
                    </button>
                    <!-- /ko -->
                </form>
            </div>
            <div>
                <h3 class="heading mb-0 d-flex justify-content-between align-items-center">
                    Till Transactions
                    <a data-bs-target="#details-modal" data-bs-toggle="modal" href="javascript:;">
                        Line Details
                    </a>
                </h3>
                <table id="daily-invoice-details" class="table table-condensed mb-0">
                    <colgroup>
                    </colgroup>
                    <thead>
                        <tr>
                            <th></th>
                            <th class="text-end">
                                Total
                            </th>
                            <th class="text-end">
                                Variance
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ko foreach: reconciliationResults().sort((a, b) => { return a.SortOrder > b.SortOrder ? 1 : -1 }) -->
                        <tr>
                            <th>
                                <span data-bind="text: Label"></span>
                            </th>
                            <td class="text-end">
                                <span data-bind="text: formatCurrency(Invoice_Value, 2, 'en-GB', 'GBP')"></span>
                            </td>
                            <td class="text-end">
                                <span data-bind="text: formatCurrency(Variance_Value, 2, 'en-GB', 'GBP')"></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="separator" colspan="4"></td>
                        </tr>
                        <!-- /ko -->
                    </tbody>
                </table>
                <div data-bind="template: { name: 'generic-form-field-template', data: signOffNotes }"></div>
                <div data-bind="foreach: notifications">
                    <div class="mb-3" data-bind="html: Notification"></div>
                </div>
                <!-- ko ifnot: signedOff -->
                <button class="btn btn-secondary btn-lg w-100" data-bind="disable: busy, click: () => { save(true); }">
                    Sign Off
                </button>
                <!-- /ko -->
                <!-- ko if: signedOff -->
                <button class="btn btn-secondary btn-lg w-100" data-bind="with: selectedSelfBillInvoice" disabled>
                    <span data-bind="html: (SignedOffByMember ? `Signed off by ${SignedOffByMember.FullName} on ${renderDate(SignedOffDT)}` : null)"></span>
                </button>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->
</div>

<script id="detail-row-template" type="text/html">
    <tr data-bind="css: { 'sale': SaleOrCredit === 'S', 'credit': SaleOrCredit === 'C' }">
        <td>
            <span data-bind="text: InvoiceID"></span>
        </td>
        <td>
            <span data-bind="text: renderDate(InvoiceDate)"></span>
        </td>
        <td>
            <span data-bind="text: SaleOrCredit"></span>
        </td>
        <td>
            <span data-bind="text: ProductCode"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: Quantity"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(GrossSales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(Discount, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(NetSales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: DepartmentID"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: TillID"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: StaffID"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: FenwickTransactionID"></span>
        </td>
        <td>
            <span data-bind="text: EAN"></span>
        </td>
        <td>
            <span data-bind="text: Processed"></span>
        </td>
    </tr>
</script>

<div class="modal fade" id="details-modal">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span data-bind="text: selectedSelfBillInvoice()?.Branch.Name"></span>
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div data-bind="kendoGrid: detailGridSettings"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-bind="click: function() { detailGridSettings.widget().saveAsExcel(); }">
                    Export to Excel
                </button>
            </div>
        </div>
    </div>
</div>