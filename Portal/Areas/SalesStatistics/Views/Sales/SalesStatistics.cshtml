@model SalesStatistics.ViewModels.SalesStatsViewModel
@{
    ViewBag.Title = "Sales Statistics - Designers Guild Portal";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/sales-statistics")
    @Styles.Render("~/bundles/css/member-search")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/sales-statistics")
    @Scripts.Render("~/bundles/js/member-search")

    <script type="text/javascript">

        var lockedToRep = true;

        @if (!Model.LockedToRep)
        {
            <text>
        lockedToRep = false;
            </text>
        }

        function getAvailableMarkets() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Markets.OrderBy(p => p.Name)));
        }

        function getAvailableTags() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Tags.OrderBy(p => p.Name)));
        }

        function getPreselectedSalesRep() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedSalesRep));
        }

        $(document).ready(function () {

                        viewModel = new salesStatisticsViewModel();

                        ko.validation.init({
                            decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
                        });

                        ko.options.deferUpdates = true;
                        ko.applyBindings(viewModel, document.body);

                        viewModel.init();
                    });

                    function formatGBP(val) {
                        return formatCurrency(val, 0, 'en-GB', 'GBP')
                    }

                    function formatGBPDec(val) {
                        return formatCurrency(val, 2, 'en-GB', 'GBP')
                    }

                    function formatSelectedCurrency(val) {
                        var curr = viewModel.slicerGroup.selectedCurrency();
                        if (curr) {
                            if (curr.hasOwnProperty('FormattingCulture')) {
                                return formatCurrency(val, 0, curr.FormattingCulture, curr.CurrencyCode);
                            }
                        }
                        return formatNumber(val, 0, 'en-GB');
                    }

                    function formatAnalysisSelectedCurrency(val) {
                        var curr = viewModel.slicerGroupOne.selectedCurrency();
                        if (curr) {
                            if (curr.hasOwnProperty('FormattingCulture')) {
                                return formatCurrency(val, 0, curr.FormattingCulture, curr.CurrencyCode);
                            }
                        }
                        return formatNumber(val, 0, 'en-GB');
                    }

                    function formatNumber(value, digits) {

                        digits = digits || 0;

                        var formatter = new Intl.NumberFormat(
                            'en-GB',
                            {
                    minimumFractionDigits: digits,
                    maximumFractionDigits: digits
                });

            return formatter.format(value);
        }

            // redefinition of functions.js fn
            function formatPercentage(value) {
                var formatter = new Intl.NumberFormat('en-GB', {
                style: 'percent',
                minimumFractionDigits: 1,
                maximumFractionDigits: 1
                });

            return formatter.format(value);
        }

        $("#total-sales-collapse").on('show.bs.collapse', function () {
            viewModel.slicerGroup.nonce.valueHasMutated();
        });

        $("#quarterly-sales-collapse").on('show.bs.collapse', function () {
            viewModel.slicerGroup.nonce.valueHasMutated();
        });

        $("#sales-area-collapse").on('shown.bs.collapse', function () {
            viewModel.slicerGroup.nonce.valueHasMutated();
        });

        $("#sales-customer-collapse").on('shown.bs.collapse', function () {
            viewModel.slicerGroup.nonce.valueHasMutated();
        });

        $("#lower-filters-collapse").on('show.bs.collapse', function () {
            $('#lower-filters-toggle').text('Hide Filters');
            $('#clear-lower-filters').show();
        });

        $("#lower-filters-collapse").on('hide.bs.collapse', function () {
            $('#lower-filters-toggle').text('Show Filters');
            $('#clear-lower-filters').hide();
        });

        $('#customer-analysis-collapse').on('show.bs.collapse', function () {
            console.log('chart redrawn');
            $("#line-chart-blocker").css('display', 'flex');
        })

        $('#customer-analysis-collapse').on('shown.bs.collapse', function () {
            viewModel.customerAnalysisChart().redraw();
            $("#line-chart-blocker").css('display', 'none');
            viewModel.customerAnalysisNonce.valueHasMutated();
        });

        $(window).resize(function () {
            viewModel.customerAnalysisChart().redraw();
        });
    </script>
}
@section beforeContainer {
    <div class="form-busy" data-bind="fadeVisible: loadingBusy">
        <div class="busy-bars">
            <div class="rect1 alert alert-info"></div>
            <div class="rect2 alert alert-info"></div>
            <div class="rect3 alert alert-info"></div>
            <div class="rect4 alert alert-info"></div>
            <div class="rect5 alert alert-info"></div>
        </div>
    </div>
}
@section components {
    @Html.Action("MonthRangeSelector", "Component", new { Area = "" })
}

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
        <h1 class="main-heading">
            @(Model.ApplicationHeading)
        </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
        <h4 class="sub-heading">
            <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
        </h4>
            }
        </div>
    </div>
</div>

