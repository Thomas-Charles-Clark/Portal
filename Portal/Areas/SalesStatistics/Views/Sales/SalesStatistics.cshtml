<div id="contact-modal" class="modal fade" data-bind="with: contactDataToDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">
                    <span data-bind="text: Code"></span>
                    <span data-bind="text: Name"></span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Name
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <span class="address-span" data-bind="text: Name"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Address
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <span class="address-span" data-bind="text: AddressLine1"></span>
                        <span class="address-span" data-bind="text: AddressLine2"></span>
                        <span class="address-span" data-bind="text: AddressLine3"></span>
                        <span class="address-span" data-bind="text: AddressLine4"></span>
                        <span class="address-span" data-bind="text: CountryCode"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Default Delivery Address
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <span class="address-span" data-bind="text: DeliveryAddressLine1"></span>
                        <span class="address-span" data-bind="text: DeliveryAddressLine2"></span>
                        <span class="address-span" data-bind="text: DeliveryAddressLine3"></span>
                        <span class="address-span" data-bind="text: DeliveryAddressLine4"></span>
                        <span class="address-span" data-bind="text: DeliveryCountryCode"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Phone
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <!-- ko if: PhoneNumber -->
                        <a data-bind="attr: { href: 'tel:'+PhoneNumber }, text: PhoneNumber"></a>
                        <!-- /ko -->
                        <!-- ko ifnot: PhoneNumber -->
                        <span class="address-span">Unknown</span>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Email
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <!-- ko if: Email -->
                        <a data-bind="attr: { href: 'mailto:'+Email }, text: Email"></a>
                        <!-- /ko -->
                        <!-- ko ifnot: Email -->
                        <span class="address-span">Unknown</span>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-right" data-dismiss="modal" data-target="#contact-modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>