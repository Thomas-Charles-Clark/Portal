@model Portal.Areas.Marylebone.ViewModels.MarylebonePackingViewModel
@{
    ViewBag.Title = Model.ApplicationHeading;

    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/marylebone-boxing")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/marylebone-boxing")
    @Scripts.Render("~/bundles/js/datetime-picker")

    <script type="text/javascript">

        let viewModel = maryleboneBoxingViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });
        
        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

        viewModel.ready();
    </script>
}
@section beforeContainer {
    <div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
        <div class="loading-spinner"></div>
        <h3 class="mt-3">
            Please Wait...
        </h3>
    </div>
}
<script id="row-template" type="text/html">
    <tr>
        <td>
            <span data-bind="text: BoxCode"></span>
        </td>
        <td>
            <span data-bind="text: `${DestinationStockLocation.Code} - ${DestinationStockLocation.Name}`"
        </td>
        <td class="text-end">
            <span data-bind="text: BoxedItems.reduce((a, i) => a += i.Deleted == true ? 0 : i.Quantity, 0)"></span>
        </td>
        <td>
            <span data-bind="text: moment(CreatedDT).format('DD/MM/YYYY HH:mm')"></span>
        </td>
        <td>
            <button class="btn btn-danger" data-bind="click: $parent.deleteBox, clickBubble: false">
                <i class="bi bi-trash3"></i>
            </button>
        </td>
    </tr>
</script>

<div class="form-group row mb-3">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<ul class="nav nav-tabs nav-justified" id="marylebone-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fs-5 active" id="boxing-tab-btn" data-bs-toggle="tab" data-bs-target="#boxing-tab" type="button" role="tab" aria-controls="Boxing" aria-selected="true">
            Boxing
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fs-5" id="reviewing-tab-btn" data-bs-toggle="tab" data-bs-target="#reviewing-tab" type="button" role="tab" aria-controls="Reviewing" aria-selected="false">
            Reviewing
        </button>
    </li>
</ul>
<div class="tab-content" id="marylebone-tabs-content">
    <div class="tab-pane fade show active" id="boxing-tab" role="tabpanel" aria-labelledby="boxing-tab-btn">
        <div id="box-container" style="display: none" data-bind="visible: currentBox, with: currentBox">
            <h4>
                <span>
                    <span data-bind="text: BoxCode"></span>
                    <i class="bi bi-box ms-3"></i>
                    <span class="ms-3" data-bind="text: totalItemsDisplay"></span>
                </span>
                <div>
                    <div class="form-control">
                        <label class="form-label">
                            Destination
                        </label>
                        <div class="input-group">
                            <div data-bind="component: { name: 'mdc-text-field-component', params: stockLocationCodeParams }"></div>
                            <span class="validation-message" data-bind="validationMessage: stockLocationCode"></span>
                        </div>
                    </div>
                </div>
            </h4>
            <div id="searcher" class="form-control">
                <label class="form-label">
                    Scan
                </label>
                <div class="input-group">
                    <div id="search-term" data-bind="component: { name: 'mdc-text-area-component', params: inputSearchTermParams }"></div>
                    <button class="btn btn-secondary" type="button" id="button-scan" data-bind="disable: busy, click: () => { addItem(inputSearchTerm()) }">
                        Enter
                    </button>
                </div>
            </div>
            <div id="boxing-grid">
                <div>
                    <!-- ko if: undeletedBoxedItems().length -->
                    <ul id="contents-list" class="list-group">
                        <!-- ko foreach: undeletedBoxedItems -->
                        <li class="list-group-item">
                            <div class="boxed-product-display">
                                <!-- ko if: Product.ImageID -->
                                <img class="thumb" data-bind="attr: { src: `https://www.designersguild.com/image/90/${Product.ImageID}`, alt: Product.ImageID, title: `Image ID: ${Product.ImageID}` }" />
                                <!-- /ko -->
                                <span class="me-auto" data-bind="text: Product.ShortLabel"></span>
                                <button class="btn btn-secondary btn-increase" data-bind="click: $parent.increaseQuantity">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                                <span class="quantity-display" data-bind="html: `&times; ${quantity()}`"></span>
                                <button class="btn btn-secondary btn-decrease" data-bind="click: $parent.reduceQuantity">
                                    <i class="bi bi-trash3" data-bind="css: { 'bi-trash3': quantity() == 1, 'bi-dash': quantity() != 1 }"></i>
                                </button>
                            </div>
                        </li>
                        <!-- /ko -->
                    </ul>
                    <!-- /ko -->
                </div>
                <div>
                    <div class="vr"></div>
                </div>
                <div>
                    <div class="card">
                        <div class="card-body">
                            <pre id="scanner-results" data-bind="html: scannedText"></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="btn btn-success w-100 text-align-center" style="display: none" data-bind="visible: currentBox() != null, click: closeCurrentBox">
            Save Box
            <i class="bi bi-floppy2"></i>
        </button>
        <button class="btn btn-primary w-100 text-align-center" style="display: none" data-bind="visible: currentBox() == null, click: showNewBoxModal">
            New Box
            <i class="bi bi-plus-lg bold"></i>
        </button>
    </div>
    <div class="tab-pane fade" id="reviewing-tab" role="tabpanel" aria-labelledby="boxing-tab-btn">
        <div data-bind="kendoGrid: boxGridSettings"></div>
    </div>
</div>

<div class="modal fade" id="new-box-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    New Box
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideNewBoxModal"></button>
            </div>
            <div class="modal-body">
                <div>
                    <div class="mb-3" data-bind="component: { name: 'mdc-text-area-component', params: newBoxCodeParams }"></div>
                    <div data-bind="component: { name: 'mdc-text-area-component', params: newBoxStockLocationCodeParams }"></div>
                    <span class="validation-message" data-bind="validationMessage: newBoxStockLocationCode"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-bind="click: saveNewBox">
                    Save
                </button>
                <button class="btn btn-secondary" data-bind="click: hideNewBoxModal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>