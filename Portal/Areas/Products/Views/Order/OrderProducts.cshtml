@model Portal.Areas.Products.ViewModels.OrderProductsViewModel
@{
    ViewBag.Title = "Order Entry";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/intl-tel")
    @Scripts.Render("~/bundles/js/order-products-base")
    @Scripts.Render("~/bundles/js/popper")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">

        function getAvailableTags() {
            return [];
        }

        function getMyHeldOrderImportStatuses() {
            return [{
                Status: 'Active',
                Name: 'Active Baskets'
            }, {
                Status: 'Held',
                Name: 'Held Baskets'
            }, {
                Status: 'Parked',
                Name: 'Parked Baskets'
            }];
        }

        function getOrderImportStatuses() {
            return [{
                Status: 'Sample',
                Name: 'Sample Orders'
            }, {
                Status: 'Mixed',
                Name: 'Mixed Orders'
            }];
        }

        function getOrderImportSources() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.OrderImportSources));
        }

        function getHoldReasons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.HoldReasons));
        }

        function formatSelectedCurrency(value) {
            return formatCurrency(value, 2, viewModel.tradeAccount().CurrencyCulture, viewModel.tradeAccount().CurrencyCode);
        }

        var viewModel = new orderProductsBaseViewModel();

        var orf = viewModel.orderFactory;

        var bfhf = orf.bespokeFabricHangerFactory;

        var bfsf = orf.bespokeFabricShowlengthFactory;

        var df = orf.dispatchFactory;

        var pd = viewModel.orderProductsDrilldown;

        var barf = orf.bespokeArchitectRingFactory;

        var daf = orf.deliveryAddressFactory;

        var bff = orf.bespokeFurnitureFactory;

        var pdfc = viewModel.orderProductsDrilldownFurnitureComponents;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        $(document).ready(function () {
            ko.applyBindings(viewModel, document.body);

            //if (sessionStorage) {
            //    if (sessionStorage.getItem('basket')) {
            //        $('#load-from-session').show();
            //        //console.log('sessionStorage.basket', JSON.parse(sessionStorage.getItem('basket')))
            //        //viewModel.orderFactory.loadBasket(JSON.parse(sessionStorage.getItem('basket')), JSON.parse(sessionStorage.getItem('errata')));
            //    }
            //}

            if (window.location.search) {
                viewModel.orderFactory.deserializeViewSettings();
            }
        });

        function getMemberId() {
            return @(User.Identity.GetUserId<int>())
        }
    </script>

    @if (User.IsInRole("Super Admin") || User.IsInRole("Senior Manager") || User.IsInRole("User Masquerade") || User.IsInRole("Customer Services"))
    {
        <script type="text/javascript">
            window.memberMasqueradeParams = kendoMDCDropDownList({
                label: 'User',
                odata: true,
                endPoint:  '/odata/Members',
                textField: 'FullName',
                valueField: 'Id',
                virtual: true,
                virtualOptions: {
                    itemHeight: 34,
                    mapValueTo: 'dataItem',
                    valueMapper: function (options) {
                        $.ajax({
                            url: `/odata/Members/Default.MemberValueMapper(id=${options.value || "null"})`,
                            type: 'GET',
                            success: function (data) {
                                options.success(data.value);
                                if (data.value.length == 1)
                                    viewModel.memberBasketFetcher.memberId(data.value[0].Id);
                            }
                        });
                    }
                },
                idObservable: ko.observable(@(User.Identity.GetUserId<int>())),
                objObservable: ko.observable(),
                height: 340,
                template: '#: FullName # - #: Email #',
                valueTemplate: '#: FullName # - #: Email #',
                optionLabel: null,
                optionLabelTemplate: null,
                autoBind: true,
                height: 340,
                filtering: function (ev) {
                    var filterValue = ev.filter != undefined ? ev.filter.value : "";
                    ev.preventDefault();

                    this.dataSource.filter({
                        logic: "or",
                        filters: [
                            {
                                field: "Email",
                                operator: "startswith",
                                value: filterValue
                            },
                            {
                                field: "FullName",
                                operator: "contains",
                                value: filterValue
                            }
                        ]
                    });
                },
                showClear: false,
                clearFunction: null,
                permitRevert: true,
                revertFunction: function () {
                    window.memberMasqueradeParams.idObservable(@(User.Identity.GetUserId<int>()))
                },
                popupSettings: {
                    appendTo: $('#user-masquerade .panel-body')
                }
            });
            window.memberMasqueradeParams.dropDownListSettings.value.subscribe(function (newValue) {
                viewModel.memberBasketFetcher.memberId(newValue);
            });
        </script>
    }
}

<script id="basket-row-template" type="text/html">
    <tr class="pointer">
        <td class="basket-row-status-column">
            <a class="basket-status-button" data-bind="bootstrapPopover: bootstrapPopoverDetails">
                <span data-bind="html: Status"></span>
            </a>
            <span class="basket-memo-flag" style="display: none;" data-bind="click: function (data, event) { event.stopPropagation(); }, visible: Enumerable.From(BasketItemLineMemos).Where('$.LineMemoType.AlertOperator == true').Any()"></span>
        </td>
        <td>
            <span data-bind="html: HeldReason"></span>
        </td>
        <td>
            <span data-bind="html: Market, attr: { 'data-toggle': 'popover', 'data-html': true, title: MarketHover ? 'Market' : '', 'data-content': MarketHover }"></span>
        </td>
        <td>
            <span data-bind="html: CustomerCode"></span>
        </td>
        <td>
            <span data-bind="html: Customer, attr: { 'data-toggle': 'popover', 'data-html': true, title: CustomerHover ? 'Customer Info' : '', 'data-content': CustomerHover }"></span>
        </td>
        <td>
            <span data-bind="html: OrderReference"></span>
        </td>
        <td class="text-right">
            <span data-bind="html: BasketValue"></span>
        </td>
        <td>
            <span data-bind="html: HasAllocations, attr: { 'data-toggle': 'popover', 'data-html': true, title: HasAllocationsHover ? 'Allocations' : '', 'data-content': HasAllocationsHover }"></span>
        </td>
        <td>
            <span data-bind="html: Modified"></span>
        </td>
        <td>
            <span data-bind="html: Expires"></span>
        </td>
        <td data-bind="click: function (data, event) { event.stopPropagation(); event.preventDefault(); }">
            <!-- ko if: DeletePermitted === 'true' -->
            <a class="close" data-bind="attr: { href: 'javascript:;' }, click: function (data) { $parentContext.$parent.orderFactory.deleteBasket(BasketID, true) }">
                <i class="material-icons">
                    delete_forever
                </i>
            </a>
            <!-- /ko -->
        </td>
    </tr>
</script>


