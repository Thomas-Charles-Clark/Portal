                <div class="margin-top-30" data-bind="kendoGrid: basketSubmissionResultGrid"></div>
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bind="click: closeSubmissionModal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<div id="retail-payment-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory">
    <div class="modal-dialog modal-lg modal-xl">
        <div class="modal-content">
            <div class="blocker" data-bind="visible: phase() != ORDERFACTORY_PHASE_RETAIL || busy()">
                <div class="loading-spinner"></div>
                <h3>
                    Please wait...
                </h3>
            </div>
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    <a class="close pull-right" data-bind="click: parent.memberBasketFetcher.cancelRetailPaymentModal">
                        &times;
                    </a>
                    <span class="display-block margin-bottom-15">
                        Retail Payment Details
                    </span>
                    <span data-bind="with: basketServerObject">
                        <!-- ko if: typeof Reference !== 'undefined' -->
                        <span data-bind="html: Reference"></span>
                        <!-- /ko -->
                    </span>
                </h4>
            </div>
            <div class="modal-body">
                <!-- ko if: phase() == ORDERFACTORY_PHASE_RETAIL && isViewingRetailPaymentModal() -->
                <!-- ko template: { name: 'retail-till-phase-template', data: $data } --><!-- /ko -->
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-green" data-bind="click: saveRetailFromPaymentModal">
                    Save
                </button>
                <button class="btn btn-default pull-left" data-bind="click: parent.memberBasketFetcher.cancelRetailPaymentModal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<div id="last-chance-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: orderFactory.dispatchFactory">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="blocker" data-bind="visible: busy()">
                <div class="loading-spinner"></div>
                <h3>
                    Please wait...
                </h3>
            </div>
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Please Provide Additional Details
                </h4>
            </div>
            <div class="modal-body">
                <p>
                    Basket ID: <span data-bind="text: parent.basketId"></span>
                </p>
                <p data-bind="with: parent.tradeAccount">
                    Trade Account: <span data-bind="text: Label"></span>
                </p>
                <p class="margin-bottom-15">
                    Providing all of the beneath will greatly assist this order in transit.
                </p>
                <!-- ko if: parent.basketRequiresEORI() -->
                <div class="alert alert-warning">
                    <p class="margin-bottom-15 bold">
                        EORI Number and Delivery Contact Name are mandatory.
                    </p>
                    <p>
                        If an EORI Number is not present below, you may need to either use the Refresh button to fetch the value from Mertex, or contact Credit Control to
                        update <span data-bind="text: parent.tradeAccount().Code"></span>'s EORI Number value and then use the Refresh button below.
                    </p>
                </div>
                <!-- /ko -->
                <!--<p data-bind="with: parent.parent.tradeAccount">-->
                <!-- ko if: typeof PhoneNumber !== 'undefined' -->
                <!-- ko if: PhoneNumber -->
                <!--The primary phone number we have on file for
                <span data-bind="text: Label"></span>
                is
                <a href="javascript" data-bind="attr: { title: 'Click to Copy Below' }, text: PhoneNumber, click: function (data) { $parent.lastChancePhone.observable(data.PhoneNumber); }"></a>-->
                <!-- /ko -->
                <!-- ko ifnot: PhoneNumber -->
                <!--We don't appear to have a telephone number on file for <span data-bind="text: Label"></span>. Please inform Credit Control.-->
                <!-- /ko -->
                <!-- /ko -->
                <!--</p>-->
                <div class="input-group margin-bottom-15">
                    <div data-bind="component: { name: 'mdc-text-field-component', params: parent.eoriNumberParams }"></div>
                    <span class="input-group-addon">
                        <span class="material-icons refresh-btn" data-bind="click: parent.refreshEORINumber">
                            refresh
                        </span>
                    </span>
                </div>
                <!-- ko if: parent.eoriNumberMessage() -->
                <span class="validation-message margin-bottom-15 display-block" style="margin-top: -10px;" data-bind="css: { 'red-text': parent.eoriNumberError, 'text-success': parent.eoriNumberValid }, html: parent.eoriNumberMessage()"></span>
                <!-- /ko -->
                <!-- ko if: !parent.eoriRefreshBusy() && !parent.eoriNumberCheckPerformed.isValid() -->
                <span class="validation-message red-text margin-bottom-15" style="margin-top: -10px;">
                    Please <a data-bind="attr: { href: 'javascript:;' }, click: parent.forceEORINumberValidation">click here</a> to attempt to check the EORI number above.
                </span>
                <!-- /ko -->
                <div class="margin-bottom-15 margin-top-20" data-bind="component: { name: 'mdc-text-field-component', params: lastChanceContactName }"></div>
                <p class="margin-bottom-15 bold">
                    You must provide at least one phone number below.
                </p>
                <div class="margin-bottom-15" data-bind="component: { name: 'mdc-phone-field-component', params: lastChancePhone }"></div>
                <div class="margin-bottom-15" data-bind="component: { name: 'mdc-phone-field-component', params: lastChanceMobilePhone }"></div>
                <div data-bind="component: { name: 'mdc-text-field-component', params: lastChanceDeliveryEmailParams }"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: cancelLastChanceModal">
                    Cancel
                </button>
                <button class="btn btn-green pull-right" data-bind="click: saveLastChanceModal">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

