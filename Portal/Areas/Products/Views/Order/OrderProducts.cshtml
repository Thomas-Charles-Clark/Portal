<script id="held-order-row-template" type="text/html">
    <tr>
        <td style="white-space: normal">
            <span data-bind="html: Reference"></span>
        </td>
        <td>
            <!-- ko if: MertexMarket -->
            <span data-bind="text: MertexMarket.Name"></span>
            <!-- /ko -->
            <!-- ko ifnot: MertexMarket -->
            <span data-bind="text: Market"></span>
            <!-- /ko -->
        </td>
        <td>
            <span class="display-block" data-bind="text: CustomerCode"></span>
            <span class="display-block" data-bind="text: CustomerName"></span>
        </td>
        <td>
            <span data-bind="text: CustomerReference"></span>
        </td>
        <td class="text-right">
            <span data-bind="html: Value"></span>
        </td>
        <td>
            <!-- ko if: HasAllocations -->
            <span class="material-icons" title="Has Allocations">
                done
            </span>
            <!-- /ko -->
            <!-- ko ifnot: HasAllocations -->
            <span class="material-icons" title="Does not have Allocations">
                close
            </span>
            <!-- /ko -->
        </td>
        <td style="white-space: normal">
            <div data-bind="html: Enumerable.From(JSON.parse(HeldReasons)).Select('$.HeldReason').ToArray().join('<br/><br/>')"></div>
            <span class="display-block margin-top-5" data-bind="text: 'Held Since: ' + moment(HeldSince).format('dddd Do MMM YY')"></span>
        </td>
        <td>
            <!-- ko if: AllowBasketView -->
            <button class="btn btn-flat" data-bind="click: $parent.fetchBasketView">
                View Details
            </button>
            <!-- /ko -->
            <!-- ko if: AllowBasketEdit -->
            <button class="btn btn-flat" data-bind="click: $parent.editBasket">
                Edit Basket
            </button>
            <!-- /ko -->
            <!-- ko if: AllowBasketRelease -->
            <button class="btn btn-flat" data-bind="click: $parent.releaseBasket">
                Release Basket
            </button>
            <!-- /ko -->
            <!-- ko if: AllowBasketDelete -->
            <button class="btn btn-red" data-bind="click: function () { $parentContext.$parent.orderFactory.deleteBasket(BasketID, true); }">
                Delete Basket
            </button>
            <!-- /ko -->
            <!-- ko if: AllowTransactionView -->
            <button class="btn btn-flat" data-bind="click: $parent.fetchTransactionView">
                View Details
            </button>
            <!-- /ko -->
            <!-- ko if: AllowTransactionEdit -->
            <button class="btn btn-battleship-blue" data-bind="click: $parent.editTransaction">
                Edit / Delete
            </button>
            <!-- /ko -->
            <!-- ko if: AllowRetailPaymentDetails -->
            <button class="btn btn-blue" data-bind="click: $parent.provideRetailPaymentDetails">
                Provide Retail Payment Details
            </button>
            <!-- /ko -->
            <!-- ko if: AllowTransactionRelease -->
            <button class="btn btn-battleship-blue" data-bind="click: $parent.releaseTransaction">
                Release Transaction
            </button>
            <!-- /ko -->
            <!-- ko if: AllowTransactionDelete -->
            <button class="btn btn-red" data-bind="click: $parent.deleteTransaction">
                Delete Transaction
            </button>
            <!-- /ko -->
            <!-- ko foreach: documents -->
            <button class="btn btn-green" data-bind="click: function () { $parentContext.$parent.fetchDocument($data, $parent); }">
                <span data-bind="text: label"></span>
            </button>
            <!-- /ko -->
        </td>
    </tr>
</script>

