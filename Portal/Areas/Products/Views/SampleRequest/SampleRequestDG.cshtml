<div id="stock-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 id="stock-title" class="modal-title"></h4>
            </div>
            <div style="position: relative;" class="modal-body">
                <div class="panel-busy-wrapper" style="display: none;" data-bind="fadeVisible: stockInfoBusy">
                    <div class="form-busy">
                        <div class="busy-bars">
                            <div class="rect1 alert alert-info"></div>
                            <div class="rect2 alert alert-info"></div>
                            <div class="rect3 alert alert-info"></div>
                            <div class="rect4 alert alert-info"></div>
                            <div class="rect5 alert alert-info"></div>
                        </div>
                    </div>
                </div>
                <div id="stock-container">
                    <div data-bind="foreach: stockInfoProducts, fadeVisible: !stockInfoBusy()">
                        <div class="stock-info">
                            <div>
                                <table class="drilldown-stock-table">
                                    <colgroup>
                                        <col style="width: 300px" />
                                        <col />
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <td style="vertical-align: top; padding-right: 15px;">
                                                <div id="product-name">
                                                    <!-- ko if: ImageID != null -->
                                                    <img class="thumb" data-bind="attr: { src: 'https://www.designersguild.com/image/156/' + ImageID, title: Code }" />
                                                    <!-- /ko -->
                                                    <div class="product-details">
                                                        <span>
                                                            <span data-bind="text: Name"></span>
                                                            <span data-bind="text: Code"></span>
                                                        </span>
                                                        <span data-bind="html: '(Unit of Stock: ' + Units + ')'"></span>
                                                    </div>
                                                    <div class="clearfix"></div>
                                                </div>
                                            </td>
                                            <td>
                                                <!-- ko with: supplierAvailabilityMessage -->
                                                <div class="alert alert-warning" data-bind="html: $data"></div>
                                                <!-- /ko -->
                                                <!-- ko if: $parent.showStockCheckRequester() -->
                                                <!-- ko with: $parent.stockCheckRequester -->
                                                <div class="alert" data-bind="class: cssClass">
                                                    <div data-bind="html: message"></div>
                                                    <button class="btn btn-blue request-stock-check-btn" data-bind="enable: allowStockCheckRequest, click: $parentContext.$parent.beginStockCheckRequest">
                                                        Request Stock Check
                                                    </button>
                                                </div>
                                                <!-- /ko -->
                                                <!-- /ko -->
                                                <!-- ko if: stockInfo() -->
                                                <table class="stock-allocation-table allocation-table table table-condensed" data-bind="with: stockInfo">
                                                    <colgroup>
                                                        <col style="width: 25%" />
                                                        <col style="width: 105px" />
                                                        <col style="width: 75px" />
                                                        <col style="width: 75px" />
                                                        <col style="width: 75px" />
                                                        <col style="width: 75px" />
                                                        <col style="width: 90px" />
                                                        <col style="width: auto" />
                                                    </colgroup>
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                Batch
                                                            </th>
                                                            <th>
                                                                <sup class="font-normal">1</sup> Available Now
                                                            </th>
                                                            <th>
                                                                Bulk Stock
                                                            </th>
                                                            <th>
                                                                <sup class="font-normal">2</sup> Just Arrived
                                                            </th>
                                                            <th>
                                                                <sup class="font-normal">3</sup> Ring Fenced
                                                            </th>
                                                            <th>
                                                                On Reserve
                                                            </th>
                                                            <th>
                                                                Total
                                                            </th>
                                                            <th>
                                                                Due In
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                Total all Locations
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('$.stockLocation.availableNowTotal').Sum().toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('$.stockLocation.bulkTotal').Sum().toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('$.stockLocation.waitingTotal').Sum().toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('$.stockLocation.ringFencedTotal').Sum().toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('$.stockLocation.onReserveTotal').Sum().toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('+$.stockLocation.totalQuantity()').Sum().toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: Enumerable.From($data).Select('$.stockLocation.dueInTotal').Sum().toFixed(1)"></span>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td colspan="8">
                                                                &nbsp;
                                                            </td>
                                                        </tr>
                                                        <!-- ko foreach: $data -->
                                                        <!-- ko if: stockLocation.totalIncludingDue() == 0 -->
                                                        <tr class="stock-location">
                                                            <th>
                                                                <span data-bind="text: `${stockLocation.stockLocationCode} - ${stockLocation.stockLocationName}`"></span>
                                                            </th>
                                                            <th colspan="7">
                                                                <span class="font-normal text-italic">
                                                                    No stock available in this location
                                                                </span>
                                                            </th>
                                                        </tr>
                                                        <!-- /ko -->
                                                        <!-- ko if: stockLocation.totalIncludingDue() > 0 -->
                                                        <tr class="stock-location">
                                                            <th>
                                                                <span data-bind="text: `${stockLocation.stockLocationCode} - ${stockLocation.stockLocationName}`"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: stockLocation.availableNowTotal.toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: stockLocation.bulkTotal.toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: stockLocation.waitingTotal.toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: stockLocation.ringFencedTotal.toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: stockLocation.onReserveTotal.toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: (+stockLocation.totalQuantity()).toFixed(1)"></span>
                                                            </th>
                                                            <th>
                                                                <span data-bind="text: stockLocation.dueInTotal.toFixed(1)"></span>
                                                            </th>
                                                        </tr>
                                                        <!-- ko foreach: batches -->
                                                        <tr data-bind="css: { 'location-end': $index() == ($parent.batches.length - 1) }">
                                                            <td>
                                                                <span data-bind="text: batch.batchNo"></span>
                                                            </td>
                                                            <td colspan="7" class="no-padding">
                                                                <table class="piece-table table table-condensed">
                                                                    <colgroup>
                                                                        <col style="width: 105px;" />
                                                                        <col style="width: 75px;" />
                                                                        <col style="width: 75px;" />
                                                                        <col style="width: 75px;" />
                                                                        <col style="width: 75px;" />
                                                                        <col style="width: 90px;" />
                                                                        <col style="width: auto" />
                                                                    </colgroup>
                                                                    <tbody>
                                                                        <!-- ko foreach: pieces -->
                                                                        <tr>
                                                                            <td>
                                                                                <span data-bind="text: AvailableNowDisplay"></span>
                                                                            </td>
                                                                            <td>
                                                                                <span data-bind="text: BulkDisplay"></span>
                                                                            </td>
                                                                            <td>
                                                                                <span data-bind="text: WaitingDisplay"></span>
                                                                            </td>
                                                                            <td>
                                                                                <span data-bind="text: RingFencedDisplay"></span>
                                                                            </td>
                                                                            <td>
                                                                                <span data-bind="text: OnReserveDisplay"></span>
                                                                            </td>
                                                                            <td>
                                                                                <span data-bind="text: TotalDisplay"></span>
                                                                            </td>
                                                                            <td>
                                                                                <span data-bind="text: DueInDisplay"></span>
                                                                                <!-- ko if: POConfirmed != null -->
                                                                                <span data-bind="text: POConfirmed ? '(confirmed)' : '(unconfirmed)'"></span>
                                                                                <!-- /ko -->
                                                                            </td>
                                                                        </tr>
                                                                        <!-- /ko -->
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <!-- /ko -->
                                                        <!-- /ko -->
                                                        <!-- ko if: $index() != ($parent.length - 1) -->
                                                        <tr>
                                                            <td colspan="6">
                                                                &nbsp;
                                                            </td>
                                                        </tr>
                                                        <!-- /ko -->
                                                        <!-- /ko -->
                                                    </tbody>
                                                </table>
                                                <p>
                                                    <sup class="font-normal">1</sup> "Available Now" = Free Stock + Stock Ring Fenced for this Customer
                                                </p>
                                                <p>
                                                    <sup class="font-normal">2</sup> "Just Arrived" = Stock waiting to be put away
                                                </p>
                                                <p>
                                                    <sup class="font-normal">3</sup> "Ring Fenced" = Stock Ring Fenced for other Customers
                                                </p>
                                                <!-- /ko -->
                                                <!-- ko if: stockInfo() ? stockInfo().length == 0 : true -->
                                                <label data-bind="text: StockStatus">
                                                </label>
                                                <!-- /ko -->
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="stock-close" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="spa-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 id="spa-title" class="modal-title"></h4>
            </div>
            <div style="position: relative;">
                <div class="panel-busy-wrapper" style="display: none;" data-bind="fadeVisible: spaInfoBusy">
                    <div class="form-busy">
                        <div class="busy-bars">
                            <div class="rect1 alert alert-info"></div>
                            <div class="rect2 alert alert-info"></div>
                            <div class="rect3 alert alert-info"></div>
                            <div class="rect4 alert alert-info"></div>
                            <div class="rect5 alert alert-info"></div>
                        </div>
                    </div>
                </div>
                <div id="spa-container" class="modal-body">

                </div>
            </div>
            <div class="modal-footer">
                <button id="spa-close" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="extra-text-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Order Confirmation Customised Message</h4>
            </div>
            <div class="modal-body">
                <p>
