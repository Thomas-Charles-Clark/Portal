@section modals {

}

@section earlyScripts {
    @Scripts.Render("~/bundles/js/jqueryui")
}

@section scripts {
    @Scripts.Render("~/bundles/js/sample-request-dg")

    <script type="text/javascript">

        function orderTakerHidden() {
            return @Model.HideOrderTaker.ToString().ToLowerInvariant();
        }

        function getAllCountries() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Countries))
        }

        function getAllCountriesWithout3D() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Countries.Select(p => new { Name = p.Name, Code = p.Code, CountryID = p.CountryID })))
        }

        function getAllLanguages() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Languages.OrderBy(p => p.LanguageID)))
        }

        function getDefaultOrderTaker() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.DefaultOrderTaker));
        }

        $(document).ready(function () {

            viewModel = new SamplesViewModel();

            ko.validation.init({
                decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
            });

            ko.options.deferUpdates = true;
            ko.applyBindings(viewModel, document.body);

            $("#account-number").focus();
            //fireTestConfiguration();
        });

        //$("#success-modal").on('hidden.bs.modal', function (e) {
        //    $("#account-name-label").trigger("click");
        //})
    </script>
}
<div id="stock-check-request-modal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" data-bind="with: stockCheckRequester">
        <div class="modal-content">
            <div class="blocker" data-bind="visible: busy">
                <div class="loading-spinner"></div>
                <h4>
                    Please wait..
                </h4>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-bind="click: hideModal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Stock Check Request
                </h4>
            </div>
            <div class="modal-body">
                <div class="d-flex">
                    <h5>
                        Quantity Required
                    </h5>
                    <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: quantityParams }"></div>
                </div>
                <span class="validation-message" data-bind="validationMessage: quantity"></span>
            </div>
            <div class="modal-footer">
                <button class="btn btn-red" data-bind="click: hideModal">
                    Cancel
                </button>
                <button class="btn btn-green" data-bind="click: submit">
                    Submit
                </button>
            </div>
        </div>
    </div>
</div>