@model Portal.Areas.Products.ViewModels.SamplesViewModel
@{
    ViewBag.Title = "Designers Guild Sample Ordering";
}
@section styles {
    @Styles.Render("~/bundles/css/sample-request-dg")
    @Styles.Render("~/Content/Components/slicer-component.css")
}
@section beforeContainer {

    <div class="form-busy" data-bind="fadeVisible: placeOrderBusy">
        <div class="busy-bars">
            <div class="rect1 alert alert-info"></div>
            <div class="rect2 alert alert-info"></div>
            <div class="rect3 alert alert-info"></div>
            <div class="rect4 alert alert-info"></div>
            <div class="rect5 alert alert-info"></div>
        </div>
    </div>
}

@section components {
    @Html.Partial("~/Views/Shared/Components/_DeliverySelectorComponent.cshtml", Model.DeliverySelectorViewModel)
}

@section navbarCollapsedRight {
    <button type="button" class="basket-toggle-btn navbar-toggle navbar-toggle-right" data-toggle="modal" data-target="#basket-modal" href="#basket-modal" aria-expanded="true" aria-controls="basket-modal" style="display: none;" data-bind="visible: true">
        <span class="glyphicon glyphicon-shopping-cart" style="margin-right: 6px;"></span>
        View Basket
        <!-- ko if: basket().length -->
        <span id="basket-count" data-bind="text: Enumerable.From(basket()).Select('Number($.Quantity())').Sum()"></span>
        <!-- /ko -->
    </button>
}
@section navbarRight {
    <ul class="nav navbar-nav navbar-right" style="display: none" data-bind="visible: true">
        <li class="basket-toggle-btn navbar-toggle navbar-toggle-right" data-toggle="modal" data-target="#basket-modal" href="#basket-modal" aria-expanded="true" aria-controls="basket-modal">
            <span class="glyphicon glyphicon-shopping-cart" style="margin-right: 6px;"></span>
            View Basket
            <!-- ko if: basket().length -->
            <span id="basket-count" data-bind="text: Enumerable.From(basket()).Select('Number($.Quantity())').Sum()"></span>
            <!-- /ko -->
        </li>
        <!-- ko if: basket().length -->
        <li class="basket-toggle-btn navbar-toggle navbar-toggle-right" data-bind="click: storeBasket">
            <span class="glyphicon glyphicon-floppy-save" style="margin-right: 6px;"></span>
            Store Basket
        </li>
        <!-- /ko -->
    </ul>
}

<script id="search-result-template" type="text/html">
    <tr>
        <td>
            <!-- ko if: ImageID -->
            <img class="thumb" data-bind="click: $parent.loadLargeImage, attr: { src: 'https://www.designersguild.com/image/32/' + ImageID, title: Code + ' - Product ID: ' + ProductID + ' Sample Product ID: ' + CuttingProductID + ' Returnable Product ID: ' + ReturnableProductID }" />
            <!-- /ko -->
        </td>
        <td>
            <i class="material-icons" title="Find Similar" style="cursor: pointer;" data-bind="click: function(data) { $parent.slicers.findSimilar(data) }">&#xE14D;</i>
        </td>
        <td>
            <!-- ko if: ProductPageID -->
            <a class="code-display" data-bind="text: Code, attr: { href: 'https://www.designersguild.com/uk/p' + ProductPageID, target: '_blank'}"></a>
            <!-- /ko -->
            <!-- ko ifnot: ProductPageID -->
            <span class="code-display" data-bind="text: Code"></span>
            <!-- /ko -->
        </td>
        <td>
            <span data-bind="text: Status, attr: { title: $parent.statusTitle(Status) }"></span>
        </td>
        <td>
            <span data-bind="text: FreeStock"></span>
            <a href="javascript:;" class="stock-link" data-bind="text: StockStatus, click: function(data) { $parent.showStockInfo(data); }"></a>
        </td>
        <td>
            <span data-bind="text: Name"></span>
        </td>
        <td>
            <span data-bind="text: RRP"></span>
        </td>
        <td>
            <a href="javascript:;" data-bind="text: ListPrice, click: function() { $parent.loadSpecialPriceAgreements($data); }"></a>
        </td>
        <td>
            <span data-bind="text: CuttingStatus"></span>
        </td>
        <td>
            <span data-bind="text: CStock"></span>
        </td>
        <td>
            <span data-bind="text: CuttingPrice"></span>
        </td>
        <td>
            <!-- ko if: CuttingCode != null && CuttingPrice != null -->
            <span class="quantity" data-bind="text: cuttingQuantityInBasket"></span>
            <!-- /ko -->
        </td>
        <td class="text-center">
            <!-- ko if: CuttingCode != null && CuttingPrice != null -->
            <button class="btn btn-default btn-sm" data-bind="click: function(data) { $parent.increaseCuttingCodeInBasket(data) }" title="Add">
                <span class="glyphicon glyphicon-plus"></span>
            </button>
            <!-- /ko -->
        </td>
        <td class="text-center">
            <!-- ko if: CuttingCode != null && CuttingPrice != null -->
            <button class="btn btn-default btn-sm" data-bind="click: function(data) { $parent.decreaseCuttingCodeInBasket(data) }" title="Remove">
                <span class="glyphicon glyphicon-minus"></span>
            </button>
            <!-- /ko -->
        </td>
        <td>
            <span data-bind="text: ReturnableStatus"></span>
        </td>
        <td>
            <span data-bind="text: RStock"></span>
        </td>
        <td>
            <span data-bind="text: ReturnablePrice"></span>
        </td>
        <td>
            <!-- ko if: ReturnableCode != null && ReturnablePrice != null -->
            <span class="quantity" data-bind="text: returnableQuantityInBasket"></span>
            <!-- /ko -->
        </td>
        <td class="text-center">
            <!-- ko if: ReturnableCode != null && ReturnablePrice != null -->
            <button class="btn btn-default btn-sm" data-bind="click: function(data) { $parent.increaseReturnableCodeInBasket(data) }" title="Add">
                <span class="glyphicon glyphicon-plus"></span>
            </button>
            <!-- /ko -->
        </td>
        <td class="text-center">
            <!-- ko if: ReturnableCode != null && ReturnablePrice != null -->
            <button class="btn btn-default btn-sm" data-bind="click: function(data) { $parent.decreaseReturnableCodeInBasket(data) }" title="Remove">
                <span class="glyphicon glyphicon-minus"></span>
            </button>
            <!-- /ko -->
        </td>
    </tr>
</script>

<div id="basket-modal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">
                    Basket
                </h4>
            </div>
            <div class="modal-body">
                <div data-bind="visible: deliverySelector && basket().length">
                    <h4 style="margin-top: 0;">
                        <!-- ko if: deliverySelector -->
                        <span data-bind="with: deliverySelector" style="margin-right: 24px;">Delivery: <span data-bind="text: despatchPriceDisplaySmall"></span></span>
                        <span data-bind="with: account">Grand Total: <span data-bind="text: formatCurrency($parent.totalPrice(), 2, CurrencyCulture, CurrencyCode)"></span></span>
                        <!-- /ko -->
                        <span class="clearfix"></span>
                    </h4>

                    <label id="send-confirmation-basket-label" for="send-confirmation" class="send-confirmation-label">
                        Send Confirmation Email
                        <input id="send-confirmation-basket" class="send-confirmation" type="checkbox" data-bind="checked: customerWantsOrderConfirmation" />
                    </label>
                    <label id="extra-text-basket-label" for="extra-text-basket" class="send-confirmation-label" data-bind="visible: customerWantsOrderConfirmation()">
                        With Customised Message
                        <input id="extra-text-basket" class="send-confirmation" type="checkbox" data-bind="checked: sendExtraText" />
                    </label>
                    <div class="basket-button-container">
                        @*<a id="take-payment-btn" class="btn btn-warning" href="https://retail.designersguild.com" target="_blank" data-bind="visible: totalPrice() > 0">TAKE PAYMENT</a>*@
                        <button id="place-order-btn-1" class="btn btn-primary" data-bind="enable: !placeOrderBusy(), click: placeOrder">PLACE ORDER</button>
                    </div>
                    <div id="basket-panel" class="panel-body">
                        <table id="basket-table" class="table-striped">
                            <colgroup>
                                <col style="width: 32px; max-width: 32px;" />
                                <col style="width: 172px; max-width: 172px;" />
                                <col style="width: 44px; max-width: 44px;" />
                                <col style="width: 106px; max-width: 106px;" />
                                <col style="width: 98px; max-width: 98px;" />
                            </colgroup>
                            <!-- ko foreach: { data: basket } -->
                            <tbody>
                                <tr>
                                    <td>
                                        <!-- ko if: ImageID -->
                                        <img class="thumb" data-bind="click: $parent.loadLargeImage, attr: { src: 'https://www.designersguild.com/image/32/' + ImageID, title: Code }" />
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <label class="col-form-label" data-bind="text: Name"></label><br />
                                        <span class="code" data-bind="text: Code"></span>
                                    </td>
                                    <td>
                                        <button class="btn btn-default" data-tooltip="tooltip" data-toggle="collapse" data-bind="attr: { 'data-target': '#' + $data.Code.replace(/\//g, '-') + '-line-ref' }" data-placement="bottom" title="Add Line Reference">
                                            <i class="far fa-comment"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <div class="input-group-addon input-group-addon-default currency-display">
                                                <span data-bind="with: $parent.account"><span class="currency-display" data-bind="text: CurrencySymbol"></span></span>
                                            </div>
                                            @if (Model.Properties?.Sampling_CanOverridePricing == true)
                                            {
                                                <input class="price-control form-control" data-bind="numeric, keepElement: Price, forceNullOnEmpty: Price, value: Price" onfocus="this.select()" />
                                            }
                                            else
                                            {
                                                <div class="price-control form-control" data-bind="text: Price"></div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <div class="input-group-btn">
                                                <button class="btn btn-secondary-blue basket-add-btn" data-bind="click: function() { Quantity(Quantity() + 1); }">
                                                    +
                                                </button>
                                            </div>
                                            <input class="quantity form-control" onfocus="$(this).select()" data-bind="numericWhole, value: Quantity" />
                                            <span class="input-group-btn">
                                                <button class="btn btn-default basket-remove-btn" data-bind="click: function() { $parent.basket.remove($data) }">
                                                    <span class="basket-remove material-icons">&#xE92B;</span>
                                                </button>
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                            <tbody data-bind="attr: { id: $data.Code.replace(/\//g, '-') + '-line-ref' }" class="collapse">
                                <tr class="form-group">
                                    <td colspan="5" class="line-ref">
                                        <input class="form-control" data-bind="textInput: LineRef, attr: { id: $data.Code.replace(/\//g, '-') + '-line-ref-input' }, charsRemaining: LineRef, charsRemainingOptions: { maxLength: 25, elementId: '#' + $data.Code.replace(/\//g, '-') + '-line-ref-input' }" placeholder="Line Reference" />
                                        <label class="col-form-label">
                                        </label>
                                    </td>
                                </tr>
                            </tbody>
                            <!-- /ko -->
                        </table>
                    </div>
                    <div class="basket-button-container" style="border-bottom: 0; border-top: 1px solid #ddd;" data-bind="visible: basket().length > 3">
                        @*<a id="take-payment-btn" class="btn btn-warning" href="https://retail.designersguild.com" target="_blank" data-bind="visible: totalPrice() > 0">TAKE PAYMENT</a>*@
                        <button id="place-order-btn-1" class="btn btn-primary" data-bind="enable: !placeOrderBusy(), click: placeOrder">PLACE ORDER</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

