@model Portal.Areas.Products.ViewModels.BasketStatusViewModel
@{
    ViewBag.Title = "Basket Status";

    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/basket-status")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/basket-status")

    <script type="text/javascript">
    window.getPreselectedTradeAccount = () => {
        return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedTradeAccount))
    }

    let basketStatus = basketStatusViewModel();

    ko.options.deferUpdates = true;

    ko.validation.init({
        decorateInputElement: true,
        errorElementClass: 'alert-danger',
        errorMessageClass: 'validation-message text-danger'
    });

    $(document).ready(function () {
        ko.applyBindings(basketStatus, document.body);
        window.setTimeout(() => {
            basketStatus.ready();
        }, 0);
    });
    </script>
}
@if (ViewBag.Partial == true)
{
    <style type="text/css">
        #basket-status-wrapper {
            min-height: 460px;
        }
    </style>
}

<script type="text/html" id="basket-status-row-template">
    <tr>
        @*<td>
                <span data-bind="text: BasketID"></span>
            </td>*@
        <td>
            <span data-bind="text: CustomerOrderReference"></span>
        </td>
        <td>
            <span data-bind="html: Status"></span>
        </td>
        <td class="popover-container">
            <a class="nav-link pointer" data-bind="click: $parent.fetchOrderDetail">
                <span data-bind="text: OrderHeadID, bootstrapPopover: orderDetailPopover"></span>
            </a>
        </td>
        <td>
            <span data-bind="text: Owner"></span>
        </td>
        <td>
            <span data-bind="html: History"></span>
        </td>
        <td>
            <div class="basket-status-controls">
                <div>
                    <a class="btn btn-link pointer"
                       href="javascript:;"
                       data-bind="attr: { disabled: CanEditBasket == false, title: 'Click to load Basket ' + BasketID }, click: $parent.editBasket, css: { 'disabled': CanEditBasket == false }"
                       disabled>
                        <i class="material-icons">
                            shopping_bag
                        </i>
                    </a>
                </div>
                <!-- ko if: TradeOrderImportFileID -->
                <div data-bind="bootstrapPopover: orderImportDetailPopover">
                    <a class="btn btn-link pointer"
                       href="javascript:;"
                       title="Click to View Import File Details"
                       data-bind="attr: { disabled: TradeOrderImportFileID == null }, click: $parent.fetchImportDetail, css: { 'disabled': TradeOrderImportFileID == null }"
                       disabled>
                        <i class="material-icons" data-bind="text: 'upload_file'"></i>
                    </a>
                </div>
                <!-- /ko -->
            </div>
        </td>
        @*<td>
                <span data-bind="text: OrderImportHeadID"></span>
            </td>
            <td>
                <span data-bind="text: BasketSplitName"></span>
            </td>
            <td>
                <span data-bind="text: LineCount"></span>
            </td>
            <td>
                <span data-bind="text: CancelledLineCount"></span>
            </td>
            <td>
                <span data-bind="text: LastModified"></span>
            </td>*@
    </tr>
</script>

@if (ViewBag.Partial != true)
{
    <div class="form-group row mb-5">
        <div class="col-xs-12">
            <div class="page-heading-logo">
                <div></div>
            </div>
            <div class="page-heading text-right">
                @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
                {
                    <h1 class="main-heading">
                        @(Model.ApplicationHeading)
                    </h1>
                }
                @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
                {
                    <h4 class="sub-heading">
                        <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                    </h4>
                }
            </div>
        </div>
    </div>
}
else
{
    <style type="text/css">
        #basket-status-wrapper {
            border: 0;
        }
    </style>
}

<div id="basket-status-wrapper" class="card">
    <div class="card-body p-3">
        <div class="blocker" style="display: none;" data-bind="flexVisible: busy, toggleOpacity: busy">
            <div class="loading-spinner"></div>
            <h3 class="mt-3">
                Please Wait
            </h3>
        </div>
        @Html.Action("TradeAccountSelector", "Component", new { Area = "", CanSearch = true, canCollapse = false, orderProductsExtension = false })
        <div id="basket-status-search-controls" class="d-none pt-3" data-bind="css: { 'd-none': !tradeAccount() }">
            <div class="hstack gap-3 mb-3">
                <div data-bind="component: { name: 'mdc-text-field-component', params: customerOrderReferenceParams }"></div>
                <div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: fromParams }"></div>
                <div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: toParams }"></div>
                <button class="btn btn-primary" data-bind="click: fetch">
                    Search
                </button>
            </div>
        </div>
        <div class="mt-3" data-bind="kendoGrid: resultGridParams"></div>
    </div>
</div>