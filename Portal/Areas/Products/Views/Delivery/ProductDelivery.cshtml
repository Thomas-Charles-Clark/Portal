                                                    <!-- /ko -->
                                                </div>
                                                <div>
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_VIEW -->
                                                    <span data-bind="with: deliveryWeekDay">
                                                        <span data-bind="text: Name"></span>
                                                    </span>
                                                    <!-- /ko -->
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_EDIT -->
                                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: deliveryWeekDayDropDownList }"></div>
                                                    <!-- /ko -->
                                                </div>
                                                <div>
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_VIEW -->
                                                    <span data-bind="text: weightBracket"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_EDIT -->
                                                    <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: weightBracketTextBox }"></div>
                                                    <!-- /ko -->
                                                </div>
                                                <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_EDIT -->
                                                <div>
                                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: destinationDeliveryZoneDropDownList }"></div>
                                                </div>
                                                <div>
                                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: deliveryGroupDropDownList }"></div>
                                                </div>
                                                <!-- /ko -->
                                                <div>
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_VIEW -->
                                                    <span data-bind="text: expressService() ? 'Yes' : 'No'"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_EDIT -->
                                                    <div data-bind="component: { name: 'mdc-checkbox-component', params: expressServiceCheckbox }"></div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                        <div class="panel-footer">
                                            <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_VIEW -->
                                            <p></p>
                                            <!-- /ko -->
                                            <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_EDIT -->
                                            <p class="text-right">
                                                <button class="btn btn-sm btn-default pull-right" data-bind="click: addDefaultDeliveryService">
                                                    Add Price Point
                                                </button>
                                                <span class="clearfix"></span>
                                            </p>
                                            <!-- /ko -->
                                            <div class="delivery-service-hash">
                                                <div>
                                                    <label>
                                                        ID
                                                    </label>
                                                </div>
                                                <div>
                                                    <label>
                                                        Preference
                                                    </label>
                                                </div>
                                                <div>
                                                    <label>
                                                        Charge
                                                    </label>
                                                </div>
                                                <div>
                                                    <label>
                                                        Proportional Charge
