<div id="delivery-group-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: deliveryGroupFactory">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="blocker" style="display: none" data-bind="visible: busy">
                <div class="loading-spinner"></div>
            </div>
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Delivery Group
                    <span data-bind="text: name() ? ': ' + name() : ''"></span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="col-xs-6">
                        <div data-bind="component: { name: 'mdc-text-field-component', params: codeTextBox }"></div>
                    </div>
                    <div class="col-xs-6">
                        <div data-bind="component: { name: 'mdc-text-field-component', params: nameTextBox }"></div>
                    </div>
                </div>
                <div class="margin-bottom-30" data-bind="component: { name: 'mdc-text-field-component', params: notesTextBox }"></div>
                <div class="form-group row">
                    <div class="col-xs-6">
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: minimumParcelWeightTextBox }"></div>
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: avgParcelWeightTextBox }"></div>
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: avgPalletWeightTextBox }"></div>
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: packagingAllowanceTextBox }"></div>
                    </div>
                    <div class="col-xs-6">
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: avgParcelLengthTextBox }"></div>
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: avgParcelWidthTextBox }"></div>
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: avgParcelHeightTextBox }"></div>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-6 col-xs-push-6">
                        <div class="text-right" data-bind="component: { name: 'mdc-text-field-numeric-component', params: courierSurchargeTextBox }"></div>
                    </div>
                </div>
                <div class="checkbox-container" data-bind="component: { name: 'mdc-checkbox-component', params: splitBasketByAvailabilityCheckbox }"></div>
                <div class="checkbox-container" data-bind="component: { name: 'mdc-checkbox-component', params: splitByBasketItemCheckbox }"></div>
                <div class="checkbox-container" data-bind="component: { name: 'mdc-checkbox-component', params: allowDisplayDeliveryGroupConsolidationCheckbox }"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: cancel">
                    Cancel
                </button>
                <button class="btn btn-green" data-bind="click: save">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>