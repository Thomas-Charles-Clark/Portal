        <div class="form-group delivery-service-grouping delivery-group-grouping">
            <div class="panel panel-default" data-bind="template: { name: 'new-default-delivery-service-panel', data: newDefaultDeliveryService }"></div>
        </div>
        <!-- /ko -->
        <button class="btn btn-default" data-bind="click: createDeliveryGroup">
