                                                <div>
                                                    <label>
                                                        Surcharge
                                                    </label>
                                                </div>
                                                <div>
                                                    <label>
                                                        Surcharge Charging Logic
                                                    </label>
                                                </div>
                                            </div>
                                            <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_VIEW -->
                                            <!-- ko foreach: deliveryHashServices -->
                                            <div class="delivery-service-hash">
                                                <div>
                                                    <span class="text-right" data-bind="text: DefaultDeliveryServiceID"></span>
                                                </div>
                                                <div>
                                                    <span class="text-right" data-bind="text: Preference"></span>
                                                </div>
                                                <div>
                                                    <span class="text-right" data-bind="text: formatCurrency(Charge, 2, Currency.FormattingCulture, Currency.Code)"></span>
                                                </div>
                                                <div>
                                                    <!-- ko if: ProportionalCharge -->
                                                    <span class="text-right" data-bind="text: `${ProportionalCharge}%`"></span>
                                                    <!-- /ko -->
                                                </div>
                                                <div>
                                                    <span class="text-right" data-bind="text: thresholdMinimumDisplay"></span>
                                                </div>
                                                <div>
                                                    <span class="text-right" data-bind="text: thresholdMaximumDisplay"></span>
                                                </div>
                                                <div>
                                                    <span class="text-right" data-bind="text: formatCurrency(Surcharge, 2, Currency.FormattingCulture, Currency.Code)"></span>
