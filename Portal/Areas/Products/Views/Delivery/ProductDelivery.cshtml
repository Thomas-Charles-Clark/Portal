    <div id="trade-haulier-overrides" class="tab-pane active">
        <div data-bind="kendoGrid: tradeHaulierOverrideGridSettings"></div>
    </div>
</div>

<div id="delivery-zone-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: deliveryZoneFactory">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Add Delivery Zone
                </h4>
            </div>
            <div class="modal-body">
                <p data-bind="with: destinationCountry">
                    Add Delivery Zone to <span data-bind="text: Name"></span>
                </p>
                <div class="flex-container" style="justify-content: space-between">
                    <div data-bind="component: { name: 'mdc-text-field-component', params: codeTextBox }"></div>
                    <div data-bind="component: { name: 'mdc-text-field-component', params: nameTextBox }"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: cancel">
                    Cancel
                </button>
                <button class="btn btn-green" data-bind="click: save">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

