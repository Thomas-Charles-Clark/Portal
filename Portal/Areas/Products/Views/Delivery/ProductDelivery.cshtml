                                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: deliveryChargingLogicDropDownList }"></div>
                                                    <!-- /ko -->
                                                </div>
                                                <div>
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_VIEW -->
                                                    <span data-bind="with: currency">
                                                        <span data-bind="text: Name"></span>
                                                    </span>
                                                    <!-- /ko -->
                                                    <!-- ko if: hash.view() == DEFAULT_DELIVERY_MODE_EDIT -->
