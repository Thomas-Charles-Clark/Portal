            <div class="delivery-service-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: alternativeDeliveryGroupDropDownList }"></div>
            <div></div>
        </div>
        <div data-bind="kendoGrid: alternateDeliveryServicesGridSettings"></div>
    </div>
