@model Portal.Areas.Products.ViewModels.ProductMaintenanceViewModel
@{
    ViewBag.Title = "Product Maintenance";

    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/product-maintenance")
    @Styles.Render("~/bundles/css/tempus-dominus")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/tempus-dominus")
    @Scripts.Render("~/bundles/js/product-maintenance")

    @if (Request.IsAuthenticated)
    {
        <script type="text/javascript">

        window.getFormDefinitions = () => {
            return @Html.Raw(Model.FormJSON);
        }

        window.getFormData = () => {
            return @Html.Raw(Model.DataJSON);
        }

        let viewModel = productMaintenanceBaseViewModel(getFormDefinitions(), getFormData());

        let ftf = viewModel.fabricTreatmentFactory;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        $(document).ready(function () {
            ko.applyBindings(viewModel, document.body);
            window.setTimeout(() => {
                viewModel.ready();
            }, 0);
        });
        </script>
    }
}

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<ul class="nav nav-pills">
    <li>
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#maintenance-tab-products" data-bind="click: productsMode">
            Products
        </button>
    </li>
</ul>
<div id="product-tabs-container" class="tab-content">
    <div id="maintenance-tab-products" class="tab-pane fade maintenance-tab show active" data-bind="css: { 'active': mode() == PRODUCT_MAINTENANCE_MODE_PRODUCTS },
        template: {
            foreach: forms,
            name: 'generic-form-template'
        }">
    </div>
</div>