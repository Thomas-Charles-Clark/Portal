#samples-busy-wrap {    
    position: fixed;
    width: 100%;
    height: 100%;
    background-color: #000;
    z-index: 2000;
    opacity: 0.5;
    display: none;
}

#samples-busy-wrap > div {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1500;
    opacity: 1.0;
}

label {
    font-weight: normal;
}

#large-image-container {
    text-align: center;
    user-select: none;
}

.status-D {
    background-color: #ffdfdf;
}

.basket-item.status-D {
    background-image: none;
}

.table-striped > tbody > tr.status-D {
    background-color: #ffdfdf;
}

.stock-table {
    width: 100%;
    max-width: 400px;
    margin: 0 auto 15px;
}

.stock-table th,
.stock-table td {
    padding: 2px 4px;
}

.stock-table th.batch-no {
    vertical-align: middle;
    text-align: center;
    border-bottom: 3px double black;
}

.stock-table th.total {
    text-align: right;
    border-top: 1px double black;
    border-bottom: 3px double black;
}

th.total-heading {
    width: 85px;
}

.stock-table td {
    text-align: right;
}

.stock-total-table {
    margin-bottom: 15px;
}

.stock-total-table th.stock-total {
    text-align: right;
}

.stock-total-table > thead > tr > th {
    border-bottom: 0;
}

.po-total-table {
    margin-bottom: 15px;
    margin-top: 30px;
}

.po-total-table th.stock-total {
    text-align: right;
}

.po-total-table > thead > tr > th {
    border-bottom: 0;
}

