#primary-address-wrapper {
    margin-bottom: 15px;
}

#secondary-select-button {
    margin: 0 auto;
    display: block;
}

#dispatch-select-button {
    width: 254px;
    display: block;
}

#product-selector {
    margin-bottom: 15px;
}

#products-table > thead > tr > th,
#products-table > tbody > tr > td {
    vertical-align: middle;
}

#products-table > thead > tr > .thin-bottom-border {
    border-bottom: 1px solid #ddd;
}

#products-table > thead > .sub-heading > th {
    font-size: 11px;
    width: 42px;
    text-align: center;
}

#products-table > tbody > tr > td > label {
    margin-bottom: 0;
}

