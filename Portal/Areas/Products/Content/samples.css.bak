.basket-toggle-btn {
    padding: 6px 10px;
    position: relative;
    cursor: pointer;
}

#basket,
#mobile-basket {
    padding-left: 0;
    padding-right: 0;
}

.basket-panel {
    max-height: 600px;
    background-color: white;
    overflow-y: auto;
}

