@model Projects.ViewModels.ProjectsViewModel
@{
    ViewBag.Title = "Projects Dashboard - Designers Guild";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    @Styles.Render("~/bundles/css/projects-dashboard")
    @Styles.Render("~/bundles/css/tasks-dashboard")
    @Styles.Render("~/bundles/css/components")
}

@section scripts {
    @Scripts.Render("~/bundles/js/address")
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/tasks-dashboard")
    @Scripts.Render("~/bundles/js/projects-dashboard")

    <script type="text/javascript">

        $(document).on('click', function (e) {
            $('[data-toggle="popover"],[data-original-title]').each(function () {
                //the 'is' for buttons that trigger popups
                //the 'has' for icons within a button that triggers a popup
                if (!$(this).is(e.target) && $(this).has(e.target).length === 0 && $('.popover').has(e.target).length === 0) {
                    (($(this).popover('hide').data('bs.popover') || {}).inState || {}).click = false  // fix for BS 3.3.6
                    e.stopPropagation();
                    return false;
                }
            });
        });

        $('.modal').scroll(function (event) {
            //console.log(event);
            $('[data-role="dropdownlist"],[data-role="dropdowntree"],[data-role="datepicker"]', $(event.target)).each(function (idx, item) {
                var control = $(item).data('kendoDropDownList') || $(item).data('kendoDropDownTree') || $(item).data('datepicker');
                //console.log(item, control);
                if (control)
                    control.close();
            });
        });

        function getUserId() {
            return @Html.Raw(User.Identity.GetUserId<int>());
        }

        function getInitialWidget() {
            return 'Preparation'
        }

        function getUserName() {
            return '@Html.Raw(Model.UserName)';
        }

        function getAvailableProjects() {
            return [];
        }

        function getAvailableTags() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Tags));
        }

        function getAvailableCompetitors() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Competitors));
        }

        function getAvailableProjectCategories() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ProjectCategories));
        }

        function getAvailableProjectStakeholderTypes() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ProjectStakeholderTypes));
        }

        function getAvailableTaskTypes() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.TaskTypes));
        }

        function getPreloaded() {
            return {};
        }

        function getEmployeeHierarchyData() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.EmployeeHierarchyData));
        }

        function getAvailableExternalCompanies() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ExternalCompanies));
        }

        $(document).ready(function () {

            viewModel = new projectsDashboardViewModel();

            ko.validation.init({
                decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
            });

            ko.options.deferUpdates = true;
            ko.applyBindings(viewModel, document.body);

            $("#first-enquiry-date").attr('readonly', true);
            $("#first-enquiry-date").click(function () {
                $("#first-enquiry-date").data("kendoDatePicker").open();
            });

            $("#expected-date").attr('readonly', true);
            $("#expected-date").click(function () {
                $("#expected-date").data("kendoDatePicker").open();
            });

            //$("#project-modal").modal('show');

            //$("#new-task-due-date").attr('readonly', true);
            //$("#new-task-due-date").click(function () {
            //    $("#new-task-due-date").data("kendoDatePicker").open();
            //});

            //$("#new-task-from-date").attr('readonly', true);
            //$("#new-task-from-date").click(function () {
            //    $("#new-task-from-date").data("kendoDatePicker").open();
            //});

            //$("#new-task-until-date").attr('readonly', true);
            //$("#new-task-until-date").click(function () {
            //    $("#new-task-until-date").data("kendoDatePicker").open();
            //});

            //$(".edit-task-delivery-date").attr('readonly', true);
            //$(".edit-task-delivery-date").click(function () {
            //    $(".edit-task-delivery-date").data("kendoDatePicker").open();
            //});

            $('#project-modal').on('shown.bs.modal', function () {
                $(document).off('focusin.modal');
            });
        });
    </script>
}
@section beforeContainer {

}
@section modals {
    @Html.Partial("Modals/_EditProjectModal")
    @Html.Partial("Modals/_ProjectStakeholderModal")

    @Html.Partial("~/Areas/Tasks/Views/Dashboard/Modals/_NewTaskModal.cshtml")
    @Html.Partial("~/Areas/Tasks/Views/Dashboard/Modals/_EditTaskModal.cshtml")
    @Html.Partial("~/Areas/Tasks/Views/Dashboard/Modals/_ExternalAssignmentModal.cshtml")
}
@section components {
    @Html.Partial("~/Views/Shared/Components/_AddableListComponent.cshtml")
    @Html.Partial("~/Views/Shared/Components/_CheckableListComponent.cshtml")
}

<div class="form-group row">
    <div class="col-xs-12">
        <div class="btn-toolbar pull-right">
            <div class="btn-group">
                <a class="btn btn-success" data-bind="click: openModalCreate">
                    Create
                </a>
            </div>
            @*<div class="btn-group">
                <a class="btn btn-primary" data-bind="click: myTasks">
                    View My Tasks
                </a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" data-bind="click: tasksICreated">
                    View Tasks I Created
                </a>
            </div>
            <div class="btn-group">
                <a class="btn btn-primary" data-bind="click: allExternalTasks">
                    View My Externally Assigned Tasks
                </a>
            </div>*@
            <div class="btn-group">
                <a class="btn btn-battleship-blue" data-bind="click: preFilters.clearFilters">
                    Clear All Filters
                </a>
            </div>
        </div>
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<script id="grid-row-template" type="text/x-kendo-template">
    <tr class="project-outer" data-uid="#= uid #">
        <td colspan="1000" class="project-td">
            <div class="project" data-bind="click: function(data, event) { $parent.projectFactory.loadProject(data); }">
                <div class="project-inner">
                    <div class="row">
                        <div class="col-xs-5">
                            <h4>
                                <span data-bind="text: Name"></span>
                            </h4>
                            <p data-bind="attr: { title: 'Project ID: ' + ProjectID }">
                                Project ID: <span data-bind="text: ProjectID"></span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </td>
    </tr>
</script>

<script id="stakeholder-row-template" type="text/x-kendo-template">
    <tr>
        <td>
            <span data-bind="text: ProjectStakeholderType.Name"></span>
        </td>
        <td>
            <span data-bind="text: CompanyName"></span>
        </td>
        <td>
            <span data-bind="text: Name"></span>
        </td>
        <td>
            <span data-bind="with: Phone">
                <a data-bind="text: $data, attr: { href: 'tel:' + $data }"></a>
                @*, click: function () { event.stopImmediatePropagation(); return true; }*@
            </span>
        </td>
        <td>
            <span data-bind="with: Email">
                <a data-bind="text: $data, attr: { href: 'mailto:' + $data }"></a>
                @*, click: function () { event.stopImmediatePropagation(); return true; }*@
            </span>
        </td>
        <td data-bind="with: Address, click: function (data, event) { event.stopPropagation(); return false; }">
            <a role="button" tabindex="0" data-bind="bootstrapPopover: { title: 'Address', content: displayBlock, placement: 'left', trigger: 'click' }, text: addressLine1, click: function (data, event) {  }"></a>
        </td>
        <td>
            <!-- ko if: DecisionMaker -->
            Yes
            <!-- /ko -->
            <!-- ko ifnot: DecisionMaker -->
            No
            <!-- /ko -->
        </td>
        <td>
            <!-- ko if: LeadID != null -->
            <a data-bind="text: Name, attr: { href: '/sales/leads?leadId=' + LeadID, target: '_blank' }"></a>
            <!-- /ko -->
            <!-- ko if: TradeAccountID != null -->
            <a data-bind="text: 'Trade Account ' + Code, attr: { href: '/customers/enquiry?tradeAccountId=' + TradeAccountID, target: '_blank' }"></a>
            <!-- /ko -->
            @*<!-- ko if: LeadContactID != null -->
            <a data-bind="text: Name, attr: { href: '/sales/leads?leadId=' + LeadID, target: '_blank' }"></a>
            <!-- /ko -->*@
        </td>
        <td>
            <span data-bind="with: Website">
                <a data-bind="text: $data, attr: { href: ($data.indexOf('://') > -1 ? $data : 'http://' + $data), target: '_blank' }"></a>
            </span>
            @*, click: function () { event.stopImmediatePropagation(); return true; }*@
        </td>
        <td data-bind="click: function (data, event) { event.stopPropagation(); return false; }">
            <span class="k-icon k-clear-value k-i-close" title="Remove" role="button" tabindex="-1" data-bind="click: function (data, event) { $parent.stakeholderFactory.removeStakeholder(data); }"></span>
        </td>
    </tr>
</script>

<script id="competitor-row-template" type="text/x-kendo-template">
    <tr class="k-master-row" data-bind="css: { 'alert-danger': errors.isAnyMessageShown() }">
        <td class="k-hierarchy-cell"><a class="k-icon k-i-expand" href="#" aria-label="Expand" tabindex="-1"></a></td>
        <td>
            <span class="line-30" data-bind="text: Name"></span>
            <button class="btn btn-secondary-blue btn-sm pull-right" data-bind="click: function(data, event) { addRow(event); }">Add Project Information</button>
            <!-- ko if: productQuotes().length -->
            <span class="line-30" style="margin-left: 15px;" data-bind="text: '(' + productQuotes().length + ')'"></span>
            <!-- /ko -->
            <span class="k-icon k-clear-value k-i-close" style="margin-left: 15px;" title="Remove" role="button" tabindex="-1" data-bind="click: function (data, event) { removeRow(CompetitorID, event); }"></span>
        </td>
    </tr>
</script>

<script id="competitor-detail-template" type="text/x-kendo-template">
    <div data-bind="kendoGrid: gridSettings"></div>    
</script>

<script id="competitor-product-quote-row-template" type="text/x-kendo-template">
    <tr data-bind="validationOptions: { insertMessages: false }">
        <td>
            <input class="form-control" data-bind="textInput: data.productName" />
        </td>
        <td>
            <input class="form-control" data-bind="textInput: data.productCode" />
        </td>
        <td>
            <input class="form-control text-right" data-bind="numeric, forceNullOnEmpty: data.quantity, value: data.quantity.formatted" />
        </td>
        <td class="border-box">
            <div data-bind="component: { name: 'sterling-conversion-component', params: priceParams }"></div>
        </td>
        <td>
            <textarea rows="1" class="form-control" data-bind="textInput: data.comment"></textarea>
        </td>
        <td>
            <span class="k-icon k-clear-value k-i-close" title="Remove" role="button" tabindex="-1" data-bind="click: remove"></span>
        </td>
    </tr>
</script>

<div class="row">
    <div class="col-xs-12">
        <div class="panel panel-primary">
            <div class="panel-heading no-padding non-search panel-stats">
                <h4 class="panel-title">
                    <a class="panel-title panel-toggle" data-toggle="collapse" data-target="#project-dashboard-collapse">
                        Dashboard
                    </a>
                </h4>
            </div>
            <div id="project-dashboard-collapse" class="panel-collapse collapse in">
                <div class="panel-body bg-info" style="padding: 4px 15px;">
                    <div class="form-group row" data-bind="with: preFilters">
                        <div class="col-xs-3">
                            <div class="prefilter">
                                <label class="col-form-label">
                                    Project Category
                                </label>
                                <div data-bind="kendoDropDownList: projectCategorySettings"></div>
                            </div>
                        </div>
                        <div class="col-xs-3">
                            <div class="prefilter">
                                <label class="col-form-label">
                                    Reporting Market
                                </label>
                                <div data-bind="kendoDropDownList: tradeMarketSettings"></div>
                            </div>
                        </div>
                        <div class="col-xs-3">
                            <div class="prefilter">
                                <label class="col-form-label">
                                    Project Location
                                </label>
                                <div data-bind="kendoDropDownList: countrySettings"></div>
                            </div>
                        </div>
                        <div class="col-xs-3">
                            <div class="prefilter">
                                <label class="col-form-label">
                                    Assigned To
                                </label>
                                <div data-bind="kendoDropDownTree: ownerMemberSettings, keepElement: ownerMemberSlicer"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-2 col-xs-6">
                            <div id="dash-preparation" class="panel dash-panel" data-bind="click: function(data, event) { preFilters.setWidget('Preparation', event.target); }">
                                <div class="panel-heading">
                                    <h4 class="panel-title">Preparation</h4>
                                </div>
                                <div class="panel-body text-center" data-bind="with: projectDashboard">
                                    <span class="count" data-bind="text: Preparation"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-6">
                            <div id="dash-specification" class="panel dash-panel" data-bind="click: function(data, event) { preFilters.setWidget('Specification', event.target); }">
                                <div class="panel-heading">
                                    <h4 class="panel-title">Specification</h4>
                                </div>
                                <div class="panel-body text-center" data-bind="with: projectDashboard">
                                    <span class="count" data-bind="text: Specification"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-6">
                            <div id="dash-quote" class="panel dash-panel" data-bind="click: function(data, event) { preFilters.setWidget('Quote', event.target); }">
                                <div class="panel-heading">
                                    <h4 class="panel-title">Quote</h4>
                                </div>
                                <div class="panel-body text-center" data-bind="with: projectDashboard">
                                    <span class="count" data-bind="text: Quote"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-6">
                            <div id="dash-order" class="panel dash-panel" data-bind="click: function(data, event) { preFilters.setWidget('Order', event.target); }">
                                <div class="panel-heading">
                                    <h4 class="panel-title">Order</h4>
                                </div>
                                <div class="panel-body text-center" data-bind="with: projectDashboard">
                                    <span class="count" data-bind="text: Order"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-6">
                            <div id="dash-lost" class="panel dash-panel" data-bind="click: function(data, event) { preFilters.setWidget('Lost', event.target); }">
                                <div class="panel-heading">
                                    <h4 class="panel-title">Lost</h4>
                                </div>
                                <div class="panel-body text-center" data-bind="with: projectDashboard">
                                    <span class="count" data-bind="text: Lost"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-2 col-xs-6">
                            <div id="dash-all" class="panel dash-panel" data-bind="click: function(data, event) { preFilters.setWidget('All', event.target); }">
                                <div class="panel-heading">
                                    <h4 class="panel-title">All</h4>
                                </div>
                                <div class="panel-body text-center" data-bind="with: projectDashboard">
                                    <span class="count" data-bind="text: All"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div style="position: relative">
            <div class="form-busy" style="display: none;" data-bind="fadeVisible: projectGridBusy">
                <div class="busy-bars">
                    <div class="rect1 alert alert-info"></div>
                    <div class="rect2 alert alert-info"></div>
                    <div class="rect3 alert alert-info"></div>
                    <div class="rect4 alert alert-info"></div>
                    <div class="rect5 alert alert-info"></div>
                </div>
            </div>
            <div id="projects-grid" data-bind="kendoGrid: projectGridSettings"></div>
        </div>
    </div>
</div>

<div id="project-lost-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: projectFactory">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Project Lost
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group row margin-bottom-0">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Reason
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <textarea id="lost-comment" class="form-control" data-bind="textInput: lostComment"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: function() { closeLostModal(); }">
                    Cancel
                </button>
                <button class="btn btn-danger pull-right" data-bind="click: function() { markProjectAsLost(); }">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<div id="project-completed-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="with: projectFactory">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Project Completed
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group row margin-bottom-0">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Comment
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <textarea id="completed-comment" class="form-control" data-bind="textInput: completedComment"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: function() { closeCompletedModal(); }">
                    Cancel
                </button>
                <button class="btn btn-success pull-right" data-bind="click: function() { markProjectAsCompleted(); }">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>
