@model Portal.Areas.Stock.ViewModels.RangeManagementViewModel
@{
    ViewBag.Title = "Range Management";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/range-management")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/range-management")
    @Scripts.Render("~/bundles/js/image-download-tasks")

    <script type="text/javascript">

        //console.log = () => { };

        function getStockLocationIDFilterOptions() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.StockLocations))
        }

        var viewModel = rangeManagementViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        viewModel.busy(false);

        window.self = viewModel;

        var headerController = new HeaderController();

        ko.cleanNode(document.querySelector("#archives-modal"));

        ko.applyBindings(headerController, document.querySelector("#archives-modal"));

        window.downloadTasksViewModel = headerController;


        //$(document).ready(() => {

        //    ko.cleanNode(document.getElementById('add-note-modal'));

        //    $('#add-note-modal').detach().appendTo('body');

        //    ko.applyBindings(viewModel, document.getElementById('add-note-modal'));

        //    viewModel.addNoteModal = bootstrap.Modal.getOrCreateInstance(viewModel.addNoteModalElement);
        //});
    </script>
}
@section modals {
    @Html.Partial("Modals/_ImageModalNew")
}

<script id="row-template" type="text/html">
    <!-- ko ifnot: $root.getFilledRecord($data.ProductID) -->
    <tr class="relative busy">
        <td class="k-group-cell product-filter-name-pad"></td>
        <td class="k-group-cell product-page-name-pad"></td>
        <td class="k-group-cell order-form-group-pad"></td>
        <td class="product-card-wrapper" valign="top">
            <div class="product-card-tooltip card">
                <div class="card-body">
                    <div class="flex">
                        <!-- ko if: ImageID -->
                        <img class="thumb" width="80" height="80" data-bind="attr: { src: `https://www.designersguild.com/image/90/${ImageID}` }" />
                        <!-- /ko -->
                        <div>
                            <span data-bind="text: ProductName, attr: { title: ProductName }"></span>
                            <span data-bind="text: ProductCode"></span>
                            <span class="d-flex justify-content-between">
                                <span data-bind="text: Launch"></span>
                                <span data-bind="text: ProductStatus"></span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </td>
        <td colspan="@(Model.ReadOnlyMode ? "4" : "300")"></td>
    </tr>
    <!-- /ko -->
    <!-- ko with: $root.getFilledRecord($data.ProductID) -->
    <tr data-bind="css: { busy: typeof busy === 'undefined' ? true : busy }">
        <td class="k-group-cell product-filter-name-pad"></td>
        <td class="k-group-cell product-page-name-pad"></td>
        <td class="k-group-cell order-form-group-pad"></td>
        <td class="product-card-wrapper" valign="top">
            <div class="product-card-tooltip card">
                <div class="card-body">
                    <div class="flex">
                        <!-- ko if: ImageID -->
                        <img class="thumb" width="80" height="80" data-bind="attr: { src: `https://www.designersguild.com/image/90/${ImageID}` }" />
                        <!-- /ko -->
                        <div>
                            <span data-bind="text: ProductName, attr: { title: ProductName }"></span>
                            <span data-bind="text: ProductCode"></span>
                            <span class="d-flex justify-content-between">
                                <span data-bind="text: Launch"></span>
                                <span data-bind="text: ProductStatus"></span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </td>
        <td data-bind="html: priceSummary"></td>
        <td class="text-end">
            @if (Model.ReadOnlyMode == false)
            {
                <div class="range-planned" data-bind="component: { name: 'mdc-text-field-numeric-component', params: rangePlannedParams }"></div>
            }
            else
            {
                <span data-bind="text: rangePlanned"></span>
            }
        </td>
        <td class="text-end">
            <span data-bind="text: rangeActual"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: rangeInProgress"></span>
        </td>
        @if (Model.ReadOnlyMode == false)
        {
            <td class="text-end">
                <span data-bind="text: rangeRequired"></span>
            </td>
            <td class="recommendations-container">
                <div data-bind="html: actionRecommendations"></div>
            </td>
            <td class="text-end" data-bind="style: { 'background-color': actionTransferToBranchHighlight }">
                <div data-bind="visible: actionTransferToBranchBasketItemId() == null, component: { name: 'mdc-text-field-numeric-component', params: actionTransferToBranchQuantityParams }"></div>
                <button class="btn btn-sm btn-outline-primary" style="display: none" data-bind="
                        visible: actionTransferToBranchBasketItemId,
                        disable: actionTransferToBranchQuantityParams.busy,
                        click: removeWH2BRFromOrder,
                        css: { busy: actionTransferToBranchQuantityParams.busy },
                        attr: { title: `BasketItemID: ${actionTransferToBranchBasketItemId()}` }">
                    Cancel Transfer of <span data-bind="text: actionTransferToBranchExtantTransferQuantity"></span>
                </button>
            </td>
            <td class="text-end" data-bind="style: { 'background-color': actionTransferToWarehouseHighlight }">
                <div data-bind="visible: actionTransferToWarehouseBasketItemId() == null, component: { name: 'mdc-text-field-numeric-component', params: actionTransferToWarehouseQuantityParams }"></div>
                <button class="btn btn-sm btn-outline-primary" style="display: none" data-bind="
                        visible: actionTransferToWarehouseBasketItemId,
                        disable: actionTransferToWarehouseQuantityParams.busy,
                        click: removeBR2WHFromOrder,
                        css: { busy: actionTransferToWarehouseQuantityParams.busy },
                        attr: { title: `BasketItemID: ${actionTransferToWarehouseBasketItemId()}` }">
                    Cancel Transfer of <span data-bind="text: actionTransferToWarehouseExtantTransferQuantity"></span>
                </button>
            </td>
            <td>
                <button class="btn btn-secondary btn-sm submit-btn" data-bind="visible: submitVisible(), disable: busy, click: submitTransfers">
                    Submit
                </button>
            </td>
            <td class="text-end">
                <span data-bind="text: sales180DayBranch"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: stockWHFreeStock"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: stockWHNextPOFreeStock"></span>
            </td>
            <td>
                <!-- ko if: stockWHNextPODueDate -->
                <span data-bind="text: renderDate(stockWHNextPODueDate.substring(0, 10))"></span>
                <!-- /ko -->
            </td>
            <td class="text-end">
                <span data-bind="text: stockKRFreeStock"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: stockMHSFreeStock"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: stockFWFreeStock"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: stockRingFence"></span>
            </td>
            @*<td>
                <span data-bind="html: salesSummary"></span>
            </td>*@
            <td class="text-end">
                <span data-bind="text: sales180DayTotal"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: sales180DayKR"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: sales180DayMHS"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: sales180DayFW"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: sales180DayUKEcommerce"></span>
            </td>
            <td class="text-end">
                <span data-bind="text: sales180DayUKTrade"></span>
            </td>
            <td>
                <!-- ko if: notes != null && notes.length > 0 -->
                <button class="add-note-btn btn btn-link btn-sm" data-bind="click: $root.showAddNoteModal">
                    <span data-bind="text: notes"></span>
                </button>
                <!-- /ko -->
                <!-- ko if: notes == null || notes.length == 0 -->
                <button class="add-note-btn btn btn-sm" data-bind="click: $root.showAddNoteModal">
                    <i class="material-icons">add</i>
                </button>
                <!-- /ko -->
            </td>
        }
    </tr>
    <!-- /ko -->
</script>


