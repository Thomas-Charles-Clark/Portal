@section afterContainer {
    <div class="modal fade" id="add-note-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="blocker" data-bind="flexFadeVisible: noteBusy">
                    <div class="loading-spinner"></div>
                    <h4 class="mt-3">
                        Please wait...
                    </h4>
                </div>
                <div class="modal-header">
                    <h5 class="modal-title">
                        Add Note
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideAddNoteModal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko foreach: notes -->
                    <div class="note">
                        <div class="heading">
                            <span data-bind="text: renderDate(CreatedDT)"></span>
                            <span data-bind="text: MemberName"></span>
                        </div>
                        <div class="note-body">
                            <p data-bind="html: $data.Note"></p>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div data-bind="component: { name: 'mdc-text-area-component', params: noteParams }"></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" data-bind="click: saveNote">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}