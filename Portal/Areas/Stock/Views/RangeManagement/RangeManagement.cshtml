@model Portal.Areas.Stock.ViewModels.RangeManagementViewModel
@{
    ViewBag.Title = "Range Management";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/range-management")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/range-management")

    <script type="text/javascript">

        function getStockLocationIDFilterOptions() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.StockLocations))
        }

        var viewModel = rangeManagementViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;
    </script>
}
@section modals {
    @Html.Partial("Modals/_ImageModalNew")
}

<div class="blocker" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="form-group row mb-2">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<script id="row-template" type="text/html">
    <tr class="relative">
        <td class="k-group-cell"></td>
        <td class="k-group-cell"></td>
        <td class="k-group-cell"></td>
        <td class="product-card-wrapper" valign="top">
            <div class="product-card-tooltip card">
                <div class="pad product-filter"></div>
                <div class="pad product-name"></div>
                <div class="pad order-form-group"></div>
                <div class="card-body">
                    <div class="flex">
                        <!-- ko if: ImageID -->
                        <img class="thumb" width="80" height="80" data-bind="attr: { src: `https://www.designersguild.com/image/90/${ImageID}` }" />
                        <!-- /ko -->
                        <div>
                            <span data-bind="text: ProductName"></span>
                            <span data-bind="text: ProductCode"></span>
                            <span class="d-flex justify-content-between">
                                <span data-bind="text: Launch"></span>
                                <span data-bind="text: ProductStatus"></span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </td>
        <td>
            <span data-bind="text: rangeStatus"></span>
        </td>
        <td class="text-end">
            <div class="range-planned" data-bind="component: { name: 'mdc-text-field-numeric-component', params: rangePlannedParams }"></div>
        </td>
        <td class="text-end">
            <span data-bind="text: rangeActual"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: rangeInProgress"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: rangeRequired"></span>
        </td>
        <td>
            <span data-bind="html: actionRecommendations"></span>
        </td>
        <td class="text-end" data-bind="style: { 'background-color': actionTransferToBranchHighlight }">
            <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: actionTransferToBranchQuantityParams }"></div>
            <!-- ko if: actionTransferToBranchBasketItemId -->
            <button class="btn btn-sm btn-outline-primary mt-2" data-bind="click: removeWH2BRFromOrder, attr: { title: `BasketItemID: ${actionTransferToBranchBasketItemId()}` }">
                Remove from Order
            </button>
            <!-- /ko -->
        </td>
        <td class="text-end" data-bind="style: { 'background-color': actionTransferToWarehouseHighlight }">
            @*ActionTransferToWHQuantity<br />*@
            <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: actionTransferToWarehouseQuantityParams }"></div>
            <!-- ko if: actionTransferToWarehouseBasketItemId -->
            <button class="btn btn-sm btn-outline-primary mt-2"  data-bind="click: removeBR2WHFromOrder, attr: { title: `BasketItemID: ${actionTransferToWarehouseBasketItemId()}` }">
                Remove from Order
            </button>
            <!-- /ko -->
        </td>
        <td>
            @* Submit? *@
            <button class="btn btn-secondary" data-bind="click: submitTransfers">
                Submit
            </button>
        </td>
        <td>
            @*Notes<br />*@
            <span data-bind="html: notes"></span>
        </td>
        <td>
            @*StockSummary<br />*@
            <span data-bind="text: stockSummary"></span>
        </td>
        <td class="text-end">
            @*StockWHFreeStock<br />*@
            <span data-bind="text: stockWHFreeStock"></span>
        </td>
        <td class="text-end">
            @*StockCover<br />*@
            <span data-bind="text: stockCover"></span>
        </td>
        <td class="text-end">
            @*StockWHNextPOFreeStock<br />*@
            <span data-bind="text: stockWHNextPOFreeStock"></span>
        </td>
        <td class="text-end">
            @*StockWHNextPODueDate<br />*@
            <span data-bind="text: stockWHNextPODueDate"></span>
            <br/>
            <span data-bind="text: renderDate(stockWHNextPODueDate)"></span>
        </td>
        <td>
            @*StockKRFreeStock<br />*@
            <span data-bind="text: stockKRFreeStock"></span>
        </td>
        <td class="text-end">
            @*StockMHSFreeStock<br />*@
            <span data-bind="text: stockMHSFreeStock"></span>
        </td>
        <td class="text-end">
            @*StockFWFreeStock<br />*@
            <span data-bind="text: stockFWFreeStock"></span>
        </td>
        <td class="text-end">
            @*StockRingFence<br />*@
            <span data-bind="text: stockRingFence"></span>
        </td>
        <td>
            @*SalesSummary<br />*@
            <span data-bind="html: salesSummary"></span>
        </td>
        <td class="text-end">
            @*Sales180DayTotal<br />*@
            <span data-bind="text: sales180DayTotal"></span>
        </td>
        <td class="text-end">
            @*Sales180DayKR<br />*@
            <span data-bind="text: sales180DayKR"></span>
        </td>
        <td class="text-end">
            @*Sales180DayMHS<br />*@
            <span data-bind="text: sales180DayMHS"></span>
        </td>
        <td class="text-end">
            @*Sales180DayFW<br />*@
            <span data-bind="text: sales180DayFW"></span>
        </td>
        <td class="text-end">
            @*Sales180DayUKEcom<br />*@
            <span data-bind="text: sales180DayUKEcommerce"></span>
        </td>
        <td class="text-end">
            @*Sales180DayUKTrade<br />*@
            <span data-bind="text: sales180DayUKTrade"></span>
        </td>
    </tr>
</script>

<script id="group-header-template" type="text/html">
    <tr>
        <td colspan="200">
        <h5>
            Group Header Template
        </h5>
        </td>
    </tr>
</script>

<div class="content-container">
    <div class="prefilters mb-3">
        <div id="branch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: branchParams }"></div>
        <ul id="main-tabs" class="nav nav-pills" style="display: none" data-bind="visible: branch">
            <li class="nav-item">
                <a id="range-tab-anchor" href="#range-tab" data-bs-toggle="tab" class="nav-link active">
                    Manage Range
                </a>
            </li>
            <li class="nav-item">
                <a id="restock-tab-anchor" href="#restock-tab" data-bs-toggle="tab" class="nav-link">
                    Transfer Orders - Restock (WH &raquo; Branch)
                </a>
            </li>
            <li class="nav-item">
                <a id="recall-tab-anchor" href="#recall-tab" data-bs-toggle="tab" class="nav-link">
                    Transfer Orders - Recall (Branch &raquo; WH)
                </a>
            </li>
        </ul>
    </div>
    <div class="prefilters mb-3" style="display: none" data-bind="visible: branch">
        <div id="product-filter-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productFilterGroupParams }"></div>
        <div id="product-filter-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productFilterParams }"></div>
        <div id="brand-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
        <div id="status-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: statusGroupParams }"></div>
        @*<div id="status-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: statusGroupParams }"></div>*@
        @*<div id="buyer-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: buyerParams }"></div>
            <div id="supplier-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
            <div id="launch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
            <div id="product-colour-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productColourParams }"></div>
            <div id="stock-level-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: stockLevelParams }"></div>
            <div id="collection-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>*@
        <div id="search-term-prefilter" data-bind="component: { name: 'mdc-text-field-component', params: searchTermParams }"></div>
        <ul id="secondary-tabs" class="nav nav-pills">
            <li class="nav-item">
                <a id="add-to-range-anchor" class="nav-link active" data-bind="click: openAddToRangeModal">
                    Add to Range
                </a>
            </li>
        </ul>
    </div>
    <div id="range-management-tab-container" style="display: none" data-bind="visible: branch">
        <div id="range-tab" class="tab-pane active">
            <div class="blocker" data-bind="flexFadeVisible: manageBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="relative">
                <div class="blocker" data-bind="flexFadeVisible: fetchDataBusy">
                    <div class="loading-spinner"></div>
                    <h4 class="mt-3">
                        Please wait...
                    </h4>
                </div>
                <div id="results-grid" data-bind="kendoGrid: gridSettings"></div>
            </div>
        </div>
        <div id="restock-tab" class="tab-pane">
            <div class="blocker" data-bind="flexFadeVisible: restockBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
        </div>
        <div id="recall-tab" class="tab-pane">
            <div class="blocker" data-bind="flexFadeVisible: recallBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
        </div>
    </div>
</div>
<div id="add-to-range-modal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" data-bind="flexFadeVisible: addToRangeModalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Add to Range
                </h4>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" data-bind="click: closeAddToRangeModal"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: closeAddToRangeModal">
                    Cancel
                </button>
                <button class="btn btn-green pull-right" data-bind="click: confirmAddToRangeModal">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

