                            <div class="list-group-item list-group-item-action" role="menuitem">
                                <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" data-bind="style: { '--clip-width': taskPercentCss }, css: barCss"></div>
                                <span data-bind="text: ArchiveBaseName"></span>
                                <span class="text-center" data-bind="text: taskPercentCss"></span>
                            </div>
