                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideAddNoteModal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko foreach: notes -->
                    <div class="note">
                        <div class="heading">
                            <span data-bind="text: renderDate(CreatedDT)"></span>
                            <span data-bind="text: MemberName"></span>
                        </div>
                        <div class="note-body">
                            <p data-bind="html: $data.Note"></p>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div data-bind="component: { name: 'mdc-text-area-component', params: noteParams }"></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" data-bind="click: saveNote">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div data-bind="stopBinding">
        <div id="archives-modal" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            Download Images
                        </h5>
                        <button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
                    </div>
                    <div id="archives-modal-body" class="modal-body">
                        <p id="archives-leading-text">
                            To make it easier for you to download, we are consolidating the {COUNT} image(s) you requested into zip file(s). Each zip file will be limited to 2GB. If you request more images than fit in 2GB, additional sequentially numbered zip files will be generated for you as necessary.
                        </p>
                        <p id="archives-leading-text-2">
                            You may begin downloading your zip files as they become available by clicking the green download button(s).
                        </p>
                        <div class="list-group" style="margin-bottom: 0;" data-bind="foreach: tasks">
                            <!-- ko foreach: createdArchiveFiles -->
                            <a href="#" data-bind="attr: { href: `/stock/range-management/DownloadImageArchive?archiveName=${FileName}` }" class="list-group-item complete d-flex justify-content-between align-items-center">
                                <span data-bind="text: FileName"></span>
                                <span class="download-display">
                                    <span class="badge bg-primary badge-pill" data-bind="text: FileSize"></span>
                                    <span class="btn btn-success btn-sm">
                                        Download
                                    </span>
                                </span>
                            </a>
                            <!-- /ko -->
