                                                                        </colgroup>
                                                                        <tbody>
                                                                            <!-- ko foreach: pieces -->
                                                                            <tr>
                                                                                <td>
                                                                                    <span data-bind="text: AvailableNowDisplay"></span>
                                                                                </td>
                                                                                <td>
                                                                                    <span data-bind="text: BulkDisplay"></span>
