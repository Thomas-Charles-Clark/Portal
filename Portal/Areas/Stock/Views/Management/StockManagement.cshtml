<div id="detail-modal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lxx">
        <div class="modal-content">
            <div class="blocker" data-bind="flexVisible: modalBusy, toggleOpacity: modalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    <span data-bind="with: productDetail">
                        <span data-bind="text: ProductName"></span>
                    </span>
                </h4>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" data-bind="click: closeModal"></button>
            </div>
            <div class="modal-body relative">
                <div data-bind="with: productDetail">
                    <div class="owl-carousel owl-theme" data-bind="with: $parent, keepElement: $parent.productImages">
                        <div class="order-products-carousel" data-bind="foreach: productImages">
                            <img class="pointer" data-bind="click: function (data) { $parent.loadLargeImage($data, $parent.preferredEmail); }, attr: { src: 'https://www.designersguild.com/image/428/' + $data.ImageID, title: $data.TitleText, alt: $data.AltText }" />
                        </div>
                    </div>
                </div>
                <ul class="nav nav-tabs mt-3">
                    <li class="nav-item">
                        <a id="stock-tab-anchor" href="#stock-tab" data-bs-toggle="tab" title="Stock Info" class="nav-link" data-bind="event: { 'show.bs.tab': (e) => { orderProductsDrilldown.fetchStockInfo('S'); return true; } }">
                            Stock Info
                        </a>
                    </li>
                    <li class="nav-item">
                        <a id="supplier-tab-anchor" href="#supplier-tab" data-bs-toggle="tab" title="Supplier Info" class="nav-link" data-bind="event: { 'show.bs.tab': (e) => { orderProductsDrilldown.fetchSupplierInfo(); return true;} }">
                            Supplier Info
                        </a>
                    </li>
                    <li class="nav-item">
                        <a id="sales-tab-anchor" href="#sales-tab" data-bs-toggle="tab" title="Sales History" class="nav-link active" data-bind="event: { 'show.bs.tab': (e) => { orderProductsDrilldown.fetchSalesInfo(); return true; } }">
                            Sales History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a id="order-book-tab-anchor" href="#order-book-tab" data-bs-toggle="tab" title="Order Book" class="nav-link" data-bind="event: { 'show.bs.tab': (e) => { orderProductsDrilldown.fetchOrderBookInfo(); return true; } }">
