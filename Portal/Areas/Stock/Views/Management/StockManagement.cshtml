<div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<ul class="nav nav-tabs mt-3">
    <li class="nav-item">
        <a href="#stock-management-overview-tab" data-bs-toggle="tab" class="nav-link active">
            Overview
        </a>
    </li>
    <li class="nav-item">
        <a href="#stock-management-range-tab" data-bs-toggle="tab" class="nav-link">
            Range Management
        </a>
    </li>
    <li class="nav-item">
        <a href="#stock-management-tranfers-tab" data-bs-toggle="tab" class="nav-link">
            Transfer Management
        </a>
    </li>
</ul>
<div id="stock-management-tab-container" class="tab-content">
    <div class="prefilters">
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: branchGroupParams }"></div>
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: branchParams }"></div>
        <div id="product-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productTypeParams }"></div>
    </div>
    <div class="prefilters" style="display: none;" data-bind="visible: secondaryFiltersVisible">
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productColourParams }"></div>
    </div>
    <div class="prefilters" style="display: none;" data-bind="visible: secondaryFiltersVisible">
        <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: attributeGroupParams }"></div>
        <label style="display: none;" class="flex-grow-0" data-bind="visible: attributeGroup">
            equals/contains
        </label>
        <div data-bind="visible: attributeGroup, component: { name: 'mdc-kendo-multiselect-component', params: attributesParams }"></div>
    </div>
    <div id="stock-management-overview-tab" class="tab-pane active">
        <div class="blocker" data-bind="flexVisible: overviewTabBusy, toggleOpacity: overviewTabBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
        <div style="display: none" data-bind="visible: productSearchResults().length">
            <div class="product-search-results">
                <!-- ko foreach: productSearchResults -->
                <div class="product-result">
                    <span data-bind="text: Code"></span>
                    <span data-bind="text: Name"></span>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <div id="stock-management-range-tab" class="tab-pane">
        <div class="blocker" data-bind="flexVisible: rangeTabBusy, toggleOpacity: rangeTabBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
        <div style="display: none" data-bind="visible: productSearchResults().length">

        </div>
    </div>
    <div id="stock-management-tranfers-tab" class="tab-pane">
        <div class="blocker" data-bind="flexVisible: transferTabBusy, toggleOpacity: transferTabBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
        <div style="display: none" data-bind="visible: productSearchResults().length">

        </div>
    </div>
</div>

<div id="-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" data-bind="flexVisible: modalBusy, toggleOpacity: modalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-bind="click: closeModal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Modal
                </h4>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: closeModal">
                    Cancel
                </button>
                <button class="btn btn-green pull-right" data-bind="click: confirmModal">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>