<div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<ul class="nav nav-tabs mt-3">
    <li class="nav-item">
        <a id="overview-tab-anchor" href="#stock-management-overview-tab" data-bs-toggle="tab" class="nav-link active">
            Overview
        </a>
    </li>
    <li class="nav-item">
        <a id="range-tab-anchor" href="#stock-management-range-tab" data-bs-toggle="tab" class="nav-link">
            Range Management
        </a>
    </li>
    <li class="nav-item">
        <a id="transfer-tab-anchor" href="#stock-management-tranfers-tab" data-bs-toggle="tab" class="nav-link">
            Transfer Management
        </a>
    </li>
</ul>
<div id="stock-management-tab-container" class="tab-content">
    <div class="prefilters">
        <div id="branch-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: branchGroupParams }"></div>
        <div id="branch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: branchParams }"></div>
        <div id="product-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productTypeParams }"></div>
        <div id="display-prefilter" class="me-auto d-flex gap-3">
            <div data-bind="component: { name: 'mdc-checkbox-component', params: displayWarehouseStockParams }"></div>
            <div data-bind="component: { name: 'mdc-checkbox-component', params: displayRingFencedStockParams }"></div>
            <div data-bind="component: { name: 'mdc-checkbox-component', params: displaySalesParams }"></div>
        </div>
        <button class="btn btn-success" data-bind="click: saveChanges">
            Save
        </button>
    </div>
    <div class="prefilters" style="display: none;" data-bind="visible: secondaryFiltersVisible">
        <div id="launch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
        <div id="brand-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
        <div id="product-colour-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productColourParams }"></div>
        <div id="stock-level-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: stockLevelParams }"></div>
        <div id="collection-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
    </div>
    <div class="prefilters" style="display: none;" data-bind="visible: secondaryFiltersVisible">
        <div id="attribute-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: attributeGroupParams }"></div>
        <label style="display: none;" class="flex-grow-0" data-bind="visible: attributeGroup">
            equals/contains
        </label>
        <div id="attribute-prefilter" data-bind="visible: attributeGroup, component: { name: 'mdc-kendo-multiselect-component', params: attributesParams }"></div>
    </div>
    <div id="stock-management-overview-tab" class="tab-pane active">
        <div class="blocker" data-bind="flexFadeVisible: overviewBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
        <div style="display: none" data-bind="visible: productSearchResults().length">
            <table class="table table-condensed product-search-results">
                <colgroup>
                    <col /> <!-- Code -->
                    <col /> <!-- Name -->
                    <col /> <!-- Separator -->
                    <!-- ko if: true -->
                    <col style="width: 80px" /> <!-- TARGET Branch Group Total -->
                    <!-- ko if: branchId() && productSearchResults().length && productSearchResults()[0].Range -->
                    <col style="width: 80px" /> <!-- TARGET Branch Total -->
                    <!-- /ko -->
                    <col style="width: 80px" /> <!-- TARGET Contrast A -->
                    <col style="width: 80px" /> <!-- TARGET Contrast B -->
                    <!-- /ko -->
                    <col /> <!-- Separator -->
                    <!-- ko if: true -->
                    <col style="width: 80px" /> <!-- ACTUAL Branch Group Total -->
                    <!-- ko if: branchId() && productSearchResults().length && productSearchResults()[0].Range -->
                    <col style="width: 80px" /> <!-- ACTUAL Branch Total -->
                    <!-- /ko -->
                    <col style="width: 80px" /> <!-- ACTUAL Contrast A -->
                    <col style="width: 80px" /> <!-- ACTUAL Contrast B -->
                    <!-- /ko -->
                    <!-- ko if: displayWarehouseStock -->
                    <col /> <!-- Separator -->
                    <col style="" /> <!-- WH STOCK Current Free Stock -->
                    <col style="" /> <!-- WH STOCK Transfer Stock Leaving -->
                    <col style="" /> <!-- WH STOCK Transfer Stock Arriving -->
                    <col style="" /> <!-- WH STOCK On Purhcase Order -->
                    <col style="" /> <!-- WH STOCK First Due Date -->
                    <col style="" /> <!-- WH STOCK First Due Quantity -->
                    <col style="" /> <!-- WH STOCK Projected Stock -->
                    <!-- /ko -->
                    <!-- ko if: displayRingFencedStock -->
                    <col /> <!-- Separator -->
                    <col style="" /> <!-- RINGFENCED STOCK Fenwick -->
                    <col style="" /> <!-- RINGFENCED STOCK KR -->
                    <col style="" /> <!-- RINGFENCED STOCK MHS -->
                    <col style="" /> <!-- RINGFENCED STOCK Trade -->
                    <col style="" /> <!-- RINGFENCED STOCK eCommerce -->
                    <col style="" /> <!-- RINGFENCED STOCK Trade (Total...?) -->
                    <!-- /ko -->
                    <!-- ko if: displaySales -->
                    <col /> <!-- Separator -->
                    <col style="" /> <!-- SALES Fenwick -->
                    <col style="" /> <!-- SALES KR -->
                    <col style="" /> <!-- SALES MHS -->
                    <col style="" /> <!-- SALES eCommerce -->
                    <col style="" /> <!-- SALES Trade -->
                    <!-- /ko -->
                </colgroup>
                <thead>
                    <tr>
                        <th colspan="2">
                            &nbsp;
                        </th>
                        <th class="separator"></th>
                        <th data-bind="attr: { colspan: branchId() && productSearchResults().length && productSearchResults()[0].Range ? 4 : 3 }">
                            Target Shelf Stock
                        </th>
                        <th class="separator"></th>
                        <th data-bind="attr: { colspan: branchId() && productSearchResults().length && productSearchResults()[0].Range ? 4 : 3 }">
                            Actual Shelf Stock
                        </th>
                        <!-- ko if: displayWarehouseStock -->
                        <th class="warehouse-stock separator"></th>
                        <th class="warehouse-stock" colspan="7">
                            Warehouse Stock
                        </th>
                        <!-- /ko -->
                        <!-- ko if: displayRingFencedStock -->
                        <th class="separator"></th>
                        <th colspan="6">
                            Ring Fenced Stock
                        </th>
                        <!-- /ko -->
                        <!-- ko if: displaySales -->
                        <th class="separator"></th>
                        <th colspan="5">
                            Sales
                        </th>
                        <!-- /ko -->
                    </tr>
                    <tr>
                        <th class="text-start">
                            Code
                        </th>
                        <th class="text-start">
                            Name
                            <i class="result-count-display">
                                <span data-bind="text: productSearchResults().length"></span>
                                Results
                            </i>
                        </th>
                        <th class="separator"></th>
                        <th>
                            <span data-bind="text: branchGroup()?.Name"></span>
                            <br />
                            Total
                        </th>
                        <!-- ko if: branchId() && productSearchResults().length && productSearchResults()[0].Range -->
                        <th>
                            <span data-bind="text: branch()?.Name ?? 'Branch'"></span>
                            <br />Total
                        </th>
                        <!-- /ko -->
                        <th>
                            Contrast
                            <br />
                            A
                        </th>
                        <th>
                            Contrast
                            <br />
                            B
                        </th>
                        <th class="separator"></th>
                        <th>
                            <span data-bind="text: branchGroup()?.Name"></span>
                            <br />
                            Total
                        </th>
                        <!-- ko if: branchId() && productSearchResults().length && productSearchResults()[0].Range -->
                        <th>
                            <span data-bind="text: branch()?.Name ?? 'Branch'"></span>
                            <br />Total
                        </th>
                        <!-- /ko -->
                        <th>
                            Contrast
                            <br />
                            A
                        </th>
                        <th>
                            Contrast
                            <br />
                            B
                        </th>
                        <!-- ko if: displayWarehouseStock -->
                        <th class="separator"></th>
                        <th class="warehouse-stock">
                            Current Stock
                            <br/>
                            Free
                        </th>
                        <th class="warehouse-stock">
                            Transfer Stock
                            <br/>
                            Leaving
                        </th>
                        <th class="warehouse-stock">
                            Transfer Stock
                            <br/>
                            Arriving
                        </th>
                        <th class="warehouse-stock">
                            On Purchase
                            <br/>
                            Order
                        </th>
                        <th class="warehouse-stock">
                            First
                            <br/>
                            Due Date
                        </th>
                        <th class="warehouse-stock">
                            First
                            <br/>
                            Due Quantity
                        </th>
                        <th class="warehouse-stock">
                            Project
                            <br/>
                            Stock
                        </th>
                        <!-- /ko -->
                        <!-- ko if: displayRingFencedStock -->
                        <th class="separator"></th>
                        <th>
                            Fenwick
                        </th>
                        <th>
                            KR
                        </th>
                        <th>
                            MHS
                        </th>
                        <th>
                            Trade
                        </th>
                        <th>
                            eCommerce
                        </th>
                        <th>
                            Total?
                        </th>
                        <!-- /ko -->
                        <!-- ko if: displaySales -->
                        <th class="separator"></th>
                        <th>
                            Fenwick
                        </th>
                        <th>
                            KR
                        </th>
                        <th>
                            MHS
                        </th>
                        <th>
                            eCommerce
                        </th>
                        <th>
                            Trade
                        </th>
                        <!-- /ko -->
                    </tr>
                </thead>
                <!-- ko foreach: productSearchResults().sort((a, b)  => a.BranchGroup?.Quantity > b.BranchGroup?.Quantity ? -1 : 1) -->
                <tbody>
                    <tr class="product-result">
                        <td class="text-start">
                            <span data-bind="text: Code"></span>
                        </td>
                        <td class="text-start">
                            <span data-bind="text: Name"></span>
                        </td>
                        <td class="separator"></td>
                        <td>
                            <span data-bind="text: branchGroupTarget"></span>
                        </td>
                        <!-- ko if: $parentContext.$data.branchId() && Range -->
                        <td>
                            <div class="number-control"
                                 data-bind="
                                 css: { 'unsaved-changes': branchTargetParams.unsavedChanges },
                                 component: { name: 'mdc-text-field-numeric-component', params: branchTargetParams }"></div>
                            @*<input class="form-control input-sm" data-bind="numeric, textInput: branchTarget, css: { 'busy': busy } event: { focus: (data, event) => { event.target.select() }, blur: saveBranchTarget }" />*@
                            @*<span data-bind="text: branchTarget"></span>*@
                        </td>
                        <!-- /ko -->
                        <td>
                            <span data-bind="text: contrastTarget_A"></span>
                        </td>
                        <td>
                            <span data-bind="text: contrastTarget_B"></span>
                        </td>
                        <td class="separator"></td>
                        <td>
                            <span data-bind="text: branchGroupActual"></span>
                        </td>
                        <!-- ko if: $parentContext.$data.branchId() && Range -->
                        <td>
                            <span data-bind="text: branchActual"></span>
                        </td>
                        <!-- /ko -->
                        <td>
                            <span data-bind="text: contrastActual_A"></span>
                        </td>
                        <td>
                            <span data-bind="text: contrastActual_B"></span>
                        </td>
                        <!-- ko if: $parentContext.$data.displayWarehouseStock() -->
                        <td class="separator"></td>
                        <td class="warehouse-stock">
                            <span data-bind="text: currentFreeStock"></span>
                        </td>
                        <td class="warehouse-stock">
                            <span data-bind="text: transferStockLeaving"></span>
                        </td>
                        <td class="warehouse-stock">
                            <span data-bind="text: transferStockArriving"></span>
                        </td>
                        <td class="warehouse-stock">
                            <span data-bind="text: onPurchaseOrder"></span>
                        </td>
                        <td class="warehouse-stock">
                            <span data-bind="text: firstDueDate"></span>
                        </td>
                        <td class="warehouse-stock">
                            <span data-bind="text: firstDueQuantity"></span>
                        </td>
                        <td class="warehouse-stock">
                            <span data-bind="text: projectedStock"></span>
                        </td>
                        <!-- /ko -->
                        <!-- ko if: $parentContext.$data.displayRingFencedStock() -->
                        <td class="separator"></td>
                        <td>
                            <span data-bind="text: fenwickRingFence"></span>
                        </td>
                        <td>
                            <span data-bind="text: kingsRoadRingFence"></span>
                        </td>
                        <td>
                            <span data-bind="text: maryleboneRingFence"></span>
                        </td>
                        <td>
                            <span data-bind="text: tradeRingFence"></span>
                        </td>
                        <td>
                            <span data-bind="text: eCommerceRingFence"></span>
                        </td>
                        <td>
                            <span data-bind="text: tradeRingFence"></span>
                        </td>
                        <!-- /ko -->
                        <!-- ko if: $parentContext.$data.displaySales() -->
                        <td class="separator"></td>
                        <td>
                            <span data-bind="text: fenwickSales"></span>
                        </td>
                        <td>
                            <span data-bind="text: kingsRoadSales"></span>
                        </td>
                        <td>
                            <span data-bind="text: maryleboneSales"></span>
                        </td>
                        <td>
                            <span data-bind="text: eCommerceSales"></span>
                        </td>
                        <td>
                            <span data-bind="text: tradeSales"></span>
                        </td>
                        <!-- /ko -->
                    </tr>
                </tbody>
                <!-- /ko -->
            </table>
        </div>
    </div>
    <div id="stock-management-range-tab" class="tab-pane">
        <div class="blocker" data-bind="flexFadeVisible: rangeBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
        <div style="display: none" data-bind="visible: productSearchResults().length">

        </div>
    </div>
    <div id="stock-management-tranfers-tab" class="tab-pane">
        <div class="blocker" data-bind="flexFadeVisible: transferBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
        <div style="display: none" data-bind="visible: productSearchResults().length">

        </div>
    </div>
</div>

<div id="-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" data-bind="flexVisible: modalBusy, toggleOpacity: modalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-bind="click: closeModal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Modal
                </h4>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: closeModal">
                    Cancel
                </button>
                <button class="btn btn-green pull-right" data-bind="click: confirmModal">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>