@model Portal.Areas.Stock.ViewModels.StockManagementViewModel
@{
	ViewBag.Title = "Stock - Management";
	Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
	@Styles.Render("~/bundles/css/components")
	@Styles.Render("~/bundles/css/kendo-custom")
	@Styles.Render("~/bundles/css/stock-management")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/components")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/stock-management")

	<script type="text/javascript">

        function getStockLocationIDFilterOptions() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.StockLocations))
        }

        var viewModel = stockManagementViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;
	</script>
}
@section modals {
	@Html.Partial("Modals/_ImageModalNew")
}

<div id="stock-check-request-modal" class="modal fade" data-backdrop="static" data-keyboard="false">
	<div class="modal-dialog">
		<!-- ko if: productDetail -->
		<div class="modal-content" data-bind="with: stockCheckRequester">
			<div class="blocker" data-bind="visible: busy">
				<div class="loading-spinner"></div>
				<h4>
					Please wait..
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<button type="button" class="close" data-bind="click: hideModal">
					<span aria-hidden="true">
						&times;
					</span>
				</button>
				<h4 class="modal-title">
					Stock Check Request
				</h4>
			</div>
			<div class="modal-body">
				<div class="d-flex">
					<h5>
						Quantity Required
					</h5>
					<div data-bind="component: { name: 'mdc-text-field-numeric-component', params: quantityParams }"></div>
				</div>
				<span class="validation-message" data-bind="validationMessage: quantity"></span>
				<div class="mt-3" data-bind="component: { name: 'mdc-text-area-component', params: notesParams }"></div>
			</div>
			<div class="modal-footer">
				<button class="btn btn-red" data-bind="click: hideModal">
					Cancel
				</button>
				<button class="btn btn-green" data-bind="click: submit">
					Submit
				</button>
			</div>
		</div>
		<!-- /ko -->
	</div>
</div>

<div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3">
		Please wait...
	</h4>
</div>

<div class="form-group row">
	<div class="col-xs-12">
		<div class="page-heading-logo">
			<div></div>
		</div>
		<div class="page-heading text-right">
			@if (!String.IsNullOrEmpty(Model.ApplicationHeading))
			{
				<h1 class="main-heading">
					@(Model.ApplicationHeading)
				</h1>
			}
			@if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
			{
				<h4 class="sub-heading">
					<span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
				</h4>
			}
		</div>
	</div>
</div>

<script id="row-template" type="text/html">
	<tr>
		<td>
			<!-- ko if: ImageID -->
			<img class="thumb" width="80" height="80" data-bind="attr: { src: `https://www.designersguild.com/image/90/${ImageID}` }" />
			<!-- /ko -->
		</td>
		@*<td class="text-end">
				<span data-bind="text: ProductID"></span>
			</td>*@
		<td>
			<span data-bind="text: ProductCode"></span>
