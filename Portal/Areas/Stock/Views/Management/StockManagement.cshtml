<div id="change-status-modal" class="modal fade" data-backdrop="static" data-keyboard="false">
	<div class="modal-dialog modal-dialog-centered modal-md">
		<div class="modal-content">
			<div class="blocker" data-bind="flexVisible: changeStatusBusy, toggleOpacity: changeStatusBusy">
				<div class="loading-spinner"></div>
				<h4 class="mt-3">
					Please wait...
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<h4 class="modal-title">
					<span data-bind="with: productDetail">
						<span data-bind="text: ProductCode"></span>
						-
						<span data-bind="text: ProductName"></span>
					</span>
				</h4>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bind="click: closeChangeStatusModal"></button>
			</div>
			<div class="modal-body d-flex flex-column gap-3">
				<div id="product-status-wrapper" class="relative" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productStatusCodeParams }"></div>
				<div class="d-flex justify-content-end align-items-center gap-3">
					<label>
						Clearance Discount %
					</label>
					<div data-bind="component: { name: 'mdc-text-field-numeric-component', params: productClearanceDiscountPercentageParams }"></div>
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn btn-default pull-left" data-bind="click: closeChangeStatusModal">
					Cancel
				</button>
				<button class="btn btn-green pull-right" data-bind="click: confirmStatusChangeModal">
					Confirm
				</button>
			</div>
		</div>
