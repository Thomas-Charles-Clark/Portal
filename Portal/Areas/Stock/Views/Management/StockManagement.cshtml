@model Portal.Areas.Stock.ViewModels.StockManagementViewModel
@{
    ViewBag.Title = "Stock - Management";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/stock-management")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/stock-management")

    <script type="text/javascript">

        function getStockLocationIDFilterOptions() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.StockLocations))
        }

        var viewModel = stockManagementViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);
    </script>
}

<div class="blocker" data-bind="flexVisible: busy, toggleOpacity: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<script id="row-template" type="text/html">
    <tr>
        <td class="text-end">
            <span data-bind="text: ProductID"></span>
        </td>
        <td>
            <span data-bind="text: StatusGroup ? StatusGroup.Name : null"></span>
        </td>
        <td class="text-center">
            <span data-bind="text: Status"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: ClearanceDiscountPercentage ? formatPercentage(ClearanceDiscountPercentage / 100, 2) : null"></span>
        </td>
        <td class="text-center">
            <span data-bind="text: InStock ? '✔' : null"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: AverageDailySales"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: AverageDailySalesDurationDays"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(_01_30DaySales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(_31_60DaySales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(_61_90DaySales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(_91_120DaySales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(_121_150DaySales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(_151_180DaySales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(LifetimeSales, 2, 'en-GB', 'GBP')"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: FirstSaleDate ? renderDate(FirstSaleDate) : null"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: LastSaleDate ? renderDate(LastSaleDate) : null"></span>
        </td>
    </tr>
</script>

<ul class="nav nav-tabs mt-3">
    <li class="nav-item">
        <a id="current-tab-anchor" href="#current-tab" data-bs-toggle="tab" title="(C)urrent and (Y)o we need to set this to Limited" class="nav-link active">
            Current
        </a>
    </li>
    <li class="nav-item">
        <a id="limited-tab-anchor" href="#limited-tab" data-bs-toggle="tab" title="(L)imited" class="nav-link">
            Limited
        </a>
    </li>
    <li class="nav-item">
        <a id="clearance-tab-anchor" href="#clearance-tab" data-bs-toggle="tab" title="(P,C,Y,L,D) - because anything can be set to Clearance..." class="nav-link">
            Clearance
        </a>
    </li>
    <li class="nav-item">
        <a id="discontinued-tab-anchor" href="#discontinued-tab" data-bs-toggle="tab" title="(D)iscontinued" class="nav-link">
            Discontinued
        </a>
    </li>
</ul>
<div id="stock-management-tab-container" class="tab-content" style="display: none" data-bind="visible: true">
    <div class="prefilters">
        <div id="buyer-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: buyerParams }"></div>
        <div id="supplier-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
        <div id="product-filter-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productFilterGroupParams }"></div>
        <div id="product-filter-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productFilterParams }"></div>
    </div>
    <div class="prefilters" style="display: none;" data-bind="visible: secondaryFiltersVisible">
        <div id="launch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
        <div id="brand-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
        <div id="product-colour-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productColourParams }"></div>
        <div id="stock-level-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: stockLevelParams }"></div>
        <div id="collection-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
    </div>
    <div class="prefilters" style="display: none;" data-bind="visible: secondaryFiltersVisible">
        <div id="attribute-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: attributeGroupParams }"></div>
        <label style="display: none;" class="flex-grow-0" data-bind="visible: attributeGroup">
            equals/contains
        </label>
        <div id="attribute-prefilter" data-bind="visible: attributeGroup, component: { name: 'mdc-kendo-multiselect-component', params: attributesParams }"></div>
    </div>
    @*<div class="prefilters">
        <button class="btn btn-success" data-bind="click: saveChanges">
            Save
        </button>
        <i class="result-count-display">
            <span data-bind="text: productSearchResults().length"></span>
            Results
        </i>
    </div>*@
    <div id="prelaunch-tab" class="tab-pane">
        <div class="blocker" data-bind="flexFadeVisible: prelaunchBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div id="current-tab" class="tab-pane active">
        <div class="blocker" data-bind="flexFadeVisible: currentBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div id="limited-tab" class="tab-pane">
        <div class="blocker" data-bind="flexFadeVisible: limitedBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div id="clearance-tab" class="tab-pane">
        <div class="blocker" data-bind="flexFadeVisible: clearanceBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div id="discontinued-tab" class="tab-pane">
        <div class="blocker" data-bind="flexFadeVisible: discontinuedBusy">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">
                Please wait...
            </h4>
        </div>
    </div>
    <div class="mt-3" data-bind="kendoGrid: gridSettings"></div>
</div>

<div id="-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" data-bind="flexVisible: modalBusy, toggleOpacity: modalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-bind="click: closeModal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Modal
                </h4>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: closeModal">
                    Cancel
                </button>
                <button class="btn btn-green pull-right" data-bind="click: confirmModal">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>