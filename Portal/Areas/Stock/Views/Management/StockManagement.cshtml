                                                                </th>
                                                            </tr>
                                                            <!-- /ko -->
                                                            <!-- ko if: stockLocation.totalIncludingDue() > 0 -->
                                                            <tr class="stock-location">
                                                                <th>
                                                                    <span data-bind="text: `${stockLocation.stockLocationCode} - ${stockLocation.stockLocationName}`"></span>
                                                                </th>
                                                                <th>
                                                                    <span data-bind="text: stockLocation.availableNowTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
                                                                </th>
                                                                <th>
                                                                    <span data-bind="text: stockLocation.bulkTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
                                                                </th>
                                                                <th>
                                                                    <span data-bind="text: stockLocation.waitingTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
                                                                </th>
                                                                <th>
                                                                    <span data-bind="text: stockLocation.ringFencedTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
                                                                </th>
                                                                <th>
                                                                    <span data-bind="text: stockLocation.onReserveTotal.toFixed($parentContext.$parent.productFilterOptions().QuantityPrecision)"></span>
