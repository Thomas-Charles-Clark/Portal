			</td>
			<td class="text-center">
				<span data-bind="text: InStock ? '✔' : null"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: AverageDailySales"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: AverageDailySalesDurationDays"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(_01_30DaySales, 2, 'en-GB', 'GBP')"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(_31_60DaySales, 2, 'en-GB', 'GBP')"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(_61_90DaySales, 2, 'en-GB', 'GBP')"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(_91_120DaySales, 2, 'en-GB', 'GBP')"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(_121_150DaySales, 2, 'en-GB', 'GBP')"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(_151_180DaySales, 2, 'en-GB', 'GBP')"></span>
			</td>
			<td class="text-end">
				<span data-bind="text: formatCurrency(LifetimeSales, 2, 'en-GB', 'GBP')"></span>
