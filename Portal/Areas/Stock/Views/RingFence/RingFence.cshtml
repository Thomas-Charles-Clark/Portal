<script id="ring-fence-row-template" type="text/x-kendo-template">
    <tr class="ring-fence-row">
        <td>
            <span data-bind="text: StockLocation.Name"></span>
        </td>
        <td class="text-right">
            <span data-bind="text: InitialQuantity"></span>
        </td>
        <td class="text-right">
            <span data-bind="text: CurrentQuantity"></span>
        </td>
        <td>
            <span class="display-block" data-bind="text: Product.Code"></span>
            <span class="display-block" data-bind="text: Product.BasketName"></span>
        </td>
        <td>
            <span data-bind="text: Batch"></span>
        </td>
        <td>
            <span data-bind="text: Piece"></span>
        </td>
        <td>
            <span data-bind="text: TradeAccount.Code + ' - ' + TradeAccount.Name"></span>
        </td>
        <td class="controls">
            <button class="btn btn-red" data-bind="click: $parent.confirmDeleteRingFence">
                Delete
            </button>
        </td>
    </tr>
</script>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<ul class="nav nav-tabs">
    <li class="active">
        <a href="#ring-fenced-stock-tab" data-toggle="tab">
            Ring Fenced Stock
        </a>
    </li>
</ul>
<div id="ring-fence-tab-container" class="tab-content">
    <div id="ring-fenced-stock-tab" class="tab-pane active">
        <div class="blocker" style="display: none" data-bind="visible: busy">
            <div class="busy-bars">
                <div class="rect1 alert alert-info"></div>
                <div class="rect2 alert alert-info"></div>
                <div class="rect3 alert alert-info"></div>
                <div class="rect4 alert alert-info"></div>
                <div class="rect5 alert alert-info"></div>
            </div>
        </div>
        <div class="prefilters">
            <div id="trade-account-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountGroupParams }"></div>
            <div id="trade-account-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
            <div id="product-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productParams }"></div>
            <div id="expiry-date-prefilter" data-bind="component: { name: 'mdc-date-time-picker-component', params: expiryDateParams }"></div>
            <div></div>
            <div></div>
            <div></div>
            <button id="add-new" class="btn btn-blue" data-bind="click: ringFenceGridAddNew">
                Add New
            </button>
        </div>
        <div style="display: none" data-bind="visible: ready">
            <div data-bind="kendoGrid: ringFenceGrid"></div>
        </div>
    </div>
</div>

<div id="new-ring-fence-modal" class="modal fade" data-backdrop="static" data-keyboard="false" data-bind="">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="blocker" style="display: none" data-bind="visible: newBusy">
                <div class="busy-bars">
                    <div class="rect1 alert alert-info"></div>
                    <div class="rect2 alert alert-info"></div>
                    <div class="rect3 alert alert-info"></div>
                    <div class="rect4 alert alert-info"></div>
                    <div class="rect5 alert alert-info"></div>
                </div>
                <h3>
                    Working...
                </h3>
            </div>
            <div class="modal-header grey-blue">
                <button type="button" class="close" aria-label="Close" data-bind="click: closeNewRingFenceModal">
                    <span aria-hidden="true">
                        &times;
                    </span>
                </button>
                <h4 class="modal-title">
                    Create Ring Fence
                </h4>
            </div>
            <div class="modal-body">
                <table class="drilldown-stock-table">
                    <colgroup>
                        <col style="width: 245px;" />
                        <col />
                    </colgroup>
                    <tbody>
                        <tr>
                            <td data-bind="with: prefilterProduct">
                                <div id="product-name">
                                    <!-- ko if: Product_Images != null -->
                                    <!-- ko if: Product_Images.length > 0 -->
                                    <img class="margin-right-15" data-bind="attr: { src: 'https://www.designersguild.com/image/239/' + Product_Images.shift().ImageID, title: Code }" />
                                    <!-- /ko -->
                                    <!-- /ko -->
                                    <div class="product-details">
                                        <span>
                                            <span data-bind="text: OrderFormName"></span>
                                            <span data-bind="text: Code"></span>
                                        </span>
                                        <span data-bind="html: '(Unit of Stock: ' + StockUnit.Units + ')'"></span>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </td>
                            <td>
                                <div class="new-ring-fence-grid">
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: stockLocationParams }"></div>
                                </div>
                                <!-- ko ifnot: stockInfo().length -->
                                <i>
                                    No stock available at this location.
                                </i>
                                <!-- /ko -->
                                <!-- ko if: stockInfo().length -->
                                <table class="new-ring-fence-table">
                                    <colgroup>
                                        <col style="width: 20%" />
                                        <col style="width: 20%" />
                                        <col style="width: 20%" />
                                        <col style="width: 10%" />
                                        <col style="width: 20%" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                Batch
                                            </th>
                                            <th>
                                                Piece
                                            </th>
                                            <th>
                                                Rack
                                            </th>
                                            <th class="text-right">
                                                Quantity
                                            </th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- ko foreach: stockInfo() -->
                                        <tr>
                                            <td>
                                                <span data-bind="text: batch"></span>
                                            </td>
                                            <td colspan="4" style="padding: 0;">
                                                <table class="stock-breakdown-table">
                                                    <colgroup>
                                                        <col style="width: 25%;" />
                                                        <col style="width: 25%;" />
                                                        <col style="width: 25%;" />
                                                        <col style="width: 25%;" />
                                                    </colgroup>
                                                    <tbody>
                                                        <!-- ko foreach: pieces -->
                                                        <tr>
                                                            <td>
                                                                <span data-bind="text: Piece"></span>
                                                            </td>
                                                            <td>
                                                                <span data-bind="text: Rack"></span>
                                                            </td>
                                                            <td class="text-right">
                                                                <span data-bind="text: formatNumber(Quantity, 1, 'en-GB')"></span>
                                                            </td>
                                                            <td>
                                                                <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: ringFenceQuantity }"></div>
                                                            </td>
                                                        </tr>
                                                        <!-- /ko -->
                                                        <tr>
                                                            <td></td>
                                                            <td></td>
                                                            <td class="text-right" style="line-height: normal">
                                                                <a href="javascript:;" data-bind="click: function (batch) { $parent.addAllBatchPieces(batch); }">
                                                                    + All Pieces
                                                                </a>
                                                            </td>
                                                            <td class="text-right">
                                                                <a href="javascript:;" data-bind="click: function (batch) { $parent.clearPiecesFromBatch(batch); }">
                                                                    - Clear
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- /ko -->
                                    </tbody>
                                </table>
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-left" data-bind="click: closeNewRingFenceModal">
                    Cancel
                </button>
                <!-- ko if: stockInfo().length -->
                <button class="btn btn-green pull-right" data-bind="click: confirmRingFence">
                    Confirm
                </button>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>