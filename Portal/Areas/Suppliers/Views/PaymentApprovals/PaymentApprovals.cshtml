@model Portal.Areas.Suppliers.ViewModels.SupplierPaymentApprovalViewModel
@{
	ViewBag.Title = "Supplier Payment Approvals";
}
@section styles {
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/supplier-payment-approvals")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/credit-control")
	@Scripts.Render("~/bundles/js/supplier-payment-approvals")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	<script type="text/javascript">
		window.getDashboard = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.Dashboard));
		}
	</script>

	<script type="text/javascript">

		var viewModel = supplierPaymentApprovalsViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		window.self = viewModel;

		if (getUserId() != 8) {
			addEventListener('beforeunload', (event) => {
				if (viewModel.gridWidget().dataSource.hasChanges() ||
					viewModel.gridWidget().dataSource.hasChanges()) {
					event.preventDefault();
				}
				return false;
			})
		}
	</script>

	<script type="text/html" id="conversion-control">
		<div class="converting-component">
			<div data-bind="component: { name: 'mdc-text-field-numeric-component', params: inputParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: forexParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: convertedParams }"></div>
		</div>
	</script>

	<script type="text/javascript">
		ko.components.register('conversion-control', {
			template: { element: document.getElementById('conversion-control') }
		});
	</script>
}
@section modals {

}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<script type="text/html" id="approval-basket-row">
	<tr>
		<td></td>
		<td></td>
		<td></td>
		<td></td>
		<td></td>
		<td></td>
	</tr>
</script>

<script type="text/html" id="approval-item-row">
	<tr>
		<td>
			<div data-bind="html: supplierLabel"></div>
		</td>
		<td>
			<div class="converting-component-wrapper" data-bind="component: { name: 'conversion-control', params: amountParams }"></div>
		</td>
		<td>
			<div class="form-control requester-comments" data-bind="html: RequesterComments"></div>
		</td>
		<td>
			@*<div class="converting-component-wrapper" data-bind="component: { name: 'conversion-control', params: approvedAmountInCurrencyParams }"></div>*@
		</td>
		<td>
			@*<div data-bind="component: { name: 'mdc-text-area-component', params: deciderCommentsParams }"></div>*@
		</td>
		<td>
			<button type="button" class="btn btn-secondary">
				<i class="bi bi-x-lg" data-bind="click: $parent.removeBasketItem"></i>
			</button>
		</td>
	</tr>
</script>

<script type="text/html" id="supplier-detail-template">
	<div class="detailTabstrip"></div>
</script>

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div class="modal fade breakdown-modal" id="-modal" tabindex="-1">
	<div class="modal-dialog modal-lg modal-xl" id="n-modal-dialog">
		<div class="modal-content">
			<div class="blocker" data-bind="flexFadeVisible: busy">
				<div class="loading-spinner"></div>
				<h4>
					Please Wait...
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<h4 class="modal-title">
					Title
				</h4>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" data-bind="with: $data">

			</div>
		</div>
	</div>
</div>

<div id="main-supplier-payments-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top show">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: filters.togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: filters.countDisplay"></label>
			</div>
			<div id="sidebar-collapse" class="sidebar-body">
				<form id="prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Suppliers
						</h5>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Sales Analysis
						</h5>
						@*<div id="sales-history-analysis-period-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesHistoryAnalysisPeriodsParams }"></div>
							<div id="invoice-company-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: invoiceCompanyParams }"></div>*@
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: filters.reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
	<main id="supplier-payment-approvals-main">
		<div id="prefilters">
			<div class="date-prefilter" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: filters.weekCommencingDateParams }"></div>
		</div>
		<div id="grid-container">
			<div class="card mx-3">
				<div class="card-body">
					<h4 class="my-0">
						Payment Plans
					</h4>
					<div style="display: none"
						 class="supplier-payment-requests-grid-container payment-plans mt-3 z-2"
						 data-bind="visible: true, kendoGrid: paymentPlanGridParams"></div>
				</div>
			</div>
			<div class="card m-3">
				<div class="card-body">
					<h4 class="my-0">
						Other Payments
					</h4>
					<div style="display: none"
						 class="supplier-payment-requests-grid-container other-statuses mt-3 z-1"
						 data-bind="visible: true, kendoGrid: otherPaymentRequestStatusesGridParams"></div>
				</div>
			</div>
		</div>
	</main>
</div>

<sidebar id="basket-sidebar" class="collapse collapse-horizontal sidebar sticky-bottom show">
	<div class="sidebar-inner">
		<div class="sidebar-header">
			<h5 class="sidebar-heading" data-bind="click: basket.togglePinning">
				<i class="bi bi-basket"></i>
				<span>
					Approvals Basket
					<label class="count" data-bind="html: basket.countDisplay"></label>
				</span>
				<button type="button" class="btn btn-light basket-toggle-btn" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
			</h5>
			<div class="d-flex justify-content-center gap-3">
				<button type="button" class="btn btn-secondary gap-3" data-bind="enable: basket.canClearBasket, click: basket.clear, clickBubble: false">
					Empty Basket
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
		<div id="basket-collapse" class="sidebar-body">
			<form id="basket" data-bind="with: basket" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
				<div id="approval-basket-contents" style="display: none" data-bind="flexFadeVisible: items().length > 0">
					<table id="payment-plans" class="table">
						<colgroup>
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
						</colgroup>
						<thead>
							<tr>
								<th colspan="6">
									<h4 class="mb-0">
										Payment Plans
									</h4>
								</th>
							</tr>
							<tr>
								<th>
									Supplier
								</th>
								<th>
									Amount Requested
								</th>
								<th>
									Requester Comments
								</th>
								<th>
									Amount Approved
								</th>
								<th>
									Approval Comments
								</th>
								<th></th>
							</tr>
						</thead>
						<tbody data-bind="foreach: paymentPlans">
							<!-- ko template: { name: 'approval-item-row', data: $data } --><!-- /ko -->
						</tbody>
					</table>
					<table id="other-payments" class="table">
						<colgroup>
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
						</colgroup>
						<thead>
							<tr>
								<th colspan="6">
									<h4 class="mb-0">
										Other Payments
									</h4>
								</th>
							</tr>
							<tr>
								<th>
									Supplier
								</th>
								<th>
									Amount Requested
								</th>
								<th>
									Requester Comments
								</th>
								<th>
									Amount Approved
								</th>
								<th>
									Approval Comments
								</th>
								<th></th>
							</tr>
						</thead>
						<tbody data-bind="foreach: otherPayments">
							<!-- ko template: { name: 'approval-item-row', data: $data } --><!-- /ko -->
						</tbody>
					</table>
				</div>
			</form>
		</div>
	</div>
</sidebar>