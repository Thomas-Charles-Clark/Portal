@model Portal.Areas.Suppliers.ViewModels.SupplierPaymentApprovalViewModel
@{
	ViewBag.Title = "Supplier Payment Approvals";
}
@section styles {
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/supplier-payment-approvals")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/credit-control")
	@Scripts.Render("~/bundles/js/supplier-payment-approvals")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	<script type="text/javascript">
		window.getDashboard = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.Dashboard));
		}
	</script>

	<script type="text/javascript">

		var viewModel = supplierPaymentApprovalsViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		window.self = viewModel;

		if (getUserId() != 8) {
			addEventListener('beforeunload', (event) => {
				if (viewModel.gridWidget().dataSource.hasChanges() ||
					viewModel.gridWidget().dataSource.hasChanges()) {
					event.preventDefault();
				}
				return false;
			})
		}
	</script>
}
@section modals {

}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div class="modal fade breakdown-modal" id="-modal" tabindex="-1">
	<div class="modal-dialog modal-lg modal-xl" id="n-modal-dialog">
		<div class="modal-content">
			<div class="blocker" data-bind="flexFadeVisible: busy">
				<div class="loading-spinner"></div>
				<h4>
					Please Wait...
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<h4 class="modal-title">
					Title
				</h4>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" data-bind="with: $data">

			</div>
		</div>
	</div>
</div>

<div id="main-supplier-payments-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: filters.togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: filters.countDisplay"></label>
			</div>
			<div id="sidebar-collapse" class="sidebar-body">
				<form id="prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Suppliers
						</h5>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Sales Analysis
						</h5>
						@*<div id="sales-history-analysis-period-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesHistoryAnalysisPeriodsParams }"></div>
							<div id="invoice-company-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: invoiceCompanyParams }"></div>*@
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: filters.reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
	<main id="supplier-payment-approvals-main">
		<div id="totals-wrapper">
			<div class="card">
				<div class="card-body">
					<table id="totals-requested-approved" class="table">
						<colgroup>
							<col />
							<col />
							<col />
							<col style="width: 160px;" />
							<col />
							<col />
						</colgroup>
						<thead>
							<tr>
								<th colspan="6" class="text-center fs-5 mb-0 p-2">
									Requested
								</th>
							</tr>
							<tr>
								<th>
									Total Requested
								</th>
								<th>
									Currency
								</th>
								<th>
									Sterling
								</th>
								<th>
									Total Approved
								</th>
								<th>
									Currency
								</th>
								<th>
									Sterling
								</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									Euro (€)
								</td>
								<td>
									<span data-bind="text: formatCurrency(5000, 2, 'fr-FR', 'EUR')"></span>
								</td>
								<td>
									<span data-bind="text: formatCurrency(4000, 2, 'en-GB', 'GBP')"></span>
								</td>
								<td></td> @* Total Approved Heading Spacer *@
								<td>
									<span data-bind="text: formatCurrency(3000, 2, 'fr-FR', 'EUR')"></span>
								</td>
								<td>
									<span data-bind="text: formatCurrency(2000, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
							<tr>
								<td>
									US Dollar ($)
								</td>
								<td>
									<span data-bind="text: formatCurrency(1000, 2, 'en-US', 'USD')"></span>
								</td>
								<td>
									<span data-bind="text: formatCurrency(800, 2, 'en-GB', 'GBP')"></span>
								</td>
								<td></td> @* Total Approved Heading Spacer *@
								<td>
									<span data-bind="text: formatCurrency(1000, 2, 'en-US', 'USD')"></span>
								</td>
								<td>
									<span data-bind="text: formatCurrency(800, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
							<tr>
								<td>
									Sterling (£)
								</td>
								<td>
									<span data-bind="text: formatCurrency(2000, 2, 'en-GB', 'GBP')"></span>
								</td>
								<td>
									<span data-bind="text: formatCurrency(2000, 2, 'en-GB', 'GBP')"></span>
								</td>
								<td></td> @* Total Approved Heading Spacer *@
								<td>
									<span data-bind="text: formatCurrency(2000, 2, 'en-GB', 'GBP')"></span>
								</td>
								<td>
									<span data-bind="text: formatCurrency(2000, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
							<tr>
								@* Sterling Total Column *@
								<td></td>
								<td></td>
								<td>
									<span class="bold" data-bind="text: formatCurrency(6800, 2, 'en-GB', 'GBP')"></span>
								</td>
								<td></td>
								<td></td>
								<td>
									<span class="bold" data-bind="text: formatCurrency(4800, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="card">
				<div class="card-body">
					<table id="weekly-table" class="table">
						<colgroup>
							<col />
							<col />
						</colgroup>
						<thead>
							<tr>
								<th colspan="2" class="text-center fs-5 mb-0 p-2">
									Approved
								</th>
							</tr>
							<tr>
								<th>
									Week Commencing
								</th>
								<td>
									12/01/2025
								</td>
							</tr>
						</thead>
						<tbody>
							<tr>
								<th>
									Available for Approval
								</th>
								<td>
									<span data-bind="text: formatCurrency(10000, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
							<tr>
								<th>
									Target Spend
								</th>
								<td>
									<span data-bind="text: formatCurrency(5000, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
							<tr>
								<th>
									Spent
								</th>
								<td>
									<span data-bind="text: formatCurrency(6800, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
							<tr>
								<th>
									Remaining
								</th>
								<td>
									<span data-bind="text: formatCurrency(3200, 2, 'en-GB', 'GBP')"></span>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</main>
</div>