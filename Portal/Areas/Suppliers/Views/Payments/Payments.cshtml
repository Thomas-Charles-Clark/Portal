@model Portal.Areas.Suppliers.ViewModels.SupplierPaymentsViewModel
@{
	ViewBag.Title = "Supplier Payments";
}
@section styles {
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/supplier-payments")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/supplier-payments")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	@if (Model.UserMayAdministrate)
	{
		<style type="text/css">
			#tabs-container #tabs-list .mdc-select .k-input-inner {
				padding-right: 82px;
			}
		</style>
	}

	<script type="text/javascript">
		window.getDashboard = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.Dashboard.Records));
		}
		window.getCanUserAdministrate = () => {
			return @Html.Raw($"{Model.UserMayAdministrate}".ToLowerInvariant());
		}
	</script>

	<script type="text/javascript">

		var viewModel = supplierPaymentsViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		window.self = viewModel;

		if (getUserId() != 8) {
			addEventListener('beforeunload', (event) => {
				if (viewModel.requests.paymentPlanGridWidget().dataSource.hasChanges() ||
					viewModel.requests.otherStatusesGridWidget().dataSource.hasChanges() ||
					viewModel.approvals.gridWidget().dataSource.hasChanges()) {
					event.preventDefault();
				}
				return false;
			})
		}

		viewModel.ready(true);

	</script>

	<script type="text/html" id="approval-item-row">
		<tr>
			<td>
				<div data-bind="html: supplierLabel"></div>
			</td>
			<td>
				<div class="converting-component-wrapper" data-bind="component: { name: 'conversion-control', params: amountParams }"></div>
			</td>
			<td>
				<div class="form-control requester-comments" data-bind="html: RequesterComments"></div>
			</td>
			<td>
				@*<div class="converting-component-wrapper" data-bind="component: { name: 'conversion-control', params: approvedAmountInCurrencyParams }"></div>*@
			</td>
			<td>
				@*<div data-bind="component: { name: 'mdc-text-area-component', params: deciderCommentsParams }"></div>*@
			</td>
			<td>
				<button type="button" class="btn btn-secondary">
					<i class="bi bi-x-lg" data-bind="click: $parent.removeBasketItem"></i>
				</button>
			</td>
		</tr>
	</script>

	<script type="text/html" id="conversion-control">
		<div class="converting-component">
			<div data-bind="component: { name: 'mdc-text-field-numeric-component', params: inputParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: forexParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: convertedParams }"></div>
		</div>
	</script>

	<script type="text/javascript">
		ko.components.register('conversion-control', {
			template: { element: document.getElementById('conversion-control') }
		});
	</script>
}
@section modals {
	<div class="modal fade breakdown-modal" id="-modal" tabindex="-1">
		<div class="modal-dialog modal-lg modal-xl" id="n-modal-dialog">
			<div class="modal-content">
				<div class="blocker" data-bind="flexFadeVisible: busy">
					<div class="loading-spinner"></div>
					<h4>
						Please Wait...
					</h4>
				</div>
				<div class="modal-header grey-blue">
					<h4 class="modal-title">
						Title
					</h4>
					<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body" data-bind="with: $data">

				</div>
			</div>
		</div>
	</div>
}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div id="supplier-payments-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top show">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: filters.togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: filters.countDisplay"></label>
			</div>
			<div id="sidebar-collapse" class="sidebar-body">
				<form id="sidebar-prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Suppliers
						</h5>
					</div>
					<div class="prefilter-group">
						@*<h5 class="sidebar-heading">
								Sales Analysis
							</h5>*@
						@*<div id="sales-history-analysis-period-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesHistoryAnalysisPeriodsParams }"></div>
							<div id="invoice-company-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: invoiceCompanyParams }"></div>*@
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: filters.reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
	<main id="supplier-payments-main" class="d-none" data-bind="flexFadeVisible: true">
		<div class="card align-self-start">
			<div class="card-body">
				<div id="prefilters" data-bind="with: filters">
					<div class="d-flex gap-3 align-items-center mb-3">
						<div class="prefilter d-flex align-items-center gap-3">
							<label class="form-label m-0">
								Week Commencing:
							</label>
							@*<div class="date-prefilter" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: weekCommencingDateParams }"></div>*@
							<div id="payment-period-prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: paymentPeriodParams }"></div>
						</div>
					</div>
				</div>
				<div id="totals" data-bind="with: dashboard">
					<table id="totals-table" class="table table-bordered mb-0">
						<colgroup>
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
						</colgroup>
						<thead>
							<tr>
								<th>
									Currency
								</th>
								<th>
									Overdue Supplier Invoices
								</th>
								<th>
									Budget
								</th>
								<th>
									Requests Total
								</th>
								<th>
									Payment Plans
								</th>
								<th>
									Approved
								</th>
								<th>
									Declined
								</th>
								<th>
									GBP FX Rate
								</th>
							</tr>
						</thead>
						<tbody data-bind="foreach: rows">
							<tr>
								<td>
									<span data-bind="text: RowLabel"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: OverdueSupplierInvoiceTotal ? formatCurrency(OverdueSupplierInvoiceTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: formatCurrency(Budget, 2, CurrencyFormattingCulture, CurrencyCode)"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: PaymentRequestTotal ? formatCurrency(PaymentRequestTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: PaymentRequestPaymentPlanTotal ? formatCurrency(PaymentRequestPaymentPlanTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: PendingApprovalTotal ? formatCurrency(PendingApprovalTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: ApprovedTotal ? formatCurrency(ApprovedTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: formatNumber(GBPFXRate, 4, 'en-GB')"></span>
								</td>
							</tr>
						</tbody>
						<tbody>
							<tr class="dashboard-total-row" data-bind="with: totalRow">
								<th>
									<span data-bind="text: RowLabel"></span>
								</th>
								<td class="text-end">
									<span data-bind="text: OverdueSupplierInvoiceTotal ? formatCurrency(OverdueSupplierInvoiceTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: formatCurrency(Budget, 2, CurrencyFormattingCulture, CurrencyCode)"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: PaymentRequestTotal ? formatCurrency(PaymentRequestTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: PaymentRequestPaymentPlanTotal ? formatCurrency(PaymentRequestPaymentPlanTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: PendingApprovalTotal ? formatCurrency(PendingApprovalTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
									<span data-bind="text: ApprovedTotal ? formatCurrency(ApprovedTotal, 2, CurrencyFormattingCulture, CurrencyCode) : ''"></span>
								</td>
								<td class="text-end">
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div id="tabs-container" class="card">
			<div class="card-body">
				<ul class="nav nav-pills" id="tabs-list" role="tablist">
					<li class="nav-item" role="presentation">
						<button class="nav-link @(Model.UserMayAdministrate ? "" : "active")" id="payment-requests-tab-btn" data-bs-toggle="tab" data-bs-target="#payment-requests-tab-pane" type="button" role="tab" aria-controls="payment-requests-tab" aria-selected="true">
							Payment Requests
						</button>
					</li>
					<li class="nav-item relative" role="presentation" id="user-selector" data-bind="with: filters">
						<div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: userSelectorParams }"></div>
					</li>
					@if (Model.UserMayAdministrate)
					{
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="budget-tab-btn" data-bs-toggle="tab" data-bs-target="#budget-tab-pane" type="button" role="tab" aria-controls="budget-tab-pane" aria-selected="false">
								Budget
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="approvals-tab-btn" data-bs-toggle="tab" data-bs-target="#approvals-tab-pane" type="button" role="tab" aria-controls="approvals-tab-pane" aria-selected="false">
								Approval
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="history-summary-tab-btn" data-bs-toggle="tab" data-bs-target="#history-summary-tab-pane" type="button" role="tab" aria-controls="history-summary-tab-pane" aria-selected="false">
								History Summary
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="history-detail-tab-btn" data-bs-toggle="tab" data-bs-target="#history-detail-tab-pane" type="button" role="tab" aria-controls="history-detail-tab-pane" aria-selected="false">
								History Details
							</button>
						</li>
					}
				</ul>
			</div>
		</div>
		<div id="notes-container" class="card d-none">
			<div class="card-body">
				<p>
					This is now an amalgamation of requests and approvals back into one single destination. We must have the various functionalities siloed for various roles. Doesn't have to be Fort Knox: just having client side control over visibility of functional components of the whole is sufficient.
				</p>
				<p>
					Should request rows be editable by any requester? At the moment that is the case. Might we perhaps need to restrict editing - or even viewing - to only those requests which the currently-viewing user has created? That would seem to make sense, but then... possibly not. Might be the case that departments <i>should</i> see what other departments are requesting.
				</p>
				<p>
					A further argument against having the approvals information displayed here: interdepartmental rivalry: "Why do Product Development always get their payments made in a timely fashion but Facilities don't?" sort of thing.
				</p>
				<p>
					Experiment with background &amp; foreground colouring for one of the grids - probably Payment Plans, as it's the more important...? Colouring just the card elements, not the grids within them.
				</p>
			</div>
		</div>
		<div class="tab-content">
			<div id="payment-requests-tab-pane" class="tab-pane fade">
				<div class="card mb-3" data-bind="with: requests">
					<div class="card-body">
						<h4 class="my-0">
							Payment Plans
						</h4>
						<div style="display: none" class="supplier-payments-grid-container payment-plans mt-3 z-2"
							 data-bind="visible: true, kendoGrid: paymentPlanGridParams"></div>
					</div>
				</div>
				<div class="card" data-bind="with: requests">
					<div class="card-body">
						<h4 class="my-0">
							Other Payments
						</h4>
						<div style="display: none" class="supplier-payments-grid-container other-statuses mt-3 z-1"
							 data-bind="visible: true, kendoGrid: otherPaymentRequestStatusesGridParams"></div>
					</div>
				</div>
			</div>
			<div id="budget-tab-pane" class="tab-pane fade">
				<div class="card" data-bind="with: budgets">
					<div class="card-body">
						<h4 class="mb-0">
							Budget
						</h4>
						<div style="display: none" class="supplier-payments-grid-container budget-grid mt-3 z-1" data-bind="visible: true, kendoGrid: gridParams"></div>
						<p class="mt-3 mb-0 notes">
							Still need to ensure you can't create more than one budget entry per currency per period. How? Exactly.
						</p>
					</div>
				</div>
			</div>
			<div id="approvals-tab-pane" class="tab-pane fade">
				<div class="card">
					<div class="card-body">
						<div class="d-flex align-items-center gap-3" data-bind="with: filters">
							<h4 class="my-0">
								Approvals
							</h4>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyIncludeSuppliersWithPaymentRequestsParams }"></div>
							</div>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyShowSuppliersWithOutstandingInvoicesParams }"></div>
							</div>
						</div>
						<div style="display: none" class="supplier-payments-grid-container mt-3 z-1"
							 data-bind="visible: true, kendoGrid: approvals.gridParams"></div>
					</div>
				</div>
			</div>
			<div id="history-summary-tab-pane" class="tab-pane fade">
				<div class="card">
					<div class="card-body">
						<h4 class="mb-0">
							History Summary
						</h4>
					</div>
				</div>
			</div>
			<div id="history-detail-tab-pane" class="tab-pane fade show active">
				<div class="card">
					<div class="card-body">
						<h4 class="mb-0">
							History Details
						</h4>
						<div style="display: none" class="supplier-payments-grid-container mt-3 z-1"
							 data-bind="visible: true, kendoGrid: historyDetails.gridParams"></div>
					</div>
				</div>
			</div>
		</div>
	</main>
</div>

@if (Model.UserMayAdministrate)
{
	<sidebar id="basket-sidebar" class="collapse collapse-horizontal sidebar fixed-bottom show">
		<div class="sidebar-inner" data-bind="with: approvals">
			<div class="sidebar-header">
				<h5 class="sidebar-heading" data-bind="click: basket.togglePinning">
					<i class="bi bi-basket"></i>
					<span>
						Approvals Basket
						<label class="count" data-bind="html: basket.countDisplay"></label>
					</span>
					<button type="button" class="btn btn-light basket-toggle-btn" title="Toggle Pinning">
						<i class="bi bi-pin-angle-fill fs-5"></i>
					</button>
				</h5>
				<div class="d-flex justify-content-center gap-3">
					<button type="button" class="btn btn-secondary gap-3" data-bind="enable: basket.canClearBasket, click: basket.clear, clickBubble: false">
						Empty Basket
						<i class="bi bi-arrow-counterclockwise"></i>
					</button>
				</div>
			</div>
			<div id="basket-collapse" class="sidebar-body">
				<form id="basket" data-bind="with: basket" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div id="approval-basket-contents" style="display: none" data-bind="flexFadeVisible: items().length > 0">
						<table id="payment-plans" class="table">
							<colgroup>
								<col />
								<col />
								<col />
								<col />
								<col />
								<col />
							</colgroup>
							<thead>
								<tr>
									<th colspan="6">
										<h4 class="mb-0">
											Payment Plans
										</h4>
									</th>
								</tr>
								<tr>
									<th>
										Supplier
									</th>
									<th>
										Amount Requested
									</th>
									<th>
										Requester Comments
									</th>
									<th>
										Amount Approved
									</th>
									<th>
										Approval Comments
									</th>
									<th></th>
								</tr>
							</thead>
							<tbody data-bind="foreach: paymentPlans">
								<!-- ko template: { name: 'approval-item-row', data: $data } --><!-- /ko -->
							</tbody>
						</table>
						<table id="other-payments" class="table">
							<colgroup>
								<col />
								<col />
								<col />
								<col />
								<col />
								<col />
							</colgroup>
							<thead>
								<tr>
									<th colspan="6">
										<h4 class="mb-0">
											Other Payments
										</h4>
									</th>
								</tr>
								<tr>
									<th>
										Supplier
									</th>
									<th>
										Amount Requested
									</th>
									<th>
										Requester Comments
									</th>
									<th>
										Amount Approved
									</th>
									<th>
										Approval Comments
									</th>
									<th></th>
								</tr>
							</thead>
							<tbody data-bind="foreach: otherPayments">
								<!-- ko template: { name: 'approval-item-row', data: $data } --><!-- /ko -->
							</tbody>
						</table>
					</div>
				</form>
			</div>
		</div>
	</sidebar>
}