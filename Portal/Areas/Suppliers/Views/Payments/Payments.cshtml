@model Portal.Areas.Suppliers.ViewModels.SupplierPaymentsViewModel
@{
	ViewBag.Title = "Supplier Payments";
}
@section styles {
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/supplier-payments")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/supplier-payments")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	@if (Model.UserMayAdministrate)
	{
		<style type="text/css">
			#tabs-container #tabs-list .mdc-select .k-input-inner {
				padding-right: 82px;
			}
		</style>
	}

	<script type="text/javascript">
		window.getDashboardRecords = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.Dashboard.Records));
		}
		window.getDashboardPeriodMessage = () => {
			return @Html.Raw(JsonConvert.SerializeObject(Model.Dashboard.PeriodMessage));
		}
		window.getCanUserAdministrate = () => {
			return @Html.Raw($"{Model.UserMayAdministrate}".ToLowerInvariant());
		}
	</script>

	<script type="text/javascript">

		var viewModel = supplierPaymentsViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		window.self = viewModel;

		if (getUserId() != 8) {
			addEventListener('beforeunload', (event) => {
				if (viewModel.requests.paymentPlanGridWidget().dataSource.hasChanges() ||
					viewModel.requests.otherStatusesGridWidget().dataSource.hasChanges() ||
					viewModel.approvals.gridWidget().dataSource.hasChanges()) {
					event.preventDefault();
				}
				return false;
			})
		}

		document.querySelectorAll("button.nav-link").forEach(b => {
			b.addEventListener('show.bs.tab', (e) => {
				if (e.target.id === 'approvals-tab-btn') {
					document.querySelector('#basket-sidebar').classList.add('show');
				} else {
					document.querySelector('#basket-sidebar').classList.remove('show');
				}
			})
		});

		viewModel.ready(true);

	</script>

	<script type="text/html" id="conversion-control">
		<div class="converting-component">
			<div data-bind="highlightNullField: highlightOnNull, component: { name: 'mdc-text-field-numeric-component', params: inputParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: forexParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: convertedParams }"></div>
		</div>
	</script>

	<script type="text/javascript">
		ko.components.register('conversion-control', {
			template: { element: document.getElementById('conversion-control') }
		});
	</script>

	<script type="text/html" id="approval-item-row">
		<tr>
			<td>
				<div data-bind="html: supplierLabel"></div>
			</td>
			<td>
				<div class="converting-component-wrapper" data-bind="component: { name: 'conversion-control', params: amountParams }"></div>
			</td>
			<td>
				<!-- ko if: RequesterComments -->
				<div class="form-control requester-comments" data-bind="html: RequesterComments"></div>
				<!-- /ko -->
			</td>
			<td>
				@*<div class="converting-component-wrapper" data-bind="component: { name: 'conversion-control', params: approvedAmountInCurrencyParams }"></div>*@
			</td>
			<td>
				<div data-bind="component: { name: 'mdc-text-area-component', params: deciderCommentsParams }"></div>
			</td>
			<td>
				<button type="button" class="btn btn-secondary">
					<i class="bi bi-x-lg" data-bind="click: $parent.removeBasketItem"></i>
				</button>
			</td>
		</tr>
	</script>
}
@section modals {
	<div class="modal fade" id="new-request-modal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
		<div class="modal-dialog" id="new-request-modal-dialog">
			<div class="modal-content" data-bind="with: requests">
				<div class="blocker" data-bind="flexFadeVisible: busy">
					<div class="loading-spinner"></div>
					<h4>
						Please Wait...
					</h4>
				</div>
				<div class="modal-header grey-blue" data-bind="with: newRequest">
					<h4 class="modal-title">
						New Payment Request
					</h4>
				</div>
				<div class="modal-body" data-bind="with: newRequest">
					<div class="properties-container">
						<div class="mb-3" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: paymentRequestStatusParams }"></div>
						<div class="d-flex justify-content-end align-items-center gap-3 mb-3">
							<label class="mb-0">
								Payment Due
							</label>
							<div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: paymentDueDateParams }"></div>
						</div>
						<div class="mb-3" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: supplierParams }"></div>
						<div class="d-flex justify-content-end align-items-center gap-3 mb-3">
							<label class="mb-0">
								Amount
								<!-- ko if: supplier() -->
								<span data-bind="text: supplier().Currency.Symbol, css: { 'open-sans-inflated-dollar-glyph': supplier().Currency.Symbol == '$' }"></span>
								<!-- /ko -->
							</label>
							<div data-bind="component: { name: 'mdc-text-field-numeric-component', params: amountInCurrencyParams }"></div>
						</div>
						<div class="mb-3">
							<div data-bind="component: { name: 'mdc-kendo-multiselect-component', params: purchaseOrderIdsParams }"></div>
						</div>
						<div class="mb-3">
							<div data-bind="component: { name: 'mdc-text-field-component', params: proformaNumberParams }"></div>
						</div>
						<div>
							<div data-bind="component: { name: 'mdc-text-area-component', params: requesterCommentsParams }"></div>
						</div>
					</div>
				</div>
				<div class="modal-footer d-flex align-items-center justify-contents-end">
					<button class="btn btn-secondary" data-bind="click: closeNewRequestModal">
						Cancel
					</button>
					<button class="btn btn-primary" data-bind="click: saveNewRequestModal">
						Save
					</button>
				</div>
			</div>
		</div>
	</div>
}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<div id="supplier-payments-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top show">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: filters.togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: filters.countDisplay"></label>
			</div>
			<div id="sidebar-collapse" class="sidebar-body">
				<form id="sidebar-prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Suppliers
						</h5>
					</div>
					<div class="prefilter-group">
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: filters.reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
	<main id="supplier-payments-main" class="d-none" data-bind="flexFadeVisible: true">
		<div class="card align-self-start">
			<div class="blocker" data-bind="flexFadeVisible: dashboard.busy">
				<div class="loading-spinner"></div>
				<h4 class="mt-3" data-bind="text: busyMessage"></h4>
			</div>
			<div class="card-body">
				<div id="prefilters" data-bind="with: filters">
					<div class="d-flex gap-3 align-items-center mb-3">
						<div class="prefilter d-flex align-items-center gap-3">
							<div id="payment-period-prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: paymentPeriodParams }"></div>
							<!-- ko if: paymentPeriod() -->
							<div class="period-message m-0" data-bind="html: $parent.dashboard.periodMessage"></div>
							<!-- /ko -->
						</div>
					</div>
				</div>
				<div id="totals" data-bind="with: dashboard">
					<table id="totals-table" class="table table-bordered mb-0">
						<colgroup>
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
							<col />
						</colgroup>
						<thead>
							<tr>
								<th>
									Currency
								</th>
								<th>
									Suppler Invoices Total
								</th>
								<th>
									Overdue Supplier Invoices
								</th>
								<th>
									Requests Total
								</th>
								<th>
									Payment Plans
								</th>
								<th>
									Gone Legal
								</th>
								<th>
									Budget
								</th>
								<th>
									<!-- ko ifnot: ($parent.filters.paymentPeriod() && $parent.filters.paymentPeriod().Finalised) -->
									<span>
										Approved to Pay
									</span>
									<!-- /ko -->
									<!-- ko if: ($parent.filters.paymentPeriod() && $parent.filters.paymentPeriod().Finalised) -->
									<span>
										Approved
									</span>
									<!-- /ko -->
								</th>
								<!-- ko ifnot: ($parent.filters.paymentPeriod() && $parent.filters.paymentPeriod().Finalised) -->
								<th>
									Balance
								</th>
								<!-- /ko -->
								<th>
									GBP FX Rate
								</th>
							</tr>
						</thead>
						<tbody data-bind="foreach: rows">
							<tr>
								<td>
									<span data-bind="text: RowLabel"></span>
								</td>
								<td>
									<span data-bind="html: SupplierInvoiceTotal ? formatCurrency(SupplierInvoiceTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</td>
								<td>
									<span data-bind="html: OverdueSupplierInvoiceTotal ? formatCurrency(OverdueSupplierInvoiceTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</td>
								<td>
									<span data-bind="html: PaymentRequestTotal ? formatCurrency(PaymentRequestTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</td>
								<td>
									<span data-bind="html: PaymentRequestPaymentPlanTotal ? formatCurrency(PaymentRequestPaymentPlanTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</td>
								<td>
									<span data-bind="html: PaymentRequestGoneLegalTotal ? formatCurrency(PaymentRequestGoneLegalTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</td>
								<td>
									<span data-bind="html: formatCurrency(Budget, 2, CurrencyFormattingCulture, CurrencyCode, true)"></span>
								</td>
								<td>
									<!-- ko ifnot: ($parentContext.$parent.filters.paymentPeriod() && $parentContext.$parent.filters.paymentPeriod().Finalised) -->
									<span data-bind="html: PendingApprovalTotal ? formatCurrency(PendingApprovalTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
									<!-- /ko -->
									<!-- ko if: ($parentContext.$parent.filters.paymentPeriod() && $parentContext.$parent.filters.paymentPeriod().Finalised) -->
									<span data-bind="html: ApprovedTotal ? formatCurrency(ApprovedTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
									<!-- /ko -->
								</td>
								<!-- ko ifnot: ($parent.filters.paymentPeriod() && $parent.filters.paymentPeriod().Finalised) -->
								<td>
									<span data-bind="css: { 'text-danger': PendingApprovalBalance < 0 }, html: formatCurrency(PendingApprovalBalance, 2, CurrencyFormattingCulture, CurrencyCode, true)"></span>
								</td>
								<!-- /ko -->
								<td>
									<span data-bind="text: formatNumber(GBPFXRate, 4, 'en-GB')"></span>
								</td>
							</tr>
						</tbody>
						<tbody>
							<tr class="dashboard-total-row" data-bind="with: totalRow">
								<th>
									<span data-bind="text: RowLabel"></span>
								</th>
								<th>
									<span data-bind="html: SupplierInvoiceTotal ? formatCurrency(SupplierInvoiceTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</th>
								<th>
									<span data-bind="html: OverdueSupplierInvoiceTotal ? formatCurrency(OverdueSupplierInvoiceTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</th>
								<th>
									<span data-bind="html: PaymentRequestTotal ? formatCurrency(PaymentRequestTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</th>
								<th>
									<span data-bind="html: PaymentRequestPaymentPlanTotal ? formatCurrency(PaymentRequestPaymentPlanTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</th>
								<th>
									<span data-bind="html: PaymentRequestGoneLegalTotal ? formatCurrency(PaymentRequestGoneLegalTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
								</th>
								<th>
									<span data-bind="html: formatCurrency(Budget, 2, CurrencyFormattingCulture, CurrencyCode, true)"></span>
								</th>
								<th>
									<!-- ko ifnot: ($parentContext.$parent.filters.paymentPeriod() && $parentContext.$parent.filters.paymentPeriod().Finalised) -->
									<span data-bind="html: PendingApprovalTotal ? formatCurrency(PendingApprovalTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
									<!-- /ko -->
									<!-- ko if: ($parentContext.$parent.filters.paymentPeriod() && $parentContext.$parent.filters.paymentPeriod().Finalised) -->
									<span data-bind="html: ApprovedTotal ? formatCurrency(ApprovedTotal, 2, CurrencyFormattingCulture, CurrencyCode, true) : ''"></span>
									<!-- /ko -->
								</th>
								<!-- ko ifnot: ($parent.filters.paymentPeriod() && $parent.filters.paymentPeriod().Finalised) -->
								<th>
									<span data-bind="css: { 'text-danger': PendingApprovalBalance < 0 }, html: formatCurrency(PendingApprovalBalance, 2, CurrencyFormattingCulture, CurrencyCode, true)"></span>
								</th>
								<!-- /ko -->
								<td>
									<small>GBP Totals calculated with latest FX rates above</small>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div id="tabs-container" class="card">
			<div class="card-body">
				<ul class="nav nav-pills" id="tabs-list" role="tablist">
					<li class="nav-item" role="presentation">
						<button class="nav-link active" id="payment-requests-tab-btn" data-bs-toggle="tab" data-bs-target="#payment-requests-tab-pane" type="button" role="tab" aria-controls="payment-requests-tab" aria-selected="true">
							Payment Requests
						</button>
					</li>
					<li class="nav-item" role="presentation">
						<button class="nav-link" id="suppliers-tab-btn" data-bs-toggle="tab" data-bs-target="#suppliers-tab-pane" type="button" role="tab" aria-controls="suppliers-tab" aria-selected="true">
							Suppliers
						</button>
					</li>
					@if (Model.UserMayAdministrate)
					{
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="budget-tab-btn" data-bs-toggle="tab" data-bs-target="#budget-tab-pane" type="button" role="tab" aria-controls="budget-tab-pane" aria-selected="false">
								Budget
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="approvals-tab-btn" data-bs-toggle="tab" data-bs-target="#approvals-tab-pane" type="button" role="tab" aria-controls="approvals-tab-pane" aria-selected="false">
								Approval
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="history-summary-tab-btn" data-bs-toggle="tab" data-bs-target="#history-summary-tab-pane" type="button" role="tab" aria-controls="history-summary-tab-pane" aria-selected="false">
								History Summary
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="history-detail-tab-btn" data-bs-toggle="tab" data-bs-target="#history-detail-tab-pane" type="button" role="tab" aria-controls="history-detail-tab-pane" aria-selected="false">
								History Details
							</button>
						</li>
					}
				</ul>
			</div>
		</div>
		<div class="tab-content">
			<div id="payment-requests-tab-pane" class="tab-pane fade active show">
				<div class="card mb-3">
					<div class="card-body" data-bind="with: filters">
						<div class="prefilters">
							<div class="prefilter user-selector-prefilter relative" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: userSelectorParams }"></div>
							<div id="payment-request-status-prefilter" class="prefilter relative" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: paymentRequestStatusParams }"></div>
						</div>
					</div>
				</div>
				<div class="card mb-3" data-bind="with: requests">
					<div class="blocker" data-bind="flexFadeVisible: busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: busyMessage"></h4>
					</div>
					<div class="card-body">
						<div style="display: none" class="supplier-payments-grid-container payment-requests z-2"
							 data-bind="visible: true, kendoGrid: gridParams"></div>
					</div>
				</div>
			</div>
			<div id="suppliers-tab-pane" class="tab-pane fade">
				<div class="card">
					<div class="blocker" data-bind="flexFadeVisible: suppliers.busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: suppliers.busyMessage"></h4>
					</div>
					<div class="card-body">
						<div class="d-flex align-items-center gap-3 prefilters" data-bind="with: filters">
							<div class="prefilter user-selector-prefilter relative" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: userSelectorParams }"></div>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyIncludeSuppliersWhereProductionStoppedParams }"></div>
							</div>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyIncludeSuppliersWhereShippingStoppedParams }"></div>
							</div>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyIncludeSuppliersWhereGoodsAreHeldParams }"></div>
							</div>
							<button class="btn btn-dark btn-export ms-auto" data-bind="click: $parent.suppliers.exportToExcel">
								Export to Excel
								<i class="bi bi-download"></i>
								<i class="bi bi-filetype-xlsx"></i>
							</button>
						</div>
						<div style="display: none" class="supplier-payments-grid-container suppliers-grid z-1"
							 data-bind="visible: true, kendoGrid: suppliers.gridParams"></div>
					</div>
				</div>
			</div>
			<div id="budget-tab-pane" class="tab-pane fade">
				<div class="card" data-bind="with: budgets">
					<div class="blocker" data-bind="flexFadeVisible: busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: busyMessage"></h4>
					</div>
					<div class="card-body">
						<div style="display: none" class="supplier-payments-grid-container budget-grid z-1" data-bind="visible: true, kendoGrid: gridParams"></div>
					</div>
				</div>
			</div>
			<div id="approvals-tab-pane" class="tab-pane fade">
				<div class="card">
					<div class="blocker" data-bind="flexFadeVisible: approvals.busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: approvals.busyMessage"></h4>
					</div>
					<div class="card-body">
						<div class="d-flex align-items-center gap-3 prefilters" data-bind="with: filters">
							<div class="prefilter">
								<div id="payment-request-database-status-prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: paymentRequestDatabaseStatusParams }"></div>
							</div>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyIncludeSuppliersWithPaymentRequestsParams }"></div>
							</div>
							<div class="prefilter">
								<div data-bind="component: { name: 'mdc-checkbox-component', params: onlyShowSuppliersWithOutstandingInvoicesParams }"></div>
							</div>
							<button class="btn btn-dark btn-export ms-auto" data-bind="click: $parent.approvals.exportToExcel">
								Export to Excel
								<i class="bi bi-download"></i>
								<i class="bi bi-filetype-xlsx"></i>
							</button>
						</div>
						<div style="display: none" class="supplier-payments-grid-container z-1"
							 data-bind="visible: true, kendoGrid: approvals.gridParams"></div>
					</div>
				</div>
			</div>
			<div id="history-summary-tab-pane" class="tab-pane fade">
				<div class="card" data-bind="with: historySummary">
					<div class="blocker" data-bind="flexFadeVisible: busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: busyMessage"></h4>
					</div>
					<div class="card-body">
						<h4 class="d-flex justify-content-end align-items-center">
							<button class="btn btn-dark btn-export" data-bind="click: exportToExcel">
								Export to Excel
								<i class="bi bi-download"></i>
								<i class="bi bi-filetype-xlsx"></i>
							</button>
						</h4>
						<div style="display: none" class="supplier-payments-grid-container z-1"
							 data-bind="visible: true, kendoGrid: gridParams"></div>
					</div>
				</div>
			</div>
			<div id="history-detail-tab-pane" class="tab-pane fade">
				<div class="card" data-bind="with: historyDetails">
					<div class="blocker" data-bind="flexFadeVisible: busy">
						<div class="loading-spinner"></div>
						<h4 class="mt-3" data-bind="text: busyMessage"></h4>
					</div>
					<div class="card-body">
						<h4 class="d-flex justify-content-end align-items-center">
							<button class="btn btn-dark btn-export" data-bind="click: exportToExcel">
								Export to Excel
								<i class="bi bi-download"></i>
								<i class="bi bi-filetype-xlsx"></i>
							</button>
						</h4>
