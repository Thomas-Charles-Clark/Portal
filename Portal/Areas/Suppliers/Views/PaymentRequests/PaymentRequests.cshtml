@model Portal.Areas.Suppliers.ViewModels.SupplierPaymentRequestViewModel
@{
	ViewBag.Title = "Supplier Payment Requests";
}
@section styles {
	@Styles.Render("~/bundles/css/kendo-custom")
	@Styles.Render("~/bundles/css/generic-forms")
	@Styles.Render("~/bundles/css/supplier-payment-requests")
	@Styles.Render("~/bundles/css/tempus-dominus")
	@Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
	@Scripts.Render("~/bundles/js/jqueryui")
	@Scripts.Render("~/bundles/js/datetime-picker")
	@Scripts.Render("~/bundles/js/generic-forms")
	@Scripts.Render("~/bundles/js/credit-control")
	@Scripts.Render("~/bundles/js/supplier-payment-requests")
	@Scripts.Render("~/bundles/js/tempus-dominus")

	<script type="text/javascript">

		var viewModel = supplierPaymentRequestsViewModel();

		var vm = viewModel;

		ko.options.deferUpdates = true;

		ko.validation.init({
			decorateInputElement: true,
			errorElementClass: 'alert-danger',
			errorMessageClass: 'validation-message text-danger'
		});

		ko.applyBindings(viewModel, document.body);

		window.self = viewModel;

	</script>

	<script type="text/html" id="conversion-control">
		<div class="converting-component">
			<div data-bind="highlightNullField: highlightOnNull, component: { name: 'mdc-text-field-numeric-component', params: inputParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: forexParams }"></div>
			<div data-bind="component: { name: 'mdc-text-field-component', params: convertedParams }"></div>
		</div>
	</script>

	<script type="text/javascript">
		ko.components.register('conversion-control', {
			template: { element: document.getElementById('conversion-control') }
		});
	</script>
}
@section modals {

}
@section navbarTitle {
	<h2 class="d-flex gap-3 align-items-center">
		<span>
			@(ViewBag.Title)
		</span>
	</h2>
}

<script type="text/html" id="grid-row-template">
	<tr>
		<td>
			<span data-bind="text: moment(CreatedDT).format('DD/MM/YYYY HH:mm')"></span>
		</td>
		<td>
			<span data-bind="text: `${Currency.Symbol}` - ${Currency.Code}`"></span>
		</td>
		<td>
			<span data-bind="text: `${Supplier.Code} - ${Supplier.Name}`"></span>
		</td>
		<td>
			<span data-bind="text: PaymentRequestStatus.Name"></span>
		</td>
		<td>
			<span data-bind="text: RequestedByMember.FullName"></span>
		</td>
		<td class="purchase-orders">
			<span data-bind="html: purchaseOrdersLabel, actualBootstrapPopover: { details: bootstrapPopoverDetails }"></span>
			@*<div class="cell shipped" data-bind="actualBootstrapPopover: { details: bootstrapPopoverDetails }, event: { keydown: keydown }" tabindex="0"></div>*@
		</td>
		<td>
			<span data-bind="text: ProformaNumber"></span>
		</td>
		<td>
			<div data-bind="component: { name: 'conversion-control', params: amountParams }"></div>
		</td>
		<td>
			<span data-bind="html: Comments"></span>
		</td>
	</tr>
</script>

<div class="blocker" data-bind="flexFadeVisible: busy">
	<div class="loading-spinner"></div>
	<h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div class="modal fade breakdown-modal" id="-modal" tabindex="-1">
	<div class="modal-dialog modal-lg modal-xl" id="n-modal-dialog">
		<div class="modal-content">
			<div class="blocker" data-bind="flexFadeVisible: busy">
				<div class="loading-spinner"></div>
				<h4>
					Please Wait...
				</h4>
			</div>
			<div class="modal-header grey-blue">
				<h4 class="modal-title">
					Title
				</h4>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" data-bind="with: $data">

			</div>
		</div>
	</div>
</div>

<div id="main-supplier-payments-container" class="d-flex align-items-start w-100 opacity-100" data-bind="flexFadeVisible: true">
	<sidebar id="filters-sidebar" class="collapse collapse-horizontal sidebar sticky-top">
		<div class="sidebar-inner">
			<div class="sidebar-header" data-bind="click: filters.togglePinning">
				<button type="button" class="btn btn-light" title="Toggle Pinning">
					<i class="bi bi-pin-angle-fill fs-5"></i>
				</button>
				<label class="filters-count" data-bind="html: filters.countDisplay"></label>
			</div>
			<div id="sidebar-collapse" class="sidebar-body">
				<form id="prefilters" data-bind="with: filters" action="javascript:void(0);" autocomplete="off" onsubmit="return false;">
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Suppliers
						</h5>
					</div>
					<div class="prefilter-group">
						<h5 class="sidebar-heading">
							Sales Analysis
						</h5>
						@*<div id="sales-history-analysis-period-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesHistoryAnalysisPeriodsParams }"></div>
							<div id="invoice-company-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: invoiceCompanyParams }"></div>*@
					</div>
				</form>
				<button type="button" class="btn btn-secondary gap-3 mt-5" data-bind="click: filters.reset">
					Reset Filters
					<i class="bi bi-arrow-counterclockwise"></i>
				</button>
			</div>
		</div>
	</sidebar>
	<main id="supplier-payment-requests-main">
		@*<div class="dashboard" style="display: none" data-bind="visible: dashboardPods().length, foreach: dashboardPods">
				<div class="dashboard-pod card" data-bind="css: { 'selected-pod': $parent.selectedPod() == $data }">
					<div class="card-body" data-bind="class: Classes">
						<h4 data-bind="html: Heading"></h4>
						<div data-bind="html: Stats"></div>
						<a href="#" class="stretched-link" data-bind="click: $parent.dashboardClick"></a>
					</div>
				</div>
			</div>
			<div id="selected-filter-pills">
				<!-- ko template: { name: 'filter-pills-template', data: filters } --><!-- /ko -->
				<div class="dropdown ms-3" style="display: none" data-bind="visible: true">
					<a class="btn btn-secondary dropdown-toggle no-ripple" href="#" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" data-bind="click: $root.hideValueDropdowns, clickBubble: false">
						<i class="bi bi-list-check"></i>
					</a>
					<!-- ko template: { name: 'credit-control-quantity-value-dropdown-container', data: filters } --><!-- /ko -->
				</div>
			</div>*@
		<div id="supplier-payment-requests-grid-container" data-bind="kendoGrid: gridParams"></div>
	</main>
</div>

