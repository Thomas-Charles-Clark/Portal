@model Downloads.ViewModels.DownloadProductsViewModel
@{
    ViewBag.Title = $"{Model.ApplicationSubHeading} - Designers Guild Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/download-products")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/download-products")

    <script type="text/javascript">
        function getResource(name) {
            switch (name) {
                case 'PrimaryImage':
                    return '@Html.Raw(DownloadsText.PrimaryImage)';
                    break;
                case 'Heading':
                    return '@Html.Raw(DownloadsText.Heading)';
                    break;
                case 'Description':
                    return '@Html.Raw(DownloadsText.Description)';
                    break;
                case 'SecondaryImages':
                    return '@Html.Raw(DownloadsText.SecondaryImages)';
                    break;
                case 'BasketEmpty':
                    return '@Html.Raw(DownloadsText.EmptyBasket)';
                    break;
            }
        }

        function getSortOptions() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.SortOptions));
        }

        function getTradeAccount() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedTradeAccount));
        }

        function getProductFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ProductFilterButtons));
        }

        function getCompleteProductFilterButtonSet() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.CompleteProductFilterButtonSet));
        }

        function getBrandFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.BrandFilterButtons));
        }

        function getLaunchFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.LaunchFilterButtons));
        }

        function getPatternFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PatternFilterButtons));
        }

        function getItemTypeFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ItemTypeFilterButtons));
        }

        function getStockFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.StockFilterButtons));
        }

        function getMartindaleFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.MartindaleFilterButtons));
        }

        function getSizeFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.SizeFilterButtons));
        }

        function getProductFilterButtons() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ProductFilterButtons));
        }

        function getWidthFilterButtons() {
            return [{
                Name: 'Standard',
                WidthID: false
            }, {
                Name: 'Wide',
                WidthID: true
            }]
        }

        var viewModel = new downloadProductsViewModel();

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        $(document).ready(function () {
            $('#tc-modal').modal('show');

            ko.applyBindings(viewModel, document.body);

            viewModel.init();

            $("#basket-wrapper").mouseenter(function (event) {

                if (viewModel.basket().length && viewModel.tradeAccount()) {

                    $("#basket-drop").stop(true, true).slideDown({ duration: 300, easing: "easeInCubic" });

                    $("#basket-drop").empty();
                    $("#basket-drop").append("<p class='basket-loading'>Loading...</p>");

                    $.ajax({
                        url: "/api/downloadproductsapi/BasketSummary",
                        type: "POST",
                        cache: false,
                        async: true,
                        data: {
                            IDs: viewModel.basket(),
                            TradeAccountID: viewModel.tradeAccount().TradeAccountID
                        },
                        success: function (data) {
                            if (data.basketContents != null) {
                                if (data.basketContents.length > 0) {
                                    $(".basket-loading").hide();
                                    $("#basket-drop").empty();
                                    for (var i = 0; i < data.basketContents.length; i++) {
                                        $("#basket-drop").append("<p>" + data.basketContents[i].BasketCount + " x " + data.basketContents[i].ProductFilter + "</p>");
                                    }
                                } else {
                                    $(".basket-loading").hide();
                                    $("#basket-drop").empty();
                                    $("#basket-drop").append("<p class='basket-loading'>" + '@Html.Encode(DownloadsText.EmptyBasket)' + "</p>")
                                }
                            }

                        },
                        error: function (xhr, s, e) {
                            console.log(e);
                        }
                    });
                }
            });

            $("#basket-wrapper").mouseleave(function (event) {
                $("#basket-drop").stop(true, true).slideUp({ duration: 300, easing: "easeOutCubic" });
            });
        });
    </script>
}

<script id="grid-row-template" type="text/html">
    <tr role="row">
        <td>

        </td>
        <td class="image-cell">
            <!-- ko if: Images.length > 0 -->
            <img class='record-primary-image' data-bind="attr: { src:'https://www.designersguild.com/image/90/' + Images[0].ImageID }" />
            <!-- /ko -->
        </td>
        <td class="heading-cell">
            <span class="heading" data-bind="text: Heading"></span>
            <span data-bind="text: SubHeading"></span>
        </td>
        <td class="description-cell">
            <span data-bind="text: Description"></span>
        </td>
        <td class="secondary-images-cell">
            <!-- ko foreach: Images -->
            <img class='record-secondary-image' data-bind="attr: { src:'https://www.designersguild.com/image/90/' + $data.ImageID }" />
            <!-- /ko -->
        </td>
    </tr>
</script>

<script id="advertising-row-template" type="text/html">
    <tr>
        <td class="advertising-img-cell">
            <img data-bind="attr: { src: '/Areas/Downloads/Content/AdvertisingImages/vdir/thumbnails/' + UniqueThumbnailFilename }" />
        </td>
        <td>
            <h4 data-bind="html: Name"></h4>
            <p data-bind="html: Description"></p>
            <div class="btn-toolbar">
                <a href="javascript:void(0);" class="btn btn-primary advertising-image-button" data-bind="click: function () { window.location.href = '/advertising/downloadweb/' + UniqueWebQualityFilename }">
                    @DownloadsText.DownloadForWeb
                </a>
                <a href="javascript:void(0);" class="btn btn-primary advertising-image-button" data-bind="click: function() { window.location.href = '/advertising/downloadprint/' + UniquePrintQualityFilename }">
                    @DownloadsText.DownloadForPrint
                </a>
            </div>
        </td>
    </tr>
</script>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

