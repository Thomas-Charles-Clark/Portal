@model Tagging.ViewModels.TaggingViewModel
@{
    ViewBag.Title = "Customer Tagging - Designers Guild Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    @Styles.Render("~/bundles/css/customer-tagging")
    @Styles.Render("~/bundles/css/components")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/customer-tagging")

    <script type="text/javascript">

        function getAvailableTags() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Tags.OrderBy(p => p.Name)));
        }

        function getPreselectedSalesRep() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedSalesRep));
        }

        $(document).ready(function () {

            viewModel = new customerTaggingViewModel();

            ko.validation.init({
                decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
            });

            ko.options.deferUpdates = true;
            ko.applyBindings(viewModel, document.body);
        });

        function formatGBP(val) {
            return formatCurrency(val, 0, 'en-GB', 'GBP')
        }

        function formatSelectedCurrency(val) {
            //var curr = viewModel.selectedCurrency();
            //if (curr != null) {
            //    return formatCurrency(val, 0, curr.FormattingCulture, curr.Code);
            //} else {
                return formatCurrency(val, 0, 'en-GB', 'GBP');
            //}
        }
    </script>
}
@section beforeContainer {
    <div class="form-busy" data-bind="fadeVisible: loadingBusy">
        <div class="busy-bars">
            <div class="rect1 alert alert-info"></div>
            <div class="rect2 alert alert-info"></div>
            <div class="rect3 alert alert-info"></div>
            <div class="rect4 alert alert-info"></div>
            <div class="rect5 alert alert-info"></div>
        </div>
    </div>
}

<div class="form-group row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<div class="form-group row">
    <div class="col-xs-12">
        <div class="panel panel-primary">
            <div class="panel-heading no-padding">
                <h4 class="panel-title">
                    <a class="panel-title panel-toggle" data-toggle="collapse" data-target="#rep-search-collapse">
                        Sales Representative / Market
                    </a>
                </h4>
            </div>
            <div id="rep-search-collapse" class="panel-collapse collapse in">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="filters panel panel-default">
                                <div class="panel-body bg-info">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="slicers row no-gutters" data-bind="with: slicerGroupZero">
                                                <div class="input-group" style="width: 100%">
                                                    <!-- ko foreach: slicerCollection -->
                                                    <div class="input-group-btn" style="width: 25%;">
                                                        <div class="dropdown-wrapper">
                                                            <div data-bind="component: { name: 'drop-down-component', params: $data }"></div>
                                                            <!-- ko if: $index() == 2 -->
                                                            <div data-bind="with: $parent.currencySlicer">
                                                                <div class="btn-group btn-group-justified btn-group-sm" style="display: none;" data-bind="visible: selectedId() != null && selectedId() != 1">
                                                                    <a class="btn btn-default" data-bind="css: { 'btn-primary': $parentContext.$parent.currencyDisplay() == 'currency' }, click: function() { $parentContext.$parent.currencyDisplay('currency') }" style="border-top-left-radius: 0">
                                                                        Currency
                                                                    </a>
                                                                    <a class="btn btn-default" data-bind="css: { 'btn-primary': $parentContext.$parent.currencyDisplay() == 'sterling' }, click: function() { $parentContext.$parent.currencyDisplay('sterling') }">
                                                                        Sterling
                                                                    </a>

                                                                    <a class="btn btn-default" data-bind="css: { 'btn-primary': $parentContext.$parent.currencyDisplay() == 'both' }, click: function() { $parentContext.$parent.currencyDisplay('both') }" style="border-top-right-radius: 0">
                                                                        Both
                                                                    </a>
                                                                </div>
                                                            </div>
                                                            <!-- /ko -->
                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        <div class="panel panel-primary">
            <div class="panel-heading no-padding panel-stats">
                <h4 class="panel-title">
                    <a class="panel-title panel-toggle" data-toggle="collapse" data-target="#tag-customer-collapse">
                        Tag your Customers
                    </a>
                </h4>
            </div>
            <div id="tag-customer-collapse" class="panel-collapse collapse in">
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-xs-6">
                            <div class="filters panel panel-default">
                                <div class="panel-body bg-info">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="slicers row no-gutters" data-bind="with: slicerGroupOne">
                                                <div class="input-group">
                                                    <!-- ko foreach: slicerCollection -->
                                                    <div class="input-group-btn">
                                                        <div class="dropdown-wrapper">
                                                            <div data-bind="component: { name: 'drop-down-component', params: $data }"></div>

                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-6">
                            <div class="filters panel panel-default">
                                <div class="panel-body bg-info">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="slicers row no-gutters" data-bind="with: slicerGroupTwo">
                                                <div class="input-group">
                                                    <!-- ko foreach: slicerCollection -->
                                                    <div class="input-group-btn">
                                                        <div class="dropdown-wrapper">
                                                            <div data-bind="component: { name: 'drop-down-component', params: $data }"></div>

                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-xs-12">
                            <div class="filters panel panel-default">
                                <div class="panel-body bg-info">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="slicers row no-gutters lower-slicers" data-bind="with: slicerGroupThree">
                                                <div class="input-group">
                                                    <!-- ko foreach: slicerCollection -->
                                                    <div class="input-group-btn">
                                                        <div class="dropdown-wrapper">
                                                            <div data-bind="component: { name: 'drop-down-component', params: $data }"></div>

                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-xs-4">
                            <div class="btn-toolbar">
                                <div class="btn-group">
                                    <div class="input-group">
                                        <input type="text" class="form-control" data-bind="textInput: searchString, attr: { placeholder: 'Type to search by Customer' }, enterKey: function() { tagGridSettings.widget().dataSource.read(); }" />
                                        <span class="input-group-addon">
                                            <button class="clear-btn btn btn-default" type="button" data-bind="click: function() { searchString(undefined); tagGridSettings.widget().dataSource.read(); }">×</button>
                                        </span>
                                        <span class="input-group-btn">
                                            <button class="search-btn btn btn-default" data-bind="click: function(data, event) { taggingWidget().dataSource.read(); }"><span class="glyphicon glyphicon-search"></span></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-8">
                            <div class="btn-toolbar pull-right">
                                <div class="btn-group">
                                    <button class="btn btn-warning" data-bind="click: selectAllCustomers">
                                        Select All <span data-bind="text: '(' + allCustomerResults().length + ')'"></span>
                                    </button>
                                </div>
                                <div class="btn-group" data-bind="click: clearSelection">
                                    <button class="btn btn-warning">
                                        Clear Selection
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button class="btn btn-success" data-bind="click: showAddTagModal">
                                        Add Tags
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button class="btn btn-danger" data-bind="click: showRemoveTagModal">
                                        Remove Tags
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button class="btn btn-primary">
                                        Email
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button class="btn btn-primary">
                                        Print
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button class="btn btn-primary">
                                        Export to Excel
                                    </button>
                                </div>
                            </div>
                        </div>
                        @*<div class="col-xs-12">
                            <div class="tag-container" data-bind="foreach: selectedTags.sort()">
                                <span class="label label-primary tag">
                                    <span data-bind="text:Name"></span>
                                    <span class="remove" aria-hidden="true" data-bind="click: function() { $parent.selectedTags.remove($data); }">[&times;]</span>
                                </span>
                            </div>
                        </div>*@
                    </div>
                    <div class="row">
                        <div class="col-xs-12">
                            <div style="position: relative">
                                <div id="grid-loading" style="border-radius: 4px;" data-bind="visible: taggingGridBusy">
                                    <div class="form-busy">
                                        <div class="busy-bars">
                                            <div class="rect1 alert alert-info"></div>
                                            <div class="rect2 alert alert-info"></div>
                                            <div class="rect3 alert alert-info"></div>
                                            <div class="rect4 alert alert-info"></div>
                                            <div class="rect5 alert alert-info"></div>
                                        </div>
                                    </div>
                                </div>
                                <div data-bind="kendoGrid: tagGridSettings"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="add-tag-modal" class="modal fade" data-bind="visible: (loadingBusy() == false)">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">
                    Add Tags
                </h4>
            </div>
            <div class="modal-body tags-group">
                <div id="tag-search" class="input-group tags-group form-group">
                    <input class="tags form-control" data-bind="textInput: tagsAutocomplete, attr: { placeholder: 'Type to Search for Tags' }" />
                    <span class="input-group-addon" data-bind="visible: newTag()">
                        <button class="btn btn-success" type="button" data-bind="click: function() { addTag(tagsAutocomplete()) }">Add</button>
                    </span>
                    @*<div class="input-group-btn">
                            <button type="button" class="btn btn-default @(Model.Properties?.Application_ButtonClass) dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                List <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" data-bind="foreach: availableTags().sort()">
                                <li onclick="event.stopPropagation();">
                                    <label>
                                        <input type="checkbox" data-bind="checked: $parent.selectedTags, checkedValue: $data" />
                                        <span data-bind="text: Name"></span>
                                    </label>
                                </li>
                            </ul>
                        </div>*@
                </div>
                <ul id="add-tag-list" data-bind="foreach: availableTags()">
                    <li>
                        <label>
                            <input type="checkbox" data-bind="checked: $parent.selectedTags, checkedValue: $data" />
                            <span data-bind="text: Name"></span>
                        </label>
                    </li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="pull-left btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" data-bind="click: function() { addTagsToSelection(); }">Tag Customers</button>
            </div>
        </div>
    </div>
</div>

<div id="remove-tag-modal" class="modal fade" data-bind="visible: (loadingBusy() == false)">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">
                    Remove Tags
                </h4>
            </div>
            <div class="modal-body tags-group">
                <div id="tag-search" class="input-group tags-group form-group">
                    <input class="tags form-control" data-bind="textInput: tagsAutocomplete, attr: { placeholder: 'Type to Search for Tags' }" />
                    <span class="input-group-addon" data-bind="visible: newTag()">
                        <button class="btn btn-success" type="button" data-bind="click: function() { addTag(tagsAutocomplete()) }">Add</button>
                    </span>
                </div>
                <ul id="remove-tag-list" data-bind="foreach: availableTags()">
                    <li>
                        <label>
                            <input type="checkbox" data-bind="checked: $parent.selectedTags, checkedValue: $data" />
                            <span data-bind="text: Name"></span>
                        </label>
                    </li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="pull-left btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" data-bind="click: function() { removeTagsFromSelection(); }">Remove Tags</button>
            </div>
        </div>
    </div>
</div>

<div id="contact-modal" class="modal fade" data-bind="with: contactDataToDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">
                    <span data-bind="text: Code"></span>
                    <span data-bind="text: Name"></span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Name
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <span class="address-span" data-bind="text: Name"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Invoice Address
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <span class="address-span" data-bind="text: AddressLine1"></span>
                        <span class="address-span" data-bind="text: AddressLine2"></span>
                        <span class="address-span" data-bind="text: AddressLine3"></span>
                        <span class="address-span" data-bind="text: AddressLine4"></span>
                        <span class="address-span" data-bind="text: CountryCode"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Default Delivery Address
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <span class="address-span" data-bind="text: DeliveryAddressLine1"></span>
                        <span class="address-span" data-bind="text: DeliveryAddressLine2"></span>
                        <span class="address-span" data-bind="text: DeliveryAddressLine3"></span>
                        <span class="address-span" data-bind="text: DeliveryAddressLine4"></span>
                        <span class="address-span" data-bind="text: DeliveryCountryCode"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Phone
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <!-- ko if: PhoneNumber -->
                        <a data-bind="attr: { href: 'tel:'+PhoneNumber }, text: PhoneNumber"></a>
                        <!-- /ko -->
                        <!-- ko ifnot: PhoneNumber -->
                        <span class="address-span">Unknown</span>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <label class="col-form-label">
                            Email
                        </label>
                    </div>
                    <div class="col-xs-12">
                        <!-- ko if: Email -->
                        <a data-bind="attr: { href: 'mailto:'+Email }, text: Email"></a>
                        <!-- /ko -->
                        <!-- ko ifnot: Email -->
                        <span class="address-span">Unknown</span>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default pull-right" data-dismiss="modal" data-target="#contact-modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>