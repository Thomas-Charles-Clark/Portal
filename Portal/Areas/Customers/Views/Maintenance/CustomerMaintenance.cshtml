@model Portal.Areas.Customers.ViewModels.CustomerMaintenanceViewModel
@{
    ViewBag.Title = "Customer Maintenance";
}

@section styles {
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/customer-maintenance")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/customer-maintenance")

    <script type="text/javascript">

        function getPreselectedTradeAccount() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedTradeAccount))
        }

        var viewModel = customerMaintenanceViewModel();
        
        $(document).ready(function () {

            ko.validation.init({
                decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
            });

            ko.applyBindings(viewModel, document.body);

            $("#account-number").focus();

            //window.setTimeout(function () {
            //    viewModel.busy(true);
            //}, 100);
        });

    </script>
}

<div class="row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<ul id="create-or-maintain-tabs" class="nav nav-pills margin-top-30">
    <li>
        <a href="#tab-maintain" data-toggle="tab">
            Maintain
        </a>
    </li>
    <li class="active">
        <a href="#tab-create" data-toggle="tab">
            Create
        </a>
    </li>
</ul>

<div class="tab-content">
    <div id="tab-maintain" class="tab-pane">
        <div class="margin-bottom-15">
            @Html.Action("TradeAccountSelector", "Component", new { Area = "", canSearch = Model.Properties?.AccountSelector_CanSearch ?? false, canCollapse = false })
        </div>
        <!-- ko with: tradeAccount -->
        <div class="grid-container grid-1-col">
            <div class="panel panel-primary">
                <div class="panel-body">
                    <h4 class="section-heading">
                        Section Heading
                    </h4>
                    <p>
                        Maintain this Trade Account.
                    </p>
                </div>
            </div>
        </div>
        <div class="grid-container grid-1-col">
            <div class="panel panel-primary">
                <div class="panel-body">
                    <div class="grid-container grid-2-col">
                        <div>
                            <h4 class="section-heading">
                                Second Section
                            </h4>
                            <p>
                                Invoice Address (only visible to Credit Control)?
                            </p>
                        </div>
                        <div>
                            <h4 class="section-heading">
                                Third Section
                            </h4>
                            <p>
                                Address Book? Possibly?
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-container grid-2-col">
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Fourth Section
                        </h4>
                        <p>
                            Some Stuff
                        </p>
                    </div>
                </div>
            </div>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Fifth Section
                        </h4>
                        <p>
                            Some more stuff
                        </p>
                        <p>
                            Lots more stuff
                        </p>
                        <p>
                            Just taking up space now
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-container grid-3-col">
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Sixth Section
                        </h4>
                        <p>
                            Even more stuff
                        </p>
                    </div>
                </div>
            </div>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Seventh Section
                        </h4>
                        <p>
                            Guess what
                        </p>
                    </div>
                </div>
            </div>
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Eighth Section
                        </h4>
                        <p>
                            Yep - more stuff!
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-container grid-2-col">
            <div>
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Ninth Section
                        </h4>
                        <p>
                            This section has <i>too much</i> stuff, so it scrolls.
                        </p>
                        <ul class="list-group max-height-300 margin-top-15 margin-bottom-0">
                           @for (var i = 0; i < 50; i++)
                            {
                                <li class="list-group-item list-group-item-@((i % 2 == 0 ? "info" : "warning"))">
                                    Thing @(i+1)
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div>
                <div class="panel panel-primary auto-height">
                    <div class="panel-body">
                        <h4 class="section-heading">
                            Tenth Section
                        </h4>
                        <p>
                            Phew, that's a lot of stuff.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
    </div>
    <div id="tab-create" class="tab-pane active">
        <div class="panel panel-primary">
            <div class="panel-body modal-body" style="min-height: 600px;">
                <div data-bind="component: { name: 'matrix-loading-component', params: matrixLoader }"></div>
            </div>
        </div>
        <button class="btn btn-default margin-top-15" data-bind="click: function() { busy(!busy()); }">
            Toggle Busy
        </button>
    </div>
</div>