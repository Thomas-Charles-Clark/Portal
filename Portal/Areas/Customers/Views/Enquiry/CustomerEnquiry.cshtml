@model Portal.Areas.Customers.ViewModels.CustomerEnquiryViewModel
@{
    ViewBag.Title = "Customer Enquiry";
    var Today = DateTime.Now;
}
@section postscripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyA_d3HoXoCV7M85_xduYJUze1GOscDnjUw" async defer></script>
}
@section styles {
    @Styles.Render("~/bundles/css/components")
    @Styles.Render("~/bundles/css/customer-enquiry")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/intl-tel")
    @Scripts.Render("~/bundles/js/customer-enquiry")

    <script type="text/javascript">
        $('#accordion > .panel > .panel-collapse').collapse({
            parent: '#accordion',
            toggle: false
        });

        var viewModel = new customerEnquiryViewModel();

        $(document).ready(function () {

            ko.validation.init({
                decorateInputElement: true,
                errorElementClass: 'alert-danger',
                errorMessageClass: 'validation-message text-danger'
            });

            ko.applyBindings(viewModel, document.body);

            $("#account-number").focus();
        });

        function getTradeAccountGroupId() {
            return @Html.Raw(Json.Encode(Model.TradeAccountGroupID))
        }
        function getTradeAccountId() {
            return @Html.Raw(Json.Encode(Model.TradeAccountID))
        }
        function getPreselectedTradeAccount() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.PreselectedTradeAccount));
        }
        function getCustomerDetails() {
            return @Html.Raw(Json.Encode(Model.CustomerDetails))
        }
        function getAvailableCompetitors() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Competitors));
        }
        function getAvailableBrands() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Brands));
        }
        function getAvailableProductTypeGroups() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.ProductTypeGroups));
        }
        function getGBPCurrency() {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Currencies.Where(p => p.Code == "GBP" && p.FormattingCulture == "en-GB").SingleOrDefault()))
        }
        function getAvailableFinancialYears() {
            return @Html.Raw(Json.Encode(Model.NextFiveFinancialYears));
        }
        //function initSummaryKendoControls() {
        //    $("#summary-brand").kendoDropDownList({
        //        dataSource: getAvailableBrands(),
        //        dataTextField: "Name",
        //        dataValueField: "BrandID",
        //    });
        //}

        $("#price-checker-modal").on('shown.bs.modal', function () {
            viewModel.priceChecker().resultGridWidget().refresh();
        });
    </script>
}
@section modals {
    @Html.Partial("Modals/_AddressModal")
    @Html.Partial("Modals/_ImageModal")
    @Html.Partial("Modals/_OrderEnquiryModal")
    @Html.Partial("Modals/_CareSearchModal")
    @Html.Partial("Modals/_TasksModal")
    @*@Html.Partial("Modals/_VisitEditModal")*@
}

<div class="row">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<div class="row margin-bottom-15">
    <div class="col-xs-12 text-right">
    </div>
</div>

@Html.Action("TradeAccountSelector", "Component", new { Area = "", canSearch = Model.Properties?.AccountSelector_CanSearch ?? false })

<div class="page-busy-wrapper" data-bind="fadeVisible: loadBusy()">
    <div class="form-busy">
        <div class="busy-bars">
            <div class="rect1 alert alert-info"></div>
            <div class="rect2 alert alert-info"></div>
            <div class="rect3 alert alert-info"></div>
            <div class="rect4 alert alert-info"></div>
            <div class="rect5 alert alert-info"></div>
        </div>
    </div>
</div>

<!-- ko if: customerDetails -->
<div @*id="accordion"*@>
    <div class="row margin-top-15" style="display: none;" data-bind="visible: !loadBusy()">
        <div class="col-xs-12">
            <div class="panel panel-primary">
                <div class="panel-heading no-padding non-search">
                    <h4 class="panel-title">
                        <a class="panel-title panel-toggle" data-toggle="collapse" href="#pricing-summary-collapse" aria-expanded="true" aria-controls="pricing-summary-collapes">
                            Pricing
                        </a>
                    </h4>
                    <div class="clearfix"></div>
                </div>
                <div id="pricing-summary-collapse" class="panel-collapser collapse in">
                    <div class="panel-body" data-bind="with: customerDetails">
                        <div class="form-group row">
                            <div class="col-xs-12">
                                <label class="col-form-label">Pricelist: <span class="non-bold" data-bind="text: priceList">Unknown</span></label>
                            </div>
                        </div>
                        <div class="row" style="display: none;" data-bind="visible: tradePriceListId">
                            <div class="col-xs-12">
                                <button class="btn btn-primary @(Model.Properties?.Application_ButtonClass)" data-bind="click: function() { $parent.priceChecker().openPriceCheckModal(); }">Check Prices</button>
                            </div>
                        </div>
                        <div class="row" style="display: none" data-bind="visible: !tradePriceListId">
                            <div class="col-xs-12">
                                <div class="alert alert-danger" style="margin-bottom: 0;">
                                    Price List not found for account <span data-bind="text: code"></span>. Price checking cannot be performed.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
