                                                </td>
                                                <td>
                                                    <span data-bind="text: formatCustomerCurrency(netSales().NetCredits_LYMTD)"></span>
                                                    <span class="text-muted smaller" data-bind="html: formatPercentageHtmlColourSpanReversed(netSales().NetCreditsVariance_LYMTD_PLYMTD)"></span>
                                                </td>
                                                <td>
                                                    <span data-bind="text: formatNumber(netSales().OrderCount_MTD)"></span>
                                                    <span class="text-muted smaller" data-bind="html: formatPercentageHtmlColourSpan(netSales().OrderCountVariance_MTD_LYMTD)"></span>
