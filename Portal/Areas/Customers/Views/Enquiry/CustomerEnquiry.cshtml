                        <div class="form-busy">
                            <div class="busy-bars">
                                <div class="rect1 alert alert-info"></div>
                                <div class="rect2 alert alert-info"></div>
                                <div class="rect3 alert alert-info"></div>
                                <div class="rect4 alert alert-info"></div>
                                <div class="rect5 alert alert-info"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="table-responsive">
                                    <table id="competitor-table" class="table table-condensed table-striped">
                                        <thead>
                                            <tr>
                                                <th>Competitors</th>
                                                <th>Product Types</th>
                                                <th>Estimated Value</th>
                                                <th>Notes</th>
                                                <th>Note Added</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- ko foreach: competitorDetails -->
                                            <tr>
                                                <td>
                                                    <h4 class="page-heading-colour competitor-table-label" style="margin-top: 0" data-bind="html: Key().Name"></h4>
                                                    <span class="competitor-table-label">
                                                        <button class="btn btn-primary @(Model.Properties?.Application_ButtonClass)" data-bind="click: function() { $parent.openCompetitorAddModal(Key()) }, attr: { href: 'javascript:;' }">
                                                            Edit
                                                        </button>
                                                    </span>
                                                </td>
                                                <td>
                                                    <!-- ko foreach: source -->
                                                    <span class="competitor-table-label" data-bind="html: $data.ProductTypeGroup.Name"></span>
                                                    <!-- /ko -->
                                                </td>
                                                <td data-bind="foreach: source">
                                                    <!-- ko if: $data.Value -->
                                                    <!-- ko if: $parentContext.$parent.customerDetails().currencyCulture -->
                                                    <span class="competitor-table-label" data-bind="html: formatCurrency($data.Value, 0, $parentContext.$parent.customerDetails().currencyCulture, $parentContext.$parent.customerDetails().accountCurrency)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: $parentContext.$parent.customerDetails().currencyCulture -->
                                                    <span class="competitor-table-label" data-bind="html: $data.Value"></span>
                                                    <!-- /ko -->
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: $data.Value -->
                                                    <span class="competitor-table-label">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td data-bind="foreach: source">
                                                    <!-- ko with: Enumerable.From($data.Notes).OrderByDescending('$.NoteID').ToArray() -->
                                                    <!-- ko if: $data.length -->
                                                    <div class="notes">
                                                        <a class="competitor-table-span" data-bind="click: function() { $parentContext.$parentContext.$parent.openCompetitorAddModal($parentContext.$parent.Key()) }, attr: { href: 'javascript:;' }">
                                                            <span data-bind="text: $data[0].Note"></span>
                                                        </a>
                                                    </div>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: $data.length -->
                                                    <span class="competitor-table-span">&nbsp;</span>
                                                    <!-- /ko -->
                                                    <!-- /ko -->
                                                </td>
                                                <td class="notes-created" data-bind="foreach: source">
                                                    <!-- ko with: Enumerable.From($data.Notes).OrderByDescending('$.NoteID').ToArray() -->
                                                    <!-- ko if: $data.length -->
                                                    <span class="competitor-table-span" data-bind="text: $data[0].CreatedLine"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: $data.length -->
                                                    <span class="competitor-table-span">&nbsp;</span>
                                                    <!-- /ko -->
                                                    <!-- /ko -->
                                                </td>
                                            </tr>
                                            <!-- /ko -->
                                            <tr>
                                                <td colspan="5">
                                                    <span class="competitor-table-label">
                                                        <button class="btn btn-primary @(Model.Properties?.Application_ButtonClass)" data-bind="click: function() { openCompetitorAddModal(); }, attr: { href: 'javascript:;' }">
                                                            Add Competitor
                                                        </button>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row margin-top-15" style="display: none;" data-bind="visible: !loadBusy()">
