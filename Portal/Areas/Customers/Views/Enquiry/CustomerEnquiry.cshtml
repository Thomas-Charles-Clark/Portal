    <div class="row margin-top-15" style="display: none;" data-bind="visible: !loadBusy()">
        <div class="col-xs-12">
            <div class="panel panel-primary">
                <div class="panel-heading no-padding non-search">
                    <h4 class="panel-title">
                        <a class="panel-title panel-toggle" data-toggle="collapse" href="#account-competitors-collapse" aria-expanded="true" aria-controls="account-competitors-collapse">
                            Competitors
                        </a>
                    </h4>
                    <div class="clearfix"></div>
                </div>
                <div id="account-competitors-collapse" class="panel-collapser collapse in">
