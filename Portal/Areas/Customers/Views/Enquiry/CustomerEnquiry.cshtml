                    </div>
                    <div class="col-xs-12">
                        <select class="form-control" data-bind="value: editingPotential, options: [{ 'text': 'Yes', 'value': true }, { 'text': 'No', value: false }], optionsText: 'text', optionsValue: 'value'"></select>
                    </div>
                </div>
                <div data-bind="visible: editingPotential">
                    <div class="form-group row">
                        <div class="col-xs-12">
                            <label class="col-form-label">
                                Value
                            </label>
                        </div>
                        <div class="col-xs-12">
                            <div class="input-group" data-bind="with: $parent.customerDetails">
                                <span class="input-group-addon input-group-addon-default" data-bind="with: currency"><span data-bind="text: Symbol"></span></span>
                                <input class="form-control" data-bind="numeric, forceNullOnEmpty: $parent.editingValue, textInput: $parent.editingValue.formatted" />
                                <!-- ko if: $parent.editingValueGBP -->
                                <span class="input-group-addon"></span>
                                <span class="gbp-conversion form-control form-group-span" data-bind="text: $parent.editingValueGBP.formatted"></span>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-xs-12">
                            <label for="custom-country" class="col-form-label">Financial Year</label>
                        </div>
                        <div class="col-xs-12">
                            <select class="form-control" data-bind="options: getAvailableFinancialYears(), value: editingFinancialYear, optionsText: 'Name', optionsValue: 'Value', optionsCaption: 'Please Select...'"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-xs-12">
                        <label class="col-form-label">Comment</label>
                    </div>
                    <div class="col-xs-12">
                        <div class="form-group row">
                            <div class="col-xs-12">
                                <textarea class="form-control" placeholder="Comment..." rows="3" data-bind="textInput: editingNote"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="text-right">
                    <button class="btn btn-success @(Model.Properties?.Application_ButtonClass)" aria-label="Close" data-bind="click: function() { saveTradeAccountPotential(); }">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="price-checker-modal" class="modal fade" data-bind="with: priceChecker">
    <div class="modal-dialog modal-lg modal-xl">
        <div class="modal-content">
            <div class="modal-header grey-blue bg-info" style="border-bottom: 0;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 id="price-checker-title" class="modal-title">Check Prices</h4>
            </div>
            <div style="position: relative;">
                <div class="modal-body">
                    <div class="form-group row">
                        <div class="col-xs-12">
                            <div data-bind="with: $parent.customerDetails">
                                <p>
                                    <label class="col-form-label">Trade Account: <span class="non-bold" data-bind="text: $parentContext.$parent.tradeAccountSelector().name"></span></label>
                                    <div class="clearfix"></div>
                                </p>
                                <p>
                                    <label class="col-form-label" style="margin-right: 12px;">Market: <span class="non-bold" data-bind="text: marketName"></span></label>
                                    <label class="col-form-label" style="margin-right: 12px;">PriceList: <span class="non-bold" data-bind="text: priceList"></span></label>
                                    <label class="col-form-label">Currency: <span class="non-bold" data-bind="text: currencyName"></span></label>
                                    <div class="clearfix"></div>
                                </p>
                            </div>
                            @*<p>
                                    Exporting *all* pages to PDF / Excel would demand server side exporting, which is possible but annoying to have to do. Understandable limitations to processing such as this on the client side.
                                    PDF will require iTextSharp, which we... do have a license for, I believe. <a href="https://github.com/telerik/ui-for-aspnet-mvc-examples/blob/master/grid/pdf-export-server-side/KendoUIMVC5/Controllers/HomeController.cs" target="_blank">Server side PDF Export (dated)</a>
                                </p>*@
                        </div>
                    </div>
                    @Html.Partial("Components/_PriceChecker", Model)
                </div>
            </div>
        </div>
    </div>
</div>