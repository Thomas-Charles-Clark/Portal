@model Portal.Areas.Customers.ViewModels.GiftVouchersViewModel
@{
    ViewBag.Title = "Gift Vouchers";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/gift-vouchers")
    @Styles.Render("~/bundles/css/tempus-dominus")
    @Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/gift-vouchers")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">
            window.getGiftVoucherTypes = () => {
                return @Html.Raw(JsonConvert.SerializeObject(Model.GiftVoucherTypes));
            }
            window.getPriceLists = () => {
                return @Html.Raw(JsonConvert.SerializeObject(Model.PriceLists));
            }
            window.getGiftVoucherCode = () => {
                return '@Html.Raw(Model.GiftVoucherCode)';
            }
    </script>

    <script type="text/javascript">

        var viewModel = giftVouchersViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

        if (window.getGiftVoucherCode()) {
            self.giftVoucherParams.dropDownListSettings.widget.subscribe(nv => {
                window.setTimeout(() => {
                    nv.dataSource.filter({
                        field: 'Code',
                        operator: 'eq',
                        value: window.getGiftVoucherCode()
                    });
                }, 0);
            });
        }

    </script>
}
@section modals {
    @Html.Partial("Modals/_ImageModalNew")
}

<script type="text/html" id="gift-voucher-row-template">
    <tr class="gift-voucher-row">
        <td class="text-end">
            <span data-bind="text: GiftVoucherID"></span>
        </td>
        <td>
            <span data-bind="text: GiftVoucherType.Name"></span>
        </td>
        <td>
            <span data-bind="text: PriceList.Name"></span>
        </td>
        <td>
            <span data-bind="text: Code"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(ValueInc, 2, PriceList.Currency.FormattingCulture, PriceList.Currency.Code)"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: formatCurrency(ValueEx, 2, PriceList.Currency.FormattingCulture, PriceList.Currency.Code)"></span>
        </td>
        <td>
            <span data-bind="text: CreatedDT ? moment(CreatedDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: AuthorisedDT ? moment(AuthorisedDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: ExpiryDT ? moment(ExpiryDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: UsedDT ? moment(UsedDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: CancelledDT ? moment(CancelledDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: RedeemTransactionID"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: SaleTransactionID"></span>
        </td>
        <td>
            <span data-bind="text: CreatedByMember?.FullName ?? 'eCommerce'"></span>
        </td>
        <td>
            <button type="button" class="btn btn-secondary grid-btn" data-bind="click: $root.viewVoucher">
                View
            </button>
            <button type="button" class="btn btn-secondary grid-btn">
                Email
            </button>
        </td>
    </tr>
</script>

<script type="text/html" id="grid-toolbar-create-new">
    <a id="create-new-btn" role="button" class="k-button k-button-icontext k-grid-CreateNew" href="javascript:;" data-bind="click: beginNewVoucher">
        <span class="k-icon k-i-add"></span>
        Create New
    </a>
</script>

<div class="blocker" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="page-heading-wrapper">
    <div class="page-heading-logo">
        <div></div>
    </div>
    <div class="page-heading text-right">
        @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
        {
            <h1 class="main-heading">
                @(Model.ApplicationHeading)
            </h1>
        }
        @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
        {
            <h4 class="sub-heading">
                <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
            </h4>
        }
    </div>
</div>

<ul class="nav nav-tabs nav-justified" id="gift-voucher-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fs-5" id="find-tab-btn" data-bs-toggle="tab" data-bs-target="#find-tab" type="button" role="tab" aria-controls="Find" aria-selected="true">
            Find a Gift Voucher
        </button>
    </li>
    @if (User.IsInRole("Super Admin") || User.IsInRole("Gift Voucher Creator"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fs-5 active" id="create-tab-btn" data-bs-toggle="tab" data-bs-target="#create-tab" type="button" role="tab" aria-controls="Create" aria-selected="false">
                Create a Gift Voucher
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fs-5" id="manage-tab-btn" data-bs-toggle="tab" data-bs-target="#manage-tab" type="button" role="tab" aria-controls="Manage" aria-selected="false">
                Bulk Manage Gift Vouchers
            </button>
        </li>
    }
</ul>
<div class="tab-content" id="gift-vouchers-tabs-content">
    <div class="tab-pane fade" id="find-tab" role="tabpanel" aria-labelledby="find-tab-btn">
        <div id="prefilters">
            <div id="gift-voucher-prefilter" class="prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: giftVoucherParams }"></div>
        </div>
        <div id="gift-voucher-container-wrapper" style="display: none" data-bind="visible: true, with: giftVoucher">
            <div id="gift-voucher-container">
                <dl class="gift-voucher-details row">
                    <dt class="col-3 text-end">
                        Code
                    </dt>
                    <dd class="col-8" data-bind="text: Code"></dd>
                    <dt class="col-3 text-end">
                        Value
                    </dt>
                    <dd class="col-8" data-bind="text: formatCurrency(ValueInc, 2, PriceList.Currency.FormattingCulture, PriceList.Currency.Code)"></dd>
                    <dt class="col-3 text-end">
                        Type
                    </dt>
                    <dd class="col-8" data-bind="text: GiftVoucherType.Name"></dd>
                    <dt class="col-3 text-end">
                        Sold with Order ID
                    </dt>
                    <dd class="col-8" data-bind="text: soldWithOrderId"></dd>
                    <dt class="col-3 text-end">
                        Redeemed with Order ID
                    </dt>
                    <dd class="col-8" data-bind="text: redeemOrderId"></dd>
                    <dt class="col-3 text-end">
                        Created
                    </dt>
                    <dd class="col-8" data-bind="text: moment(CreatedDT).format('DD/MM/YYYY HH:mm')"></dd>
                    <dt class="col-3 text-end">
                        Expires
                    </dt>
                    <dd class="col-8" data-bind="text: moment(expiryDate()).format('DD/MM/YYYY HH:mm')"></dd>
                    <dt class="col-3 text-end">
                        Used
                    </dt>
                    <dd class="col-8" data-bind="text: usedDt() ? moment(usedDt()).format('DD/MM/YYYY HH:mm') : 'Not yet'"></dd>
                    <dt class="col-3 text-end">
                        Message
                    </dt>
                    <dd class="col-8">
                        <p data-bind="html: orderLine?.GiftVoucherMessage.replace('\n', '<br/><br/>') ?? '(No message)', css: { 'text-italic': orderLine?.GiftVoucherMessage == null }"></p>
                    </dd>
                    <dt class="col-3 text-end mt-3">
                        Notes
                    </dt>
                    <dd class="col-8 mt-3">
                        <div data-bind="html: notes"></div>
                    </dd>
                    <dt id="actions-dt" class="col-3 text-end">
                        Actions
                    </dt>
                    <dd id="actions-dd" class="col-8">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" data-bind="disable: voucherEditDisabled, click: $parent.giftVoucherRedeemer.show">
                                Redeem
                            </button>
                            <button type="button" class="btn btn-primary" data-bind="disable: voucherEditDisabled, click: $parent.giftVoucherExtender.show">
                                Extend
                            </button>
                            <button type="button" class="btn btn-primary ms-auto" data-bind="click: $parent.viewVoucher">
                                View
                            </button>
                            <button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target=".emailer-collapse">
                                Email
                            </button>
                        </div>
                    </dd>
                    <dt class="emailer-collapse collapse">

                    </dt>
                    <dd class="emailer-collapse collapse">
                        <dl class="gift-voucher-details row">
                            <dt class="col-3 text-end">
                                Email
                            </dt>
                            <dd class="col-8">
                                <div class="py-3">
                                    <!-- ko component: { name: 'emailer-component', params: $parent.emailer } --><!-- /ko -->
                                </div>
                            </dd>
                        </dl>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Super Admin") || User.IsInRole("Gift Voucher Creator"))
    {
        <div class="tab-pane fade show active" id="create-tab" role="tabpanel" aria-labelledby="new-tab-btn" data-bind="with: giftVoucherCreator">
            <fieldset id="creation-fields">
                <div data-bind="component: { name: 'mdc-text-field-component', params: codeParams }"></div>
                <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: priceListParams }"></div>
                <div class="d-flex gap-3">
                    <div id="expiry-date-field" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: expiryDateParams }"></div>
                    <div id="voucher-credit-checkbox" data-bind="component: { name: 'mdc-checkbox-component', params: isVoucherCreditParams }"></div>
                    <div id="voucher-credit-field" style="display: none;" data-bind="visible: isVoucherCredit, component: { name: 'kendo-mdc-dropdown-component', params: creditOrderParams }"></div>
                </div>
                <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: productParams }"></div>
                <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: giftVoucherTypeParams }"></div>
                <div data-bind="component: { name: 'mdc-text-area-component', params: messageParams }"></div>
                <div class="d-flex gap-3">
                    <div id="preview-container">
                        <iframe id="gift-voucher-preview" data-bind="attr: { src: base64 }"></iframe>
                    </div>
                    <div id="internal-notes" data-bind="component: { name: 'mdc-text-area-component', params: notesParams }"></div>
                </div>
            </fieldset>
            <div class="d-flex align-items-center justify-content-end mt-3">
                <button type="button" class="btn btn-success" data-bind="click: saveChanges">
                    Save
                </button>
            </div>
        </div>
        <div class="tab-pane fade" id="manage-tab" role="tabpanel" aria-labelledby="manage-tab-btn">
            <div data-bind="kendoGrid: giftVouchersGridSettings"></div>
        </div>
    }
</div>

<div id="redeem-voucher-modal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: giftVoucherRedeemer">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Redeem Gift Voucher
                </h4>
                <button class="btn-close btn-close-white" data-bind="click: hide"></button>
            </div>
            <div class="modal-body">
                <p class="bold">
                    Important Notes
                </p>
                <p>
                    Gift vouchers cannot be part-redeemed.
                </p>
                <p>
                    Please try to provide an Order ID for our records. If you cannot, please revisit this gift voucher when you have an order number from the redemption transaction.
                </p>
                <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: redeemOrderParams }"></div>
                <div class="mt-3" data-bind="component: { name: 'mdc-text-area-component', params: notesParams }"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bind="click: hide">
                    Cancel
                </button>
                <button class="btn btn-primary" data-bind="click: proceed">
                    Ok
                </button>
            </div>
        </div>
    </div>
</div>

<div id="extend-voucher-modal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: giftVoucherExtender">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Extend Gift Voucher Expiry
                </h4>
                <button class="btn-close btn-close-white" data-bind="click: hide"></button>
            </div>
            <div class="modal-body">
                <p class="bold">
                    Important Notes
                </p>
                <p>
                    Gift vouchers cannot be indefinite. Please avoid extending gift vouchers for more than a month at a time.
                </p>
                <div data-bind="component: { name: 'tempus-dominus-date-picker-component', params: expiryDateParams }"></div>
                <div class="mt-3" data-bind="component: { name: 'mdc-text-area-component', params: notesParams }"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bind="click: hide">
                    Cancel
                </button>
                <button class="btn btn-primary" data-bind="click: proceed">
                    Ok
                </button>
            </div>
        </div>
    </div>
</div>

<p class="text-italic mt-3">
