@model Portal.Areas.Customers.ViewModels.AdvertiserMaintenanceViewModel
@{
    ViewBag.Title = "Advertiser Maintenance";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}

<script id="advertising-class-row-template" type="text/html">
    <tr>
        <td role="gridcell" class="trade-account-cell">
            <div>
                <span data-bind="html: ShortLabel"></span>
                <button type="button" class="btn" data-bind="click: $parent.removeTradeAccountFromAdvertiserClass">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </td>
        <td role="gridcell">
            <span data-bind="text: AdvertiserClass?.Name"></span>
        </td>
    </tr>
</script>

<script id="trade-account-row-template" type="text/html">
    <tr>
        <td role="gridcell" class="trade-account-cell">
            <span data-bind="text: Code"></span>
        </td>
        <td role="gridcell" class="trade-account-cell">
            <span data-bind="text: Name"></span>
        </td>
        <td role="gridcell" class="member-since-date-cell">
            <span data-bind="text: moment(AdvertiserSinceDT).format('DD/MM/YYYY')"></span>
        </td>
        <td role="gridcell" class="removal-cell">
            <button type="button" class="btn" data-bind="click: $parent.removeTradeAccountFromAdvertiserClass">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</script>

<script type="text/x-kendo-template" id="detail-template">
    <div class="detail-grid" data-bind="kendoGrid: gridParams"></div>
</script>

@section styles {
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/generic-forms")
    @Styles.Render("~/bundles/css/advertiser-maintenance")
    @Styles.Render("~/bundles/css/tempus-dominus")
    @Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/advertiser-maintenance")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">
        window.getPreselectedSalesMarketId = () => {
            return '@(Model.FixedSalesMarketID)';
        }
    </script>

    <script type="text/javascript">

        var viewModel = advertiserMaintenanceViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

    </script>
}
<div class="blocker" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="page-heading-wrapper">
    <div class="page-heading-logo">
        <div></div>
    </div>
    <div class="page-heading text-right">
        @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
        {
            <h1 class="main-heading">
                @(Model.ApplicationHeading)
            </h1>
        }
        @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
        {
            <h4 class="sub-heading">
                <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
            </h4>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div id="prefilters">
            <div id="sales-market-prefilter" class="prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: salesMarketParams }"></div>
            <div id="advertiser-group-prefilter" class="prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: advertiserClassParams }"></div>
            <div id="trade-account-prefilter" class="prefilter" data-bind="component: { name: 'kendo-mdc-dropdown-component', params: tradeAccountSearchParams }"></div>
        </div>
        <div id="advertiser-group-container-wrapper">
            <div id="advertiser-group-container">
                <p class="mb-0 mt-3" style="display: none" data-bind="visible: true, css: { 'd-none': salesMarket }">
                    Please select a Sales Market
                </p>
                <div id="advertiser-group-membership" style="display: none;" data-bind="visible: salesMarket">
                    <div id="membership-grid" data-bind="kendoGrid: advertiserClassGridParams"></div>
                    <div class="mt-3 d-flex justify-content-end">
                        <button type="button" class="btn btn-dark d-flex gap-2 justify-content-between align-items-center" data-bind="click: downloadtoExcel">
                            Download to Excel
                            <i class="bi bi-floppy ms-2"></i>
                        </button>
                    </div>
                </div>
                @*<ul class="mt-3">
                    <li>
                        Make Market Mandatory ✔
                    </li>
                    <li>
                        Possibly make the add icon green ✔
                    </li>
                    <li>
                        Change the X to a trash can icon ✔
                    </li>
                    <li>
                        Download to Excel option ✔
                    </li>
                    <li>
                        Search for Trade Account to discover which Advertising Class they're in ✔
                    </li>
                </ul>*@
            </div>
        </div>
    </div>
</div>

