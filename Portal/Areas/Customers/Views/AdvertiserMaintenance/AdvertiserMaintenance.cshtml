@model Portal.Areas.Customers.ViewModels.AdvertiserMaintenanceViewModel
@{
    ViewBag.Title = "Advertiser Maintenance";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/generic-forms")
    @Styles.Render("~/bundles/css/advertiser-maintenance")
    @Styles.Render("~/bundles/css/tempus-dominus")
    @Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/advertiser-maintenance")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">
        window.getPreselectedSalesMarketId = () => {
            return '@(Model.FixedSalesMarketID)';
        }
    </script>

    <script type="text/javascript">

        var viewModel = advertiserMaintenanceViewModel();

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

    </script>
}

<script id="ko-pager-template" type="text/html">
    <li class="page-item bookend ripple disabled" data-bind="css: { 'disabled': false }">
        <a href="javascript:;">
            <label class="page-link" aria-label="Previous Page"
                   data-bind="enable: backEnabled, click: () => navigatePrevious(), css: { 'disabled': !backEnabled() }">
                <span class="material-icons">
                    chevron_left
                </span>
                <span class="visually-hidden">
                    <input type="radio" name="page"
                           data-bind="checked: page, checkedValue: previousPage">
                </span>
            </label>
        </a>
    </li>
    <!-- ko if: leftEllipsisVisible -->
    <li class="page-item ripple disabled" data-bind="css: { 'disabled': false }">
        <a href="javascript:;">
            <label class="page-link" aria-label="Page - 2">
                <span>
                    &#8230;
                </span>
                <span class="visually-hidden">
                    <input type="radio" name="page"
                           data-bind="checked: page, checkedValue: 1">
                </span>
            </label>
        </a>
    </li>
    <!-- /ko -->
    <!-- ko foreach: visiblePages -->
    <li class="page-item ripple disabled" data-bind="css: { 'disabled': false, 'active': $parent.page() == $data.page }">
        <a href="javascript:;">
            <label class="page-link" aria-label="Previous Page">
                <span data-bind="text: $data.page"></span>
                <span class="visually-hidden">
                    <input type="radio" name="page"
                           data-bind="checked: $parent.page, checkedValue: $data.page">
                </span>
            </label>
        </a>
    </li>
    <!-- /ko -->
    <!-- ko if: rightEllipsisVisible -->
    <li class="page-item ripple disabled" data-bind="css: { 'disabled': false }">
        <a href="javascript:;">
            <label class="page-link" aria-label="Page + 2">
                <span>
                    &#8230;
                </span>
                <span class="visually-hidden">
                    <input type="radio" name="page"
                           data-bind="checked: page, checkedValue: pageCount">
                </span>
            </label>
        </a>
    </li>
    <!-- /ko -->
    <li class="page-item bookend ripple disabled" data-bind="css: { 'disabled': false }">
        <a href="javascript:;">
            <label class="page-link" aria-label="Previous Page"
                   data-bind="enable: forwardEnabled, click: () => navigateNext(), css: { 'disabled': !forwardEnabled() }">
                <span class="material-icons">
                    chevron_right
                </span>
                <span class="visually-hidden">
                    <input type="radio" name="page"
                           data-bind="checked: page, checkedValue: nextPage">
                </span>
            </label>
        </a>
    </li>
</script>

<script type="text/html" id="trade-account-pod">
    <h2 data-bind="text: ShortLabel"></h2>
</script>

<script type="text/html" id="gift-voucher-row-template">
    <tr class="gift-voucher-row">
        <td class="text-end">
            <span data-bind="text: GiftVoucherID"></span>
        </td>
        <td>
            <span data-bind="text: GiftVoucherType.Name"></span>
        </td>
        <td>
            <span data-bind="text: PriceList.Name"></span>
        </td>
        <td>
            <span data-bind="text: Code"></span>
        </td>
        <td class="text-end" colspan="500">
            @*<span data-bind="text: formatCurrency(ValueInc, 2, PriceList.Currency.FormattingCulture, CurrencyCode)"></span>*@
        </td>
        @*<td class="text-end">
            <span data-bind="text: formatCurrency(ValueEx, 2, PriceList.Currency.FormattingCulture, CurrencyCode)"></span>
        </td>
        <td>
            <span data-bind="text: CreatedDT ? moment(CreatedDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: AuthorisedDT ? moment(AuthorisedDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: ExpiryDT ? moment(ExpiryDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: UsedDT ? moment(UsedDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td>
            <span data-bind="text: CancelledDT ? moment(CancelledDT).format('DD/MM/YYYY HH:MM') : ''"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: RedeemTransactionID"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: SaleTransactionID"></span>
        </td>
        <td>
            <span data-bind="text: CreatedByMember?.FullName ?? 'eCommerce'"></span>
        </td>
        <td>
            <button type="button" class="btn btn-primary grid-btn" data-bind="click: (data, event) => { $parent.giftVoucherExtender.show($data); }">
                Extend
            </button>
            <button type="button" class="btn btn-success grid-btn" data-bind="click: (data, event) => { $parent.giftVoucherRedeemer.show($data); }">
                Redeem
            </button>
            <button type="button" class="btn btn-danger grid-btn" data-bind="click: (data, event) => { $parent.giftVoucherCanceller.show($data); }">
                Cancel
            </button>
            <button type="button" class="btn btn-secondary grid-btn" data-bind="click: (data, event) => { $root.viewVoucher($data); }">
                View
            </button>
            <button type="button" class="btn btn-secondary grid-btn">
                Email
            </button>
        </td>*@
    </tr>
</script>

<script type="text/html" id="grid-toolbar-create-new">
    <a id="create-new-btn" role="button" class="k-button k-button-icontext k-grid-CreateNew" href="javascript:;" data-bind="click: beginNewVoucher">
        <span class="k-icon k-i-add"></span>
        Create New
    </a>
</script>

<div class="blocker" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div class="page-heading-wrapper">
    <div class="page-heading-logo">
        <div></div>
    </div>
    <div class="page-heading text-right">
        @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
        {
            <h1 class="main-heading">
                @(Model.ApplicationHeading)
            </h1>
        }
        @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
        {
            <h4 class="sub-heading">
                <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
            </h4>
        }
    </div>
</div>

<ul class="nav nav-tabs nav-justified mt-5" id="advertiser-group-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fs-5 active" id="find-tab-btn" data-bs-toggle="tab" data-bs-target="#find-tab" type="button" role="tab" aria-controls="Find" aria-selected="true">
            Maintain an Advertiser Group
        </button>
    </li>
    @if (User.IsInRole("Super Admin") || User.IsInRole("Advertiser Maintenance"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fs-5" id="create-tab-btn" data-bs-toggle="tab" data-bs-target="#create-tab" type="button" role="tab" aria-controls="Create" aria-selected="false">
                Create an Advertiser Group
            </button>
        </li>
    }
</ul>
