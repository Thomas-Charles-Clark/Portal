<div id="add-trade-account-modal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header grey-blue">
                <h4 class="modal-title">
                    Add Trade Account
                </h4>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="bold fs-5" data-bind="with: addingToAdvertisingClass">
                    Advertising Class: <span data-bind="text: Name"></span>
                </p>
                <div data-bind="component: { name: 'kendo-mdc-dropdown-component', params: tradeAccountSelectorParams }"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button class="btn btn-primary" data-bind="click: addTradeAccountToAdvertiserClass">
                    Ok
                </button>
            </div>
        </div>
    </div>
</div>