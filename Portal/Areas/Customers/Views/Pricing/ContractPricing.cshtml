    <h4 class="mt-3">
        Please wait...
    </h4>
</div>

<div id="upper-section">
    <div id="prefilters-wrapper" style="display: none" data-bind="visible: true">
        <div id="prefilters-deals" class="grid">
            <div id="sales-market-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesMarketParams }"></div>
            <div id="sales-representative-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: salesRepresentativeParams }"></div>
            <div id="existing-contracts-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: existingContractsParams }"></div>
            <div id="trade-account-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: tradeAccountParams }"></div>
        </div>
        <div id="prefilters-impact" class="grid" style="display: none;" data-bind="visible: impactVisible">
            <div id="launch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
            <div id="brand-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
            <div id="product-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productGroupParams }"></div>
            <div id="item-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: itemTypeParams }"></div>
            <div id="collection-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
            <div id="search-term-prefilter" data-bind="component: { name: 'mdc-text-field-component', params: searchTermParams }"></div>
        </div>
    </div>
</div>

<div id="body-wrapper" style="display: none" data-bind="visible: tradeAccountDealDetails">
    <div id="trade-account-deals">
        <div id="current-deals" class="deal-group-heading">
            Current Deals
        </div>
        <div data-bind="with: tradeAccountGroupDealDetails">
            <div id="group-account" class="deal-group-heading">
                <span data-bind="text: label"></span>
                <a href="javascript:;">
                    [ Add new Date Range ]
                </a>
            </div>
            <!-- ko template: { name: 'date-ranges-template', data: Object.assign($data, { accordionId: 'group-date-ranges' }) } --><!-- /ko -->
        </div>
        <div data-bind="with: tradeAccountDealDetails">
            <div id="trade-account" class="deal-group-heading">
                <span>
                    <span data-bind="text: label"></span>
                    <span data-bind="with: $parent.tradeAccount">
                        <span data-bind="text: ` - ${TradePriceList.Code} - ${TradePriceList.Name}`"></span>
                    </span>
                </span>
                <a href="javascript:;">
                    [ Add new Date Range ]
                </a>
            </div>
            <!-- ko template: { name: 'date-ranges-template', data: Object.assign($data, { accordionId: 'account-date-ranges' }) } --><!-- /ko -->
        </div>
    </div>
    <div>
        <div id="impact" class="impact-heading" style="display: none;" data-bind="visible: haveImpactResults">
            Impact
        </div>
    </div>
</div>

@section afterContainer {
    <div class="modal fade" id="add-note-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="blocker" data-bind="flexFadeVisible: modalBusy">
                    <div class="loading-spinner"></div>
                    <h4 class="mt-3">
                        Please wait...
                    </h4>
                </div>
                <div class="modal-header">
                    <h5 class="modal-title">
                        Add Note
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideModal"></button>
                </div>
                <div class="modal-body">

                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" data-bind="click: hideModal">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}