                                <!-- /ko -->
                                <!-- ko foreach: items -->
                                <!-- ko if: headerVisible -->
                                <tr role="row" class="k-grouping-row product-page-name-row">
                                    <td class="k-group-cell"></td>
                                    <td colspan="300" aria-expanded="true">
                                        <p class="k-reset">
                                            <a class="k-icon k-i-collapse" href="#" tabindex="-1" aria-label="Collapse"></a>
                                            <span class="group-heading" style="transform: translateX(0px);" data-bind="text: name"></span>
                                        </p>
                                    </td>
                                </tr>
                                <!-- /ko -->
                                <!-- ko foreach: items -->
                                <!-- ko if: headerVisible -->
                                <tr role="row" class="k-grouping-row order-form-group-row">
                                    <td class="k-group-cell"></td>
                                    <td class="k-group-cell"></td>
                                    <td colspan="300" aria-expanded="true">
                                        <p class="k-reset">
                                            <a class="k-icon k-i-collapse" href="#" tabindex="-1" aria-label="Collapse"></a>
                                            <span class="group-heading" data-bind="text: `${name}`"></span>
                                        </p>
                                    </td>
                                </tr>
                                <!-- /ko -->
                                <!-- ko template: { name: 'row-template', foreach: visibleItems } --><!-- /ko -->
                                <!-- /ko -->
                                <!-- /ko -->
                            </tbody>
                            <tbody style="display: none" data-bind="visible: groupedSearchResults().length === 0 && busy() == false">
                                <tr class="no-results">
                                    <td colspan="300">
                                        <h4 class="mb-0">
                                            No Results
                                        </h4>
                                    </td>
                                </tr>
                            </tbody>
                            <tbody class="virtual-spacing">
                                <tr class="final-row">
                                    <td colspan="300" data-bind="style: { height: `${gridScrollBottomPadding()}px` }">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

