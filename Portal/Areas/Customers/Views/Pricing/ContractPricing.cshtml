<script id="contract-level-product-template" type="text/html">
    <!-- ko if: contracts.length === 0 -->
    <span class="no-contracts">
        No Deals
    </span>
    <!-- /ko -->
    <!-- ko if: contracts.length > 0 -->
    <table class="table table-hover contract-table">
        <colgroup>
            <col style="width: 30%" />
            <col style="width: 13%" />
            <col />
            <col />
        </colgroup>
        <thead>
            <tr>
                <th>
                    Product
                </th>
                <th class="text-end">
                    Deal
                </th>
                <th class="text-end">
                    Qty Break
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody data-bind="foreach: contracts">
            <tr data-bind="css: { 'selected': contractListId == $root.selectedContractListId() }, click: $root.fetchImpact">
                <td>
                    <span data-bind="text: productName"></span>
                </td>
                <td class="text-end">
                    <span data-bind="text: contractType == 'D' ? `${value}%` : `£${value}`"></span>
                </td>
                <td class="text-end">
                    <span data-bind="text: quantityBreak"></span>
                </td>
                <td class="text-end">
                    <span class="d-flex gap-2 justify-content-end">
                        <a href="javascript:;">
                            Edit
                        </a>
                        <a href="javascript:;">
                            Delete
                        </a>
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
    <!-- /ko -->
</script>

