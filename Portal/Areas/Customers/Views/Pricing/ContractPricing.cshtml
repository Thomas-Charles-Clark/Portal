<script id="date-ranges-template" type="text/html">
    <div class="date-ranges-wrapper accordion" data-bind="attr: { id: accordionId }, foreach: dateRanges">
        <div class="date-range accordion-item" data-bind="class: statusLabel.replace(/\s/g, '-').toLowerCase()">
            <div class="accordion-header">
                <div class="accordion-button"
                     type="button"
                     data-bs-toggle="collapse"
                     data-bind="attr: { 'data-bs-target': `#${$parent.accordionId}-date-range-${$index()}` }">
                    <span>
                        <span data-bind="text: label"></span>
                        <span data-bind="text: `(${contractLevels.reduce((a, i) => a = a + i.contracts.length, 0)} deal${(contractLevels.reduce((a, i) => a = a + i.contracts.length, 0) > 1 ? 's' : '')})`"></span>
                        <span class="bold ms-3" data-bind="text: statusLabel"></span>
                    </span>
                    <div class="ms-auto">
                        <a href="javascript:;">Edit</a>
                        <a href="javascript:;">Delete</a>
                    </div>
                </div>
            </div>
            <div class="accordion-collapse collapse show"
                 data-bind="attr: {
                    id: `${$parent.accordionId}-date-range-${$index()}`,
                    'data-bs-parent': `#${$parent.accordionId}`
                 }">
                <div class="accordion-body">
                    <div class="deal-types accordion" data-bind="attr: { id: `${$root.accordionId}-deal-types` }, foreach: contractLevels">
                        <div class="accordion-item">
                            <div class="accordion-header">
                                <div class="accordion-button collapsed"
                                     type="button"
                                     data-bs-toggle="collapse"
                                     data-bind="attr: { 'data-bs-target': `#${$parentContext.$parent.accordionId}-date-range-${$parentContext.$index()}-contract-level-${$index()}` }">
                                    <span data-bind="text: `${label} Deals (${contracts.length})`"></span>
                                    <div class="ms-auto">
                                        <a href="javascript:;">Add Deal</a>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-collapse collapse"
                                 data-bind="attr: { id: `${$parentContext.$parent.accordionId}-date-range-${$parentContext.$index()}-contract-level-${$index()}` }">
                                <div class="deal-types-wrapper">
                                    <!-- ko template: { name: `contract-level-${label.replace(/\s/g, '-').toLowerCase()}-template` } --><!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</script>

