        </td>
        <td class="text-end" data-bind="style: { 'background-color': actionTransferToBranchHighlight }">
            <div data-bind="visible: actionTransferToBranchBasketItemId() == null, component: { name: 'mdc-text-field-numeric-component', params: actionTransferToBranchQuantityParams }"></div>
            <button class="btn btn-sm btn-outline-primary" style="display: none" data-bind="
                    visible: actionTransferToBranchBasketItemId,
                    disable: actionTransferToBranchQuantityParams.busy,
                    click: removeWH2BRFromOrder,
                    css: { busy: actionTransferToBranchQuantityParams.busy },
                    attr: { title: `BasketItemID: ${actionTransferToBranchBasketItemId()}` }">
                Cancel Transfer of <span data-bind="text: actionTransferToBranchExtantTransferQuantity"></span>
            </button>
        </td>
        <td class="text-end" data-bind="style: { 'background-color': actionTransferToWarehouseHighlight }">
            <div data-bind="visible: actionTransferToWarehouseBasketItemId() == null, component: { name: 'mdc-text-field-numeric-component', params: actionTransferToWarehouseQuantityParams }"></div>
            <button class="btn btn-sm btn-outline-primary" style="display: none" data-bind="
                    visible: actionTransferToWarehouseBasketItemId,
                    disable: actionTransferToWarehouseQuantityParams.busy,
                    click: removeBR2WHFromOrder,
                    css: { busy: actionTransferToWarehouseQuantityParams.busy },
                    attr: { title: `BasketItemID: ${actionTransferToWarehouseBasketItemId()}` }">
                Cancel Transfer of <span data-bind="text: actionTransferToWarehouseExtantTransferQuantity"></span>
            </button>
        </td>
        <td>
            <button class="btn btn-secondary btn-sm submit-btn" data-bind="visible: submitVisible(), disable: busy, click: submitTransfers">
                Submit
            </button>
        </td>
        <td class="text-end">
            <span data-bind="text: sales180DayBranch"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: stockWHFreeStock"></span>
        </td>
        @*<td class="text-end">
                <span data-bind="text: stockCover"></span>
            </td>*@
        <td class="text-end">
            <span data-bind="text: stockWHNextPOFreeStock"></span>
        </td>
        <td>
            <!-- ko if: stockWHNextPODueDate -->
            <span data-bind="text: renderDate(stockWHNextPODueDate.substring(0, 10))"></span>
            <!-- /ko -->
        </td>
        <td class="text-end">
            <span data-bind="text: stockKRFreeStock"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: stockMHSFreeStock"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: stockFWFreeStock"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: stockRingFence"></span>
        </td>
        @*<td>
                <span data-bind="html: salesSummary"></span>
            </td>*@
        <td class="text-end">
            <span data-bind="text: sales180DayTotal"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: sales180DayKR"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: sales180DayMHS"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: sales180DayFW"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: sales180DayUKEcommerce"></span>
        </td>
        <td class="text-end">
            <span data-bind="text: sales180DayUKTrade"></span>
        </td>
        <td>
            <!-- ko if: notes != null && notes.length > 0 -->
            <button class="add-note-btn btn btn-link btn-sm" data-bind="click: $root.showAddNoteModal">
                <span data-bind="text: notes"></span>
            </button>
            <!-- /ko -->
            <!-- ko if: notes == null || notes.length == 0 -->
            <button class="add-note-btn btn btn-sm" data-bind="click: $root.showAddNoteModal">
                <i class="material-icons">add</i>
            </button>
            <!-- /ko -->
        </td>
    </tr>
    <!-- /ko -->
</script>


