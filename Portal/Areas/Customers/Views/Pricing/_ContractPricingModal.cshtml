@model Portal.Areas.Customers.ViewModels.ContractPricingViewModel

<script id="product-group-item-type-row" type="text/html">
    <tr>
        <th>
            <span data-bind="text: label"></span>
        </th>
        <td class="checkbox-column text-center">
            <label class="brand-checkbox-wrapper">
                <input type="checkbox" data-bind="checked: allBrands" />
            </label>
            @*<div data-bind="component: { name: 'mdc-checkbox-component', params: allBrands }"></div>*@
        </td>
        <!-- ko foreach: brands -->
        <td class="checkbox-column text-center">
            <label class="brand-checkbox-wrapper">
                <input type="checkbox" data-bind="checked: checked" />
            </label>
            @*<div data-bind="component: { name: 'mdc-checkbox-component', params: checkedParams }"></div>*@
        </td>
        <!-- /ko -->
        <td>
            <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
        </td>
        <td>
            <span data-bind="text: status"></span>
        </td>
    </tr>
</script>

<div class="modal fade" id="contract-pricing-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" data-bind="with: contractPricingEditor">
            <div class="blocker" data-bind="flexFadeVisible: busy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title" data-bind="html: modalTitle">
                    Contract Prices
                </h5>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" data-bind="click: hideModal"></button>
            </div>
            <div class="modal-body">
                <ul id="contract-editor-nav" class="nav nav-pills" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button id="product-group-item-type-tab-btn" class="nav-link" data-bs-toggle="tab" data-bs-target="#product-group-item-type-tab" type="button" role="tab">
                            Product Group / Item Type
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button id="quality-tab-btn" class="nav-link active" data-bs-toggle="tab" data-bs-target="#quality-tab" type="button" role="tab">
                            Design
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button id="product-tab-btn" class="nav-link" data-bs-toggle="tab" data-bs-target="#product-tab" type="button" role="tab">
                            Product
                        </button>
                    </li>
                </ul>
                <div id="contract-editor-content" class="tab-content">
                    <div id="product-group-item-type-tab" class="tab-pane fade" role="tabpanel" data-bind="with: productGroupItemTypeEditor">
                        <table class="table table-condensed table-bordered table-striped product-group-item-type-table mt-3">
                            <colgroup>
                                <col class="title-column" />
                                <col class="checkbox-column all-brands" />
                                <!-- ko foreach: brands -->
                                <col class="checkbox-column" />
                                <!-- /ko -->
                                <col class="discount-column" />
                                <col class="status-column" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>

                                    </th>
                                    <th class="text-center">
                                        All Brands
                                    </th>
                                    <!-- ko foreach: brands -->
                                    <th class="text-center">
                                        <span data-bind="text: Code, attr: { title: Name }"></span>
                                    </th>
                                    <!-- /ko -->
                                    <th>
                                        Discount
                                    </th>
                                    <th>
                                        Status
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllFabric } --><!-- /ko -->
                                <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllWallpaper } --><!-- /ko -->
                                <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllPatternBooks } --><!-- /ko -->
                                <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllRugs } --><!-- /ko -->
                            </tbody>
                        </table>
                        <!-- ko foreach: Object.keys(itemTypesByProductGroup) -->
                        <table class="table table-condensed table-bordered table-striped product-group-item-type-table mt-5">
                            <colgroup>
                                <col class="title-column" />
                                <col class="checkbox-column all-brands" />
                                <!-- ko foreach: $parent.brands -->
                                <col class="checkbox-column" />
                                <!-- /ko -->
                                <col class="discount-column" />
                                <col class="status-column" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th data-bind="attr: { colspan: $parent.brands.length + 4 }">
                                        <span data-bind="text: $data"></span>
                                    </th>
                                </tr>
                                <tr>
                                    <th>

                                    </th>
                                    <th class="text-center">
                                        All Brands
                                    </th>
                                    <!-- ko foreach: $parent.brands -->
                                    <th class="text-center">
                                        <span data-bind="text: Code, attr: { title: Name }"></span>
                                    </th>
                                    <!-- /ko -->
                                    <th>
                                        Discount
                                    </th>
                                    <th>
                                        Status
                                    </th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: $parent.itemTypesByProductGroup[$data]">
                                <!-- ko template: { name: 'product-group-item-type-row' } --><!-- /ko -->
                            </tbody>
                        </table>
                        <!-- /ko -->
                    </div>
                    <div id="quality-tab" class="tab-pane fade show active" role="tabpanel" data-bind="with: qualityEditor">
                        <div id="quality-wrapper" class="grid">
                            <div id="quality-search">
                                <div id="quality-prefilters" class="grid">
                                    <div id="quality-launch-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
                                    <div id="quality-brand-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
                                    <div id="quality-collection-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
                                    <div id="quality-product-group-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productGroupParams }"></div>
                                    <div id="quality-item-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: itemTypeParams }"></div>
                                    <div id="quality-search-term-prefilter" data-bind="component: { name: 'mdc-text-field-component', params: searchTermParams }"></div>
                                </div>
                                <!-- ko with: virtualScroller -->
                                <div id="quality-results-scroller-container" class="virtual-scroller-container">
                                    <table id="quality-search-results-table" class="table table-condensed table-striped table-hover product-group-item-type-table">
                                        <colgroup>
                                            <col class="code-column" />
                                            <col class="name-column" />
                                            <col class="checkbox-column" />
                                            <col class="sales-quantity-column" />
                                            <col class="sales-value-column" />
                                            <col class="current-price-column" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>
                                                    Design Code
                                                </th>
                                                <th>
                                                    Design Name
                                                </th>
                                                <th>

                                                </th>
                                                <th class="text-end">
                                                    Quantity Sold<br />
                                                    Last 180 Days
                                                </th>
                                                <th class="text-end">
                                                    Sales Value<br />
                                                    Last 180 Days
                                                </th>
                                                <th class="text-end">
                                                    Current Price
                                                </th>
                                            </tr>
                                        </thead>
                                        <!-- ko if: visibleItems().length > 0 -->
                                        <tbody class="virtual-spacing">
                                            <tr>
                                                <td colspan="6" style="height: 0px;" data-bind="style: { height: `${gridScrollTopPadding()}px` }"></td>
                                            </tr>
                                        </tbody>
                                        <tbody data-bind="foreach: visibleItems">
                                            <tr class="search-result" data-bind="css: { 'busy': busy }, click: $parentContext.$parent.toggleSelection">
                                                <td>
                                                    <span data-bind="text: QualityCode"></span>
                                                </td>
                                                <td>
                                                    <span data-bind="text: QualityName"></span>
                                                </td>
                                                <td class="text-center">
                                                    <label class="checkbox-wrapper" tabindex="-1">
                                                        <input type="checkbox" name="selected-qualities" data-bind="click: (data, event) => { event.preventDefault(); $parentContext.$parent.toggleSelection(data); }, checked: $parentContext.$parent.selectedQualityIds, checkedValue: QualityID" />
                                                    </label>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: salesQuantity"></span>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: salesValue"></span>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: currentPrice"></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tbody class="virtual-spacing">
                                            <tr class="final-row">
                                                <td colspan="6" style="height: 0px;" data-bind="style: { height: `${gridScrollBottomPadding()}px` }"></td>
                                            </tr>
                                        </tbody>
                                        <!-- /ko -->
                                        <!-- ko ifnot: visibleItems().length > 0 -->
                                        <tbody>
                                            <tr class="no-results">
                                                <td colspan="6">
                                                    No search results
                                                </td>
                                            </tr>
                                        </tbody>
                                        <!-- /ko -->
                                    </table>
                                </div>
                                <!-- /ko -->
                            </div>
                            <div id="quality-specify">
                                <!-- ko if: selectedQualityIds().length -->
                                <h2 id="quality-count">
                                    <span data-bind="text: `${selectedQualityIds().length} Design${selectedQualityIds().length > 1 ? 's' : ''} selected`"></span>
                                </h2>
                                <table id="selected-qualities-table" class="table table-condensed table-striped table-hover product-group-item-type-table">
                                    <colgroup>
                                        <col class="discount-column" />
                                        <col />
                                        <col class="quantity-break-column" />
                                        <col class="date-column" />
                                        <col class="date-column" />
                                        <col class="status-column" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                Discount
                                            </th>
                                            <th></th>
                                            <th>
                                                Quantity Break
                                            </th>
                                            <th>
                                                Start Date
                                            </th>
                                            <th>
                                                End Date
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: selectedQualities">
                                        <tr>
                                            <td>
                                                <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
                                            </td>
                                            <td></td>
                                            <td>
                                                Qty Break
                                            </td>
                                            <td>
                                                Start Date
                                            </td>
                                            <td>
                                                End Date
                                            </td>
                                            <td>
                                                Status
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <!-- /ko -->
                                <!-- ko ifnot: selectedQualityIds().length -->
                                <h2 id="quality-count">
                                    No Designs Specified
                                </h2>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div id="product-tab" class="tab-pane fade" role="tabpanel">
                        <h2>
                            Product
                        </h2>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-bind="click: hideModal">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>