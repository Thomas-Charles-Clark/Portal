@model Portal.Areas.Customers.ViewModels.ContractPricingViewModel

<script id="product-group-item-type-row" type="text/html">
    <tr>
        <th>
            <span data-bind="text: label"></span>
        </th>
        <td class="checkbox-column text-center">
            <label class="brand-checkbox-wrapper">
                <input type="checkbox" data-bind="checked: allBrands" />
            </label>
            @*<div data-bind="component: { name: 'mdc-checkbox-component', params: allBrands }"></div>*@
        </td>
        <!-- ko foreach: brands -->
        <td class="checkbox-column text-center" data-bind="css: { 'invalid': !$parent.brandSelectionValid() }">
            <label class="brand-checkbox-wrapper">
                <input type="checkbox" data-bind="checked: checked" />
            </label>
            @*<div data-bind="component: { name: 'mdc-checkbox-component', params: checkedParams }"></div>*@
        </td>
        <!-- /ko -->
        <td>
            <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
        </td>
        <td>
            <span data-bind="text: status"></span>
        </td>
    </tr>
</script>

<div class="modal fade" id="contract-pricing-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" data-bind="with: contractPricingEditor">
            <div class="blocker" data-bind="flexFadeVisible: busy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title" data-bind="html: modalTitle">
                    Contract Prices
                </h5>
                <button type="button" class="btn-close btn-close-white" aria-label="Close" data-bind="click: hideModal"></button>
            </div>
            <div class="modal-body">
                <ul id="contract-editor-nav" class="nav nav-pills" role="tablist">
                    <li class="nav-item" role="presentation" data-bind="css: { 'errored': productGroupItemTypeEditor.errors().length },
                        attr: { 'title': productGroupItemTypeEditor.errors().length ? 'Please correct all errors before saving' : '' }">
                        <button id="product-group-item-type-tab-btn" class="nav-link" data-bs-toggle="tab" data-bs-target="#product-group-item-type-tab" type="button" role="tab">
                            Product Group / Item Type
                            <!-- ko if: productGroupItemTypeEditor.errors().length -->
                            <span class="material-icons">
                                warning
                            </span>
                            <!-- /ko -->
                        </button>
                    </li>
                    <li class="nav-item" role="presentation" data-bind="css: { 'errored': qualityEditor.errors().length },
                        attr: { 'title': qualityEditor.errors().length ? 'Please correct all errors before saving' : '' }">
                        <button id="quality-tab-btn" class="nav-link active" data-bs-toggle="tab" data-bs-target="#quality-tab" type="button" role="tab">
                            Design
                            <!-- ko if: qualityEditor.errors().length -->
                            <span class="material-icons">
                                warning
                            </span>
                            <!-- /ko -->
                        </button>
                    </li>
                    <li class="nav-item" role="presentation" data-bind="css: { 'errored': productEditor.errors().length },
                        attr: { 'title': productEditor.errors().length ? 'Please correct all errors before saving' : '' }">
                        <button id="product-tab-btn" class="nav-link" data-bs-toggle="tab" data-bs-target="#product-tab" type="button" role="tab">
                            Product
                            <!-- ko if: productEditor.errors().length -->
                            <span class="material-icons">
                                warning
                            </span>
                            <!-- /ko -->
                        </button>
                    </li>
                </ul>
                <div id="contract-editor-content" class="tab-content">
                    <div id="product-group-item-type-tab" class="tab-pane fade" role="tabpanel" data-bind="with: productGroupItemTypeEditor">
                        <div class="grid">
                            <div>
                                <h3 class="product-group-item-type-title">
                                    Product Groups
                                </h3>
                                <table class="table table-condensed table-bordered table-striped product-group-item-type-table mt-3 mb-5">
                                    <colgroup>
                                        <col class="title-column" />
                                        <col class="checkbox-column all-brands" />
                                        <!-- ko foreach: brands -->
                                        <col class="checkbox-column" />
                                        <!-- /ko -->
                                        <col class="discount-column" />
                                        <col class="status-column" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>

                                            </th>
                                            <th class="text-center">
                                                All Brands
                                            </th>
                                            <!-- ko foreach: brands -->
                                            <th class="text-center">
                                                <span data-bind="text: Code, attr: { title: Name }"></span>
                                            </th>
                                            <!-- /ko -->
                                            <th>
                                                Discount
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllFabric } --><!-- /ko -->
                                        <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllWallpaper } --><!-- /ko -->
                                        <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllPatternBooks } --><!-- /ko -->
                                        <!-- ko template: { name: 'product-group-item-type-row', data: productGroupAllRugs } --><!-- /ko -->
                                    </tbody>
                                </table>
                                <h3 class="product-group-item-type-title">
                                    Item Types
                                </h3>
                                <!-- ko foreach: itemTypesByProductGroup -->
                                <table class="table table-condensed table-bordered table-striped product-group-item-type-table">
                                    <colgroup>
                                        <col class="title-column" />
                                        <col class="checkbox-column all-brands" />
                                        <!-- ko foreach: $parent.brands -->
                                        <col class="checkbox-column" />
                                        <!-- /ko -->
                                        <col class="discount-column" />
                                        <col class="status-column" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th data-bind="attr: { colspan: $parent.brands.length + 4 }">
                                                <span data-bind="text: key"></span>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th>

                                            </th>
                                            <th class="text-center">
                                                All Brands
                                            </th>
                                            <!-- ko foreach: $parent.brands -->
                                            <th class="text-center">
                                                <span data-bind="text: Code, attr: { title: Name }"></span>
                                            </th>
                                            <!-- /ko -->
                                            <th>
                                                Discount / Final Price
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: itemTypes">
                                        <!-- ko template: { name: 'product-group-item-type-row' } --><!-- /ko -->
                                    </tbody>
                                </table>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div id="quality-tab" class="tab-pane fade show active" role="tabpanel" data-bind="with: qualityEditor">
                        <div class="blocker" data-bind="flexFadeVisible: busy">
                            <div class="loading-spinner"></div>
                            <h4 class="mt-3">
                                Please wait...
                            </h4>
                        </div>
                        <div class="search-wrapper grid">
                            <div class="search">
                                <div class="prefilters grid">
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productGroupParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: itemTypeParams }"></div>
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: searchTermParams }"></div>
                                </div>
                                <!-- ko with: virtualScroller -->
                                <div id="quality-results-scroller-container" class="virtual-scroller-container">
                                    <table id="quality-search-results-table" class="table table-condensed table-striped table-hover product-group-item-type-table">
                                        <colgroup>
                                            <col class="code-column" />
                                            <col class="name-column" />
                                            <col class="checkbox-column" />
                                            <col class="sales-quantity-column" />
                                            <col class="sales-value-column" />
                                            <col class="current-price-column" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>
                                                    Design Code
                                                </th>
                                                <th>
                                                    Design Name
                                                </th>
                                                <th>

                                                </th>
                                                <th class="text-end">
                                                    Quantity Sold<br />
                                                    Last 180 Days
                                                </th>
                                                <th class="text-end">
                                                    Sales Value<br />
                                                    Last 180 Days
                                                </th>
                                                <th class="text-end">
                                                    Current Price
                                                </th>
                                            </tr>
                                        </thead>
                                        <!-- ko if: visibleItems().length > 0 -->
                                        <tbody class="virtual-spacing">
                                            <tr>
                                                <td colspan="6" style="height: 0px;" data-bind="style: { height: `${gridScrollTopPadding()}px` }"></td>
                                            </tr>
                                        </tbody>
                                        <tbody data-bind="foreach: visibleItems">
                                            <tr class="search-result" data-bind="css: { 'busy': busy }, click: $parentContext.$parent.toggleSelection">
                                                <td>
                                                    <span data-bind="text: QualityCode"></span>
                                                </td>
                                                <td>
                                                    <span data-bind="text: QualityName"></span>
                                                </td>
                                                <td class="text-center">
                                                    <label class="checkbox-wrapper" tabindex="-1">
                                                        <input type="checkbox" name="selected-qualities" data-bind="click: (data, event) => { event.preventDefault(); $parentContext.$parent.toggleSelection(data); }, checked: $parentContext.$parent.selectedQualityIds, checkedValue: QualityID" />
                                                    </label>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: salesQuantity"></span>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: salesValue"></span>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: currentPrice"></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tbody class="virtual-spacing">
                                            <tr class="final-row">
                                                <td colspan="6" style="height: 0px;" data-bind="style: { height: `${gridScrollBottomPadding()}px` }"></td>
                                            </tr>
                                        </tbody>
                                        <!-- /ko -->
                                        <!-- ko ifnot: visibleItems().length > 0 -->
                                        <tbody>
                                            <tr class="no-results">
                                                <td colspan="6">
                                                    No search results
                                                </td>
                                            </tr>
                                        </tbody>
                                        <!-- /ko -->
                                    </table>
                                </div>
                                <!-- /ko -->
                            </div>
                            <div id="quality-specify">
                                <!-- ko if: selectedQualityIds().length -->
                                <h2 id="quality-count">
                                    <span data-bind="text: `${selectedQualityIds().length} Design${selectedQualityIds().length > 1 ? 's' : ''} selected`"></span>
                                </h2>
                                <table id="selected-qualities-table" class="table table-condensed table-striped discounter-table">
                                    <colgroup>
                                        <col class="code-column" />
                                        <col class="name-column" />
                                        <col class="quantity-break-column" />
                                        <col class="discounter-column" />
                                        <col class="status-column" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                Design Code
                                            </th>
                                            <th>
                                                Design Name
                                            </th>
                                            <th>
                                                Quantity Break
                                                <a class="small" href="javascript:;" data-bind="click: showSetAllModal">
                                                    Set All
                                                </a>
                                            </th>
                                            <th>
                                                Discount / Final Price
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: selectedQualities">
                                        <tr>
                                            <td>
                                                <span data-bind="text: QualityCode"></span>
                                            </td>
                                            <td>
                                                <span data-bind="text: QualityName"></span>
                                            </td>
                                            <td colspan="2">
                                                <!-- ko foreach: quantityBreaks -->
                                                <div class="d-flex quantity-break-controls">
                                                    <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: quantityBreakParams }"></div>
                                                    <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
                                                    <!-- ko if: $index() == 0 -->
                                                    <button class="btn btn-secondary btn-add-quantity-break" data-bind="click: $parent.addQuantityBreak" tabindex="-1">
                                                        <span class="material-icons">
                                                            add
                                                        </span>
                                                    </button>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: $index() == 0 -->
                                                    <button class="btn btn-secondary btn-remove-quantity-break" data-bind="click: $parent.removeQuantityBreak" tabindex="-1">
                                                        <span class="material-icons">
                                                            remove
                                                        </span>
                                                    </button>
                                                    <!-- /ko -->
                                                </div>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <span>
                                                    Status
                                                </span>
                                            </td>
                                        </tr>
                                        <!-- ko if: $parent.afterSelectedQualitiesRender($index()) --><!-- /ko -->
                                    </tbody>
                                </table>
                                <!-- /ko -->
                                <!-- ko ifnot: selectedQualityIds().length -->
                                <h2 id="quality-count">
                                    No Designs Specified
                                </h2>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div id="product-tab" class="tab-pane fade" role="tabpanel" data-bind="with: productEditor">
                        <div class="blocker" data-bind="flexFadeVisible: busy">
                            <div class="loading-spinner"></div>
                            <h4 class="mt-3">
                                Please wait...
                            </h4>
                        </div>
                        <div class="search-wrapper grid">
                            <div class="search">
                                <div class="prefilters grid">
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: launchParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: brandParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: collectionParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: productGroupParams }"></div>
                                    <div data-bind="component: { name: 'mdc-kendo-dropdown-component', params: itemTypeParams }"></div>
                                    <div data-bind="component: { name: 'mdc-text-field-component', params: searchTermParams }"></div>
                                </div>
                                <!-- ko with: virtualScroller -->
                                <div id="product-results-scroller-container" class="virtual-scroller-container">
                                    <table id="product-search-results-table" class="table table-condensed table-striped table-hover product-group-item-type-table">
                                        <colgroup>
                                            <col class="code-column" />
                                            <col class="name-column" />
                                            <col class="checkbox-column" />
                                            <col class="sales-quantity-column" />
                                            <col class="sales-value-column" />
                                            <col class="current-price-column" />
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>
                                                    Product Code
                                                </th>
                                                <th>
                                                    Product Name
                                                </th>
                                                <th>

                                                </th>
                                                <th class="text-end">
                                                    Quantity Sold<br />
                                                    Last 180 Days
                                                </th>
                                                <th class="text-end">
                                                    Sales Value<br />
                                                    Last 180 Days
                                                </th>
                                                <th class="text-end">
                                                    Current Price
                                                </th>
                                            </tr>
                                        </thead>
                                        <!-- ko if: visibleItems().length > 0 -->
                                        <tbody class="virtual-spacing">
                                            <tr>
                                                <td colspan="6" style="height: 0px;" data-bind="style: { height: `${gridScrollTopPadding()}px` }"></td>
                                            </tr>
                                        </tbody>
                                        <tbody data-bind="foreach: visibleItems">
                                            <tr class="search-result" data-bind="css: { 'busy': busy }, click: $parentContext.$parent.toggleSelection">
                                                <td>
                                                    <span data-bind="text: ProductCode"></span>
                                                </td>
                                                <td>
                                                    <span data-bind="text: ProductName"></span>
                                                </td>
                                                <td class="text-center">
                                                    <label class="checkbox-wrapper" tabindex="-1">
                                                        <input type="checkbox" name="selected-qualities" data-bind="click: (data, event) => { event.preventDefault(); $parentContext.$parent.toggleSelection(data); }, checked: $parentContext.$parent.selectedQualityIds, checkedValue: ProductID" />
                                                    </label>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: salesQuantity"></span>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: salesValue"></span>
                                                </td>
                                                <td class="text-end">
                                                    <span data-bind="text: currentPrice"></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tbody class="virtual-spacing">
                                            <tr class="final-row">
                                                <td colspan="6" style="height: 0px;" data-bind="style: { height: `${gridScrollBottomPadding()}px` }"></td>
                                            </tr>
                                        </tbody>
                                        <!-- /ko -->
                                        <!-- ko ifnot: visibleItems().length > 0 -->
                                        <tbody>
                                            <tr class="no-results">
                                                <td colspan="6">
                                                    No search results
                                                </td>
                                            </tr>
                                        </tbody>
                                        <!-- /ko -->
                                    </table>
                                </div>
                                <!-- /ko -->
                            </div>
                            <div id="product-specify">
                                <!-- ko if: selectedQualityIds().length -->
                                <h2 id="product-count">
                                    <span data-bind="text: `${selectedQualityIds().length} Design${selectedQualityIds().length > 1 ? 's' : ''} selected`"></span>
                                </h2>
                                <table id="selected-products-table" class="table table-condensed table-striped discounter-table">
                                    <colgroup>
                                        <col class="code-column" />
                                        <col class="name-column" />
                                        <col class="quantity-break-column" />
                                        <col class="discounter-column" />
                                        <col class="status-column" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                Design Code
                                            </th>
                                            <th>
                                                Design Name
                                            </th>
                                            <th>
                                                Quantity Break
                                                <a class="small" href="javascript:;" data-bind="click: showSetAllModal">
                                                    Set All
                                                </a>
                                            </th>
                                            <th>
                                                Discount / Final Price
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: selectedQualities">
                                        <tr>
                                            <td>
                                                <span data-bind="text: ProductCode"></span>
                                            </td>
                                            <td>
                                                <span data-bind="text: ProductName"></span>
                                            </td>
                                            <td colspan="2">
                                                <!-- ko foreach: quantityBreaks -->
                                                <div class="d-flex quantity-break-controls">
                                                    <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: quantityBreakParams }"></div>
                                                    <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
                                                    <!-- ko if: $index() == 0 -->
                                                    <button class="btn btn-secondary btn-add-quantity-break" data-bind="click: $parent.addQuantityBreak" tabindex="-1">
                                                        <span class="material-icons">
                                                            add
                                                        </span>
                                                    </button>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: $index() == 0 -->
                                                    <button class="btn btn-secondary btn-remove-quantity-break" data-bind="click: $parent.removeQuantityBreak" tabindex="-1">
                                                        <span class="material-icons">
                                                            remove
                                                        </span>
                                                    </button>
                                                    <!-- /ko -->
                                                </div>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <span>
                                                    Status
                                                </span>
                                            </td>
                                        </tr>
                                        <!-- ko if: $parent.afterSelectedQualitiesRender($index()) --><!-- /ko -->
                                    </tbody>
                                </table>
                                <!-- /ko -->
                                <!-- ko ifnot: selectedQualityIds().length -->
                                <h2 id="product-count">
                                    No Products Specified
                                </h2>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- ko if: errors().length -->
                <span class="validation-message">
                    Please correct all errors before saving.
                    <span data-bind="text: productGroupItemTypeEditor.errorSummaryMessage"></span>
                    <span data-bind="text: qualityEditor.errorSummaryMessage"></span>
                    <span data-bind="text: productEditor.errorSummaryMessage"></span>
                </span>
                <!-- /ko -->
                <button class="btn btn-primary" data-bind="click: save">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quality-discounter-set-all-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: contractPricingEditor.qualityEditor">
            <div class="blocker" data-bind="flexFadeVisible: setAllBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title">
                    Set All Quantity Breaks / Discounts
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideSetAllModal"></button>
            </div>
            <div class="modal-body" data-bind="with: setAllRecord">
                <table id="set-all-qualities-table" class="table table-condensed table-striped discounter-table">
                    <colgroup>
                        <col class="quantity-break-column" />
                        <col class="discounter-column" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>
                                Quantity Break
                            </th>
                            <th>
                                Discount / Final Price
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="2">
                                <!-- ko foreach: quantityBreaks -->
                                <div class="d-flex quantity-break-controls">
                                    <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: quantityBreakParams }"></div>
                                    <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
                                    <!-- ko if: $index() == 0 -->
                                    <button class="btn btn-secondary btn-add-quantity-break" data-bind="click: $parent.addQuantityBreak" tabindex="-1">
                                        <span class="material-icons">
                                            add
                                        </span>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko ifnot: $index() == 0 -->
                                    <button class="btn btn-secondary btn-remove-quantity-break" data-bind="click: $parent.removeQuantityBreak" tabindex="-1">
                                        <span class="material-icons">
                                            remove
                                        </span>
                                    </button>
                                    <!-- /ko -->
                                </div>
                                <!-- ko if: $parentContext.$parent.afterSelectedQualitiesRender($index()) --><!-- /ko -->
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
                <!-- ko if: $parent.setAllBusy -->
                <div class="progress-wrapper">
                    <progress max="100" value="0" data-bind="attr: { value: $parent.setAllProgress }"></progress>

                    <label data-bind="text: `${Math.round(($parent.setAllProgress() * 10) / 10)}%`"></label>
                </div>
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <!-- ko if: setAllErrors.isAnyMessageShown() -->
                <span class="validation-message">
                    Please correct all errors above.
                </span>
                <!-- /ko -->
                <button class="btn btn-secondary" data-bind="click: resetSetAll">
                    Reset
                </button>
                <button class="btn btn-primary" data-bind="click: setAll">
                    Apply
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="product-discounter-set-all-modal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: contractPricingEditor.productEditor">
            <div class="blocker" data-bind="flexFadeVisible: setAllBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3">
                    Please wait...
                </h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title">
                    Set All Quantity Breaks / Discounts
                </h5>
                <button type="button" class="btn-close" aria-label="Close" data-bind="click: hideSetAllModal"></button>
            </div>
            <div class="modal-body" data-bind="with: setAllRecord">
                <table id="set-all-products-table" class="table table-condensed table-striped discounter-table">
                    <colgroup>
                        <col class="quantity-break-column" />
                        <col class="discounter-column" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>
                                Quantity Break
                            </th>
                            <th>
                                Discount / Final Price
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="2">
                                <!-- ko foreach: quantityBreaks -->
                                <div class="d-flex quantity-break-controls">
                                    <div data-bind="component: { name: 'mdc-text-field-numeric-component', params: quantityBreakParams }"></div>
                                    <div data-bind="component: {  name: 'mdc-discounter-component', params: discounter }"></div>
                                    <!-- ko if: $index() == 0 -->
                                    <button class="btn btn-secondary btn-add-quantity-break" data-bind="click: $parent.addQuantityBreak" tabindex="-1">
                                        <span class="material-icons">
                                            add
                                        </span>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko ifnot: $index() == 0 -->
                                    <button class="btn btn-secondary btn-remove-quantity-break" data-bind="click: $parent.removeQuantityBreak" tabindex="-1">
                                        <span class="material-icons">
                                            remove
                                        </span>
                                    </button>
                                    <!-- /ko -->
                                </div>
                                <!-- ko if: $parentContext.$parent.afterSelectedQualitiesRender($index()) --><!-- /ko -->
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
                <!-- ko if: $parent.setAllBusy -->
                <div class="progress-wrapper">
                    <progress max="100" value="0" data-bind="attr: { value: $parent.setAllProgress }"></progress>

                    <label data-bind="text: `${Math.round(($parent.setAllProgress() * 10) / 10)}%`"></label>
                </div>
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <!-- ko if: setAllErrors.isAnyMessageShown() -->
                <span class="validation-message">
                    Please correct all errors above.
                </span>
                <!-- /ko -->
                <button class="btn btn-secondary" data-bind="click: resetSetAll">
                    Reset
                </button>
                <button class="btn btn-primary" data-bind="click: setAll">
                    Apply
                </button>
            </div>
        </div>
    </div>
</div>