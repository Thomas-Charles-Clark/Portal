@model GDPR.ViewModels.GDPRSurveyViewModel
@{
    ViewBag.Title = "GDPR Internal Survey - Designers Guild Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/gdpr-survey")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/gdpr-survey")
    @*@Scripts.Render("~/bundles/js/components")
    @Scripts.Render("~/bundles/js/datetime-picker")*@

<script type="text/javascript">

    function getDataCategories() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.DataCategories));
    }

    function getIndividualCategories() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.IndividualCategories));
    }

    function getDataStores() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.DataStores));
    }

    function getDataSources() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.DataSources));
    }

    function getPartnerCategories() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.PartnerCategories));
    }

    function getDataTransmissionMethods() {
        return @Html.Raw(JsonConvert.SerializeObject(Model.DataTransmissionMethods));
    }

    $(document).ready(function () {

        viewModel = new gdprSurveyViewModel();

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.options.deferUpdates = true;
        ko.applyBindings(viewModel, document.body);

        viewModel.init();

        recalculateClones();
    });

    function recalculateClones() {
        $(".table-clone").remove();

        $(".wide-table").each(function (idx, item) {
            var parent = $(item).parent();
            $(item).clone(true).appendTo(parent).addClass('table-clone');
        });
    }

    function skipToEnd() {
        window.setTimeout(function () {
            viewModel.nextStage();
            window.setTimeout(function () {
                viewModel.nextStage();
                window.setTimeout(function () {
                    viewModel.nextStage();
                    window.setTimeout(function () {
                        viewModel.nextStage();
                    }, 500);
                }, 500);
            }, 500);
        }, 500);
    }

</script>
}
