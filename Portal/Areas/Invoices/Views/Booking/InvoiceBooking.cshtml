                                    <div class="attachment-supplier-wrapper mb-0">
                                        <div class="attachment-supplier-container">
                                            <div class="attachment-supplier" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: $parent.supplierParams }"></div>
                                            <div class="supplier-address-display" style="display: none" data-bind="visible: $parent.supplierParams.locked, with: $parent.supplier">
                                                <p class="mb-0" data-bind="text: AddressDisplaySingleLine"></p>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-dark" data-bind="visible: $parent.Processed == false && ($parent.readOnly == true ? false : $parent.supplierParams.locked), click: () => { $parent.supplierParams.locked(!$parent.supplierParams.locked()) }">
                                            Change
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="additional-info" style="display: none" data-bind="visible: $parent.additionalInfo, foreach: $parent.additionalInfo">
                            <div class="card p-0" data-bind="class: CSSClasses">
                                <div class="card-body" data-bind="html: HTMLContents"></div>
                            </div>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: isEmailBody == false && $parent.supplier() != null  -->
                        <ul class="nav nav-tabs" id="data-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="original-data-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#original-data-tab-pane"
                                        type="button"
                                        role="tab"
                                        aria-controls="original-data-tab-pane"
                                        aria-selected="true">
                                    <span data-bind="attr: { title: `Attachment ID: ${AttachmentID}` }">
                                        Attachment Details
                                    </span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation" style="display: none" data-bind="visible: mertexData != null">
                                <button class="nav-link" id="mertex-data-tab" data-bs-toggle="tab" data-bs-target="#mertex-data-tab-pane" type="button" role="tab" aria-controls="mertex-data-tab-pane" aria-selected="false">
                                    Mertex Data
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content" id="original-data-tab-content">
                            <div class="tab-pane fade show active" id="original-data-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
                                <div class="attachment-property" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: attachmentTypeParams }"></div>

                                <!-- ko if: attachmentTypeId() !== 1 -->
                                <!-- ko if: properties -->
                                <div data-bind="template: { name: propertiesTemplateName, data: properties }"></div>
                                <!-- /ko -->
                                <!-- ko ifnot: readOnly -->
                                <!-- ko if: ko.unwrap(properties) -->
                                <!-- ko if: (ko.unwrap(properties).duplicateResults().length != 0) && (ko.unwrap(properties).duplicateWarningAccepted() == false) -->
                                <button type="button" class="btn btn-danger btn-lg w-100 bold mt-3" data-bind="click: () => { ko.unwrap(properties).acknowledgeDuplicate() }">
                                    Click here to agree that this document is a duplicate.
                                    <br />
                                    It will be flagged as such and will not be submitted to Mertex.
                                </button>
                                <!-- /ko -->
                                <!-- ko if: (ko.unwrap(properties).duplicateResults().length == 0) || ((ko.unwrap(properties).duplicateResults().length != 0) && (ko.unwrap(properties).duplicateWarningAccepted() == true)) -->
                                <button class="btn btn-success w-100 btn-lg save-btn mt-3" type="button" data-bind="click: save">
                                    Save
                                </button>
                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- /ko -->

                            </div>
                            <div class="tab-pane fade" id="mertex-data-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0" data-bind="with: mertexData">
                                <!-- ko if: $parent.SubmittedToMertex == false -->
                                <p>
                                    This attachment has not yet been submitted for processing.
                                </p>
                                <!-- /ko -->
                                <!-- ko if: typeof Code != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Mertex Invoice Registry Code
                                    </label>
                                    <span data-bind="text: Code ? Code : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof SupplierCode != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Supplier Code
                                    </label>
                                    <span data-bind="text: SupplierCode ? SupplierCode : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof SupplierInvoiceCode != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Supplier Invoice Code
                                    </label>
                                    <span data-bind="text: SupplierInvoiceCode ? SupplierInvoiceCode : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof InvoiceDate != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Invoice Date
                                    </label>
                                    <span data-bind="text: InvoiceDate ? moment(InvoiceDate).format('dddd Do MMMM YYYY (DD/MM/YYYY)') : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof InvoiceProcessedDate != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Invoice Processed
                                    </label>
                                    <span data-bind="text: InvoiceProcessedDate ? moment(InvoiceProcessedDate).format('dddd Do MMMM YYYY (DD/MM/YYYY)') : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof InvoiceReceivedDate != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Invoice Received
                                    </label>
                                    <span data-bind="text: InvoiceReceivedDate ? moment(InvoiceReceivedDate).format('dddd Do MMMM YYYY (DD/MM/YYYY)') : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof InvoiceDueDT != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Invoice Due
                                    </label>
                                    <span data-bind="text: InvoiceDueDT ? moment(InvoiceDueDT).format('dddd Do MMMM YYYY (DD/MM/YYYY)') : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof SettlementDT != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Settlement Date
                                    </label>
                                    <span data-bind="text: SettlementDT ? moment(SettlementDT).format('dddd Do MMMM YYYY (DD/MM/YYYY)') : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof PassedTo != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Passed to
                                    </label>
                                    <span data-bind="text: PassedTo ? `${PassedTo} on ${moment(PassedToDT).format('dddd Do MMMM YYYY (DD/MM/YYYY)')}` : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof PaymentTermsCode != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Payment Terms Code
                                    </label>
                                    <span data-bind="text: PaymentTermsCode ? PaymentTermsCode : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof MertexCurrencyCode != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Mertex Currency Code
                                    </label>
                                    <span data-bind="text: MertexCurrencyCode ? MertexCurrencyCode : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof DocumentBalance != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Document Balance
                                    </label>
                                    <span data-bind="text: DocumentBalance ? DocumentBalance : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof VATBalance != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        VAT Balance
                                    </label>
                                    <span data-bind="text: VATBalance ? VATBalance : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof ExchangeRate != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Exchange Rate
                                    </label>
                                    <span data-bind="text: ExchangeRate ? ExchangeRate : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof InvoiceTotalInCurrencyIncVAT != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Invoice Total In Currency Inc. VAT
                                    </label>
                                    <span data-bind="text: InvoiceTotalInCurrencyIncVAT ? InvoiceTotalInCurrencyIncVAT : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof InvoiceTotalInGBPIncVAT != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Invoice Total In GBP Inc. VAT
                                    </label>
                                    <span data-bind="text: InvoiceTotalInGBPIncVAT ? InvoiceTotalInGBPIncVAT : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof Memo != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Memo
                                    </label>
                                    <span data-bind="text: Memo ? Memo : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof OtherMemos != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        Other Memos
                                    </label>
                                    <span data-bind="html: OtherMemos ? OtherMemos : 'n/a'"></span>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof GeneralLedgerCodes != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        General Ledger Entries
                                    </label>
                                    <div data-bind="foreach: GeneralLedgerCodes">
                                        <span data-bind="text: $data"></span>
                                        :
                                        <span data-bind="text: $parent.GeneralLedgerAmountsExVAT[$index()]"></span>
                                    </div>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: typeof VATCodes != 'undefined' -->
                                <div class="attachment-property loaded-property">
                                    <label>
                                        VAT Entries
                                    </label>
                                    <div data-bind="foreach: VATCodes">
                                        <span data-bind="text: $data"></span>
                                        :
                                        <span data-bind="text: `VATable Value: ${$parent.VATValues[$index()]}`"></span>
                                        -
                                        <span data-bind="text: `VAT: ${$parent.VATValues[$index()]}`"></span>
                                    </div>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="download-attachments-modal">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: selectedEmail">
            <div class="blocker" data-bind="flexFadeVisible: downloadAttachmentsModalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3" data-bind="html: downloadAttachmentsModalBusyMessage"></h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title d-flex justify-content-between align-items-center w-100 pe-2">
                    Download Attachments
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-3 mb-3 justify-content-between">
                    <button class="btn btn-dark flex-grow-1" data-bind="click: deselectAllAttachmentsForDownload">
                        Deselect All
                    </button>
                    <button class="btn btn-primary flex-grow-1" data-bind="click: selectAllAttachmentsForDownload">
                        Select All
                    </button>
                </div>
                <ul id="attachments-list-container" class="list-group mb-3" data-bind="foreach: regularAttachments().slice(1)">
                    <li class="list-group-item">
                        <div class="d-flex gap-3 align-items-center">
                            <div data-bind="component: { name: 'mdc-checkbox-collection-component', params: { observable: selectedForDownload, checkboxName: `download-attachment-${$index()}` } }"></div>
                            <div class="attachment" data-bind="css: { 'submitted': $data.SubmittedToMertex }, click: toggleSelectedForDownload">
                                <span data-bind="class: $parent.iconClass($data)"></span>
                                <div class="attachment-properties">
                                    <label data-bind="html: FileName, attr: { title: FileName }"></label>
                                    <span data-bind="text: FileSizeDisplay"></span>
                                </div>
                                <!-- ko if: attachmentType -->
                                <div class="attachment-type" data-bind="with: attachmentType, class: attachmentType() ? `attachment-type-${attachmentType().Name.toLowerCase().replace(/\s/g, '-').replace(/\(/g, '').replace(/\)/g, '')}` : ''">
                                    <span data-bind="text: Name"></span>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                    </li>
                </ul>
                <button class="btn btn-dark w-100" disable data-bind="enable: attachmentsSelectedForDownload().length > 0, click: downloadSelectedAttachments">
                    <!-- ko if: attachmentsSelectedForDownload().length == 0 -->
                    Please select at least one attachment
                    <!-- /ko -->
                    <!-- ko if: attachmentsSelectedForDownload().length > 0 -->
                    Download
                    <span data-bind="text: attachmentsSelectedForDownload().length"></span>
                    <span data-bind="text: `Attachment${(attachmentsSelectedForDownload().length > 1 ? 's': '')}`"></span>
                    <!-- /ko -->
                </button>
                <div id="download-attachments-progress" class="mt-3" style="display: none" data-bind="fadeVisible: downloadAttachmentsDownloadsBusy, kendoProgressBar: downloadAttachmentsProgressBarParams"></div>
            </div>
        </div>
    </div>
</div>