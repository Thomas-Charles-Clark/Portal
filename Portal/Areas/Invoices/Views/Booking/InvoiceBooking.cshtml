@model Portal.Areas.Invoices.ViewModels.InvoiceBookingViewModel
@using Microsoft.AspNet.Identity;
@{
    ViewBag.Title = "Invoice Booking";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @*@Styles.Render("~/bundles/css/full-width-app")*@
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/generic-forms")
    @Styles.Render("~/bundles/css/invoice-booking")
    @Styles.Render("~/bundles/css/tempus-dominus")
    @Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {

    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/invoice-booking")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">
        window.getMailboxId = () => {
            return @Html.Raw(Model.MailboxID);
        }
        window.getDepartmentRestrictions = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.LockedToDepartmentGroupIDs));
        }
        window.getBudgetHolderRestriction = () => {
            return '@Html.Raw(Model.LockedToBudgetHolderCode)';
        }
        window.getDashboard = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.Dashboard));
        }
        window.getEmailStatusIdToLoad = () => {
            return @Html.Raw(Model.LoadingEmailStatusID);
        }
        window.getDocumentsDashboard = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.DocumentsDashboard));
        }
        window.getAttachmentStatusIdToLoad = () => {
            return @Html.Raw(Model.LoadingAttachmentStatusID);
        }
        window.getFreeTextSearchDefault = () => {
            return '@Html.Raw(Model.DefaultFreeTextSearchString)';
        }
        window.setDuplicateTest = () => {
            viewModel.selectedEmail().selectedAttachment().properties().duplicateResults([{ MertexCode: 'Potato', SupplierCode: 'Waffles', SupplierInvoiceReference: 'PAYME!', InvoiceDate: new Date(), InvoiceTotalInCurrencyIncVAT: 180000 }]);
        }
        window.getInvoiceRegistrationSubmissionSuspended = () => {
            return @(Model.InvoiceRegistrationSuspended ? "true" : "false");
        }
        window.getAttachmentTypes = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.AttachmentTypes));
        }
        window.getAttachmentStatuses = () => {
            return @Html.Raw(JsonConvert.SerializeObject(Model.AttachmentStatuses));
        }
    </script>

    <style type="text/css">
        .attachment:not(.disabled):has(@(String.Join(" ", (Model.AttachmentTypes.Select(at => (at.AttachmentTypeID != 1 && at.AttachmentTypeID != 1000) ? $".attachment-type-{at.Name.ToLowerInvariant().Replace(" ", "-").Replace("(", "").Replace(")", "")}," : ""))).TrimEnd(new[] { ',', ' ' })) ) {
            background-color: #309365 !important;
            color: #fff !important;
            border-color: #75b798 !important;
        }
    </style>

    <script type="text/html" id="invoice-value-conversion-control">
        <div class="converting-component">
            <div data-bind="highlightNullField: highlightOnNull, component: { name: 'mdc-text-field-numeric-component', params: inputParams }"></div>
            <div data-bind="component: { name: 'mdc-text-field-component', params: forexParams }"></div>
            <div data-bind="component: { name: 'mdc-text-field-component', params: convertedParams }"></div>
        </div>
    </script>

    <script type="text/javascript">
        ko.components.register('invoice-conversion-control', {
            template: { element: document.getElementById('invoice-value-conversion-control') }
        });
    </script>

    <script type="text/html" id="email-stub-row-template">
        <tr class="email-stub">
            @*<td class="k-group-cell"></td>*@
            <td data-bind="attr: { title: Supplier == null ? '' : `${SupplierCode} - ${Supplier?.Name}` }">
                <span data-bind="html: Supplier == null ? '' : `${SupplierCode} - ${Supplier?.Name}`"></span>
            </td>
            <td data-bind="attr: { title: `${fromDisplay()} (Email ID: ${EmailID})` }">
                <span data-bind="html: fromDisplay"></span>
            </td>
            <td data-bind="attr: { title: Subject }">
                <span data-bind="html: Subject"></span>
            </td>
            <td data-bind="attr: { title: moment(ReceivedDT).format('dddd Do MMM YYYY HH:mm') }">
                <span data-bind="html: moment(ReceivedDT).format('DD/MM/YYYY HH:mm')"></span>
            </td>
            <td>
                <span data-bind="html: (Supplier == null ? 'n/a' : Supplier.BudgetHolder == null ? 'n/a' : Supplier.BudgetHolder.Name)"></span>
            </td>
            <td class="text-center attachment-count-cell">
                <span class="icon-wrapper" data-bind="html: attachmentDisplay"></span>
            </td>
        </tr>
    </script>

    <script type="text/html" id="attachment-stub-row-template">
        <tr class="document-stub">
            <td class="checkbox-column">
                <label class="form-checkbox">
                    <input class="form-check-input" type="checkbox" data-bind="checked: selectedFromGrid" />
                </label>
            </td>
            <td data-bind="attr: { title: AttachmentType.Name }">
                <span data-bind="html: AttachmentType.Name"></span>
            </td>
            <td data-bind="attr: { title: Supplier == null ? 'Unknown' : `${Supplier.Code} - ${Supplier.Name}` }">
                <span data-bind="html: Supplier == null ? 'Unknown' : `${Supplier.Code} - ${Supplier.Name}`"></span>
            </td>
            <td data-bind="attr: { title: BudgetHolder == null ? 'N/A' : `${BudgetHolder.Name} - (Code: ${BudgetHolder.Code})` }">
                <span data-bind="html: BudgetHolder == null ? 'N/A' : `${BudgetHolder.Name} - (Code: ${BudgetHolder.Code})`"></span>
            </td>
            <td data-bind="attr: { title: ProcessedBy == null ? 'N/A' : `${ProcessedBy.FullName}` }">
                <!-- ko if: ProcessedBy -->
                <a href="#" data-bind="attr: { href: `mailto:${ProcessedBy.Email}` }, text: ProcessedBy.FullName" target="_blank"></a>
                <!-- /ko -->
            </td>
            <td data-bind="attr: { title: AttachmentStatusName }">
                <span data-bind="html: AttachmentStatusName"></span>
            </td>
            <td data-bind="attr: { title: `DG Document Reference: ${MertexCode}`}">
                <span data-bind="html: MertexCode"></span>
            </td>
            <td data-bind="attr: { title: `Supplier Reference: ${SupplierDocumentReference}` }">
                <span data-bind="html: SupplierDocumentReference"></span>
            </td>
            <td data-bind="attr: { title: moment(ReceivedDT).format('dddd Do MMM YYYY HH:mm') }">
                <span data-bind="html: moment(ReceivedDT).format('DD/MM/YYYY HH:mm')"></span>
            </td>
            <td data-bind="attr: { title: DocumentDate == null ? '' : moment(DocumentDate).format('DD/MM/YYYY') }">
                <span data-bind="html:  DocumentDate == null ? '' : moment(DocumentDate).format('DD/MM/YYYY')"></span>
            </td>
            <td data-bind="attr: { title:  DocumentDueDate == null ? '' : moment(DocumentDueDate).format('DD/MM/YYYY') }">
                <span data-bind="html: DocumentDueDate == null ? '' :  moment(DocumentDueDate).format('DD/MM/YYYY')"></span>
            </td>
            <td class="total-cell">
                <span data-bind="html: DocumentTotalInc == null ? '' : formatCurrency(DocumentTotalInc, 2, 'en-gb', 'GBP')"></span>
            </td>
        </tr>
    </script>

    <script type="text/html" id="bank-details-template">
        <div class="supplier-bank-properties card">
            <div class="card-body">
                <h5>
                    <span>
                        <span data-bind="text: templateLabel"></span>
                        Bank Details
                    </span>
                </h5>
                <p>
                    Please provide banking details (Bank Name and either Account Number &amp; Sort Code <i>or&nbsp;</i> IBAN <i>or&nbsp;</i> BIC).
                </p>
                <div class="bank-name attachment-property" data-bind="highlightNullField: supplierBankName, component: { name: 'mdc-text-field-component', params: supplierBankNameParams }"></div>
                <span class="validation-message" data-bind="validationMessage: supplierBankName"></span>

                <div class="attachment-property-wrap">
                    <div data-bind="validationOptions: { insertMessages: false }">
                        <div class="bank-account-number attachment-property" data-bind="highlightNullField: supplierBankAccountNumber, component: { name: 'mdc-text-field-component', params: supplierBankAccountNumberParams }"></div>
                    </div>
                    <div data-bind="validationOptions: { insertMessages: false }">
                        <div class="bank-sort-code attachment-property" data-bind="highlightNullField: supplierBankSortCode, component: { name: 'mdc-text-field-component', params: supplierBankSortCodeParams }"></div>
                    </div>
                </div>
                <span class="validation-message" data-bind="validationMessage: supplierBankAccountNumberAndSortCode"></span>
                <div class="attachment-property-wrap">
                    <div data-bind="validationOptions: { insertMessages: false }">
                        <div class="iban attachment-property" data-bind="highlightNullField: supplierIBAN, component: { name: 'mdc-text-field-component', params: supplierIBANParams }"></div>
                    </div>
                    <div data-bind="validationOptions: { insertMessages: false }">
                        <div class="bic attachment-property" data-bind="highlightNullField: supplierBIC, component: { name: 'mdc-text-field-component', params: supplierBICParams }"></div>
                    </div>
                </div>
                <span class="validation-message" data-bind="validationMessage: supplierIBANorBIC"></span>
            </div>
        </div>
    </script>

    <script type="text/html" id="invoice-booking-invoice-template">
        <div id="invoice-properties" class="card">
            <div class="card-body" data-bind="validationElement: preambleSatisfied, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                <h5 class="data-heading">
                    <!-- ko ifnot: $parent.Processed -->
                    Please Enter the Invoice Details
                    <!-- /ko -->
                    <!-- ko if: $parent.Processed -->
                    Invoice Details
                    <!-- /ko -->
                </h5>
                <div class="attachment-property attachment-supplier-wrapper">
                    @* $parent here navigates you back up to the "attachment" level from the "invoice" level. *@
                    <div class="attachment-supplier-container">
                        <div class="attachment-supplier" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
                        <div class="supplier-address-display" style="display: none" data-bind="visible: supplierParams.locked, with: supplier">
                            <p class="mb-0" data-bind="text: typeof AddressDisplaySingleLine === 'undefined' ? '' : AddressDisplaySingleLine, attr: { 'a': '1' }"></p>
                        </div>
                    </div>
                    <button type="button" class="btn btn-dark" style="display: none;" data-bind="visible: supplierParams.changeBtnVisible, click: () => { supplierParams.locked(!supplierParams.locked()) }">
                        Change
                    </button>
                </div>
                <div class="attachment-property attachment-supplier-wrapper" data-bind="with: supplier">
                    <!-- ko ifnot: typeof BudgetHolder === 'undefined' -->
                    <div class="attachment-supplier-container" data-bind="with: BudgetHolder, attr: { 'a': 1 }">
                        <div class="attachment-supplier">
                            <label>
                                Budget Holder: <span data-bind="text: Name"></span>
                            </label>
                        </div>
                    </div>
                    <button type="button" class="btn btn-dark" data-bind="css: { 'd-none': $parent.readOnly }, click: $parentContext.$parent.requestBudgetHolderChange">
                        Change
                    </button>
                    <!-- /ko -->
                </div>
                <div id="invoice-reference" class="attachment-property" data-bind="highlightNullField: supplierInvoiceReference, component: { name: 'mdc-text-field-component', params: invoiceReferenceParams }"></div>
                <span class="validation-message" data-bind="validationMessage: supplierInvoiceReference"></span>
                <div class="attachment-property-wrap">
                    <div>
                        <div id="invoice-date" class="attachment-property" data-bind="highlightNullField: invoiceDate, component: { name: 'tempus-dominus-date-picker-component', params: invoiceDateParams }"></div>
                        <span class="validation-message" data-bind="validationMessage: invoiceDate"></span>
                    </div>
                    <div>
                        <div id="due-date" class="attachment-property" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: dueDateParams }"></div>
                        <span class="validation-message" data-bind="validationMessage: dueDate"></span>
                    </div>
                </div>
                <div class="d-flex gap-3 m-0 p-0">
                </div>
                <div class="attachment-property-wrap">
                    <div>
                        <div id="invoice-terms" class="attachment-property" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsParams }"></div>
                    </div>
                    <div>
                        <div id="settlement-date" class="attachment-property" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: settlementDateParams }"></div>
                        <span class="validation-message" data-bind="validationMessage: settlementDate"></span>
                    </div>
                </div>

                <div class="mt-4" data-bind="validationElement: documentCurrencyEqualsSupplierCurrency, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                    <div id="document-currency" class="attachment-property" data-bind="highlightNullField: documentCurrencyCode, component: { name: 'mdc-kendo-dropdown-component', params: documentCurrencyParams }"></div>
                </div>
                <span class="validation-message" data-bind="validationMessage: documentCurrencyCode"></span>

                <div class="attachment-property" data-bind="validationElement: netTotalCurrencyEqualsInvoiceTotalCurrencyMinusVAT, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                    <div class="converting-component-wrapper" data-bind="component: { name: 'invoice-conversion-control', params: netTotal }"></div>
                </div>
                <span class="validation-message" data-bind="validationMessage: netTotalCurrency"></span>

                <div class="attachment-property" data-bind="validationElement: netTotalCurrencyEqualsInvoiceTotalCurrencyMinusVAT, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                    <div class="converting-component-wrapper" data-bind="component: { name: 'invoice-conversion-control', params: vatTotal }"></div>
                </div>
                <span class="validation-message" data-bind="validationMessage: vatTotalCurrency"></span>

                <div class="attachment-property" data-bind="validationElement: netTotalCurrencyEqualsInvoiceTotalCurrencyMinusVAT, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                    <div class="converting-component-wrapper" data-bind="component: { name: 'invoice-conversion-control', params: invoiceTotal }"></div>
                </div>
                <span class="validation-message" data-bind="validationMessage: invoiceTotalIncVATCurrency"></span>

                <span class="validation-message" data-bind="validationMessage: netTotalCurrencyEqualsInvoiceTotalCurrencyMinusVAT"></span>

                <div class="attachment-property dispute-checkbox" data-bind="component: { name: 'mdc-checkbox-component', params: disputeParams }"></div>

                <div class="gross-threshold-warning-wrapper mt-3" style="display: none" data-bind="visible: invoiceTotalIncVATInSterlingExceedsSupplierInvoiceWarningThresholdGBP">
                    <div data-bind="component: { name: 'mdc-checkbox-component', params: invoiceTotalIncVATCurrencyExceedsSupplierInvoiceWarningParams }"></div>
                </div>
            </div>
        </div>
        <!-- ko template: { name: 'bank-details-template', data: Object.assign($data, { templateLabel: 'Invoice' }) } --><!-- /ko -->
        <div id="duplicate-warnings" class="card" style="display: none" data-bind="visible: duplicateResults().length > 0">
            <div class="card-body">
                <!-- ko ifnot: isFlaggedAsDuplicate -->
                <p class="bold">
                    The following potential duplicates were found.
                </p>
                <p class="bold">
                    Please review them carefully and consider whether or not the item you're processing is a duplicate.
                </p>
                <!-- /ko -->
                <!-- ko if: isFlaggedAsDuplicate -->
                <p class="bold">
                    This item has already been flagged as duplicate. If you believe that to be a mistake, please contact <a href="#" data-bind="attr: { href: `mailto:itsupport@designersguild.com?subject=Invoice Registration Email ID ${$parent.emailId} Attachment ID ${attachmentId} is NOT a duplicate!&body=Invoice Registration Email ID ${$parent.emailId} Attachment ID ${attachmentId} is NOT a duplicate. Please unflag it as such. Thank you.` }">itsupport@designersguild.com</a></a>.
                </p>
                <!-- /ko -->
                <ul class="list-group">
                    <!-- ko foreach: duplicateResults -->
                    <li class="list-group-item">
                        <div class="duplicate-property">
                            <label class="bold">
                                Mertex ID:
                            </label>
                            <span data-bind="text: MertexCode"></span>
                        </div>
                        <div class="duplicate-property">
                            <label class="bold">
                                Supplier Code:
                            </label>
                            <span data-bind="text: SupplierCode"></span>
                        </div>
                        <div class="duplicate-property">
                            <label class="bold">
                                Supplier Reference:
                            </label>
                            <span data-bind="text: SupplierInvoiceReference"></span>
                        </div>
                        <div class="duplicate-property">
                            <label class="bold">
                                g
                                Invoice Date:
                            </label>
                            <span data-bind="text: moment(InvoiceDate).format('Do ddd MMMM YYYY (DD/MM/YYYY)')"></span>
                        </div>
                        <div class="duplicate-property">
                            <label class="bold">
                                Invoice Total Inc. VAT:
                            </label>
                            <span data-bind="text: $parent.supplierCurrency() ? formatCurrency(InvoiceTotalInCurrencyIncVAT.replace(',', ''), 2, $parent.supplierCurrency().FormattingCulture, $parent.supplierCurrency().Code) : InvoiceTotalInCurrencyIncVAT"></span>
                        </div>
                    </li>
                    <!-- /ko -->
                </ul>
                <div class="duplicate-checkbox-wrapper card" style="display: none" data-bind="visible: !isFlaggedAsDuplicate()">
                    <div class="card-body">
                        <div data-bind="component: { name: 'mdc-checkbox-component', params: duplicateWarningAcceptedParams }"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="vat-entries" class="card">
            <div class="card-body">
                <h5>
                    <span>
                        VAT Breakdown
                    </span>
                    <button type="button" class="btn btn-dark add-entry-btn" data-bind="click: addVATEntry, disable: readOnly">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </h5>
                <p>
                    It is imperative that you provide a full VAT breakdown to allow us to reclaim the VAT on this invoice.
                </p>
                <ul class="list-group" data-bind="validationElement: vatErrors, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                    <!-- ko if: vatEntries().length == 0 -->
                    <li class="list-group-item">
                        [No Entries]
                    </li>
                    <!-- /ko -->
                    <!-- ko foreach: vatEntries -->
                    <li class="list-group-item">
                        <div class="code-params" data-bind="css: { 'px-0': $index() == 0 }">
                            <div class="attachment-property" data-bind="highlightNullField: vatCode, component: { name: 'mdc-kendo-dropdown-component', params: vatCodeParams }"></div>
                            <!-- ko if: $index() > 0 -->
                            <button type="button" class="btn btn-close" data-bind="click: $parent.removeVATEntry"></button>
                            <!-- /ko -->
                        </div>
                        <span class="validation-message" data-bind="validationMessage: vatCode"></span>
                        <div class="attachment-property">
                            <div class="converting-component-wrapper" data-bind="component: { name: 'invoice-conversion-control', params: vatableAmountConverter }"></div>
                        </div>
                        <div class="attachment-property">
                            <div class="converting-component-wrapper" data-bind="component: { name: 'invoice-conversion-control', params: vatConverter }"></div>
                        </div>
                        <span class="validation-message" data-bind="validationMessage: vatableAmountCurrency"></span>
                    </li>
                    <!-- /ko -->
                </ul>
                <span class="validation-message" data-bind="validationMessage: vatableSumEqualsTotalNET"></span>
                <span class="validation-message" data-bind="validationMessage: vatInCurrencyBreakdownBeyondEpsilon"></span>
                <div class="gap-3 align-items-center mt-3" style="display: none" data-bind="flexVisible: vatInCurrencyBreakdownWithinEpsilon() == true && vatInCurrencyBreakdownMatchesTotal() == false, validationOptions: { insertMessages: false }">
                    <div data-bind="component: { name: 'mdc-checkbox-component', params: vatEpsilonWarningAcceptanceParams }"></div>
                    <span class="validation-message mt-0">
                        @* This is rendered directly because if the acceptance is made the validation passes and the message is eradicated *@
                        Please ensure the VAT breakdown total aligns with the stated VAT total on the invoice.
                        <br />
                        <br />
                        If you are happy that this is a small rounding variance (due to the recalculation of the VAT), tick this box to accept the variance and continue.
                        <br />
                        <br />
                        The VAT breakdown total is: <span data-bind="text: formatCurrency(ko.unwrap(vatInCurrencyBreakdownSum), 2, ko.unwrap(supplierCurrency)?.FormattingCulture ?? 'en-GB', ko.unwrap(supplierCurrency)?.Code ?? 'GBP')"></span>.
                        <br />
                        The permissible tolerance is <span data-bind="text: `±${formatNumber(ko.unwrap(vatInCurrencyEpsilon), 2, 'en-GB')}% and the current variance is ${formatNumber(ko.unwrap(vatInCurrencyBreakdownPercentageVariance), 2, 'en-GB')}%`"></span>.
                    </span>
                </div>
            </div>
        </div>
        <div id="general-ledger-entries" class="card">
            <div class="card-body">
                <h5>
                    <span>
                        General Ledger Breakdown
                    </span>
                    <button type="button" class="btn btn-dark add-entry-btn" data-bind="click: addGeneralLedgerEntry, disable: readOnly">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </h5>
                <p>
                    Where would you like to code this cost to in your budget?
                </p>
                <ul class="list-group" data-bind="validationElement: generalLedgerSumEqualsTotalMinusVAT, validationOptions: { decorateInputElement: true, errorElementClass: 'border-danger'  }">
                    <!-- ko if: generalLedgerEntries().length == 0 -->
                    <li class="list-group-item">
                        [No Entries]
                    </li>
                    <!-- /ko -->
                    <!-- ko foreach: generalLedgerEntries -->
                    <li class="list-group-item">
                        <div class="code-params" data-bind="css: { 'px-0': $index() == 0 }">
                            <div class="attachment-property" data-bind="highlightNullField: generalLedgerCode, component: { name: 'mdc-kendo-dropdown-component', params: generalLedgerCodeParams }"></div>
                            <!-- ko if: $index() > 0 -->
                            <button type="button" class="btn btn-close" data-bind="click: $parent.removeGeneralLedgerEntry"></button>
                            <!-- /ko -->
                        </div>
                        <span class="validation-message" data-bind="validationMessage: generalLedgerCode"></span>
                        <div class="converting-component-wrapper">
                            <div data-bind="component: { name: 'invoice-conversion-control', params: amountExParams }"></div>
                        </div>
                        <span class="validation-message" data-bind="validationMessage: amountExVATInCurrency"></span>
                    </li>
                    <!-- /ko -->
                </ul>
                <span class="validation-message" data-bind="validationMessage: generalLedgerSumEqualsTotalMinusVAT"></span>
            </div>
        </div>
    </script>

    <script type="text/html" id="invoice-booking-proforma-template">
        <div id="proforma-properties" class="card">
            <div class="card-body">
                <h5 class="data-heading">
                    <!-- ko ifnot: $parent.Processed -->
                    Please Enter the Invoice Details
                    <!-- /ko -->
                    <!-- ko if: $parent.Processed -->
                    Invoice Details
                    <!-- /ko -->
                </h5>
                <div class="attachment-property attachment-supplier-wrapper">
                    @* $parent here navigates you back up to the "attachment" level from the "invoice" level. *@
                    <div class="attachment-supplier-container">
                        <div class="attachment-supplier" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
                        <div class="supplier-address-display" style="display: none" data-bind="visible: supplierParams.locked, with: supplier">
                            <p class="mb-0" data-bind="text: typeof AddressDisplaySingleLine === 'undefined' ? '' : AddressDisplaySingleLine, attr: { 'a': '2' }"></p>
                        </div>
                    </div>
                    <button type="button" class="btn btn-dark" style="display: none;" data-bind="visible: supplierParams.changeBtnVisible, click: () => { supplierParams.locked(!supplierParams.locked()) }">
                        Change
                    </button>
                </div>
                <div class="attachment-property attachment-supplier-wrapper" data-bind="with: supplier">
                    <!-- ko ifnot: typeof BudgetHolder === 'undefined' -->
                    <div class="attachment-supplier-container" data-bind="with: BudgetHolder, attr: { 'a': 2 }">
                        <div class="attachment-supplier">
                            <label>
                                Budget Holder: <span data-bind="text: Name"></span>
                            </label>
                        </div>
                    </div>
                    <button type="button" class="btn btn-dark" data-bind="visible: $parentContext.$parentContext.$parent.supplierParams.changeBtnVisible().changeBtnVisible, click: $parentContext.$parent.requestBudgetHolderChange">
                        Change
                    </button>
                    <!-- /ko -->
                </div>
                <div id="invoice-reference" class="attachment-property" data-bind="highlightNullField: supplierInvoiceReference, component: { name: 'mdc-text-field-component', params: invoiceReferenceParams }"></div>
                <span class="validation-message" data-bind="validationMessage: supplierInvoiceReference"></span>
