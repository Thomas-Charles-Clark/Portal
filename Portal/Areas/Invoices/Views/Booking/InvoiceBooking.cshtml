                                        <button class="btn btn-orange" type="button" data-bind="click: $parent.flagJunk">
                                            Flag as Junk
                                        </button>
                                        <!-- /ko -->
                                        <!-- ko if: $parent.Junk == true -->
                                        <button class="btn btn-orange" type="button" data-bind="click: $parent.flagUnjunk">
                                            Flag as not Junk
                                        </button>
