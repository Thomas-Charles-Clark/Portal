<div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" id="email-modal">
    <div class="modal-dialog modal-xl modal-xxl modal-xxxl modal-xxxxl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="blocker" data-bind="flexFadeVisible: modalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3" data-bind="html: modalBusyMessage"></h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title d-flex justify-content-between align-items-center w-100 pe-2" data-bind="with: selectedEmail">
                    <span>
                        <span class="d-inline-flex gap-3">
                            <span>
                                From:
                                <a class="text-white" data-bind="attr: { href: `mailto:${FromEmail}` }, text: (FromName == FromEmail ? FromName : `${FromName} - ${FromEmail}`)"></a>
                            </span>
                            <span data-bind="html: `Received: ${moment(ReceivedDT).format('DD/MM/YYYY HH:mm')}`, attr: { title: moment(ReceivedDT).format('dddd Do MMM YYYY HH:mm') }"></span>
                        </span>
                        <span class="d-block" data-bind="html: `Subject: ${Subject}`"></span>
                    </span>
                    <div class="d-inline-flex gap-3">
                        <nav class="nav">
                            <span class="me-3" data-bind="text: `Email ID: ${EmailID}`"></span>
                            <button class="btn btn-light" type="button" data-bind="css: { 'disabled': navPreviousDisabled }, click: parent.previous">
                                <i class="bi bi-chevron-left"></i>
                                <span>
                                    Previous
                                </span>
                            </button>
                            <label>
                                <span>
                                    You're viewing item
                                </span>
                                <span data-bind="text: selectedEmailIndex"></span>
                                <span>
                                    of
                                </span>
                                <span data-bind="text: itemCount"></span>
                            </label>
                            <button class="btn btn-light" type="button" data-bind="css: { 'disabled': navNextDisabled }, click: parent.next">
                                <span>
                                    Next
                                </span>
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </nav>
                    </div>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header secondary-header" data-bind="class: (selectedEmail() && selectedEmail().emailStatus ? `header-${selectedEmail().emailStatus.Name.toLowerCase().replace(/\s/g, '-')}` : '')">
                <h5 data-bind="html: selectedEmail() && selectedEmail().emailStatus && selectedEmail().emailStatus.Name"></h5>
            </div>
            <div class="modal-body" data-bind="with: selectedEmail">
                <div id="attachments-list-container" class="mb-3">
                    <ul id="attachments-list" class="list-unstyled" data-bind="css: { 'mb-3': regularAttachments().length > 0, 'mb-2': regularAttachments().length == 0 }">
                        <!-- ko foreach: regularAttachments -->
                        <li class="attachment" data-bind="click: $parent.selectAttachment, css: { 'selected': $parent.selectedAttachment().AttachmentID == $data.AttachmentID, 'submitted': $data.SubmittedToMertex }">
                            <span data-bind="class: $parent.iconClass($data)"></span>
                            <div class="attachment-properties">
                                <label data-bind="html: FileName, attr: { title: FileName }"></label>
                                <span data-bind="text: FileSizeDisplay"></span>
                            </div>
                            <!-- ko if: attachmentType -->
                            <div class="attachment-type" data-bind="with: attachmentType, class: attachmentType() ? `attachment-type-${attachmentType().Name.toLowerCase().replace(/\s/g, '-').toLowerCase().replace(/\(/g, '').replace(/\)/g, '')}` : ''">
                                <span data-bind="text: Name"></span>
                            </div>
                            <!-- /ko -->
                        </li>
                        <!-- /ko -->
                        <!-- ko if: regularAttachments().length == 0 -->
                        <li>
                            <h4 class="mt-3">
                                No Attachments
                            </h4>
                        </li>
