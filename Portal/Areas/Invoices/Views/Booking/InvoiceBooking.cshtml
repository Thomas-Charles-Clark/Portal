    <div class="modal-dialog modal-xl modal-xxl modal-xxxl modal-xxxxl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="blocker" data-bind="flexFadeVisible: modalBusy">
                <div class="loading-spinner"></div>
                <h4 class="mt-3" data-bind="html: modalBusyMessage"></h4>
            </div>
            <div class="modal-header">
                <h5 class="modal-title d-flex justify-content-between align-items-center w-100 pe-2" data-bind="with: selectedEmail">
                    <span>
                        <span class="d-inline-flex gap-3">
                            <span>
                                From:
                                <a class="text-white" data-bind="attr: { href: `mailto:${FromEmail}` }, text: (FromName == FromEmail ? FromName : `${FromName} - ${FromEmail}`)"></a>
                            </span>
                            <span data-bind="html: `Received: ${moment(ReceivedDT).format('DD/MM/YYYY HH:mm')}`, attr: { title: moment(ReceivedDT).format('dddd Do MMM YYYY HH:mm') }"></span>
                        </span>
                        <span class="d-block" data-bind="html: `Subject: ${Subject}`"></span>
                    </span>
                    <div class="d-inline-flex gap-3">
                        <nav class="nav">
                            <span class="me-3" data-bind="text: `Email ID: ${EmailID}`"></span>
                            <div style="display: none" data-bind="flexVisible: selectedIndex() != null" class="justify-content-between align-items-center gap-3">
                                <button class="btn btn-light" type="button" data-bind="css: { 'disabled': navPreviousDisabled }, click: parent.previous">
                                    <i class="bi bi-chevron-left"></i>
                                    <span>
                                        Previous
                                    </span>
                                </button>
                                <label>
                                    <span>
                                        You're viewing item
                                    </span>
                                    <span data-bind="text: selectedIndex"></span>
                                    <span>
                                        of
                                    </span>
                                    <span data-bind="text: itemCount"></span>
                                </label>
                                <button class="btn btn-light" type="button" data-bind="css: { 'disabled': navNextDisabled }, click: parent.next">
                                    <span>
                                        Next
                                    </span>
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </nav>
                    </div>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header secondary-header" data-bind="class: (selectedEmail() && selectedEmail().emailStatus ? `header-${selectedEmail().emailStatus.Name.toLowerCase().replace(/\s/g, '-')}` : '')">
                <h5 data-bind="html: selectedEmail() && selectedEmail().emailStatus && selectedEmail().emailStatus.Name"></h5>
            </div>
            <div class="modal-body" data-bind="with: selectedEmail">
                <div id="attachments-list-container" class="mb-3">
                    <ul id="attachments-list" class="list-unstyled" data-bind="css: { 'mb-3': regularAttachments().length > 0, 'mb-2': regularAttachments().length == 0 }">
                        <!-- ko foreach: regularAttachments -->
                        <li class="attachment" data-bind="click: $parent.selectAttachment, css: { 'selected': $parent.selectedAttachment().AttachmentID == $data.AttachmentID, 'submitted': $data.SubmittedToMertex }">
                            <span data-bind="class: $parent.iconClass($data)"></span>
                            <div class="attachment-properties">
                                <label data-bind="html: FileName, attr: { title: FileName }"></label>
                                <span data-bind="text: FileSizeDisplay"></span>
                            </div>
                            <!-- ko if: attachmentType -->
                            <div class="attachment-type" data-bind="with: attachmentType, class: attachmentType() ? `attachment-type-${attachmentType().Name.toLowerCase().replace(/\s/g, '-').toLowerCase().replace(/\(/g, '').replace(/\)/g, '')}` : ''">
                                <span data-bind="text: Name"></span>
                            </div>
                            <!-- /ko -->
                        </li>
                        <!-- /ko -->
                        <!-- ko if: regularAttachments().length == 0 -->
                        <li>
                            <h4 class="mt-3">
                                No Attachments
                            </h4>
                        </li>
                        <!-- /ko -->
                    </ul>
                    <ul id="attachments-list-control-buttons" class="list-unstyled">
                        <li id="add-attachments-item" class="attachment gap-3" data-bind="css: { 'disabled': attachmentsDisabled }">
                            <label for="file-input">
                                <span class="k-icon k-i-file-add"></span>
                                <span class="attachment-properties">
                                    <span>
                                        Add Attachment(s)
                                    </span>
                                    <span>
                                        (20 MB max per file)
                                    </span>
                                </span>
                                <form id="add-attachments-form" onsubmit="return false;">
                                    <input id="file-input" name="file-input" type="file" multiple
                                           data-bind="forceNullOnEmpty: addAttachmentParams.observable, value: addAttachmentParams.observable, attr: { accept: addAttachmentParams.accept, disabled: attachmentsDisabled }" />
                                </form>
                            </label>
                        </li>
                        <li id="download-attachments-item" class="attachment gap-3 pointer" data-bind="click: showDownloadAttachmentsModal">
                            <label for="download-attachments-item">
                                <span class="k-icon k-i-download"></span>
                                <span class="attachment-properties">
                                    <span>
                                        Download Attachments
                                    </span>
                                </span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="attachment-viewer" data-bind="with: selectedAttachment">
                    <!-- ko if: isEmailBody -->
                    <div id="email-body">
                        <div class="email-body-heading-wrapper">
                            <h5 class="email-body-heading">
                                <span>
                                    Email Contents
                                </span>
                                <button id="download-email-to-pdf" class="btn" data-bind="click: $parent.openInNewTab">
                                    <span class="k-icon k-i-pdf"></span>
                                    Open in New Tab (for Printing to PDF)
                                    <span class="k-icon k-i-hyperlink-open"></span>
                                </button>
                            </h5>
                        </div>
                        <div class="p-2 d-flex flex-column" data-bind="html: Body"></div>
                    </div>
                    <!-- /ko -->
                    <!-- ko ifnot: isEmailBody -->
                    <div class="attachment-iframe-wrapper ratio">
                        <!-- ko if: ['csv','txt','png','jpg','jpeg','gif','bmp','webp','tif','tiff'].indexOf(FileExtension.toLowerCase()) == -1 -->
                        <iframe data-bind="attr: { src: actualSrc }"></iframe>
                        <!-- /ko -->
                        <!-- ko if: ['csv','txt'].indexOf(FileExtension.toLowerCase()) > -1 -->
                        <pre class="prettyprint linenums" data-bind="html: prettyPrintedResponse"></pre>
                        <!-- /ko -->
                        <!-- ko if: ['png','jpg','jpeg','gif','bmp','webp'].indexOf(FileExtension.toLowerCase()) > -1 -->
                        <img data-bind="attr: { src: actualSrc }" />
                        <!-- /ko -->
                        <!-- ko if: ['tif', 'tiff'].indexOf(FileExtension.toLowerCase()) > -1 -->
                        <div class="tif-canvas-container">

                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->
                    <div class="data-pane">
                        <!-- ko template: { name: 'form-template' } --><!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="download-attachments-modal">
    <div class="modal-dialog">
        <div class="modal-content" data-bind="with: selectedEmail">
            <div class="blocker" data-bind="flexFadeVisible: downloadAttachmentsModalBusy">
