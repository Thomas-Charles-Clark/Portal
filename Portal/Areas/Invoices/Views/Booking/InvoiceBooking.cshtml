                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="change-budget-holder-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div data-bind="with: selectedEmail">
                <div class="blocker" data-bind="flexFadeVisible: changeBudgetHolderBusy">
