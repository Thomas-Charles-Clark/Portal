            <div class="dashboard-pod card" data-bind="click: $parent.select, css: { 'active': $parent.selectedPod() == $data, 'warning': ([1,5].indexOf($data.EmailStatusID) > -1) && (RecordCount > 0) }">
                <div class="card-body">
                    <h4>
                        <span data-bind="html: Label"></span>
                    </h4>
                    <h5>
                        <span data-bind="html: EmailStats"></span>
                    </h5>
                    <h5>
                        <span data-bind="html: AttachmentStats"></span>
                    </h5>
                    <h5>
                        <span data-bind="html: InvoiceStats"></span>
