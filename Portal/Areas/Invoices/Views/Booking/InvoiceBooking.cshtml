<div data-bind="stopBinding">
    <div id="archives-modal" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Download Documents
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" data-bs-dismiss="modal"></button>
                </div>
                <div id="archives-modal-body" class="modal-body">
                    <p id="archives-leading-text">
                        To make it easier for you to download, we are consolidating the {COUNT} document(s) you requested into zip file(s). Each zip file will be limited to 2GB. If you request more images than fit in 2GB, additional sequentially numbered zip files will be generated for you as necessary.
                    </p>
                    <p id="archives-leading-text-2">
                        You may begin downloading your zip files as they become available by clicking the green download button(s).
                    </p>
                    <div class="list-group" style="margin-bottom: 0;" data-bind="foreach: tasks">
                        <!-- ko foreach: createdArchiveFiles -->
                        <a href="#" data-bind="attr: { href: `/invoices/booking/DownloadDocumentArchive?archiveName=${FileName}` }" class="list-group-item complete d-flex justify-content-between align-items-center">
                            <span data-bind="text: FileName"></span>
                            <span class="download-display">
                                <span class="badge bg-primary badge-pill" data-bind="text: FileSize"></span>
                                <span class="btn btn-success btn-sm">
                                    Download
                                </span>
                            </span>
                        </a>
                        <!-- /ko -->
                        <!-- ko ifnot: complete -->
                        <div class="list-group-item list-group-item-action" role="menuitem">
                            <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" data-bind="style: { '--clip-width': taskPercentCss }, css: barCss"></div>
                            <span data-bind="text: ArchiveBaseName"></span>
                            <span class="text-center" data-bind="text: taskPercentCss"></span>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer" style="margin-top: 0">
                    <button id="archives-modal-close" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="forward-attachment-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div data-bind="with: selectedEmail">
                <div data-bind="with: selectedAttachment">
                    <div class="blocker" data-bind="flexFadeVisible: forwardAttachmentModalBusy">
                        <div class="loading-spinner"></div>
                        <h4 class="mt-3">
                            Please Wait...
                        </h4>
                    </div>
                </div>
            </div>
            <div class="modal-header">
                <h5 class="modal-title d-flex justify-content-between align-items-center w-100 pe-2">
                    Forward Attachment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body relative">
                <p>
                    Please select the Budget Holder to forward to.
                </p>
                <div id="destination-budget-holder" class="relative" data-bind="with: selectedEmail">
                    <div data-bind="with: selectedAttachment">
                        <div class="relative" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: forwardToBudgetHolderParams }"></div>
                        <span class="validation-message" data-bind="validationMessage: forwardToBudgetHolderCode"></span>
                        <button class="btn btn-dark w-100 mt-3" data-bind="click: forwardAttachment">
