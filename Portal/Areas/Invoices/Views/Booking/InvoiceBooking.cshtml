                <div class="attachment-property loaded-property">
                    <label>
                        Exchange Rate
                    </label>
                    <span data-bind="text: ExchangeRate ? ExchangeRate : 'n/a'"></span>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof InvoiceTotalInCurrencyIncVAT != 'undefined' -->
                <div class="attachment-property loaded-property">
                    <label>
                        Invoice Total In Currency Inc. VAT
                    </label>
                    <span data-bind="text: InvoiceTotalInCurrencyIncVAT ? InvoiceTotalInCurrencyIncVAT : 'n/a'"></span>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof InvoiceTotalInGBPIncVAT != 'undefined' -->
                <div class="attachment-property loaded-property">
                    <label>
                        Invoice Total In GBP Inc. VAT
                    </label>
                    <span data-bind="text: InvoiceTotalInGBPIncVAT ? InvoiceTotalInGBPIncVAT : 'n/a'"></span>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof Memo != 'undefined' -->
                <div class="attachment-property loaded-property">
                    <label>
                        Memo
                    </label>
                    <span data-bind="text: Memo ? Memo : 'n/a'"></span>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof OtherMemos != 'undefined' -->
                <div class="attachment-property loaded-property">
                    <label>
                        Other Memos
                    </label>
                    <span data-bind="html: OtherMemos ? OtherMemos : 'n/a'"></span>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof GeneralLedgerCodes != 'undefined' -->
                <div class="attachment-property loaded-property">
                    <label>
                        General Ledger Entries
                    </label>
                    <div data-bind="foreach: GeneralLedgerCodes">
                        <span data-bind="text: $data"></span>
                        :
                        <span data-bind="text: $parent.GeneralLedgerAmountsExVAT[$index()]"></span>
                    </div>
                </div>
                <!-- /ko -->
                <!-- ko if: typeof VATCodes != 'undefined' -->
                <div class="attachment-property loaded-property">
                    <label>
                        VAT Entries
                    </label>
                    <div data-bind="foreach: VATCodes">
                        <span data-bind="text: $data"></span>
                        :
                        <span data-bind="text: `VATable Value: ${$parent.VATValues[$index()]}`"></span>
                        -
                        <span data-bind="text: `VAT: ${$parent.VATValues[$index()]}`"></span>
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
        <!-- /ko -->
    </script>

    <script type="text/javascript">

        var viewModel = invoiceBookingViewModel({
            mailboxId: getMailboxId()
        });

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger',
            allowHtmlMessages: true
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel.selectedEmail;

        // let the engine cycle so bindings are evaluated before
        window.setTimeout(() => {
            viewModel.init();
        }, 0);

        var headerController = new HeaderController();

        ko.cleanNode(document.querySelector("#archives-modal"));

        ko.applyBindings(headerController, document.querySelector("#archives-modal"));

        window.downloadDocumentsViewModel = headerController;


        @*@if (User.Identity.GetUserId<int>() == 8)
        {
            @:viewModel.documentGridTabButton.click();
        }*@

    </script>

    @if (Model.LoadingAttachmentID.HasValue)
    {
        <script type="text/javascript">
            window.onload = () => {
                console.log('window.onload called');
                viewModel.documentViewer.load({
                    EmailID: @(Model.LoadingEmailID),
                    AttachmentID: @(Model.LoadingAttachmentID)
                });
            };
        </script>
    }
}


