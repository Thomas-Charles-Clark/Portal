@model Portal.Areas.Invoices.ViewModels.InvoiceBookingViewModel
@{
    ViewBag.Title = "Invoice Booking";
    Layout = "~/Views/Shared/_Layout-New.cshtml";
}
@section styles {
    @Styles.Render("~/bundles/css/full-width-app")
    @Styles.Render("~/bundles/css/kendo-custom")
    @Styles.Render("~/bundles/css/generic-forms")
    @Styles.Render("~/bundles/css/invoice-booking")
    @Styles.Render("~/bundles/css/tempus-dominus")
    @Styles.Render("~/bundles/css/mdc-custom")
}
@section scripts {
    @Scripts.Render("~/bundles/js/jqueryui")
    @Scripts.Render("~/bundles/js/datetime-picker")
    @Scripts.Render("~/bundles/js/generic-forms")
    @Scripts.Render("~/bundles/js/invoice-booking")
    @Scripts.Render("~/bundles/js/tempus-dominus")

    <script type="text/javascript">
        window.getMailboxId = () => {
            return @Html.Raw(Model.MailboxID);
        }
    </script>

    <script type="text/html" id="email-stub-row-template">
        <tr class="email-stub" data-bind="attr: { title: `Email ID: ${EmailID}` }">
            <td>
                <span data-bind="html: fromDisplay"></span>
            </td>
            <td>
                <span data-bind="html: Subject"></span>
            </td>
            <td>
                <span data-bind="html: moment(ReceivedDT).format('DD/MM/YYYY HH:mm')"
            </td>
            <td>
                <span data-bind="html: Supplier == null ? '' : `${Supplier?.Name} (${SupplierCode})`"></span>
            </td>
            <td class="text-center">
                <span data-bind="html: attachmentDisplay"></span>
            </td>
        </tr>
    </script>

    <script type="text/html" id="invoice-booking-invoice-template">
        <h5 class="properties-title">
            Properties
        </h5>
        <div class="attachment-property" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
        <div class="attachment-property" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: invoiceDateParams }"></div>
        <div class="attachment-property" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: paymentTermsParams }"></div>
        <div class="attachment-property" data-bind="component: { name: 'mdc-text-field-numeric-component', params: totalIncVATCurrencyParams }"></div>
        <div class="attachment-property dispute-checkbox" data-bind="component: { name: 'mdc-checkbox-component', params: disputeParams }"></div>
        <h5 class="my-3 hr fs-5">
            (Not yet completed)
        </h5>
    </script>

    <script type="text/html" id="invoice-booking-credit-note-template">
        <h5>
            Credit Note Properties
        </h5>
        <h5 class="mt-2">
            Not yet implemented
        </h5>
    </script>

    <script type="text/javascript">

        var viewModel = invoiceBookingViewModel({
            mailboxId: getMailboxId()
        });

        var vm = viewModel;

        ko.options.deferUpdates = true;

        ko.validation.init({
            decorateInputElement: true,
            errorElementClass: 'alert-danger',
            errorMessageClass: 'validation-message text-danger'
        });

        ko.applyBindings(viewModel, document.body);

        window.self = viewModel;

        // let the engine cycle so bindings are evaluated before
        window.setTimeout(() => {
            viewModel.init();

        }, 0);

    </script>
}

<div class="blocker" data-bind="flexFadeVisible: busy">
    <div class="loading-spinner"></div>
    <h4 class="mt-3" data-bind="text: busyMessage"></h4>
</div>

<div class="form-group row mb-4">
    <div class="col-xs-12">
        <div class="page-heading-logo">
            <div></div>
        </div>
        <div class="page-heading text-right">
            @if (!String.IsNullOrEmpty(Model.ApplicationHeading))
            {
                <h1 class="main-heading">
                    @(Model.ApplicationHeading)
                </h1>
            }
            @if (!String.IsNullOrEmpty(Model.ApplicationSubHeading))
            {
                <h4 class="sub-heading">
                    <span class="margin-bottom-15">@(Model.ApplicationSubHeading)</span>
                </h4>
            }
        </div>
    </div>
</div>

<div id="dashboard" style="display: none" data-bind="visible: true, with: dashboard">
    <!-- ko foreach: sortedPods -->
    <div class="dashboard-pod card" data-bind="click: $parent.select, css: { 'active': $parent.selectedPod() == $data }">
        <div class="card-body">
            <h4>
                <span data-bind="html: Label"></span>
            </h4>
            <h5>
                <span data-bind="html: RecordCount"></span>
            </h5>
        </div>
    </div>
    <!-- /ko -->
</div>

<div class="d-flex gap-3">

    <div id="inbox-browser">
        <div id="email-list-prefilters" data-bind="with: filters">
            <div id="department-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: departmentParams }"></div>
            <div id="budget-holder-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: budgetHolderParams }"></div>
            <div id="supplier-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: supplierParams }"></div>
            <div id="email-status-prefilter" class="prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: emailStatusParams }"></div>
            <div id="order-date-prefilter" class="prefilter">
                <div id="order-date-type-prefilter" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: dateRangeParams }"></div>
            </div>
            <div class="prefilter" style="display: none" data-bind="visible: dateRangeId() == -1">
                <div id="from-date" class="date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: fromDateParams }"></div>
            </div>
            <div class="prefilter" style="display: none" data-bind="visible: dateRangeId() == -1">
                <div id="to-date" class="date-picker" data-bind="component: { name: 'tempus-dominus-date-picker-component', params: toDateParams }"></div>
                <span class="validation-message text-danger" data-bind="validationMessage: fromDate"></span>
                <span class="validation-message text-danger" data-bind="validationMessage: toDate"></span>
                <span class="validation-message text-danger" data-bind="validationMessage: fromPreceedsTo"></span>
            </div>
        </div>

        <div id="email-list" data-bind="kendoGrid: mailboxGridParams"></div>
    </div>

    <div id="loaded-email-wrapper" style="display: none" data-bind="visible: loadedEmail, with: loadedEmail">
        <div class="card mb-3 bottom-shadow">
            <div class="card-body">
                <h4 class="mb-4 d-flex justify-content-between align-items-center">
                    <span data-bind="html: Subject"></span>
                    <span data-bind="html: moment(ReceivedDT).format('DD/MM/YYYY HH:mm')"></span>
                </h4>
                <h5 class="mb-0 d-flex justify-content-between align-items-center">
                    <a data-bind="attr: { href: `mailto:${FromEmail}` }, text: (FromName == FromEmail ? FromName : `${FromName} - ${FromEmail}`)"></a>
                    <span class="text-white" data-bind="text: `EmailID: ${EmailID}`"></span>
                </h5>
                <div style="display: none;" data-bind="visible: noAttachments">
                    <div class="d-flex align-items-center justify-content-between pt-4">
                        <button class="btn btn-dark" data-bind="click: flagProcessed">
                            Processed
                        </button>
                        <button class="btn btn-secondary" data-bind="click: flagJunk">
                            Junk
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div id="attachments-container" class="card mb-3  bottom-shadow">
            <div class="card-body">
                <ul id="attachments-list" class="list-unstyled mb-3" , data-bind="css: { 'mb-3': regularAttachments().length > 0, 'mb-2': regularAttachments().length == 0 }">
                    <!-- ko foreach: regularAttachments -->
                    <li class="attachment" data-bind="click: (data, event) => { $parent.selectedAttachment(data) }, css: { 'selected': $parent.selectedAttachment() == $data  }">
                        <span class="k-icon" data-bind="class: $parent.kendoIconClass($data)"></span>
                        <div class="attachment-properties">
                            <label data-bind="html: FileName, attr: { title: FileName }"></label>
                            <span data-bind="text: FileSizeDisplay"></span>
                        </div>
                    </li>
                    <!-- /ko -->
                    <!-- ko if: regularAttachments().length == 0 -->
                    <li>
                        <h4 class="mt-3">
                            No Attachments
                        </h4>
                    </li>
                    <!-- /ko -->
                </ul>
                <div id="attachment-viewer" style="display: none;" data-bind="visible: selectedAttachment, with: selectedAttachment">
                    <div id="attachment-iframe-wrapper" class="ratio">
                        <iframe id="attachment-frame" data-bind="attr: { src: src }"></iframe>
                    </div>
                    <div id="attachment-properties">
                        <div class="attachment-property" data-bind="component: { name: 'mdc-kendo-dropdown-component', params: attachmentTypeParams }"></div>
                        <!-- ko if: properties -->
                        <div class="mt-3" data-bind="template: { name: propertiesTemplateName, data: properties }"></div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
        <div id="email-viewer" class="card bottom-shadow">
            <div id="email-frame" class="card-body" data-bind="html: Body"></div>
        </div>
    </div>

</div>